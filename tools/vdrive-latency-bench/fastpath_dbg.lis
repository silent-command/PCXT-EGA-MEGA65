001651                    ; ---- compare two 512 word buffers. R8, R9 -> R8 = 0 if equal, else the
001652                    ; index of the first difference plus one
001653  8391  E0C0        CMP512                      INCRB
001654  8392  0800                                    MOVE R8, R0
001655  8393  0904                                    MOVE R9, R1
001656  8394  B208                                    XOR R2, R2
001657  8395  C086        _C5_L                       CMP @R0++, @R1++
001658  8396  FFAB  0009                              RBRA _C5_NE, !Z
001659  8398  1F88  0001                              ADD 1, R2
001660  839A  CF88  0200                              CMP 0x0200, R2
001661  839C  FFAB  FFF7                              RBRA _C5_L, !Z

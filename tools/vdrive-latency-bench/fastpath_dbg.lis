001713                    ; ---- CRT/ROM loader check.
001714                    ; R8: file name, R9: file size in bytes (< 64 KB)
001715                    ;
001716                    ; Works out for itself what SDB_FREAD_FAST is supposed to do: it takes
001717                    ; all whole 512-byte blocks except the last one, so
001718                    ; blocks = size/512 - 1, bytes = blocks*512,
001719                    ; window = bytes/4096, address = 0x7000 + bytes mod 4096
001720                    ; Then it checks
001721                    ; (a) the returned 4k window and address,
001722                    ; (b) that the handed-over file position is exactly "bytes",
001723                    ; (c) that reading the rest byte-wise yields exactly (size - bytes)
001724                    ; bytes and then EOF, with the right content, read through a
001725                    ; second file handle on the same device so that the two handles
001726                    ; fight over the FAT32 library's one sector buffer,
001727                    ; (d) every byte still visible in the 4k window against f32_fread.
001728  83DE  FF90  005E  CHKROM                      ASUB enter, 1
001729  83E0  0900                                    MOVE R9, R0                      ; R0: file size
001730  83E1  0808                                    MOVE R8, R2                      ; R2: file name
001731  83E2  FFB0  FEB0                              RSUB OPEN, 1
001732                    
001733  83E4  0004                                    MOVE R0, R1                      ; R1: bytes taken by the
001734  83E5  9FB8  FFFB                              AND 0xFFFB, R14                  ; ..fast path
001735  83E7  6F84  0009                              SHR 9, R1
001736  83E9  3F84  0001                              SUB 1, R1
001737  83EB  9FB8  FFFD                              AND 0xFFFD, R14
001738  83ED  5F84  0009                              SHL 9, R1
001739                    
001740  83EF  010C                                    MOVE R1, R3                      ; R3: expected 4k window
001741  83F0  9FB8  FFFB                              AND 0xFFFB, R14
001742  83F2  6F8C  000C                              SHR 12, R3

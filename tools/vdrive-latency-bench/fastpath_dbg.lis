001888                    
001889                    ; ============================================================================
001890                    ; ****************************************************************************
001891                    ; MiSTer2MEGA65 (M2M) QNICE ROM
001892                    ;
001893                    ; sdblock.asm: direct 512-byte block access to files on the SD card
001894                    ;
001895                    ; The FAT32 library of the QNICE Monitor only offers a byte-wise API
001896                    ; (f32_fread / f32_fwrite). Every single byte revalidates the cluster and the
001897                    ; sector of the file handle, which costs about 107 instructions per byte, and
001898                    ; f32_fseek walks the cluster chain from the start of the file, which makes a
001899                    ; random access at the far end of a 42 MB image cost seconds.
001900                    ;
001901                    ; This module resolves the on-disk layout of a file *once* into a compact
001902                    ; extent table and can then map "block N of the file" to an absolute SD card
001903                    ; LBA. A block is then one SD$READ_BLOCK plus a tight copy loop out of the
001904                    ; 512-byte buffer of the SD controller.
001905                    ;
001906                    ; ----------------------------------------------------------------------------
001907                    ; THE TWO RULES
001908                    ; ----------------------------------------------------------------------------
001909                    ;
001910                    ; (1) The FAT32 library must never be able to tell that we were here.
001911                    ;
001912                    ; The 512-byte "sector buffer" of the FAT32 library IS the 512-byte
001913                    ; hardware buffer of the SD controller; the device handle only remembers
001914                    ; *which* file handle filled it (FAT32$DEV_BUFFERED_FDH). Every direct
001915                    ; access destroys the library's buffer while the library still believes
001916                    ; it holds a particular sector.
001917                    ;
001918                    ; Earlier versions of this file solved that by pointing
001919                    ; FAT32$DEV_BUFFERED_FDH at a dummy handle, i.e. by reaching into the
001920                    ; library's bookkeeping. That is not done any more. Instead:
001921                    ;
001922                    ; * SDB_GUARD_IN works out, *before* anything is touched, which sector
001923                    ; the library believes is in the buffer and whether that sector can
001924                    ; be read back. If it cannot, the fast path is refused and nothing
001925                    ; is touched at all.
001926                    ; * a dirty buffer is written back through the library first.
001927                    ; * SDB_GUARD_OUT reads that very sector back, so the buffer holds
001928                    ; exactly what it held before.
001929                    ; * SDB_FREAD_FAST, which moves the file position anyway, restores the
001930                    ; library state the library's own way: with an f32_fseek, which
001931                    ; unconditionally re-reads the sector and re-claims ownership.
001932                    ;
001933                    ; The one remaining poke, SDB_ORPHAN, exists only for the case where the
001934                    ; restoring read itself fails, i.e. where the card is already broken. It
001935                    ; is strictly better than leaving the library with a buffer that holds
001936                    ; something else than it thinks.
001937                    ;
001938                    ; (2) Any error anywhere leaves the caller with "nothing happened".
001939                    ;
001940                    ; Every entry point returns Carry=0 on any problem, and the byte-wise
001941                    ; FAT32 path then does all of the work exactly as it did before this
001942                    ; file existed. In particular:
001943                    ;
001944                    ; * an SD card error latches the controller into its error state (see
001945                    ; the IO$SD_CSR description in sysdef.asm: "you need to reset the
001946                    ; controller to go on"), which would make every *subsequent* library
001947                    ; access fail too. SDB_SDERR therefore issues SD$RESET after any
001948                    ; failed SD operation before we hand back control.
001949                    ; * SDB_FREAD_FAST never seeks to the end of the file. It always leaves
001950                    ; at least one whole block to the byte loop, so the file position it
001951                    ; hands over is strictly inside the file and the caller reaches EOF
001952                    ; through the library, the way it always did.
001953                    ; * every seek is verified against FAT32$FDH_ACCESS afterwards.
001954                    ;
001955                    ; ----------------------------------------------------------------------------
001956                    ; Serial logging
001957                    ; ----------------------------------------------------------------------------
001958                    ; The switch is SDB_DEBUG in M2M/rom/sdblock_cfg.asm, which shell.asm includes
001959                    ; as its very first line. It must NOT be defined here: this file is included
001960                    ; at the end of shell.asm, and the C preprocessor runs once from top to
001961                    ; bottom, so a #define here would be invisible to every #ifdef above it.
001962                    ;
001963                    ; This file needs the environment of shell.asm.
001964                    ;
001965                    ; done for the PCXT-EGA-MEGA65 port and licensed under GPL v3
001966                    ; ****************************************************************************
001967                    
001968                    ; ----------------------------------------------------------------------------
001969                    ; Layout of a block map (see SDB_VD_MAPS / SDB_RM_MAP in shell_vars.asm)
001970                    ; ----------------------------------------------------------------------------
001971                    
001972                    ; Maximum amount of extents (runs of physically consecutive clusters) that we
001973                    ; are willing to remember for one file. A freshly copied image file normally
001974                    ; is one single extent. Files that would need more extents than this fall
001975                    ; back to the FAT32 library path.
001976                    SDB_MAX_EXT                 .EQU 8
001977                    
001978                    SDB_M_NEXT                  .EQU 0                           ; amount of valid extents; 0 = no map
001979                    SDB_M_FDH                   .EQU 1                           ; FDH this map was built for
001980                    SDB_M_TBLK_LO               .EQU 2                           ; amount of *whole* 512-byte blocks..
001981                    SDB_M_TBLK_HI               .EQU 3                           ; ..in the file (filesize / 512)
001982                    SDB_M_BAIL                  .EQU 4                           ; why there is no map (SDB_B_*)
001983                    SDB_M_EXT                   .EQU 5                           ; start of the extent array
001984                    
001985                    ; one extent: amount of blocks (lo/hi) and the absolute SD card LBA (lo/hi)
001986                    ; of the first of them
001987                    SDB_E_NBLK_LO               .EQU 0
001988                    SDB_E_NBLK_HI               .EQU 1
001989                    SDB_E_LBA_LO                .EQU 2
001990                    SDB_E_LBA_HI                .EQU 3
001991                    SDB_E_SIZE                  .EQU 4
001992                    
001993                    ; size of one map in words: SDB_M_EXT + SDB_E_SIZE * SDB_MAX_EXT = 5 + 4*8
001994                    ; = 37, rounded up to 40 to leave room
001995                    SDB_M_SIZE                  .EQU 40
001996                    
001997                    ; Amount of virtual drives that SDB_VD_MAPS in shell_vars.asm has room for.
001998                    ; The QNICE assembler cannot evaluate expressions in .BLOCK, so the size of
001999                    ; SDB_VD_MAPS is the literal SDB_M_SIZE * SDB_VD_MAX_N and both have to be
002000                    ; kept in sync by hand. Virtual drives beyond SDB_VD_MAX_N are not broken,
002001                    ; they just always use the (slow) FAT32 library path.
002002                    SDB_VD_MAX_N                .EQU 3
002003                    
002004                    ; Why a map could not be built. Logged, and also readable from SDB_M_BAIL.
002005                    SDB_B_OK                    .EQU 0
002006                    SDB_B_NOMAP                 .EQU 1                           ; no map slot for this drive
002007                    SDB_B_NODEV                 .EQU 2                           ; file handle has no device handle
002008                    SDB_B_NOSPC                 .EQU 3                           ; sectors per cluster is zero
002009                    SDB_B_EMPTY                 .EQU 4                           ; file is shorter than one block
002010                    SDB_B_BADSTART              .EQU 5                           ; start cluster < 2
002011                    SDB_B_FRAG                  .EQU 6                           ; more extents than SDB_MAX_EXT
002012                    SDB_B_FATERR                .EQU 7                           ; could not read a FAT sector
002013                    SDB_B_BADCLUS               .EQU 8                           ; illegal cluster in the chain
002014                    SDB_B_SHORT                 .EQU 9                           ; chain ends before the file does
002015                    SDB_B_LBA                   .EQU 10                          ; LBA arithmetic out of range
002016                    SDB_B_GUARD                 .EQU 11                          ; buffer could not be made restorable
002017                    SDB_B_SEEK                  .EQU 12                          ; restoring seek failed
002018                    
002019                    ; Why one virtual drive block request did or did not take the fast path.
002020                    ; Left in SDB_RD_STAT by SDB_VD_RDBLK / SDB_VD_WRBLK after every request, so
002021                    ; it can be read out even in a build without the serial log.
002022                    SDB_R_OK                    .EQU 0                           ; fast path taken
002023                    SDB_R_SIZE                  .EQU 1                           ; VD_SIZEB is not exactly 512
002024                    SDB_R_ALIGN                 .EQU 2                           ; byte position is not block aligned
002025                    SDB_R_MAP                   .EQU 3                           ; no usable map for this drive/handle
002026                    SDB_R_RANGE                 .EQU 4                           ; block is outside the mapped file
002027                    SDB_R_GUARD                 .EQU 5                           ; buffer could not be made restorable
002028                    SDB_R_SDERR                 .EQU 6                           ; the SD card operation failed
002029                    
002030                    ; end-of-chain marker: everything >= 0x0FFFFFF8 terminates a FAT32 chain,
002031                    ; and everything >= 0x0FFFFFF0 is reserved, so refuse all of it
002032                    SDB_EOC_HI                  .EQU 0x0FFF
002033                    SDB_EOC_LO                  .EQU 0xFFF0
002034                    
002035                    ; ----------------------------------------------------------------------------
002036                    ; Housekeeping
002037                    ; ----------------------------------------------------------------------------
002038                    
002039                    ; SDB_INVAL_ALL
002040                    ; Invalidates all block maps, i.e. everything falls back to the FAT32 library
002041                    ; until the maps are rebuilt. Called from VD_INIT and whenever the SD card
002042                    ; changes. Also clears the two zero-filled helper structures, because the
002043                    ; variables live in uninitialized RAM.
002044                    ;
002045                    ; Input: none
002046                    ; Output: none, all registers unchanged
002047  84D7  E0C0        SDB_INVAL_ALL               INCRB
002048  84D8  0F80  8D65                              MOVE SDB_VD_MAPS, R0
002049  84DA  0F84  0003                              MOVE SDB_VD_MAX_N, R1
002050  84DC  0F81  0000  _SDBIA_L                    MOVE 0, @R0
002051  84DE  1F80  0028                              ADD SDB_M_SIZE, R0
002052  84E0  3F84  0001                              SUB 1, R1
002053  84E2  FFAB  FFF8                              RBRA _SDBIA_L, !Z
002054  84E4  0F80  8DDD                              MOVE SDB_RM_MAP, R0
002055  84E6  0F81  0000                              MOVE 0, @R0
002056  84E8  0F80  8E05                              MOVE SDB_NULL_MAP, R0
002057  84EA  0F81  0000                              MOVE 0, @R0
002058  84EC  0F80  8E12                              MOVE SDB_G_VAL, R0
002059  84EE  0F81  0000                              MOVE 0, @R0
002060                    
002061                                                ; SDB_DUMMY_FDH must read as an all-zero, and therefore never
002062                                                ; dirty, file handle: SDB_ORPHAN hands it to FAT32$FLUSH
002063  84F0  0F80  8E06                              MOVE SDB_DUMMY_FDH, R0
002064  84F2  0F84  000C                              MOVE FAT32$FDH_STRUCT_SIZE, R1
002065  84F4  0F82  0000  _SDBIA_L2                   MOVE 0, @R0++
002066  84F6  3F84  0001                              SUB 1, R1
002067  84F8  FFAB  FFFA                              RBRA _SDBIA_L2, !Z
002068  84FA  E100                                    DECRB
002069  84FB  0DBC                                    MOVE @R13++, R15
002070                    
002071                    ; SDB_VDMAP
002072                    ; Returns the block map that belongs to a virtual drive. Drives that have no
002073                    ; map (see SDB_VD_MAX_N) get the permanently empty SDB_NULL_MAP, which makes
002074                    ; SDB_CHECK fail and therefore forces the FAT32 library path.
002075                    ;
002076                    ; Input: R8: virtual drive number
002077                    ; Output: R8: pointer to the block map
002078  84FC  E0C0        SDB_VDMAP                   INCRB
002079  84FD  0800                                    MOVE R8, R0
002080  84FE  0F84  0003                              MOVE SDB_VD_MAX_N, R1
002081  8500  C100                                    CMP R1, R0                       ; drive number < maximum?
002082  8501  FFA4  0004                              RBRA _SDBVM_OK, N                ; yes
002083  8503  0FA0  8E05                              MOVE SDB_NULL_MAP, R8            ; no: never mapped
002084  8505  FFA0  000C                              RBRA _SDBVM_D, 1
002085  8507  0FA0  8D65  _SDBVM_OK                   MOVE SDB_VD_MAPS, R8
002086  8509  CF80  0000  _SDBVM_L                    CMP 0, R0
002087  850B  FFA3  0006                              RBRA _SDBVM_D, Z
002088  850D  1FA0  0028                              ADD SDB_M_SIZE, R8
002089  850F  3F80  0001                              SUB 1, R0
002090  8511  FFA0  FFF6                              RBRA _SDBVM_L, 1
002091  8513  E100        _SDBVM_D                    DECRB
002092  8514  0DBC                                    MOVE @R13++, R15
002093                    
002094                    ; SDB_CHECK
002095                    ; Is the given map valid and does it belong to the given file handle?
002096                    ;
002097                    ; Input: R8: pointer to the block map
002098                    ; R9: file handle (FDH)
002099                    ; Output: Carry=1 if the map can be used, all registers unchanged
002100  8515  E0C0        SDB_CHECK                   INCRB
002101  8516  CFA1  0000                              CMP 0, @R8                       ; any extents?
002102  8518  FFA3  000A                              RBRA _SDBC_NO, Z                 ; no: unusable
002103  851A  0800                                    MOVE R8, R0
002104  851B  1F80  0001                              ADD SDB_M_FDH, R0
002105  851D  C064                                    CMP @R0, R9                      ; built for this file handle?
002106  851E  FFAB  0004                              RBRA _SDBC_NO, !Z                ; no: unusable
002107  8520  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002108  8522  FFA0  0002                              RBRA _SDBC_R, 1
002109  8524  9FB8  FFFB  _SDBC_NO                    AND 0xFFFB, R14                  ; clear Carry
002110  8526  E100        _SDBC_R                     DECRB
002111  8527  0DBC                                    MOVE @R13++, R15
002112                    
002113                    ; ----------------------------------------------------------------------------
002114                    ; Every SD card access of the fast path goes through these two wrappers, so
002115                    ; that the time the card itself needs can be measured separately from
002116                    ; everything else, and so that the number of card accesses per virtual drive
002117                    ; request is countable. Without SDB_DEBUG they are a plain call.
002118                    ; ----------------------------------------------------------------------------
002119                    
002120                    ; SDB_SDRD: read one 512-byte block into the SD controller's buffer
002121                    ; Input: R8/R9 = LBA lo/hi
002122                    ; Output: R8 = 0, or the error code
002123  8528              SDB_SDRD                    
002124                    
002125                    
002126                    
002127  8528  FF90  003C                              ASUB sd_r_block, 1
002128                    
002129                    
002130                    
002131  852A  0DBC                                    MOVE @R13++, R15
002132                    
002133                    ; SDB_SDWR: write the SD controller's buffer to one 512-byte block
002134                    ; Input: R8/R9 = LBA lo/hi
002135                    ; Output: R8 = 0, or the error code
002136  852B              SDB_SDWR                    
002137                    
002138                    
002139                    
002140  852B  FF90  003E                              ASUB sd_w_block, 1
002141                    
002142                    
002143                    
002144  852D  0DBC                                    MOVE @R13++, R15
002145                    ; SDB_SDERR
002146                    ; Called after a failed SD card operation. The controller latches its error
002147                    ; state and refuses everything until it is reset, which would turn our
002148                    ; problem into a fatal error in the *next* FAT32 library call. Reset it, so
002149                    ; that the fallback path starts from a clean controller.
002150                    ;
002151                    ; Input: R8: the error code (only used for logging)
002152                    ; Output: none, R8 unchanged
002153  852E  E0C0        SDB_SDERR                   INCRB
002154  852F  0800                                    MOVE R8, R0
002155                    
002156                    
002157                    
002158                    
002159                    
002160                    
002161                    
002162  8530  FF90  003A                              ASUB sd_reset, 1
002163  8532  0020                                    MOVE R0, R8
002164  8533  E100                                    DECRB
002165  8534  0DBC                                    MOVE @R13++, R15
002166                    
002167                    ; ----------------------------------------------------------------------------
002168                    ; Guarding the FAT32 library's sector buffer
002169                    ; ----------------------------------------------------------------------------
002170                    
002171                    ; SDB_GUARD_IN
002172                    ; Prepares for direct SD card access. Writes the FAT32 library's sector
002173                    ; buffer back first if it is dirty, and notes whether a real file handle
002174                    ; currently claims the buffer, so that SDB_GUARD_OUT can tell that handle
002175                    ; afterwards that the contents are no longer what it thinks. Refuses
002176                    ; (Carry=0) without touching anything if the write-back fails.
002177                    ;
002178                    ; This used to remember the sector's LBA and read it back in
002179                    ; SDB_GUARD_OUT. That was a second SD card access per virtual drive request,
002180                    ; about 1.5 ms of hardware time out of 3.4 ms, for something that the
002181                    ; library's own re-read mechanism does for free. It also could only ever
002182                    ; satisfy one of the two device handles that share the one hardware buffer,
002183                    ; whereas marking tells both.
002184                    ;
002185                    ; Input: none
002186                    ; Output: Carry=1: direct access is allowed
002187                    ; Carry=0: do not touch the SD card, nothing has been touched
002188                    ; all registers unchanged
002189  8535  FF90  005E  SDB_GUARD_IN                ASUB enter, 1
002190                    
002191  8537  0FA0  8E12                              MOVE SDB_G_VAL, R8               ; nobody to tell yet
002192  8539  0FA1  0000                              MOVE 0, @R8
002193                    
002194  853B  0FA0  8D40                              MOVE HANDLE_DEV, R8              ; who claims the buffer?
002195  853D  FFB0  0027                              RSUB _SDB_OWNER, 1
002196  853F  FFA2  0008                              RBRA _SDBGI_HAVE, C
002197  8541  0FA0  8D52                              MOVE CONFIG_DEVH, R8
002198  8543  FFB0  0021                              RSUB _SDB_OWNER, 1
002199  8545  FFA2  0002                              RBRA _SDBGI_HAVE, C
002200  8547  FFA0  0014                              RBRA _SDBGI_OK, 1                ; nobody: nothing to do
002201                    
002202                                                ; R8: device handle, R9: owning FDH
002203  8549  0904        _SDBGI_HAVE                 MOVE R9, R1
002204                    
002205  854A  0120                                    MOVE R1, R8                      ; dirty? then write it back
002206  854B  1FA0  000B                              ADD FAT32$FDH_FLAGS, R8
002207  854D  0860                                    MOVE @R8, R8
002208  854E  9FA0  0001                              AND FAT32$FDHF_DIRTY, R8
002209  8550  FFA3  0007                              RBRA _SDBGI_CLEAN, Z
002210  8552  0120                                    MOVE R1, R8
002211  8553  FF90  0068                              ASUB f32_fflush, 1
002212  8555  CFA4  0000                              CMP 0, R9
002213  8557  FFAB  0008                              RBRA _SDBGI_NO, !Z               ; cannot write back: refuse
002214                    
002215  8559  0FA0  8E12  _SDBGI_CLEAN                MOVE SDB_G_VAL, R8               ; a real handle owns it, so
002216  855B  0FA1  0001                              MOVE 1, @R8                      ; ..it has to be told later
002217                    
002218  855D  AFB8  0004  _SDBGI_OK                   OR 0x0004, R14                   ; set Carry
002219  855F  FFA0  0002                              RBRA _SDBGI_RET, 1
002220  8561  9FB8  FFFB  _SDBGI_NO                   AND 0xFFFB, R14                  ; clear Carry
002221  8563  FF90  0060  _SDBGI_RET                  ASUB leave, 1
002222  8565  0DBC                                    MOVE @R13++, R15
002223                    
002224                    ; Input: R8: device handle
002225                    ; Output: Carry=1 and R9 = the FDH that claims the buffer, R8 unchanged
002226                    ;
002227                    ; SDB_DUMMY_FDH is our own "the contents are unknown" marker and must not be
002228                    ; reported as an owner: otherwise the request after an orphaned one would try
002229                    ; to write back and mark a handle that is not a real file, and - since the
002230                    ; dummy has cluster 0 - would have been refused outright by the old
002231                    ; restore-based guard.
002232  8566  E0C0        _SDB_OWNER                  INCRB
002233  8567  CFA1  0000                              CMP 0, @R8                       ; device handle initialized?
002234  8569  FFA3  000F                              RBRA _SDB_OWN_NO, Z
002235  856B  0800                                    MOVE R8, R0
002236  856C  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
002237  856E  0064                                    MOVE @R0, R9
002238  856F  FFA3  0009                              RBRA _SDB_OWN_NO, Z              ; nobody claims it
002239  8571  0F80  8E06                              MOVE SDB_DUMMY_FDH, R0
002240  8573  C024                                    CMP R0, R9                       ; already marked as unknown?
002241  8574  FFA3  0004                              RBRA _SDB_OWN_NO, Z              ; then there is no owner
002242  8576  AFB8  0004                              OR 0x0004, R14
002243  8578  FFA0  0002                              RBRA _SDB_OWN_R, 1
002244  857A  9FB8  FFFB  _SDB_OWN_NO                 AND 0xFFFB, R14
002245  857C  E100        _SDB_OWN_R                  DECRB
002246  857D  0DBC                                    MOVE @R13++, R15
002247                    
002248                    ; SDB_GUARD_OUT
002249                    ; The direct access is done and the hardware buffer now holds our block. Tell
002250                    ; whoever claimed it that its contents are unknown, so that the FAT32 library
002251                    ; re-reads instead of trusting it.
002252                    ;
002253                    ; Input: none
002254                    ; Output: none, all registers unchanged
002255  857E  FF90  005E  SDB_GUARD_OUT               ASUB enter, 1
002256  8580  0FA0  8E12                              MOVE SDB_G_VAL, R8
002257  8582  CFA1  0000                              CMP 0, @R8
002258  8584  FFA3  0004                              RBRA _SDBGO_RET, Z               ; nobody had claimed it
002259  8586  0FA1  0000                              MOVE 0, @R8
002260  8588  FFB0  000A                              RSUB SDB_ORPHAN, 1
002261  858A  FF90  0060  _SDBGO_RET                  ASUB leave, 1
002262  858C  0DBC                                    MOVE @R13++, R15
002263                    
002264                    ; SDB_GUARD_CLR
002265                    ; The library has been put back by other means - SDB_FREAD_FAST finishes with
002266                    ; an f32_fseek, which re-reads the sector and re-claims ownership itself - so
002267                    ; there is nothing left to mark.
002268                    ;
002269                    ; Input: none
002270                    ; Output: none, all registers unchanged
002271  858D  E0C0        SDB_GUARD_CLR               INCRB
002272  858E  0F80  8E12                              MOVE SDB_G_VAL, R0
002273  8590  0F81  0000                              MOVE 0, @R0
002274  8592  E100                                    DECRB
002275  8593  0DBC                                    MOVE @R13++, R15
002276                    
002277                    ; SDB_ORPHAN
002278                    ; Tells both device handles that the contents of the 512-byte hardware buffer
002279                    ; are unknown, so that the library re-reads rather than serving something we
002280                    ; overwrote. This is the same mechanism the library uses on itself: READ_FDH
002281                    ; compares FAT32$DEV_BUFFERED_FDH with the handle it was called for and
002282                    ; re-reads through FAT32$RW_SIC whenever they differ.
002283                    ;
002284                    ; "Unknown" is expressed by handing the buffer to SDB_DUMMY_FDH, an all-zero
002285                    ; and therefore never dirty file handle, and not by the obvious 0: FAT32$FLUSH
002286                    ; returns immediately when called with R8 = 0 and then leaves R9 - its error
002287                    ; code - untouched, and FAT32$FILE_SEEK checks that stale R9 right after
002288                    ; calling it, so a seek would silently do nothing.
002289                    ;
002290                    ; Note what this does NOT do: it issues no SD card access of its own, so it
002291                    ; cannot produce an LBA, and therefore cannot reproduce anything of the shape
002292                    ; that made hardware run 1 fatal (a wild LBA latching the controller's error
002293                    ; state). All of the guards against that - stopping one block short of the
002294                    ; end of a file, verifying FAT32$FDH_ACCESS after every seek, validating every
002295                    ; LBA in SDB_CLULBA, and resetting the controller after a failed access - are
002296                    ; untouched.
002297                    ;
002298                    ; Input: none
002299                    ; Output: none, all registers unchanged
002300  8594  FF90  005E  SDB_ORPHAN                  ASUB enter, 1
002301                    
002302                    
002303                    
002304                    
002305                    
002306  8596  0FA0  8D40                              MOVE HANDLE_DEV, R8
002307  8598  FFB0  000B                              RSUB _SDB_ORPH1, 1
002308  859A  0FA0  8D52                              MOVE CONFIG_DEVH, R8
002309  859C  FFB0  0007                              RSUB _SDB_ORPH1, 1
002310  859E  0FA0  8E12                              MOVE SDB_G_VAL, R8               ; everybody has been told
002311  85A0  0FA1  0000                              MOVE 0, @R8
002312  85A2  FF90  0060                              ASUB leave, 1
002313  85A4  0DBC                                    MOVE @R13++, R15
002314                    
002315  85A5  E0C0        _SDB_ORPH1                  INCRB
002316  85A6  0804                                    MOVE R8, R1
002317  85A7  CFA1  0000                              CMP 0, @R8
002318  85A9  FFA3  0006                              RBRA _SDB_ORPH_R, Z
002319  85AB  0800                                    MOVE R8, R0
002320  85AC  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
002321  85AE  0F88  8E06                              MOVE SDB_DUMMY_FDH, R2
002322  85B0  0201                                    MOVE R2, @R0
002323  85B1  0120        _SDB_ORPH_R                 MOVE R1, R8
002324  85B2  E100                                    DECRB
002325  85B3  0DBC                                    MOVE @R13++, R15
002326                    
002327                    ; ----------------------------------------------------------------------------
002328                    ; 32-bit helpers
002329                    ; ----------------------------------------------------------------------------
002330                    
002331                    ; SDB_B2BLK
002332                    ; Converts a byte position into a 512-byte block index (unsigned 32 bit).
002333                    ;
002334                    ; Input: R9/R10: byte position lo/hi
002335                    ; Output: R9/R10: block index lo/hi
002336  85B4  E0C0        SDB_B2BLK                   INCRB
002337  85B5  0A00                                    MOVE R10, R0
002338  85B6  9F80  01FF                              AND 0x01FF, R0                   ; bits that move down into..
002339  85B8  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the low word; clear X so..
002340  85BA  5F80  0007                              SHL 7, R0                        ; ..SHL shifts in zeros
002341  85BC  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
002342  85BE  6FA4  0009                              SHR 9, R9
002343  85C0  1024                                    ADD R0, R9
002344  85C1  9FB8  FFFB                              AND 0xFFFB, R14
002345  85C3  6FA8  0009                              SHR 9, R10
002346  85C5  E100                                    DECRB
002347  85C6  0DBC                                    MOVE @R13++, R15
002348                    
002349                    ; SDB_BLK2B
002350                    ; Converts a 512-byte block index into a byte position (unsigned 32 bit).
002351                    ;
002352                    ; Input: R9/R10: block index lo/hi
002353                    ; Output: R9/R10: byte position lo/hi
002354  85C7  E0C0        SDB_BLK2B                   INCRB
002355  85C8  0900                                    MOVE R9, R0
002356  85C9  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
002357  85CB  6F80  0007                              SHR 7, R0                        ; bits that move up into..
002358  85CD  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the high word; clear X
002359  85CF  5FA8  0009                              SHL 9, R10
002360  85D1  1028                                    ADD R0, R10
002361  85D2  9FB8  FFFD                              AND 0xFFFD, R14
002362  85D4  5FA4  0009                              SHL 9, R9
002363  85D6  E100                                    DECRB
002364  85D7  0DBC                                    MOVE @R13++, R15
002365                    
002366                    ; SDB_CLULBA
002367                    ; The absolute SD card LBA of one sector within one cluster, i.e. exactly
002368                    ; what FAT32$RW_SIC computes, with every range check spelled out.
002369                    ;
002370                    ; Input: R8: device handle
002371                    ; R9/R10: cluster lo/hi
002372                    ; R11: sector within the cluster
002373                    ; Output: Carry=1: R9/R10 = LBA lo/hi
002374                    ; Carry=0: the cluster or the sector is out of range
002375                    ; R8, R11 unchanged
002376  85D8  E0C0        SDB_CLULBA                  INCRB
002377  85D9  0800                                    MOVE R8, R0                      ; R0: device handle
002378  85DA  0B04                                    MOVE R11, R1                     ; R1: sector
002379                    
002380  85DB  CFA8  0000                              CMP 0, R10                       ; cluster >= 2?
002381  85DD  FFAB  0006                              RBRA _SDBCL_C1, !Z
002382  85DF  CFA4  0001                              CMP 1, R9
002383  85E1  FFA4  0044                              RBRA _SDBCL_NO, N                ; cluster = 0
002384  85E3  FFA3  0042                              RBRA _SDBCL_NO, Z                ; cluster = 1
002385  85E5  CFA8  0FFF  _SDBCL_C1                   CMP SDB_EOC_HI, R10              ; cluster < 0x0FFFFFF0?
002386  85E7  FFAB  0006                              RBRA _SDBCL_C2, !Z
002387  85E9  C93E  FFF0                              CMP R9, SDB_EOC_LO
002388  85EB  FFA4  003A                              RBRA _SDBCL_NO, N
002389  85ED  FFA3  0038                              RBRA _SDBCL_NO, Z
002390  85EF  CA3E  0FFF  _SDBCL_C2                   CMP R10, 0x0FFF                  ; and inside 28 bits at all?
002391  85F1  FFA4  0034                              RBRA _SDBCL_NO, N
002392                    
002393  85F3  0008                                    MOVE R0, R2                      ; R2: sectors per cluster
002394  85F4  1F88  000C                              ADD FAT32$DEV_SECT_PER_CLUS, R2

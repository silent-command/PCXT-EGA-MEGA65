001099                    ; Test 2: a file that is not one block long and not block aligned
001100                    ; ============================================================================
001101  808E  0FA0  8B35  _T2                         MOVE S_T2, R8
001102  8090  FF90  0008                              ASUB puts, 1
001103  8092  B820                                    XOR R8, R8                       ; virtual drive 0
001104  8093  0FA4  89E3                              MOVE HANDLE_FILE, R9

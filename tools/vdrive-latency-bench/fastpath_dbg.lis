002556  86A1  1F88  0000                              ADD FAT32$FDH_DEVICE, R2
002557  86A3  0248                                    MOVE @R2, R2                     ; R2: device handle
002558  86A4  FFA3  00F2                              RBRA _SDBMB_RET, Z

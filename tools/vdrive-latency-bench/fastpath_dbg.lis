002458  863C  0010                                    MOVE R0, R4
002459  863D  1F90  0002                              ADD SDB_M_TBLK_LO, R4
002460  863F  C111                                    CMP R1, @R4
002461  8640  FFA4  0029                              RBRA _SDBL_NO, N                 ; idx_lo > total_lo
002462  8642  FFA3  0027                              RBRA _SDBL_NO, Z                 ; idx_lo = total_lo: outside
002463                    
002464  8644  0010        _SDBL_C1                    MOVE R0, R4
002465  8645  1F90  0005                              ADD SDB_M_EXT, R4                ; R4: current extent
002466  8647  0454        _SDBL_LOOP                  MOVE @R4, R5                     ; R5/R6: blocks in extent
002467  8648  0418                                    MOVE R4, R6

002482  865C  2228                                    ADDC R2, R10
002483  865D  FFA2  000C                              RBRA _SDBL_NO, C                 ; 32-bit overflow
002484  865F  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002485  8661  FFA0  000A                              RBRA _SDBL_RET, 1
002486                    
002487  8663  3504        _SDBL_NEXT                  SUB R5, R1                       ; remainder -= extent size
002488  8664  4608                                    SUBC R6, R2

001775  8425  0228                                    MOVE R2, R10
001776  8426  BB2C                                    XOR R11, R11
001777  8427  FF90  0050                              ASUB f32_fopen, 1
001778  8429  CFA8  0000                              CMP 0, R10
001779  842B  FFAB  005E                              RBRA _CR_BAD, !Z
001780  842D  0FA0  89EF                              MOVE HANDLE_FILE2, R8
001781  842F  0124                                    MOVE R1, R9
001782  8430  BA28                                    XOR R10, R10
001783  8431  FF90  0054                              ASUB f32_fseek, 1
001784  8433  CFA4  0000                              CMP 0, R9
001785  8435  FFAB  0054                              RBRA _CR_BAD, !Z
001786                    
001787  8437  001C                                    MOVE R0, R7                      ; R7: tail bytes still to go
001788  8438  311C                                    SUB R1, R7
001789  8439  CF9C  0000  _CR_TL                      CMP 0, R7
001790  843B  FFA3  0018                              RBRA _CR_TD, Z

001259                    ; ============================================================================
001260                    ; Test 6: SDB_FREAD_FAST, the CRT/ROM loader path
001261                    ; 6a: a file that fits into one 4k window, all bytes are checked
001262                    ; 6b: a 16 KB file, so that the 4k window wrap is exercised; the last
001263                    ; window and the byte-wise tail are checked
001264                    ; ============================================================================
001265  8180  0FA0  8C1D                              MOVE S_T6A, R8
001266  8182  FF90  0008                              ASUB puts, 1
001267  8184  0FA0  8A2C                              MOVE F_SMALL, R8
001268  8186  0FA4  0664                              MOVE 1636, R9                    ; file size
001269  8188  FFB0  0254                              RSUB CHKROM, 1
001270                    
001271  818A  0FA0  8C40                              MOVE S_T6B, R8
001272  818C  FF90  0008                              ASUB puts, 1
001273  818E  0FA0  8A1F                              MOVE F_TESTROM, R8
001274  8190  0FA4  412C                              MOVE 16684, R9                   ; file size
001275  8192  FFB0  024A                              RSUB CHKROM, 1
001276                    
001277                                                ; A file that ends exactly on a cluster boundary. Seeking such
001278                                                ; a file to its very end walks one step past the last cluster,
001279                                                ; and FAT32$RW_SIC then issues a block read at a wild LBA,
001280                                                ; which latches the error state of the real SD controller.
001281                                                ; The fast path must stop one whole block short, so that the
001282                                                ; position it hands over is always strictly inside the file.
001283  8194  0FA0  8C62                              MOVE S_T6C, R8
001284  8196  FF90  0008                              ASUB puts, 1
001285  8198  0FA0  8A37                              MOVE F_EXACT, R8
001286  819A  0FA4  8000                              MOVE 32768, R9                   ; exactly one 64 sector cluster
001287  819C  FFB0  0240                              RSUB CHKROM, 1
001288                    
001289                    ; ============================================================================
001290                    ; Test 7: after a map build that gives up, the FAT32 library must be exactly
001291                    ; where it was. This is the property that broke on real hardware.
001292                    ; ============================================================================
001293  819E  0FA0  8C8E                              MOVE S_T7, R8
001294  81A0  FF90  0008                              ASUB puts, 1
001295  81A2  0FA0  8A13                              MOVE F_FRAG16, R8                ; twelve extents: always bails
001296  81A4  FFB0  00EE                              RSUB OPEN, 1
001297  81A6  0FA0  89E3                              MOVE HANDLE_FILE, R8             ; reference: read 512 bytes
001298  81A8  0FA4  B000                              MOVE BUF_A, R9                   ; ..before doing anything
001299  81AA  FFB0  01D0                              RSUB FREAD512, 1
001300  81AC  0FA0  89E3                              MOVE HANDLE_FILE, R8
001301  81AE  B924                                    XOR R9, R9
001302  81AF  BA28                                    XOR R10, R10
001303  81B0  FF90  0054                              ASUB f32_fseek, 1
001304  81B2  0FA0  89E3                              MOVE HANDLE_FILE, R8             ; now let the map build run
001305  81B4  0FA4  8DDD                              MOVE SDB_RM_MAP, R9              ; ..and give up half way
001306  81B6  FFB0  04D0                              RSUB SDB_MAP_BUILD, 1
001307  81B8  0FA0  89E3                              MOVE HANDLE_FILE, R8             ; the very next library read
001308  81BA  0FA4  B200                              MOVE BUF_B, R9                   ; ..must still be correct
001309  81BC  FFB0  01BE                              RSUB FREAD512, 1
001310  81BE  0FA0  B000                              MOVE BUF_A, R8
001311  81C0  0FA4  B200                              MOVE BUF_B, R9
001312  81C2  FFB0  01CD                              RSUB CMP512, 1
001313  81C4  FFB0  02F1                              RSUB VERDICT0, 1
001314                    
001315                                                ; the same for a vdrive block read that uses the fast path:
001316                                                ; it must not disturb a second, unrelated file handle
001317  81C6  0FA0  8CB9                              MOVE S_T7B, R8
001318  81C8  FF90  0008                              ASUB puts, 1
001319  81CA  0FA0  89FB                              MOVE F_FREEDOS, R8
001320  81CC  FFB0  00C6                              RSUB OPEN, 1
001321  81CE  0FA0  89E3                              MOVE HANDLE_FILE, R8
001322  81D0  0FA4  8D65                              MOVE SDB_VD_MAPS, R9
001323  81D2  FFB0  04B4                              RSUB SDB_MAP_BUILD, 1
001324  81D4  0FA0  8D40                              MOVE HANDLE_DEV, R8              ; a second file, positioned
001325  81D6  0FA4  89EF                              MOVE HANDLE_FILE2, R9            ; ..somewhere in the middle
001326  81D8  0FA8  8A08                              MOVE F_FRAG3, R10
001327  81DA  BB2C                                    XOR R11, R11
001328  81DB  FF90  0050                              ASUB f32_fopen, 1
001329  81DD  0FA0  89EF                              MOVE HANDLE_FILE2, R8
001330  81DF  0FA4  2600                              MOVE 0x2600, R9                  ; byte 9728, inside extent 1
001331  81E1  BA28                                    XOR R10, R10
001332  81E2  FF90  0054                              ASUB f32_fseek, 1
001333  81E4  0FA0  89EF                              MOVE HANDLE_FILE2, R8            ; reference bytes
001334  81E6  0FA4  B000                              MOVE BUF_A, R9
001335  81E8  FFB0  0192                              RSUB FREAD512, 1
001336  81EA  0FA0  89EF                              MOVE HANDLE_FILE2, R8
001337  81EC  0FA4  2600                              MOVE 0x2600, R9
001338  81EE  BA28                                    XOR R10, R10
001339  81EF  FF90  0054                              ASUB f32_fseek, 1
001340  81F1  B820                                    XOR R8, R8                       ; a fast vdrive block read in
001341  81F2  0FA4  89E3                              MOVE HANDLE_FILE, R9             ; ..between, on the other file
001342  81F4  0FA8  0000                              MOVE 0x0000, R10
001343  81F6  0FAC  0002                              MOVE 0x0002, R11                 ; byte 131072 of freedos.vhd
001344  81F8  0FB0  0200                              MOVE 0x0200, R12
001345  81FA  FFB0  069D                              RSUB SDB_VD_RDBLK, 1
001346  81FC  FFAA  0015                              RBRA _T7B_NO, !C
001347  81FE  B820                                    XOR R8, R8
001348  81FF  FFB0  062E                              RSUB SDB_SD2VD, 1
001349  8201  FFB0  06CA                              RSUB SDB_VD_RDDONE, 1
001350  8203  0FA0  89EF                              MOVE HANDLE_FILE2, R8            ; ..and the second handle must
001351  8205  0FA4  B200                              MOVE BUF_B, R9                   ; ..still read the same bytes
001352  8207  FFB0  0173                              RSUB FREAD512, 1
001353  8209  0FA0  B000                              MOVE BUF_A, R8
001354  820B  0FA4  B200                              MOVE BUF_B, R9
001355  820D  FFB0  0182                              RSUB CMP512, 1
001356  820F  FFB0  02A6                              RSUB VERDICT0, 1
001357  8211  FFA0  0006                              RBRA _T7B_D, 1
001358  8213  0FA0  8A68  _T7B_NO                     MOVE S_NOMAP, R8
001359  8215  FF90  0008                              ASUB puts, 1
001360  8217  FFB0  02B7                              RSUB BUMPFAIL, 1
001361  8219  0FA0  8D17  _T7B_D                      MOVE S_NUL, R8

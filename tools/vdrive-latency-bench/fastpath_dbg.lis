001131                    ; ============================================================================
001132                    ; Test 3: read after write, both directions
001133                    ; ============================================================================
001134  80C1  0FA0  8B82                              MOVE S_T3, R8
001135  80C3  FF90  0008                              ASUB puts, 1
001136                    
001137                                                ; (a) direct write, then read back through the FAT32 library
001138  80C5  0FA0  B000                              MOVE BUF_A, R8
001139  80C7  0FA4  0055                              MOVE 0x0055, R9
001140  80C9  FFB0  0214                              RSUB PATTERN, 1
001141  80CB  0FA4  8D3C                              MOVE T3_BLK, R9
001142  80CD  0964                                    MOVE @R9, R9
001143  80CE  BA28                                    XOR R10, R10
001144  80CF  FFB0  0274                              RSUB WRBLK, 1                    ; fills the drive buffer and
001145  80D1  FFAA  0044                              RBRA _T3_NOMAP, !C               ; ..calls SDB_VD_WRBLK
001146                    
001147  80D3  0FA4  8D3C                              MOVE T3_BLK, R9
001148  80D5  0964                                    MOVE @R9, R9
001149  80D6  BA28                                    XOR R10, R10
001150  80D7  0FA0  89E3                              MOVE HANDLE_FILE, R8
001151  80D9  FFB0  0226                              RSUB RDSLOW, 1                   ; f32 read into BUF_B
001152  80DB  0FA0  B000                              MOVE BUF_A, R8
001153  80DD  0FA4  B200                              MOVE BUF_B, R9
001154  80DF  FFB0  02B0                              RSUB CMP512, 1
001155  80E1  FFB0  03D4                              RSUB VERDICT0, 1
001156                    
001157                                                ; (b) the same block through the fast read path
001158  80E3  0FA0  8BA1                              MOVE S_T3B, R8
001159  80E5  FF90  0008                              ASUB puts, 1
001160  80E7  0FA0  89E3                              MOVE HANDLE_FILE, R8
001161  80E9  0FA4  8D3C                              MOVE T3_BLK, R9
001162  80EB  0964                                    MOVE @R9, R9
001163  80EC  BA28                                    XOR R10, R10
001164  80ED  FFB0  02B7                              RSUB CHKBLK, 1                   ; fast vs slow, both re-read
001165  80EF  FFB0  03C6                              RSUB VERDICT0, 1
001166                    
001167                                                ; (c) write through the FAT32 library, read through the fast
001168                                                ; path: this is the direction that would show a stale
001169                                                ; buffer if SDB_FLUSHINV were missing
001170  80F1  0FA0  8BC0                              MOVE S_T3C, R8
001171  80F3  FF90  0008                              ASUB puts, 1
001172  80F5  0FA0  B000                              MOVE BUF_A, R8
001173  80F7  0FA4  00A7                              MOVE 0x00A7, R9
001174  80F9  FFB0  01E4                              RSUB PATTERN, 1
001175  80FB  0FA0  89E3                              MOVE HANDLE_FILE, R8
001176  80FD  0FA4  8D3C                              MOVE T3_BLK, R9
001177  80FF  0964                                    MOVE @R9, R9
001178  8100  BA28                                    XOR R10, R10
001179  8101  FFB0  020C                              RSUB WRSLOW, 1                   ; f32_fwrite + f32_fflush
001180  8103  0FA0  89E3                              MOVE HANDLE_FILE, R8
001181  8105  0FA4  8D3C                              MOVE T3_BLK, R9
001182  8107  0964                                    MOVE @R9, R9
001183  8108  BA28                                    XOR R10, R10
001184  8109  FFB0  021C                              RSUB RDFAST, 1                   ; SDB_VD_RDBLK into BUF_B
001185  810B  FFAA  000A                              RBRA _T3_NOMAP, !C
001186  810D  0FA0  B000                              MOVE BUF_A, R8
001187  810F  0FA4  B200                              MOVE BUF_B, R9
001188  8111  FFB0  027E                              RSUB CMP512, 1
001189  8113  FFB0  03A2                              RSUB VERDICT0, 1
001190  8115  FFA0  0006                              RBRA _T4, 1
001191  8117  0FA0  8A62  _T3_NOMAP                   MOVE S_FAIL, R8
001192  8119  FF90  0008                              ASUB puts, 1
001193  811B  FFB0  03B3                              RSUB BUMPFAIL, 1

001235  8155  FF90  0008                              ASUB puts, 1
001236  8157  0FA0  8A13                              MOVE F_FRAG16, R8
001237  8159  FFB0  0139                              RSUB OPEN, 1
001238  815B  0FA0  89E3                              MOVE HANDLE_FILE, R8
001239  815D  0FA4  8D65                              MOVE SDB_VD_MAPS, R9
001240  815F  FFB0  0527                              RSUB SDB_MAP_BUILD, 1

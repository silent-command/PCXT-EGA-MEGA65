001534                    ; ---- read a block through the FAT32 library into BUF_B
001535                    ; R8: FDH, R9/R10: block index lo/hi
001536  8301  E0C0        RDSLOW                      INCRB
001537  8302  0800                                    MOVE R8, R0
001538  8303  FFB0  02C2                              RSUB SDB_BLK2B, 1
001539  8305  FF90  0054                              ASUB f32_fseek, 1
001540  8307  0020                                    MOVE R0, R8
001541  8308  0FA4  B200                              MOVE BUF_B, R9
001542  830A  FFB0  0070                              RSUB FREAD512, 1
001543  830C  0020                                    MOVE R0, R8
001544  830D  E100                                    DECRB
001545  830E  0DBC                                    MOVE @R13++, R15
001546                    
001547                    ; ---- write a block through the FAT32 library from BUF_A
001548                    ; R8: FDH, R9/R10: block index lo/hi
001549  830F  E0C0        WRSLOW                      INCRB
001550  8310  0800                                    MOVE R8, R0
001551  8311  FFB0  02B4                              RSUB SDB_BLK2B, 1
001552  8313  FF90  0054                              ASUB f32_fseek, 1
001553  8315  0F84  B000                              MOVE BUF_A, R1
001554  8317  0F88  0200                              MOVE 0x0200, R2
001555  8319  0020        _WRS_L                      MOVE R0, R8
001556  831A  01A4                                    MOVE @R1++, R9
001557  831B  FF90  0066                              ASUB f32_fwrite, 1
001558  831D  3F88  0001                              SUB 1, R2
001559  831F  FFAB  FFF8                              RBRA _WRS_L, !Z
001560  8321  0020                                    MOVE R0, R8
001561  8322  FF90  0068                              ASUB f32_fflush, 1
001562  8324  0020                                    MOVE R0, R8
001563  8325  E100                                    DECRB
001564  8326  0DBC                                    MOVE @R13++, R15
001565                    
001566                    ; ---- read a block through the fast path into BUF_B
001567                    ; R8: FDH, R9/R10: block index lo/hi; Carry=1 if the fast path was used
001568  8327  E0C0        RDFAST                      INCRB
001569  8328  0800                                    MOVE R8, R0
001570  8329  FFB0  029C                              RSUB SDB_BLK2B, 1
001571  832B  0A2C                                    MOVE R10, R11
001572  832C  0928                                    MOVE R9, R10
001573  832D  B820                                    XOR R8, R8
001574  832E  0024                                    MOVE R0, R9
001575  832F  0FB0  0200                              MOVE 0x0200, R12
001576  8331  FFB0  0566                              RSUB SDB_VD_RDBLK, 1
001577  8333  FFAA  000B                              RBRA _RDF_NO, !C
001578  8335  0FA0  B200                              MOVE BUF_B, R8
001579  8337  FFB0  FFB7                              RSUB SD2MEM, 1
001580  8339  FFB0  0592                              RSUB SDB_VD_RDDONE, 1            ; hand the buffer back
001581  833B  0020                                    MOVE R0, R8
001582  833C  AFB8  0004                              OR 0x0004, R14
001583  833E  FFA0  0003                              RBRA _RDF_R, 1
001584  8340  0020        _RDF_NO                     MOVE R0, R8

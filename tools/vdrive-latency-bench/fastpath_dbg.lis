000001                    ; Correctness bench for the SD-direct fast path in M2M/rom/sdblock.asm.
000002                    ;
000003                    ; Runs the REAL firmware routines (sdblock.asm is included verbatim, the few
000004                    ; shell.asm variables it needs come from bench_env.asm) against the REAL
000005                    ; FAT32 library of the QNICE Monitor and compares, byte for byte, what the
000006                    ; fast path delivers with what the original f32_fread path delivers.
000007                    ;
000008                    ; Needs a *writable* image: run.sh points it at sd_rw.img.
000009                    ;
000010                    ; Output is plain text on the emulator console, one line per check, plus a
000011                    ; PASS/FAIL summary at the end.
000012                    
000013                    ; ****************************************************************************
000014                    ; MiSTer2MEGA65 (M2M) QNICE ROM
000015                    ;
000016                    ; sdblock_cfg.asm: the single build switch for the direct SD block access in
000017                    ; sdblock.asm and for its serial logging.
000018                    ;
000019                    ; ----------------------------------------------------------------------------
000020                    ; SDB_DEBUG: log what the fast path does on the serial console at boot
000021                    ; ----------------------------------------------------------------------------
000022                    ; Remove the ";" in front of the #define to switch the log on, put it back to
000023                    ; switch it off, then rebuild with CORE/m2m-rom/make_rom.sh. No keyboard is
000024                    ; involved: the ROM auto loader runs by itself and the virtual drive lines
000025                    ; appear as soon as an image is mounted.
000026                    ;
000027                    ; This lives in its own file and NOT in sdblock.asm because the C
000028                    ; preprocessor runs once, top to bottom, over the whole concatenated source.
000029                    ; sdblock.asm is included at the *end* of shell.asm, so a #define in it is
000030                    ; not yet known while shell.asm's own body, crts-and-roms.asm and everything
000031                    ; else above it are being processed - their #ifdef SDB_DEBUG blocks would be
000032                    ; silently dropped. Include this file first and the flag is visible
000033                    ; everywhere.
000034                    ;
000035                    ; That is not hypothetical: it is exactly how the first instrumented build
000036                    ; ended up with a working map-build log (inside sdblock.asm, after the
000037                    ; define) and no virtual drive log at all (in shell.asm, before it).
000038                    ; ****************************************************************************
000039                    
000040                    ;#define SDB_DEBUG
000041                    
000042                    ; tools/vdrive-latency-bench/run.sh passes -DSDB_NODEBUG for its timing runs,
000043                    ; so that the cycle counts it reports are those of the shipping build no
000044                    ; matter how the switch above is set.
000045                    ;;
000046                    ;; sysdef.asm: This file contains definitions to simplify assembler programming
000047                    ;; and for accessing the various hardware registers via MMIO
000048                    ;;
000049                    ;
000050                    ;***************************************************************************************
000051                    ;* Assembler macros which make life much easier:
000052                    ;***************************************************************************************
000053                    ;
000054                    
000055                    
000056                    
000057                    
000058                    
000059                    ;
000060                    ; Some register short names:
000061                    ;
000062                    
000063                    
000064                    
000065                    
000066                    ;
000067                    ;***************************************************************************************
000068                    ;* IO-page addresses: Default: 8 registers per block
000069                    ;***************************************************************************************
000070                    ;
000071                    IO$AREA_START               .EQU 0xFF00
000072                    ;
000073                    ;---------------------------------------------------------------------------------------
000074                    ; Block FF00: FUNDAMENTAL IO
000075                    ;---------------------------------------------------------------------------------------
000076                    ;
000077                    ; Switch-register:
000078                    ;
000079                    IO$SWITCH_REG               .EQU 0xFF00                      ; 16 binary keys
000080                    ;
000081                    ; Registers for TIL-display:
000082                    ;
000083                    IO$TIL_DISPLAY              .EQU 0xFF01                      ; Address of TIL-display
000084                    IO$TIL_MASK                 .EQU 0xFF02                      ; Mask register of TIL display
000085                    ;
000086                    ; USB-keyboard-registers:
000087                    ;
000088                    IO$KBD_STATE                .EQU 0xFF04                      ; Status register of USB keyboard
000089                    ; Bit 0 (read only): New ASCII character avaiable for reading
000090                    ; (bits 7 downto 0 of Read register)
000091                    ; Bit 1 (read only): New special key available for reading
000092                    ; (bits 15 downto 8 of Read register)
000093                    ; Bits 2..4 (read/write): Locales: 000 = US English keyboard layout,
000094                    ; 001 = German layout, others: reserved for more locales
000095                    ; Bits 5..7 (read only): Modifiers: 5 = shift, 6 = alt, 7 = ctrl
000096                    ; Only valid, when bits 0 and/or 1 are '1'
000097                    ;
000098                    IO$KBD_DATA                 .EQU 0xFF05                      ; Data register of USB keyboard
000099                    ; Contains the ASCII character in bits 7 downto 0 or the special key code
000100                    ; in 15 downto 8. The "or" is meant exclusive, i.e. it cannot happen that
000101                    ; one transmission contains an ASCII character PLUS a special character.
000102                    ;
000103                    ;---------------------------------------------------------------------------------------
000104                    ; Block FF08: SYSTEM COUNTERS
000105                    ;---------------------------------------------------------------------------------------
000106                    ;
000107                    ; CYCLE-COUNT-registers
000108                    ;
000109                    IO$CYC_LO                   .EQU 0xFF08                      ; low word of 48-bit counter
000110                    IO$CYC_MID                  .EQU 0xFF09                      ; middle word of 48-bit counter
000111                    IO$CYC_HI                   .EQU 0xFF0A                      ; high word of 48-bit counter
000112                    IO$CYC_STATE                .EQU 0xFF0B                      ; status register
000113                    ; Bit 0 (write only): Reset counter to zero and start counting, i.e.
000114                    ; bit 1 is automatically set to 1 when resetting
000115                    ; Bit 1 (read/write): Start/stop counter
000116                    ;
000117                    ; INSTRUCTION-COUNT-registers
000118                    ;
000119                    IO$INS_LO                   .EQU 0xFF0C                      ; low word of 48-bit counter
000120                    IO$INS_MID                  .EQU 0xFF0D                      ; middle word of 48-bit counter
000121                    IO$INS_HI                   .EQU 0xFF0E                      ; high word of 48-bit counter
000122                    IO$INS_STATE                .EQU 0xFF0F                      ; status register
000123                    ; Bit 0 (write only): Reset counter to zero and start counting, i.e.
000124                    ; bit 1 is automatically set to 1 when resetting
000125                    ; Bit 1 (read/write): Start/stop counter
000126                    ;
000127                    ;---------------------------------------------------------------------------------------
000128                    ; Block FF10: UART
000129                    ;---------------------------------------------------------------------------------------
000130                    ;
000131                    ; QNICE-FPGA supports: IO$UART_SRA, IO$UART_RHRA and IO$UART_THRA
000132                    ; The other registers are mentioned for completeness to map real hardware (16550)
000133                    ;
000134                    IO$UART_BASE_ADDRESS        .EQU 0xFF10
000135                    IO$UART_MR1A                .EQU 0xFF10                      ; n/a
000136                    IO$UART_MR1B                .EQU 0xFF10                      ; n/a
000137                    IO$UART_SRA                 .EQU 0xFF11                      ; Status register (relative to base address)
000138                    IO$UART_RHRA                .EQU 0xFF12                      ; Receiving register (relative to base address)
000139                    IO$UART_THRA                .EQU 0xFF13                      ; Transmitting register (relative to base address)
000140                    ;
000141                    ;---------------------------------------------------------------------------------------
000142                    ; Block FF18: EAE
000143                    ;---------------------------------------------------------------------------------------
000144                    ;
000145                    ; EAE (Extended Arithmetic Element) registers:
000146                    ;
000147                    IO$EAE_OPERAND_0            .EQU 0xFF18
000148                    IO$EAE_OPERAND_1            .EQU 0xFF19
000149                    IO$EAE_RESULT_LO            .EQU 0xFF1A
000150                    IO$EAE_RESULT_HI            .EQU 0xFF1B
000151                    IO$EAE_CSR                  .EQU 0xFF1C                      ; Command and Status Register
000152                    ;
000153                    ; EAE-Opcodes (CSR): 0x0000 MULU 32-bit result in LO HI
000154                    ; 0x0001 MULS 32-bit result in LO HI
000155                    ; 0x0002 DIVU result in LO, modulo in HI
000156                    ; 0x0003 DIVS result in LO, modulo in HI
000157                    ; Bit 15 of CSR is the busy bit. If it is set, the EAE is still busy crunching numbers.
000158                    ;
000159                    ;---------------------------------------------------------------------------------------
000160                    ; Block FF20: SD CARD
000161                    ;---------------------------------------------------------------------------------------
000162                    ;
000163                    ; SD CARD INTERFACE registers
000164                    ;
000165                    IO$SD_BASE_ADDRESS          .EQU 0xFF20
000166                    IO$SD_ADDR_LO               .EQU 0xFF20                      ; low word of 32bit linear SD card block address
000167                    IO$SD_ADDR_HI               .EQU 0xFF21                      ; high word of 32bit linear SD card block address
000168                    IO$SD_DATA_POS              .EQU 0xFF22 ; "Cursor" to navigate the 512-byte data buffer
000169                    IO$SD_DATA                  .EQU 0xFF23                      ; read/write 1 byte from/to the 512-byte data buffer
000170                    IO$SD_ERROR                 .EQU 0xFF24                      ; error code of last operation (read only)
000171                    IO$SD_CSR                   .EQU 0xFF25                      ; Command and Status Register (write to execute command)
000172                    ;
000173                    ; SD-Opcodes (CSR): 0x0000 Reset SD card
000174                    ; 0x0001 Read 512 bytes from the linear block address
000175                    ; 0x0002 Write 512 bytes to the linear block address
000176                    ; Bits 0 .. 2 are write-only (reading always returns 0)
000177                    ; Bits 13 .. 12 return the card type: 00 = no card / unknown card
000178                    ; 01 = SD V1
000179                    ; 10 = SD V2
000180                    ; 11 = SDHC
000181                    ; Bit 14 of the CSR is the error bit: 1, if the last operation failed. In such
000182                    ; a case, the error code is in IO$SD_ERROR and
000183                    ; you need to reset the controller to go on
000184                    ; Bit 15 of the CSR is the busy bit: 1, if current operation is still running
000185                    ;
000186                    ;---------------------------------------------------------------------------------------
000187                    ; Block FF28: TIMER 0 and 1
000188                    ;---------------------------------------------------------------------------------------
000189                    ;
000190                    ; Interrupt timer: There are two timers capable of generating interrupts.
000191                    ; Each timer is controlled by three 16 bit registers:
000192                    ;
000193                    ; IO$TIMER_x_PRE: The 100 kHz timer clock is divided by the value stored in
000194                    ; this device register. 100 (which corresponds to 0x0064 in
000195                    ; the prescaler register) yields a 1 millisecond pulse which
000196                    ; in turn is fed to the actual counter.
000197                    ; IO$TIMER_x_CNT: When the number of output pulses from the prescaler circuit
000198                    ; equals the number stored in this register, an interrupt will
000199                    ; be generated (if the interrupt address is 0x0000, the
000200                    ; interrupt will be suppressed).
000201                    ; IO$TIMER_x_INT: This register contains the address of the desired interrupt
000202                    ; service routine.
000203                    ;
000204                    IO$TIMER_BASE_ADDRESS       .EQU 0xFF28
000205                    IO$TIMER_0_PRE              .EQU 0xFF28
000206                    IO$TIMER_0_CNT              .EQU 0xFF29
000207                    IO$TIMER_0_INT              .EQU 0xFF2A
000208                    IO$TIMER_1_PRE              .EQU 0xFF2B
000209                    IO$TIMER_1_CNT              .EQU 0xFF2C
000210                    IO$TIMER_1_INT              .EQU 0xFF2D
000211                    ;
000212                    ;---------------------------------------------------------------------------------------
000213                    ; Block FF30: VGA (double block, 16 registers)
000214                    ;---------------------------------------------------------------------------------------
000215                    ;
000216                    VGA$STATE                   .EQU 0xFF30                      ; VGA status register
000217                                                ; Bits 11-10: Hardware scrolling / offset enable: Bit #10 enables the use
000218                                                ; of the offset register #4 (display offset) and bit #11
000219                                                ; enables the use of register #5 (read/write offset).
000220                                                ; Bit 9: Busy: VGA is currently busy, e.g. clearing the screen,
000221                                                ; printing, etc. While busy, commands will be ignored, but
000222                                                ; they can still be written into the registers, though
000223                                                ; Bit 8: Set bit to clear screen. Read bit to find out, if clear
000224                                                ; screen is still active
000225                                                ; Bit 7: VGA enable (1 = on; 0: no VGA signal is generated)
000226                                                ; Bit 6: Hardware cursor enable
000227                                                ; Bit 5: Hardware cursor blink enable
000228                                                ; Bit 4: Hardware cursor mode: 1 - small
000229                                                ; 0 - large
000230                                                ; Bits 2-0: Output color for the whole screen, bits (2, 1, 0) = RGB
000231                    VGA$CR_X                    .EQU 0xFF31                      ; VGA cursor X position
000232                    VGA$CR_Y                    .EQU 0xFF32                      ; VGA cursor Y position
000233                    VGA$CHAR                    .EQU 0xFF33                      ; write: VGA character to be displayed
000234                                                ; read: character "under" the cursor
000235                    VGA$OFFS_DISPLAY            .EQU 0xFF34                      ; Offset in bytes that is used when displaying
000236                                                ; the video RAM. Scrolling forward one line
000237                                                ; means adding 0x50 to this register.
000238                                                ; Only works, if bit #10 in VGA$STATE is set.
000239                    VGA$OFFS_RW                 .EQU 0xFF35                      ; Offset in bytes that is used, when you read
000240                                                ; or write to the video RAM using VGA$CHAR.
000241                                                ; Works independently from VGA$OFFS_DISPLAY.
000242                                                ; Active, when bit #11 in VGA$STATE is set.
000243                    VGA$HDMI_H_MIN              .EQU 0xFF36                      ; HDMI Data Enable: X: minimum valid column
000244                    VGA$HDMI_H_MAX              .EQU 0xFF37                      ; HDMI Data Enable: X: maximum valid column
000245                    VGA$HDMI_V_MAX              .EQU 0xFF38                      ; HDMI Data Enable: Y: maximum row (line)
000246                    ;
000247                    ;---------------------------------------------------------------------------------------
000248                    ; Block FFF0: MEGA65 (double block, 16 registers)
000249                    ;---------------------------------------------------------------------------------------
000250                    ;
000251                    ; HyperRAM
000252                    ;
000253                    IO$M65HRAM_LO               .EQU 0xFFF0                      ; Low word of address (15 downto 0)
000254                    IO$M65HRAM_HI               .EQU 0xFFF1                      ; High word of address (26 downto 16)
000255                    IO$M65HRAM_DATA8            .EQU 0xFFF2                      ; HyperRAM native 8-bit data in/out
000256                    IO$M65HRAM_DATA16           .EQU 0xFFF3                      ; HyperRAM 16-bit data in/out
000257                    
000258                    ;
000259                    ;***************************************************************************************
000260                    ;* Constant definitions
000261                    ;***************************************************************************************
000262                    ;
000263                    
000264                    ; ========== VGA ==========
000265                    
000266                    VGA$MAX_X                   .EQU 79                          ; Max. X-coordinate in decimal!
000267                    VGA$MAX_Y                   .EQU 39                          ; Max. Y-coordinate in decimal!
000268                    VGA$MAX_CHARS               .EQU 3200                        ; 80 * 40 chars
000269                    VGA$CHARS_PER_LINE          .EQU 80
000270                    
000271                    VGA$EN_HW_CURSOR            .EQU 0x0040                      ; Show hardware cursor
000272                    VGA$EN_HW_SCRL              .EQU 0x0C00                      ; Hardware scrolling enable
000273                    VGA$CLR_SCRN                .EQU 0x0100                      ; Clear screen
000274                    VGA$BUSY                    .EQU 0x0200                      ; VGA is currently performing a task
000275                    
000276                    VGA$COLOR_RED               .EQU 0x0004
000277                    VGA$COLOR_GREEN             .EQU 0x0002
000278                    VGA$COLOR_BLUE              .EQU 0x0001
000279                    VGA$COLOR_WHITE             .EQU 0x0007
000280                    
000281                    ; ========== CYCLE COUNTER ==========
000282                    
000283                    CYC$RESET                   .EQU 0x0001                      ; Reset cycle counter
000284                    CYC$RUN                     .EQU 0x0002                      ; Start/stop counter
000285                    
000286                    ; ========== CYCLE COUNTER ==========
000287                    
000288                    INS$RESET                   .EQU 0x0001                      ; Reset instruction counter
000289                    INS$RUN                     .EQU 0x0002                      ; Start/stop counter
000290                    
000291                    ; ========== EAE ==========
000292                    
000293                    EAE$MULU                    .EQU 0x0000                      ; Unsigned 16 bit multiplication
000294                    EAE$MULS                    .EQU 0x0001                      ; Signed 16 bit multiplication
000295                    EAE$DIVU                    .EQU 0x0002                      ; Unsigned 16 bit division with remainder
000296                    EAE$DIVS                    .EQU 0x0003                      ; Signed 16 bit division with remainder
000297                    EAE$BUSY                    .EQU 0x8000                      ; Busy flag (1 = operation still running)
000298                    
000299                    ; ========== SD CARD ==========
000300                    
000301                    SD$CMD_RESET                .EQU 0x0000                      ; Reset SD card
000302                    SD$CMD_READ                 .EQU 0x0001                      ; Read 512 bytes from SD to internal buffer
000303                    SD$CMD_WRITE                .EQU 0x0002                      ; Write 512 bytes from int. buf. to SD
000304                    SD$BIT_ERROR                .EQU 0x4000                      ; Error flag: 1, if last operation failed
000305                    SD$BIT_BUSY                 .EQU 0x8000                      ; Busy flag: 1, if current op. is still running
000306                    SD$TIMEOUT_MID              .EQU 0x0479                      ; equals ~75.000.000 cycles, i.e. 1.5sec @ 50 MHz
000307                    
000308                    SD$ERR_MASK                 .EQU 0x00FF                      ; AND mask for errors: HI byte = state machine info, so mask it for error checks
000309                    SD$ERR_R1_ERROR             .EQU 0x0001                      ; SD Card R1 error (R1 bit 6-0)
000310                    SD$ERR_CRC_OR_TIMEOUT       .EQU 0x0002                      ; Read CRC error or Write Timeout error
000311                    SD$ERR_RESPONSE_TOKEN       .EQU 0x0003                      ; Data Response Token error (Token bit 3)
000312                    SD$ERR_ERROR_TOKEN          .EQU 0x0004                      ; Data Error Token error (Token bit 3-0)
000313                    SD$ERR_WRITE_PROTECT        .EQU 0x0005                      ; SD Card Write Protect switch
000314                    SD$ERR_CARD_UNUSABLE        .EQU 0x0006                      ; Unusable SD card
000315                    SD$ERR_NO_CARD              .EQU 0x0007                      ; No SD card (no response from CMD0)
000316                    SD$ERR_READ_TIMEOUT         .EQU 0x0008 ; Timeout while trying to receive the read start token "FE"
000317                    SD$ERR_READWRITEJAM         .EQU 0xEE21                      ; Trying to write while pending read or trying to read while pending write
000318                    SD$ERR_TIMEOUT              .EQU 0xEEFF                      ; General timeout
000319                    
000320                    SD$CT_SD_V1                 .EQU 0x0001                      ; Card type: SD Version 1
000321                    SD$CT_SD_V2                 .EQU 0x0002                      ; Card type: SD Version 2
000322                    SD$CT_SDHC                  .EQU 0x0003                      ; Card type: SDHC (or SDXC)
000323                    
000324                    ; ========== FAT32 =============
000325                    
000326                    ; FAT32 ERROR CODES
000327                    
000328                    FAT32$ERR_MBR               .EQU 0xEE10                      ; no or illegal Master Boot Record (MBR) found
000329                    FAT32$ERR_PARTITION_NO      .EQU 0xEE11                      ; the partition number needs to be in the range 1 .. 4
000330                    FAT32$ERR_PARTTBL           .EQU 0xEE12                      ; no or illegal partition table entry found (e.g. no FAT32 partition)
000331                    FAT32$ERR_NOTIMPL           .EQU 0xEE13                      ; functionality is not implemented
000332                    FAT32$ERR_SIZE              .EQU 0xEE14                      ; partition size or volume size too large (see doc/constraints.txt)
000333                    FAT32$ERR_NOFAT32           .EQU 0xEE15                      ; illegal volume id (either not 512 bytes per sector, or not 2 FATs or wrong magic)
000334                    FAT32$ERR_ILLEGAL_SIC       .EQU 0xEE16                      ; trying to read/write a sector within a cluster that is out of range
000335                    FAT32$ERR_ILLEGAL_CLUS      .EQU 0xEE17                      ; trying to access an illegal cluster number
000336                    FAT32$ERR_CORRUPT_DH        .EQU 0xEE18                      ; corrupt directory handle (e.g. because current to-be-read offs > sector size)
000337                    FAT32$ERR_DIRNOTFOUND       .EQU 0xEE19                      ; directory not found (illegal path name passed to change directory command)
000338                    FAT32$ERR_FILENOTFOUND      .EQU 0xEE20                      ; file not found
000339                    FAT23$ERR_SEEKTOOLARGE      .EQU 0xEE21                      ; seek position > file size
000340                    
000341                    ; FAT32 STATUS CODES
000342                    
000343                    FAT32$EOF                   .EQU 0xEEEE                      ; end of file reached
000344                    
000345                    ; LAYOUT OF THE MOUNT DATA STRUCTURE (DEVICE HANDLE)
000346                    
000347                    FAT32$DEV_RESET             .EQU 0x0000                      ; pointer to device reset function
000348                    FAT32$DEV_BLOCK_READ        .EQU 0x0001                      ; pointer to 512-byte block read function
000349                    FAT32$DEV_BLOCK_WRITE       .EQU 0x0002                      ; pointer to 512-byte block write function
000350                    FAT32$DEV_BYTE_READ         .EQU 0x0003                      ; pointer to 1-byte read function (within block buffer)
000351                    FAT32$DEV_BYTE_WRITE        .EQU 0x0004                      ; pointer to 1-byte write function (within block buffer)
000352                    FAT32$DEV_PARTITION         .EQU 0x0005                      ; number of partition to be mounted
000353                    FAT32$DEV_FS_LO             .EQU 0x0006                      ; file system start address (LBA): low word
000354                    FAT32$DEV_FS_HI             .EQU 0x0007                      ; file system start address (LBA): high word
000355                    FAT32$DEV_FAT_LO            .EQU 0x0008                      ; fat start address (LBA): low word
000356                    FAT32$DEV_FAT_HI            .EQU 0x0009                      ; fat start address (LBA): high word
000357                    FAT32$DEV_CLUSTER_LO        .EQU 0x000A                      ; cluster start address (LBA): low word
000358                    FAT32$DEV_CLUSTER_HI        .EQU 0x000B                      ; cluster start address (LBA): high word
000359                    FAT32$DEV_SECT_PER_CLUS     .EQU 0x000C                      ; sectors per cluster
000360                    FAT32$DEV_RD_1STCLUS_LO     .EQU 0x000D                      ; root directory first cluster: low word
000361                    FAT32$DEV_RD_1STCLUS_HI     .EQU 0x000E                      ; root directory first cluster: high word
000362                    FAT32$DEV_AD_1STCLUS_LO     .EQU 0x000F                      ; currently active directory first cluster: low word
000363                    FAT32$DEV_AD_1STCLUS_HI     .EQU 0x0010                      ; currently active directory first cluster: high word
000364                    FAT32$DEV_BUFFERED_FDH      .EQU 0x0011                      ; FDH which is responsible for the current 512 byte hardware buffer filling
000365                    
000366                    FAT32$DEV_STRUCT_SIZE       .EQU 0x0012                      ; size (words) of the mount data structure (device handle)
000367                    
000368                    ; LAYOUT OF THE FILE HANDLE AND DIRECTORY HANDLE (FDH)
000369                    
000370                    FAT32$FDH_DEVICE            .EQU 0x0000                      ; pointer to the device handle
000371                    FAT32$FDH_CLUSTER_LO        .EQU 0x0001                      ; current cluster (low word)
000372                    FAT32$FDH_CLUSTER_HI        .EQU 0x0002                      ; current cluster (high word)
000373                    FAT32$FDH_SECTOR            .EQU 0x0003                      ; current sector
000374                    FAT32$FDH_INDEX             .EQU 0x0004                      ; current byte index within current sector
000375                    FAT32$FDH_SIZE_LO           .EQU 0x0005                      ; only if FDH is a file: low word of file size, otherwise undefined
000376                    FAT32$FDH_SIZE_HI           .EQU 0x0006                      ; only if FDH is a file: high word of file size, otherwise undefined
000377                    FAT32$FDH_ACCESS_LO         .EQU 0x0007                      ; only if FDH is a file: low word of already read/written amount of bytes
000378                    FAT32$FDH_ACCESS_HI         .EQU 0x0008                      ; only if FDH is a file: high word of already read/written amount of bytes
000379                    FAT32$FDH_START_CLUS_LO     .EQU 0x0009                      ; only if FDH is a file: start of file: cluster (low word)
000380                    FAT32$FDH_START_CLUS_HI     .EQU 0x000A                      ; only if FDH is a file: start of file: cluster (high word)
000381                    FAT32$FDH_FLAGS             .EQU 0x000B                      ; status flags
000382                    
000383                    FAT32$FDH_STRUCT_SIZE       .EQU 0x000C                      ; size of the directory handle structure
000384                    
000385                    ; Flags used by FAT32$FDH_FLAGS
000386                    
000387                    FAT32$FDHF_DIRTY            .EQU 0x0001                      ; bit 0: sector buffer is dirty due to a write access
000388                    
000389                    ; FILE ATTRIBUTES
000390                    
000391                    FAT32$FA_READ_ONLY          .EQU 0x0001                      ; read only file
000392                    FAT32$FA_HIDDEN             .EQU 0x0002                      ; hidden file
000393                    FAT32$FA_SYSTEM             .EQU 0x0004                      ; system file
000394                    FAT32$FA_VOLUME_ID          .EQU 0x0008                      ; volume id (name of the volume)
000395                    FAT32$FA_DIR                .EQU 0x0010                      ; directory
000396                    FAT32$FA_ARCHIVE            .EQU 0x0020                      ; archive flag
000397                    
000398                    FAT32$FA_DEFAULT            .EQU 0x0035                      ; browse for non hidden files and directories but not for the volume id
000399                    FAT32$FA_ALL                .EQU 0x0037                      ; browse for all files, but not for the volume id
000400                    
000401                    ; LAYOUT OF THE DIRECTORY ENTRY STRUCTURE
000402                    
000403                    FAT32$DE_NAME               .EQU 0x0000                      ; volume, file or directory name, zero terminated (max 256 characters)
000404                    FAT32$DE_ATTRIB             .EQU 0x0101                      ; file attributes (read-only, hidden, system, volume id, directory, archive)
000405                    FAT32$DE_SIZE_LO            .EQU 0x0102                      ; file size: low word
000406                    FAT32$DE_SIZE_HI            .EQU 0x0103                      ; file size: high word
000407                    FAT32$DE_YEAR               .EQU 0x0104                      ; last file write: year (valid range 1980 .. 2107)
000408                    FAT32$DE_MONTH              .EQU 0x0105                      ; last file write: month
000409                    FAT32$DE_DAY                .EQU 0x0106                      ; last file write: day
000410                    FAT32$DE_HOUR               .EQU 0x0107                      ; last file write: hour
000411                    FAT32$DE_MINUTE             .EQU 0x0108                      ; last file write: minute
000412                    FAT32$DE_SECOND             .EQU 0x0109                      ; last file write: second (in 2 second steps, valid range 0 .. 58)
000413                    FAT32$DE_CLUS_LO            .EQU 0x010A                      ; start cluster: low word
000414                    FAT32$DE_CLUS_HI            .EQU 0x010B                      ; start cluster: high word
000415                    
000416                    FAT32$DE_STRUCT_SIZE        .EQU 0x010C                      ; size (words) of the directory entry data structure of the
000417                    
000418                    ; DISPLAY FLAGS FOR FILE ENTRY PRETTY PRINTER
000419                    
000420                    FAT32$PRINT_SHOW_DIR        .EQU 0x0001 ; show "<DIR>" indicator
000421                    FAT32$PRINT_SHOW_ATTRIB     .EQU 0x0002 ; show attributes as "HRSA"
000422                    FAT32$PRINT_SHOW_SIZE       .EQU 0x0004                      ; show file size
000423                    FAT32$PRINT_SHOW_DATE       .EQU 0x0008                      ; show file date as YYYY-MM-DD
000424                    FAT32$PRINT_SHOW_TIME       .EQU 0x0010                      ; show file time as HH:MM
000425                    
000426                    FAT32$PRINT_DEFAULT         .EQU 0x001D                      ; print <DIR> indicator, size, date and time (no attributes)
000427                    FAT32$PRINT_ALL             .EQU 0x001F                      ; print all details

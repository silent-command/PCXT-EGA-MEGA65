002507  8677  FFA4  000B                              RBRA _SDB_G32Y, N                ; A_hi > B_hi
002508  8679  FFAB  0005                              RBRA _SDB_G32N, !Z               ; A_hi < B_hi
002509  867B  C865                                    CMP @R8, @R9                     ; low words
002510  867C  FFA4  0006                              RBRA _SDB_G32Y, N
002511  867E  FFA3  0004                              RBRA _SDB_G32Y, Z
002512  8680  9FB8  FFFB  _SDB_G32N                   AND 0xFFFB, R14                  ; clear Carry
002513  8682  FFA0  0002                              RBRA _SDB_G32R, 1
002514  8684  AFB8  0004  _SDB_G32Y                   OR 0x0004, R14                   ; set Carry
002515  8686  E100        _SDB_G32R                   DECRB
002516  8687  0DBC                                    MOVE @R13++, R15

001588                    
001589                    ; ---- write a block through the fast path from BUF_A. The virtual drive
001590                    ; buffer is not emulated, so the bytes are staged in the SD controller
001591                    ; buffer and SDB_VD_WRBLK is told to write exactly that block: this
001592                    ; exercises the mapping, the flush/invalidate and the SD write, but not
001593                    ; the vdrives.vhd register protocol (only hardware can show that).
001594                    ; R9/R10: block index lo/hi; Carry=1 on success
001595  8345  E0C0        WRBLK                       INCRB
001596  8346  0900                                    MOVE R9, R0
001597  8347  0A04                                    MOVE R10, R1
001598  8348  FFB0  027D                              RSUB SDB_BLK2B, 1
001599  834A  0908                                    MOVE R9, R2                      ; R2/R3: byte position
001600  834B  0A0C                                    MOVE R10, R3
001601                    
001602  834C  0FA0  8D65                              MOVE SDB_VD_MAPS, R8             ; LBA of that block
001603  834E  0024                                    MOVE R0, R9
001604  834F  0128                                    MOVE R1, R10
001605  8350  FFB0  02DB                              RSUB SDB_LBA, 1
001606  8352  FFAA  0024                              RBRA _WRB_NO, !C
001607  8354  0910                                    MOVE R9, R4                      ; R4/R5: LBA
001608  8355  0A14                                    MOVE R10, R5
001609                    
001610  8356  FFB0  01DD                              RSUB SDB_GUARD_IN, 1             ; same order as SDB_VD_WRBLK
001611  8358  FFAA  001E                              RBRA _WRB_NO, !C
001612  835A  0F98  FF22                              MOVE IO$SD_DATA_POS, R6
001613  835C  0F9C  FF23                              MOVE IO$SD_DATA, R7
001614  835E  0FA0  B000                              MOVE BUF_A, R8
001615  8360  B924                                    XOR R9, R9
001616  8361  0919        _WRB_L                      MOVE R9, @R6
001617  8362  089D                                    MOVE @R8++, @R7
001618  8363  1FA4  0001                              ADD 1, R9
001619  8365  CFA4  0200                              CMP 0x0200, R9
001620  8367  FFAB  FFF8                              RBRA _WRB_L, !Z
001621  8369  0420                                    MOVE R4, R8
001622  836A  0524                                    MOVE R5, R9
001623  836B  FF90  003E                              ASUB sd_w_block, 1
001624  836D  080C                                    MOVE R8, R3                      ; remember the error code
001625  836E  FFB0  020E                              RSUB SDB_GUARD_OUT, 1            ; hand the buffer back
001626  8370  CF8C  0000                              CMP 0, R3
001627  8372  FFAB  0004                              RBRA _WRB_NO, !Z
001628  8374  AFB8  0004                              OR 0x0004, R14

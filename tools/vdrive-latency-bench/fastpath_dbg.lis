001406  824D  0A2C                                    MOVE R10, R11
001407  824E  0928                                    MOVE R9, R10
001408  824F  B820                                    XOR R8, R8                       ; virtual drive 0
001409  8250  0FA4  89E3                              MOVE HANDLE_FILE, R9
001410  8252  0FB0  0200                              MOVE 0x0200, R12
001411  8254  FFB0  0643                              RSUB SDB_VD_RDBLK, 1
001412  8256  FFAA  0015                              RBRA _T8_NOMAP, !C
001413  8258  B820                                    XOR R8, R8
001414  8259  FFB0  05D4                              RSUB SDB_SD2VD, 1
001415  825B  FFB0  0670                              RSUB SDB_VD_RDDONE, 1
001416                    
001417                                                ; the library must still deliver block B, not block A
001418  825D  0FA0  89E3                              MOVE HANDLE_FILE, R8
001419  825F  0FA4  B200                              MOVE BUF_B, R9
001420  8261  FFB0  0119                              RSUB FREAD512, 1
001421  8263  0FA0  B000                              MOVE BUF_A, R8
001422  8265  0FA4  B200                              MOVE BUF_B, R9
001423  8267  FFB0  0128                              RSUB CMP512, 1

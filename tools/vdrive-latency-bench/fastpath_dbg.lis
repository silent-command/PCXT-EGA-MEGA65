002470  864C  C218                                    CMP R2, R6                       ; remainder < extent size?
002471  864D  FFA4  0014                              RBRA _SDBL_NEXT, N               ; rem_hi > ext_hi: no
002472  864F  FFAB  0005                              RBRA _SDBL_HIT, !Z               ; rem_hi < ext_hi: yes
002473  8651  C114                                    CMP R1, R5

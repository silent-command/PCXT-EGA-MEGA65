001386  8233  0FA0  B200                              MOVE BUF_B, R8
001387  8235  0FA4  B000                              MOVE BUF_A, R9
001388  8237  FFB0  0199                              RSUB COPY512, 1
001389                    
001390                                                ; put the library on block B, so that it owns the buffer and
001391                                                ; believes it holds B's sector
001392  8239  0FA0  89E3                              MOVE HANDLE_FILE, R8
001393  823B  0FA4  8D3E                              MOVE T8_BLKB, R9
001394  823D  0964                                    MOVE @R9, R9
001395  823E  BA28                                    XOR R10, R10
001396  823F  FFB0  0386                              RSUB SDB_BLK2B, 1
001397  8241  FF90  0054                              ASUB f32_fseek, 1
001398  8243  CFA4  0000                              CMP 0, R9
001399  8245  FFAB  002E                              RBRA _T8_BAD, !Z
001400                    
001401                                                ; now let the fast path overwrite the buffer with block A

000579                    ; ****************************************************************************
000580                    ; MiSTer2MEGA65 (M2M) QNICE ROM
000581                    ;
000582                    ; System definition file for registers and MMIO
000583                    ;
000584                    ; done by sy2002 in 2022 and licensed under GPL v3
000585                    ; ****************************************************************************
000586                    
000587                    ; ----------------------------------------------------------------------------
000588                    ; Control and status register
000589                    ; ----------------------------------------------------------------------------
000590                    
000591                    M2M$CSR                     .EQU 0xFFE0
000592                                                ; Bit 0: Reset the MiSTer core
000593                                                ; Bit 1: Pause the MiSTer core
000594                                                ; Bit 2: Show On-Screen-Menu (OSM) as an overlay over core output
000595                                                ; Bit 3: Keyboard connection between M65 keyb. and the core
000596                                                ; Bit 4: Joy. port 1 connection between M65 joy. port and core
000597                                                ; Bit 5: Joy. port 2 connection between M65 joy. port and core
000598                                                ; Bit 6: SD Card: Mode: 0=Auto: SD card automatically switches
000599                                                ; between the internal card (bottom tray) and the external
000600                                                ; card (back slot). The external card has higher precedence.
000601                                                ; Bit 7: SD Card: If Mode=1: 0=force internal / 1=force external
000602                                                ; Bit 8: SD Card: Currently active: 0=internal / 1=external
000603                                                ; Bit 9: SD Card: Internal SD card detected
000604                                                ; Bit 10: SD Card: External SD card detected
000605                                                ; Bit 11: Ascal autoset: If set to 1: M2M$ASCAL_MODE (which is
000606                                                ; controlling QNICE ouput port ascal_mode_o) is automatically
000607                                                ; kept in sync with ascal_mode_i
000608                                                ; Bits 12..15: RESERVED
000609                                                ;
000610                                                ; Bits 8, 9, 10 are read-only
000611                    
000612                    M2M$CSR_RESET               .EQU 0x0001
000613                    M2M$CSR_UN_RESET            .EQU 0xFFFE
000614                    M2M$CSR_PAUSE               .EQU 0x0002
000615                    M2M$CSR_UN_PAUSE            .EQU 0xFFFD
000616                    M2M$CSR_OSM                 .EQU 0x0004
000617                    M2M$CSR_UN_OSM              .EQU 0xFFFB
000618                    M2M$CSR_KBD                 .EQU 0x0008
000619                    M2M$CSR_UN_KBD              .EQU 0xFFF7
000620                    M2M$CSR_JOY1                .EQU 0x0010
000621                    M2M$CSR_UN_JOY1             .EQU 0xFFEF
000622                    M2M$CSR_JOY2                .EQU 0x0020
000623                    M2M$CSR_UN_JOY2             .EQU 0xFFDF
000624                    M2M$CSR_SD_MODE             .EQU 0x0040
000625                    M2M$CSR_UN_SD_MODE          .EQU 0xFFBF
000626                    M2M$CSR_SD_FORCE            .EQU 0x0080
000627                    M2M$CSR_UN_SD_FORCE         .EQU 0xFF7F
000628                    M2M$CSR_SD_ACTIVE           .EQU 0x0100
000629                    M2M$CSR_UN_SD_ACTIVE        .EQU 0xFEFF
000630                    M2M$CSR_SD_DET_INT          .EQU 0x0200
000631                    M2M$CSR_UN_SD_DET_INT       .EQU 0xFDFF
000632                    M2M$CSR_SD_DET_EXT          .EQU 0x0400
000633                    M2M$CSR_UN_SD_DET_EXT       .EQU 0xFBFF
000634                    M2M$CSR_ASCAL_AUTO          .EQU 0x0800
000635                    M2M$CSR_UN_ASCAL_AUTO       .EQU 0xF7FF
000636                    
000637                    M2M$CSR_KBD_JOY             .EQU 0x0038
000638                    M2M$CSR_UN_KBD_JOY          .EQU 0xFFC7
000639                    
000640                    ; ----------------------------------------------------------------------------
000641                    ; VGA and On-Screen-Menu (OSM)
000642                    ; ----------------------------------------------------------------------------
000643                    
000644                    ; All coordinates and sizes in the OSM context are specified in characters
000645                    ; The high-byte of the 16-bit value is always x or dx and the low-byte y or dy
000646                    
000647                    ; When bit 2 of the CSR = 1, then the OSM is shown at the coordinates
000648                    ; and in the size given by these two registers, i.e. these registers are used
000649                    ; by the display hardware
000650                    M2M$OSM_XY                  .EQU 0xFFE1                      ; x|y coordinates
000651                    M2M$OSM_DXDY                .EQU 0xFFE2                      ; dx|dy width and height
000652                    
000653                    ; Screen attributes: Single bits
000654                    M2M$SA_INVERSE              .EQU 0x80
000655                    M2M$SA_DARK                 .EQU 0x40
000656                    M2M$SA_BG_RED               .EQU 0x20
000657                    M2M$SA_BG_GREEN             .EQU 0x10
000658                    M2M$SA_BG_BLUE              .EQU 0x08
000659                    M2M$SA_FG_RED               .EQU 0x04
000660                    M2M$SA_FG_GREEN             .EQU 0x02
000661                    M2M$SA_FG_BLUE              .EQU 0x01
000662                    
000663                    ; Screen attributes: Common bit-combinations
000664                    M2M$SA_COL_STD              .EQU 0x0B                        ; cyan font on blue background
000665                    M2M$SA_COL_STD_INV          .EQU 0x8B                        ; inverse standard
000666                    M2M$SA_COL_TTLE             .EQU 0x0E                        ; Title: Yellow on blue background
000667                    M2M$SA_COL_TTLE_INV         .EQU 0x8E                        ; inverse Title
000668                    M2M$SA_COL_SEL              .EQU 0x0F                        ; selection: white font on blue background
000669                    
000670                    ; Special characters in font Anikki-16x16
000671                    M2M$FC_TL                   .EQU 201                         ; fat top/left corner
000672                    M2M$FC_SH                   .EQU 205                         ; fat straight horizontal
000673                    M2M$FC_TR                   .EQU 187                         ; fat top/right corner
000674                    M2M$FC_SV                   .EQU 186                         ; fat straight vertical
000675                    M2M$FC_BL                   .EQU 200                         ; fat bottom/left corner
000676                    M2M$FC_BR                   .EQU 188                         ; fat bottom/right corner
000677                    M2M$FC_HE_LEFT              .EQU 185                         ; fat straight horiz. line ends: left part
000678                    M2M$FC_HE_RIGHT             .EQU 204                         ; fat straight horiz. line ends: right part
000679                    M2M$NC_SH                   .EQU 196                         ; normal straight horizontal
000680                    M2M$NC_VE_LEFT              .EQU 199                         ; normal vertical line end: left part
000681                    M2M$NC_VE_RIGHT             .EQU 182                         ; normal vertical line end: right part
000682                    M2M$DIR_L                   .EQU 17                          ; left char for displaying a directory
000683                    M2M$DIR_R                   .EQU 16                          ; right char for displaying a directory
000684                    M2M$OPT_SEL_MULTI           .EQU 7                           ; selection char for options menu: multi-sel.
000685                    M2M$OPT_SEL_SINGLE          .EQU 61                          ; ditto for single select
000686                    M2M$LD_PROGRESS             .EQU 254                         ; character used for progress bar
000687                    M2M$LD_SPACE                .EQU 32                          ; space character
000688                    
000689                    ; ----------------------------------------------------------------------------
000690                    ; HDMI: Avalon Scaler (ascal.vhd)
000691                    ; ----------------------------------------------------------------------------
000692                    
000693                    M2M$ASCAL_MODE              .EQU 0xFFE3                      ; ascal mode register
000694                                                ; this reg. is read-only if CSR bit 11 = 1
000695                    
000696                    ; ascal mode: bits 2 downto 0
000697                    M2M$ASCAL_NEAREST           .EQU 0x0000                      ; Nearest neighbor
000698                    M2M$ASCAL_BILINEAR          .EQU 0x0001                      ; Bilinear
000699                    M2M$ASCAL_SBILINEAR         .EQU 0x0002                      ; Sharp Bilinear
000700                    M2M$ASCAL_BICUBIC           .EQU 0x0003                      ; Bicubic
000701                    M2M$ASCAL_POLYPHASE         .EQU 0x0004                      ; Polyphase filter (used for CRT emulation)
000702                    
000703                    ; ascal Polyphase addresses
000704                    M2M$ASCAL_PP_HORIZ          .EQU 0x0000
000705                    M2M$ASCAL_PP_VERT           .EQU 0x0100
000706                    
000707                    ; ascal mode: bits 3 and 4
000708                    M2M$ASCAL_TRIPLEBUF         .EQU 0x0008                      ; Activate triple-buffering
000709                    M2M$ASCAL_RESERVED          .EQU 0x0010                      ; reserved (see ascal.vhd)
000710                    
000711                    ; ----------------------------------------------------------------------------
000712                    ; Special-purpose and general-purpose 16-bit input flags
000713                    ; Read-only; direct pass through from SOC inputs, not buffered in a register.
000714                    ; (Currently reserved and not used, yet)
000715                    ; ----------------------------------------------------------------------------
000716                    
000717                    ; special-purpose register that gets its semantics via the Shell firmware
000718                    M2M$SPECIAL                 .EQU 0xFFE4
000719                    
000720                    ; general-purpose register, can be freely used and is not used by the Shell
000721                    M2M$GENERAL                 .EQU 0xFFE5
000722                    
000723                    ; ----------------------------------------------------------------------------
000724                    ; Keyboard for the framework (independent from the keyboard of the core)
000725                    ; ----------------------------------------------------------------------------
000726                    
000727                    ; Low active realtime snapshot of the currently pressed keys (read-only)
000728                    ; (MMIO "qnice_keys_o" register of m2m_keys.vhd)
000729                    M2M$KEYBOARD                .EQU 0xFFE8
000730                    
000731                    ; Typematic delay (DLY) and typematic repeat (SPD)
000732                    ; DLY: How long needs the key to be pressed, until the typematic repeat starts
000733                    ; SPD: How fast will the pressed key be repeated
000734                    ; IMPORTANT: These values are empiric and relative to QNICE V1.61
000735                    M2M$TYPEMATIC_DLY           .EQU 0x8000                      ; ~0.5sec in QNICE V1.61
000736                    M2M$TYPEMATIC_SPD           .EQU 0x1000                      ; ~12 per sec
000737                    
000738                    ; Definition of the bits in M2M$KEYBOARD
000739                    M2M$KEY_UP                  .EQU 0x0001
000740                    M2M$KEY_DOWN                .EQU 0x0002
000741                    M2M$KEY_LEFT                .EQU 0x0004
000742                    M2M$KEY_RIGHT               .EQU 0x0008
000743                    M2M$KEY_RETURN              .EQU 0x0010
000744                    M2M$KEY_SPACE               .EQU 0x0020
000745                    M2M$KEY_RUNSTOP             .EQU 0x0040
000746                    M2M$KEY_HELP                .EQU 0x0080
000747                    M2M$KEY_F1                  .EQU 0x0100
000748                    M2M$KEY_F3                  .EQU 0x0200
000749                    
000750                    ; ----------------------------------------------------------------------------
000751                    ; 256-bit General purpose control flags
000752                    ; ----------------------------------------------------------------------------
000753                    
000754                    ; 256-bit directly controled by the programmer (not used by the Shell)
000755                    ; Select a window between 0 and 15 in M2M$CFD_ADDR and access the control
000756                    ; flags sliced into 16-bit chunks via M2M$CFD_DATA
000757                    ; exposed by QNICE via control_d_o
000758                    M2M$CFD_ADDR                .EQU 0xFFF0
000759                    M2M$CFD_DATA                .EQU 0xFFF1
000760                    
000761                    ; 256-bit controled by the Shell via the options menu, i.e. the menu that
000762                    ; opens when the core is running and the user presses "Help" on the keyboard:
000763                    ; the bit order is: bit 0 = topmost menu entry, the mapping is 1-to-1 to
000764                    ; OPTM_ITEMS / OPTM_GROUPS in config.vhd
000765                    ; exposed by QNICE via control_m_o; M2M$CFM_ADDR runs from 0 to 15
000766                    M2M$CFM_ADDR                .EQU 0xFFF2
000767                    M2M$CFM_DATA                .EQU 0xFFF3
000768                    
000769                    ; ----------------------------------------------------------------------------
000770                    ; MMIO 4k-segmented access to RAMs, ROMs and similarily behaving devices
000771                    ; ----------------------------------------------------------------------------
000772                    
000773                    M2M$RAMROM_DEV              .EQU 0xFFF4
000774                                                ; Devices 0x0000 .. 0x00FF: RESERVED (see below)
000775                                                ; Devices 0x0100 .. 0xFFFF: Free to be used for any RAM, ROM or device
000776                                                ; that behaves like a RAM or ROM from the
000777                                                ; perspective of QNICE
000778                    
000779                    M2M$VRAM_DATA               .EQU 0x0000                      ; Device for VRAM: Data
000780                    M2M$VRAM_ATTR               .EQU 0x0001                      ; Device for VRAM: Attributes
000781                    M2M$CONFIG                  .EQU 0x0002                      ; Static Shell config data (config.vhd)
000782                    M2M$ASCAL_PPHASE            .EQU 0x0003                      ; ascal.vhd Polyphase filter RAM
000783                    M2M$HYPERRAM                .EQU 0x0004                      ; Device for the built-in 8MB of HyperRAM
000784                    M2M$SDRAM                   .EQU 0x0005                      ; @TODO/RESERVED for future R4 boards
000785                    
000786                    M2M$SYS_INFO                .EQU 0x00FF                      ; Device for System Info
000787                    
000788                    M2M$RAMROM_4KWIN            .EQU 0xFFF5                      ; 4k window selector
000789                    M2M$RAMROM_DATA             .EQU 0x7000                      ; 4k MMIO window to read/write
000790                    
000791                    ; ----------------------------------------------------------------------------
000792                    ; Sysinfo device: Selectors and addresses
000793                    ; ----------------------------------------------------------------------------
000794                    
000795                    ; Selectors (4k windows)
000796                    M2M$SYS_VDRIVES             .EQU 0x0000                      ; vdrives constants (globals.vhd)
000797                    M2M$SYS_VGA                 .EQU 0x0010                      ; gfx adaptor 0: VGA
000798                    M2M$SYS_HDMI                .EQU 0x0011                      ; gfx adaptor 1: HDMI
000799                    M2M$SYS_CRTSANDROMS         .EQU 0x0020                      ; sim. CRTs. & ROMs (globals.vhd)
000800                    M2M$SYS_CORE                .EQU 0x0030                      ; info about the MiSTer core
000801                    
000802                    ; The following read-only registers are meant to be used by the QNICE
000803                    ; firmware. They enable the ability to specify the hardware screen resolution
000804                    ; in characters as well as the start coordinates and size of the main screen.
000805                    ; The position and size of the option menu is deducted.
000806                    M2M$SYS_DXDY                .EQU 0x7000
000807                    M2M$SHELL_M_XY              .EQU 0x7001                      ; main screen: x|y start coordinates
000808                    M2M$SHELL_M_DXDY            .EQU 0x7002                      ; main screen: dx|dy width and height
000809                    
000810                    ; M2M$SYS_CORE registers: measurement from ASCAL
000811                    M2M$SYS_CORE_X              .EQU 0x7000                      ; visible dx measurement from ASCAL
000812                    M2M$SYS_CORE_Y              .EQU 0x7001                      ; visible dy measurement from ASCAL
000813                    
000814                    ; M2M$SYS_CORE registers: measurement from M2M component
000815                    M2M$SYS_CORE_H_PXLS         .EQU 0x7002                      ; visible dx
000816                    M2M$SYS_CORE_V_PXLS         .EQU 0x7003                      ; visible dy
000817                    M2M$SYS_CORE_H_PLSE         .EQU 0x7004                      ; horizontal pulse
000818                    M2M$SYS_CORE_H_BP           .EQU 0x7005                      ; horizontal back porch
000819                    M2M$SYS_CORE_H_FP           .EQU 0x7006                      ; horizontal front porch
000820                    M2M$SYS_CORE_V_PLSE         .EQU 0x7007                      ; vertical pulse
000821                    M2M$SYS_CORE_V_BP           .EQU 0x7008                      ; vertical back porch
000822                    M2M$SYS_CORE_V_FP           .EQU 0x7009                      ; vertical front porch
000823                    M2M$SYS_CORE_H_FREQ         .EQU 0x700A                      ; horizontal frequency in Hz
000824                    
000825                    ; ----------------------------------------------------------------------------
000826                    ; Static Shell configuration data (config.vhd): Selectors and addresses
000827                    ; ----------------------------------------------------------------------------
000828                    
000829                    ; Selectors (4k windows)
000830                    
000831                    M2M$CFG_WHS                 .EQU 0x1000                      ; Welcome & Help screens
000832                    M2M$CFG_DIR_START           .EQU 0x0100                      ; Start folder for file browser
000833                    M2M$CFG_CFG_FILE            .EQU 0x0101                      ; Config file for OSM persistence
000834                    M2M$CFG_GENERAL             .EQU 0x0110                      ; General configuration settings
000835                    M2M$CFG_CORENAME            .EQU 0x0200                      ; String: name and version of core
000836                    
000837                    M2M$CFG_OPTM_ITEMS          .EQU 0x0300 ; "Help" menu / Options menu items
000838                    M2M$CFG_OPTM_GROUPS         .EQU 0x0301                      ; Menu groups
000839                    M2M$CFG_OPTM_STDSEL         .EQU 0x0302                      ; Menu items that are selected by default
000840                    M2M$CFG_OPTM_LINES          .EQU 0x0303                      ; Separator lines
000841                    M2M$CFG_OPTM_START          .EQU 0x0304                      ; Position of very first cursor pos
000842                    M2M$CFG_OPTM_ICOUNT         .EQU 0x0305                      ; Amount of menu items
000843                    M2M$CFG_OPTM_MOUNT          .EQU 0x0306                      ; Menu item = mount a drive
000844                    M2M$CFG_OPTM_SINGLE         .EQU 0x0307                      ; Single-select menu item
000845                    M2M$CFG_OPTM_MSTR           .EQU 0x0308                      ; Mount string to display instead of %s
000846                    M2M$CFG_OPTM_DIM            .EQU 0x0309                      ; DX and DY of Options/Help menu
000847                    M2M$CFG_OPTM_SSTR           .EQU 0x030A                      ; Saving string to display instead of %s
000848                    M2M$CFG_OPTM_HELP           .EQU 0x0310                      ; Menu item = show a help menu
000849                    M2M$CFG_OPTM_CRTROM         .EQU 0x0311                      ; Menu item = manually load CRT/ROM
000850                    M2M$CFG_OPTM_CRSTR          .EQU 0x0312                      ; CRT/ROM load str. to show instead of %s
000851                    
000852                    ; M2M$CFG_WHS
000853                    
000854                    M2M$WHS_PAGES               .EQU 0x7FFF                      ; Amount of pages in current WHS element
000855                    M2M$WHS_WELCOME             .EQU 0x0000                      ; WHS array element: Welcome page
000856                    M2M$WHS_HELP_INDEX          .EQU 0x0001                      ; WHS array: Help pages start with index 1
000857                    M2M$WHS_HELP_NEXT           .EQU 0x0100                      ; WHS array element: Next help structure
000858                    M2M$WHS_PAGE_NEXT           .EQU 0x0001                      ; WHS array element: Next page / prev page
000859                    
000860                    ; M2M$CFG_OPTM_DIM: Addresses
000861                    
000862                    M2M$SHELL_O_DX              .EQU 0x7000                      ; Width of Help/Options menu
000863                    M2M$SHELL_O_DY              .EQU 0x7001                      ; Height of Help/Options menu
000864                    
000865                    ; M2M$CFG_GENERAL Addresses
000866                    
000867                    M2M$CFG_RP_COUNTER          .EQU 0x7001 ; keep reset for a "QNICE loop while"
000868                    M2M$CFG_RP_PAUSE            .EQU 0x7002                      ; pause core when any OSD opens
000869                    M2M$CFG_RP_WELCOME          .EQU 0x7003                      ; show the welcome screen in general
000870                    M2M$CFG_RP_WLCM_RST         .EQU 0x7004                      ; show welcome screen after reset
000871                    M2M$CFG_RP_KB_RST           .EQU 0x7005                      ; connect the keyboard at reset
000872                    M2M$CFG_RP_J1_RST           .EQU 0x7006                      ; connect the joystick 1 at reset
000873                    M2M$CFG_RP_J2_RST           .EQU 0x7007                      ; connect the joystick 2 at reset
000874                    M2M$CFG_RP_KB_OSD           .EQU 0x7008                      ; connect the keyboard at OSD
000875                    M2M$CFG_RP_J1_OSD           .EQU 0x7009                      ; connect the joystick 1 at OSD
000876                    M2M$CFG_RP_J2_OSD           .EQU 0x700A                      ; connect the joystick 2 at OSD
000877                    
000878                    M2M$CFG_ASCAL_USAGE         .EQU 0x700B                      ; firmware treatment of ascal mode
000879                    M2M$CFG_ASCAL_MODE          .EQU 0x700C                      ; hardcoded ascal mode, if applicable
000880                    
000881                    M2M$CFG_VD_AT_DELAY         .EQU 0x700D                      ; Anti-Thrashing delay (virtual drives)
000882                    M2M$CFG_VD_ITERSIZE         .EQU 0x700E                      ; Bytes that are saving per flushing-iter.
000883                    
000884                    M2M$CFG_SAVEOSDCFG          .EQU 0x700F                      ; Remember on-screen-menu settings
000885                    
000886                    ; M2M$CFG_ASCAL_USAGE modes
000887                    M2M$CFG_AUSE_CFG            .EQU 0x0000                      ; use ASCAL_MODE from config.vhd
000888                    M2M$CFG_AUSE_CUSTOM         .EQU 0x0001                      ; controlled via custom QNICE assembly
000889                    M2M$CFG_AUSE_AUTO           .EQU 0x0002                      ; auto-sync via M2M$CFG_ASCAL_USAGE
000890                    
000891                    ; ----------------------------------------------------------------------------
000892                    ; Virtual Drives Device for MiSTer "SD" interface (vdrives.vhd)
000893                    ; ----------------------------------------------------------------------------
000894                    
000895                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000896                    VD_NUM                      .EQU 0x7000                      ; amount of virtual drives
000897                    VD_DEVICE                   .EQU 0x7001                      ; address of the vdrives.vhd device
000898                    VD_RAM_BUFFERS              .EQU 0x7100                      ; array of RAM buffers to store dsk images
000899                    VD_BUF_SDDIRECT             .EQU 0xAAAA ; "buffer" value: no RAM buffer, the image
000900                                                ; stays on the SD card and blocks are
000901                                                ; transferred on request (see shell.asm)
000902                    
000903                    ; window selectors for vdrives.vhd
000904                    VD_WIN_CAD                  .EQU 0x0000                      ; control and data registers
000905                    VD_WIN_DRV                  .EQU 0x0001                      ; drive 0, next window = drive 1, ...
000906                    
000907                    ; VD_WIN_CAD: control and data registers
000908                    VD_IMG_MOUNT                .EQU 0x7000                      ; image mounted, lowest bit = drive 0
000909                    VD_RO                       .EQU 0x7001                      ; read-only for currently mounted drive
000910                    VD_SIZE_L                   .EQU 0x7002                      ; image file size, low word
000911                    VD_SIZE_H                   .EQU 0x7003                      ; image file size, high word
000912                    VD_TYPE                     .EQU 0x7004                      ; image file type (2-bit value)
000913                    VD_B_ADDR                   .EQU 0x7005                      ; drive buffer: address
000914                    VD_B_DOUT                   .EQU 0x7006                      ; drive buffer: data out (to drive)
000915                    VD_B_WREN                   .EQU 0x7007                      ; drive buffer: write enable (also needs ack)
000916                    VD_VDNUM                    .EQU 0x7008                      ; number of virtual drives
000917                    VD_BLKSZ                    .EQU 0x7009                      ; block size for LBA in bytes
000918                    VD_DRV_MOUNT                .EQU 0x700A                      ; drive mounted, lowest bit = drive 0
000919                    
000920                    ; VD_WIN_DRV (and onwards): virtual drive specific registers
000921                    VD_LBA_L                    .EQU 0x7000                      ; SD LBA low word
000922                    VD_LBA_H                    .EQU 0x7001                      ; SD LBA high word
000923                    VD_BLKCNT                   .EQU 0x7002                      ; SD block count
000924                    VD_BYTES_L                  .EQU 0x7003                      ; SD block address in bytes: low word
000925                    VD_BYTES_H                  .EQU 0x7004                      ; SD block address in bytes: high word
000926                    VD_SIZEB                    .EQU 0x7005                      ; SD block data amount in bytes
000927                    VD_4K_WIN                   .EQU 0x7006                      ; SD block address in 4k win logic: window
000928                    VD_4K_OFFS                  .EQU 0x7007                      ; SD block address in 4k win logic: offset
000929                    VD_RD                       .EQU 0x7008                      ; SD read request
000930                    VD_WR                       .EQU 0x7009                      ; SD write request
000931                    VD_ACK                      .EQU 0x700A                      ; SD acknowledge
000932                    VD_B_DIN                    .EQU 0x700B                      ; drive buffer: data in (from drive)
000933                    VD_CACHE_DIRTY              .EQU 0x700C                      ; cache dirty flag
000934                    VD_CACHE_FLUSHING           .EQU 0x700D                      ; cache flushing flag
000935                    VD_CACHE_FLUSH_ST           .EQU 0x700E                      ; cache flushing can start now
000936                    VD_CACHE_FLUSH_DE           .EQU 0x700F                      ; delay in ms between VD_WR and FLUSH_ST
000937                    
000938                    ; ----------------------------------------------------------------------------
000939                    ; Automatically and manually loadable cartridges and ROMs
000940                    ; ----------------------------------------------------------------------------
000941                    
000942                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000943                    CRTROM_MAN_NUM_A            .EQU 0x7000                      ; amount of manually loadable CRTs/ROMs
000944                    CRTROM_AUT_NUM_A            .EQU 0x7001                      ; amount of automatically loadable ROMs
000945                    CRTROM_MAN_BUFFERS          .EQU 0x7100                      ; array of records: manually loadable
000946                    CRTROM_AUT_BUFFERS          .EQU 0x7200                      ; array of records: automatically loadable
000947                    CRTROM_AUT_FILES            .EQU 0x7300                      ; auto-load filesnames
000948                    
000949                    ; Type of byte streaming device for receiving the CRT/ROM data
000950                    CRTROM_TYPE_DEVICE          .EQU 0x0000                      ; any QNICE compatible device
000951                    CRTROM_TYPE_HYPRAM          .EQU 0x0001                      ; HyperRAM
000952                    CRTROM_TYPE_SDRAM           .EQU 0x0002                      ; @TODO/RESERVED for future R4 boards
000953                    CRTROM_TYPE_MNDTRY          .EQU 0x0003                      ; mandatory ROM
000954                    CTRROM_TYPE_OPTNL           .EQU 0x0004                      ; optional ROM
000955                    
000956                    ; Control and status registers of a CRT/ROM device
000957                    CRTROM_CSR_4KWIN            .EQU 0xFFFF                      ; 4K window in the device addr. space
000958                    
000959                    CRTROM_CSR_STATUS           .EQU 0x7000                      ; QNICE to device: load status (see below)
000960                    CRTROM_CSR_FS_LO            .EQU 0x7001                      ; filesize of CRT/ROM: low word
000961                    CRTROM_CSR_FS_HI            .EQU 0x7002                      ; filesize of CRT/ROM: high word
000962                    CRTROM_CSR_PARSEST          .EQU 0x7010                      ; device to QNICE: parse status
000963                    CRTROM_CSR_PARSEE1          .EQU 0x7011                      ; device to QNICE: error code
000964                    CRTROM_CSR_ADDR_LO          .EQU 0x7012                      ; device to QNICE: load address low word
000965                    CRTROM_CSR_ADDR_HI          .EQU 0x7013                      ; device to QNICE: load address high word
000966                    CRTROM_CSR_ERR_STRT         .EQU 0x7100                      ; device to QNICE: status string
000967                    
000968                    ; QNICE to device: CRT/ROM load status
000969                    CRTROM_CSR_ST_IDLE          .EQU 0x0000                      ; device is initialized, no loading
000970                    CRTROM_CSR_ST_LDNG          .EQU 0x0001                      ; loading takes place
000971                    CRTROM_CSR_ST_ERR           .EQU 0x0002                      ; loading failed
000972                    CRTROM_CSR_ST_OK            .EQU 0x0003                      ; loading successful
000973                    
000974                    ; Device to QNICE: Parsing status
000975                    CRTROM_CSR_PT_IDLE          .EQU 0x0000                      ; parser is idle
000976                    CRTROM_CSR_PT_PRSNG         .EQU 0x0001                      ; parser is parsing
000977                    CRTROM_CSR_PT_OK            .EQU 0x0002                      ; parsing successful
000978                    CRTROM_CSR_PT_ERR           .EQU 0x0003                      ; parsing error
000979                    
000980                    ; ----------------------------------------------------------------------------
000981                    ; Situation and context identifiers for custom messages
000982                    ; ----------------------------------------------------------------------------
000983                    
000984                    CTX_MASK_CTX                .EQU 0xFF00                      ; used to mask out the lower byte
000985                    CTX_MASK_PARAM              .EQU 0x00FF                      ; used to mask out the higher byte
000986                    
000987                    ; Trying to mount a disk or a rom image. The lower byte contains the
000988                    ; core-specific disk or rom image type and core specific code can use this
000989                    ; to filter for the right types and to output context-sensitive messages
000990                    CTX_MOUNT_DISKIMG           .EQU 0x0100                      ; trying to mount a disk image
000991                    CTX_LOAD_ROM                .EQU 0x0200                      ; trying to mount a rom image
000992                    
000993                    ; The filter function returned an empty linked list. This happens when there
000994                    ; is no file that fits the criteria in the root folder and additionally the
000995                    ; root folder has no sub-directory
000996                    CMSG_BROWSENOTHING          .EQU 0x0001
000997                    
000998                                                .ORG 0x8000
000999  8000  0FB4  FEE0                              MOVE 0xFEE0, R13
001000                    
001001                                                ; ---- mount the SD card
001002  8002  0FA0  8D40                              MOVE HANDLE_DEV, R8
001003  8004  0FA4  0001                              MOVE 1, R9
001004  8006  FF90  0044                              ASUB f32_mnt_sd, 1
001005  8008  CFA4  0000                              CMP 0, R9
001006  800A  FFA3  000A                              RBRA _MOUNTED, Z
001007  800C  0FA0  8A42                              MOVE S_EMNT, R8
001008  800E  FF90  0008                              ASUB puts, 1
001009  8010  0920                                    MOVE R9, R8
001010  8011  FF90  0026                              ASUB puthex, 1
001011  8013  FF90  000A                              ASUB crlf, 1
001012  8015  E000                                    HALT
001013                    
001014                    ; ============================================================================
001015                    ; Test 1: the 42 MB, contiguous image file
001016                    ; ============================================================================
001017  8016  0FA0  8AF2  _MOUNTED                    MOVE S_T1, R8
001018  8018  FF90  0008                              ASUB puts, 1
001019  801A  0FA0  89FB                              MOVE F_FREEDOS, R8
001020  801C  FFB0  0276                              RSUB OPEN, 1
001021                    
001022                                                ; the one-off mount time cost: walking 1344 cluster chain
001023                                                ; entries, in emulator instructions
001024  801E  0FA0  FF0B                              MOVE IO$CYC_STATE, R8
001025  8020  0FA1  0001                              MOVE 1, @R8
001026  8022  0FA0  FF08                              MOVE IO$CYC_LO, R8
001027  8024  0850                                    MOVE @R8, R4
001028  8025  0FA0  FF09                              MOVE IO$CYC_MID, R8
001029  8027  0854                                    MOVE @R8, R5
001030  8028  0FA0  89E3                              MOVE HANDLE_FILE, R8
001031  802A  0FA4  8D65                              MOVE SDB_VD_MAPS, R9
001032  802C  FFB0  065A                              RSUB SDB_MAP_BUILD, 1
001033  802E  0FA0  FF08                              MOVE IO$CYC_LO, R8
001034  8030  0858                                    MOVE @R8, R6
001035  8031  0FA0  FF09                              MOVE IO$CYC_MID, R8
001036  8033  085C                                    MOVE @R8, R7
001037  8034  3418                                    SUB R4, R6
001038  8035  451C                                    SUBC R5, R7
001039  8036  0FA0  8A76                              MOVE S_MAPC, R8
001040  8038  FF90  0008                              ASUB puts, 1
001041  803A  0720                                    MOVE R7, R8
001042  803B  FF90  0026                              ASUB puthex, 1
001043  803D  0620                                    MOVE R6, R8
001044  803E  FF90  0026                              ASUB puthex, 1
001045  8040  FF90  000A                              ASUB crlf, 1
001046                    
001047  8042  0FA0  8D65                              MOVE SDB_VD_MAPS, R8
001048  8044  FFB0  0268                              RSUB PRMAP, 1
001049                    
001050                                                ; blocks to check: first, second, around the 64 sector
001051                                                ; cluster boundary, a marker block, the last one, and two
001052                                                ; blocks past the end of the file
001053  8046  0F80  8D18                              MOVE T1_BLKS, R0
001054  8048  00A4        _T1_L                       MOVE @R0++, R9                   ; block index lo
001055  8049  00A8                                    MOVE @R0++, R10                  ; block index hi
001056  804A  00AC                                    MOVE @R0++, R11                  ; expectation: 0=ok 1=nomap
001057  804B  CFAC  FFFF                              CMP 0xFFFF, R11
001058  804D  FFA3  0008                              RBRA _T1B, Z
001059  804F  0FA0  89E3                              MOVE HANDLE_FILE, R8
001060  8051  FFB0  0353                              RSUB CHKBLK, 1
001061  8053  FFB0  043F                              RSUB VERDICT, 1
001062  8055  FFA0  FFF1                              RBRA _T1_L, 1
001063                    
001064                                                ; and 16 pseudo random blocks spread over the whole image
001065  8057  0FA0  8B17  _T1B                        MOVE S_T1B, R8
001066  8059  FF90  0008                              ASUB puts, 1
001067  805B  0F80  0010                              MOVE 16, R0                      ; R0: blocks still to check
001068  805D  0F84  1234                              MOVE 0x1234, R1                  ; R1/R2: LCG state
001069  805F  0F88  5678                              MOVE 0x5678, R2
001070  8061  B30C                                    XOR R3, R3                       ; R3: amount of bad blocks
001071  8062  0FA0  4E6D  _T1B_L                      MOVE 0x4E6D, R8                  ; state = state * 0x41C64E6D
001072  8064  0FA4  41C6                              MOVE 0x41C6, R9                  ; .. + 12345 (the classic one)
001073  8066  0128                                    MOVE R1, R10
001074  8067  022C                                    MOVE R2, R11
001075  8068  FF90  0032                              ASUB mulu32, 1
001076  806A  1FA0  3039                              ADD 0x3039, R8
001077  806C  2FA4  0000                              ADDC 0, R9
001078  806E  0804                                    MOVE R8, R1
001079  806F  0908                                    MOVE R9, R2
001080  8070  0228                                    MOVE R2, R10                     ; block = state >> 16, which
001081  8071  9FA8  0001                              AND 0x0001, R10                  ; .. is 0 .. 131071, then
001082  8073  0124                                    MOVE R1, R9                      ; .. masked into the image
001083  8074  CFA8  0001                              CMP 1, R10
001084  8076  FFAB  0005                              RBRA _T1B_C, !Z
001085  8078  CFA4  5000                              CMP 0x5000, R9                   ; keep it below 86016
001086  807A  FFA4  0001                              RBRA _T1B_C, N                   ; still inside the image
001087  807C  BA28                                    XOR R10, R10                     ; no: fold it down
001088  807D  0FA0  89E3  _T1B_C                      MOVE HANDLE_FILE, R8
001089  807F  FFB0  0325                              RSUB CHKBLK, 1
001090  8081  CFA0  0000                              CMP 0, R8
001091  8083  FFA3  0002                              RBRA _T1B_N, Z
001092  8085  1F8C  0001                              ADD 1, R3
001093  8087  3F80  0001  _T1B_N                      SUB 1, R0
001094  8089  FFAB  FFD7                              RBRA _T1B_L, !Z
001095  808B  0320                                    MOVE R3, R8
001096  808C  FFB0  0429                              RSUB VERDICT0, 1
001097                    

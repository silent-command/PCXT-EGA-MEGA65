001364                    ; ============================================================================
001365                    ; Test 8: the FAT32 library reads a sector immediately after the fast path
001366                    ; overwrote the hardware buffer with a *different* sector.
001367                    ;
001368                    ; This is the check that the "mark the buffer as unknown instead of
001369                    ; reading it back" scheme stands or falls on: if the marking did not
001370                    ; happen, the library would happily serve the block we put there.
001371                    ; ============================================================================
001372  821D  0FA0  8CE3                              MOVE S_T8, R8
001373  821F  FF90  0008                              ASUB puts, 1
001374  8221  0FA0  89FB                              MOVE F_FREEDOS, R8
001375  8223  FFB0  006F                              RSUB OPEN, 1
001376  8225  0FA0  89E3                              MOVE HANDLE_FILE, R8
001377  8227  0FA4  8D65                              MOVE SDB_VD_MAPS, R9
001378  8229  FFB0  045D                              RSUB SDB_MAP_BUILD, 1

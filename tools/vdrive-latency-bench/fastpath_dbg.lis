002755                    
002756                    ; Writes one extent: R6/R7 = amount of blocks, SDB_S_RSTART = first cluster,
002757                    ; R5 = destination, R2 = device handle.
002758                    ; Output: Carry=1 if the extent is usable. Clobbers R8..R12, leaves R0..R7.
002759  87A2  0FA0  8E30  _SDB_EMIT                   MOVE SDB_S_RSTART, R8
002760  87A4  08A4                                    MOVE @R8++, R9
002761  87A5  0868                                    MOVE @R8, R10
002762  87A6  BB2C                                    XOR R11, R11                     ; sector 0 within the cluster
002763  87A7  0220                                    MOVE R2, R8
002764  87A8  FFB0  FE2E                              RSUB SDB_CLULBA, 1
002765  87AA  FFAA  000D                              RBRA _SDB_EMIT_R, !C             ; Carry is already clear
002766                    
002767  87AC  0520                                    MOVE R5, R8
002768  87AD  0621                                    MOVE R6, @R8
002769  87AE  0520                                    MOVE R5, R8
002770  87AF  1FA0  0001                              ADD SDB_E_NBLK_HI, R8
002771  87B1  0721                                    MOVE R7, @R8
002772  87B2  0520                                    MOVE R5, R8
002773  87B3  1FA0  0002                              ADD SDB_E_LBA_LO, R8
002774  87B5  0922                                    MOVE R9, @R8++
002775  87B6  0A21                                    MOVE R10, @R8
002776  87B7  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002777  87B9  0DBC        _SDB_EMIT_R                 MOVE @R13++, R15
002778                    
002779                    ; SDB_FAT_NEXT
002780                    ; Reads the FAT32 chain successor of a cluster. Uses a one entry cache for
002781                    ; the FAT sector, so a run of consecutive clusters costs one SD card block
002782                    ; read per 128 clusters. Expects SDB_GUARD_IN to have been called.
002783                    ;
002784                    ; Input: R8: device handle
002785                    ; R9/R10: cluster lo/hi
002786                    ; Output: Carry=1: R9/R10 = successor cluster lo/hi (28 bit)
002787                    ; Carry=0: the FAT sector could not be read
002788                    ; R8 unchanged
002789  87BA  E0C0        SDB_FAT_NEXT                INCRB
002790  87BB  0800                                    MOVE R8, R0                      ; R0: device handle
002791  87BC  0904                                    MOVE R9, R1                      ; R1: byte offset in sector
002792  87BD  9F84  007F                              AND 0x007F, R1                   ; 128 FAT entries per sector
002793  87BF  9FB8  FFFD                              AND 0xFFFD, R14                  ; clear X
002794  87C1  5F84  0002                              SHL 2, R1                        ; 4 bytes per entry
002795                    
002796                                                ; FAT sector number = cluster / 128
002797  87C3  0A08                                    MOVE R10, R2
002798  87C4  9F88  007F                              AND 0x007F, R2
002799  87C6  9FB8  FFFD                              AND 0xFFFD, R14
002800  87C8  5F88  0009                              SHL 9, R2
002801  87CA  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C
002802  87CC  6FA4  0007                              SHR 7, R9
002803  87CE  1224                                    ADD R2, R9
002804  87CF  9FB8  FFFB                              AND 0xFFFB, R14
002805  87D1  6FA8  0007                              SHR 7, R10
002806                    
002807  87D3  0008                                    MOVE R0, R2                      ; plus the FAT start LBA
002808  87D4  1F88  0008                              ADD FAT32$DEV_FAT_LO, R2
002809  87D6  028C                                    MOVE @R2++, R3
002810  87D7  0248                                    MOVE @R2, R2
002811  87D8  1324                                    ADD R3, R9
002812  87D9  2228                                    ADDC R2, R10
002813  87DA  FFA2  004E                              RBRA _SDB_FN_ERR, C              ; 32-bit overflow
002814                    
002815                                                ; is this sector already in the hardware buffer?
002816  87DC  0F88  8E36                              MOVE SDB_S_FCVAL, R2
002817  87DE  CF89  0000                              CMP 0, @R2
002818  87E0  FFA3  000A                              RBRA _SDB_FN_RD, Z
002819  87E2  0F88  8E34                              MOVE SDB_S_FCLBA, R2
002820  87E4  C264                                    CMP @R2, R9
002821  87E5  FFAB  0005                              RBRA _SDB_FN_RD, !Z
002822  87E7  1F88  0001                              ADD 1, R2
002823  87E9  C268                                    CMP @R2, R10
002824  87EA  FFA3  0016                              RBRA _SDB_FN_BUF, Z
002825                    
002826  87EC  0F88  8E36  _SDB_FN_RD                  MOVE SDB_S_FCVAL, R2             ; cache is stale in any case
002827  87EE  0F89  0000                              MOVE 0, @R2
002828  87F0  0908                                    MOVE R9, R2                      ; R2/R3: remember the LBA
002829  87F1  0A0C                                    MOVE R10, R3
002830  87F2  0220                                    MOVE R2, R8
002831  87F3  0324                                    MOVE R3, R9
002832  87F4  FFB0  FD32                              RSUB SDB_SDRD, 1
002833  87F6  CFA0  0000                              CMP 0, R8
002834  87F8  FFAB  002E                              RBRA _SDB_FN_SDE, !Z
002835  87FA  0FA0  8E34                              MOVE SDB_S_FCLBA, R8
002836  87FC  0222                                    MOVE R2, @R8++
002837  87FD  0321                                    MOVE R3, @R8
002838  87FE  0FA0  8E36                              MOVE SDB_S_FCVAL, R8
002839  8800  0FA1  0001                              MOVE 1, @R8
002840                    
002841                                                ; read the 32-bit little-endian FAT entry. Keep one
002842                                                ; instruction between writing IO$SD_DATA_POS and reading
002843                                                ; IO$SD_DATA, exactly like SD$READ_BYTE does: the buffer is a
002844                                                ; block RAM whose output is registered (see byte_bram.vhd).
002845  8802  0F88  FF22  _SDB_FN_BUF                 MOVE IO$SD_DATA_POS, R2
002846  8804  0F8C  FF23                              MOVE IO$SD_DATA, R3
002847  8806  0110                                    MOVE R1, R4                      ; R4: walking byte offset
002848  8807  0409                                    MOVE R4, @R2
002849  8808  1F90  0001                              ADD 1, R4                        ; spacing, and the next offset
002850  880A  0364                                    MOVE @R3, R9                     ; byte 0
002851  880B  0409                                    MOVE R4, @R2
002852  880C  1F90  0001                              ADD 1, R4
002853  880E  0354                                    MOVE @R3, R5                     ; byte 1
002854  880F  9FB8  FFFD                              AND 0xFFFD, R14
002855  8811  5F94  0008                              SHL 8, R5
002856  8813  1524                                    ADD R5, R9
002857  8814  0409                                    MOVE R4, @R2
002858  8815  1F90  0001                              ADD 1, R4
002859  8817  0368                                    MOVE @R3, R10                    ; byte 2
002860  8818  0409                                    MOVE R4, @R2
002861  8819  1F90  0001                              ADD 1, R4
002862  881B  0354                                    MOVE @R3, R5                     ; byte 3
002863  881C  9FB8  FFFD                              AND 0xFFFD, R14
002864  881E  5F94  0008                              SHL 8, R5
002865  8820  1528                                    ADD R5, R10
002866  8821  9FA8  0FFF                              AND 0x0FFF, R10                  ; FAT32 entries are 28 bit
002867  8823  0020                                    MOVE R0, R8
002868  8824  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002869  8826  FFA0  0005                              RBRA _SDB_FN_RET, 1
002870                    
002871  8828  FFB0  FD04  _SDB_FN_SDE                 RSUB SDB_SDERR, 1
002872  882A  0020        _SDB_FN_ERR                 MOVE R0, R8
002873  882B  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002874  882D  E100        _SDB_FN_RET                 DECRB
002875  882E  0DBC                                    MOVE @R13++, R15
002876                    
002877                    ; ----------------------------------------------------------------------------
002878                    ; Block transfers
002879                    ; ----------------------------------------------------------------------------
002880                    
002881                    ; SDB_SD2VD
002882                    ; Copies the 512 bytes in the buffer of the SD controller into the internal
002883                    ; block buffer of a virtual drive. Device and 4k window selection are hoisted
002884                    ; out of the loop, which is what makes this about twenty times faster than
002885                    ; the original per-byte VD_CAD_WRITE sequence.
002886                    ;
002887                    ; Input: R8: virtual drive number (only used for the vdrives device select)
002888                    ; Output: none, all registers unchanged
002889  882F  E0C0        SDB_SD2VD                   INCRB
002890  8830  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002891  8832  0F84  8D64                              MOVE VDRIVES_DEVICE, R1
002892  8834  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002893  8835  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0
002894  8837  0F81  0000                              MOVE VD_WIN_CAD, @R0             ; control and data registers
002895                    
002896  8839  0F80  FF22                              MOVE IO$SD_DATA_POS, R0
002897  883B  0F84  FF23                              MOVE IO$SD_DATA, R1
002898  883D  0F88  7005                              MOVE VD_B_ADDR, R2
002899  883F  0F8C  7006                              MOVE VD_B_DOUT, R3
002900  8841  0F90  7007                              MOVE VD_B_WREN, R4
002901  8843  B514                                    XOR R5, R5
002902  8844  0501        _SDB_S2V_L                  MOVE R5, @R0                     ; position in the SD buffer
002903  8845  0509                                    MOVE R5, @R2                     ; address in the drive buffer
002904  8846  014D                                    MOVE @R1, @R3                    ; the byte itself
002905  8847  0F91  0001                              MOVE 1, @R4                      ; strobe write enable
002906  8849  0F91  0000                              MOVE 0, @R4
002907  884B  1F94  0001                              ADD 1, R5
002908  884D  CF94  0200                              CMP 0x0200, R5
002909  884F  FFAB  FFF3                              RBRA _SDB_S2V_L, !Z
002910  8851  E100                                    DECRB
002911  8852  0DBC                                    MOVE @R13++, R15
002912                    
002913                    ; SDB_VD2SD
002914                    ; Copies the 512 bytes from the internal block buffer of a virtual drive into
002915                    ; the buffer of the SD controller. The drive buffer address register lives in
002916                    ; the control/data window while the data register lives in the drive window,
002917                    ; so the window selector has to be toggled per byte; the device selection is
002918                    ; still hoisted out of the loop.
002919                    ;
002920                    ; Input: R8: virtual drive number
002921                    ; Output: none, all registers unchanged
002922  8853  E0C0        SDB_VD2SD                   INCRB
002923  8854  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002924  8856  0F84  8D64                              MOVE VDRIVES_DEVICE, R1
002925  8858  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002926                    
002927  8859  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002928  885B  0F84  0001                              MOVE VD_WIN_DRV, R1
002929  885D  1804                                    ADD R8, R1                       ; R1: window of this drive
002930  885E  0F88  FF22                              MOVE IO$SD_DATA_POS, R2
002931  8860  0F8C  FF23                              MOVE IO$SD_DATA, R3
002932  8862  0F90  7005                              MOVE VD_B_ADDR, R4
002933  8864  0F94  700B                              MOVE VD_B_DIN, R5
002934  8866  B618                                    XOR R6, R6
002935  8867  0F81  0000  _SDB_V2S_L                  MOVE VD_WIN_CAD, @R0             ; control and data registers
002936  8869  0611                                    MOVE R6, @R4                     ; address in the drive buffer
002937  886A  0101                                    MOVE R1, @R0                     ; drive specific registers
002938  886B  0609                                    MOVE R6, @R2                     ; position in the SD buffer
002939  886C  054D                                    MOVE @R5, @R3                    ; the byte itself
002940  886D  1F98  0001                              ADD 1, R6
002941  886F  CF98  0200                              CMP 0x0200, R6
002942  8871  FFAB  FFF4                              RBRA _SDB_V2S_L, !Z
002943  8873  E100                                    DECRB
002944  8874  0DBC                                    MOVE @R13++, R15
002945                    
002946                    ; SDB_SD2DEV
002947                    ; Copies the 512 bytes in the buffer of the SD controller into an M2M byte
002948                    ; streaming device (a CRT/ROM load target), handling the 4k window boundary.
002949                    ;
002950                    ; Input: R8: target device id
002951                    ; R9: target 4k window
002952                    ; R10: target address within the window (M2M$RAMROM_DATA based)
002953                    ; Output: R9/R10: window and address behind the last written byte
002954                    ; R8 unchanged
002955  8875  E0C0        SDB_SD2DEV                  INCRB
002956  8876  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002957  8878  0801                                    MOVE R8, @R0
002958  8879  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002959  887B  0901                                    MOVE R9, @R0
002960  887C  0F84  FF22                              MOVE IO$SD_DATA_POS, R1
002961  887E  0F88  FF23                              MOVE IO$SD_DATA, R2
002962  8880  0F8C  7000                              MOVE M2M$RAMROM_DATA, R3
002963  8882  1F8C  1000                              ADD 0x1000, R3                   ; R3: end of window marker
002964  8884  B410                                    XOR R4, R4                       ; R4: position in the SD buf
002965  8885  0F94  0200                              MOVE 0x0200, R5                  ; R5: bytes still to go
002966                                                ; One instruction has to sit between writing IO$SD_DATA_POS
002967                                                ; and reading IO$SD_DATA, exactly like SD$READ_BYTE does: the
002968                                                ; buffer is a block RAM with a registered output, see
002969                                                ; M2M/QNICE/vhdl/byte_bram.vhd. The ADD below is that
002970                                                ; instruction and does useful work at the same time.
002971  8887  0405        _SDB_S2D_L                  MOVE R4, @R1                     ; position in the SD buffer
002972  8888  1F90  0001                              ADD 1, R4
002973  888A  026A                                    MOVE @R2, @R10++                 ; the byte itself
002974  888B  C328                                    CMP R3, R10                      ; 4k window boundary?
002975  888C  FFAB  0005                              RBRA _SDB_S2D_1, !Z              ; no
002976  888E  0FA8  7000                              MOVE M2M$RAMROM_DATA, R10        ; yes: next window
002977  8890  1FA4  0001                              ADD 1, R9
002978  8892  0901                                    MOVE R9, @R0
002979  8893  3F94  0001  _SDB_S2D_1                  SUB 1, R5
002980  8895  FFAB  FFF0                              RBRA _SDB_S2D_L, !Z
002981  8897  E100                                    DECRB
002982  8898  0DBC                                    MOVE @R13++, R15
002983                    
002984                    ; ----------------------------------------------------------------------------
002985                    ; High level entry points
002986                    ; ----------------------------------------------------------------------------
002987                    
002988                    ; SDB_VD_RDBLK
002989                    ; Prepares one virtual drive block read: maps the byte position to an LBA and
002990                    ; reads that block into the buffer of the SD controller. On success the
002991                    ; caller acknowledges sd_rd_i and then calls SDB_SD2VD.
002992                    ;
002993                    ; Input: R8: virtual drive number
002994                    ; R9: file handle of the disk image
002995                    ; R10/R11: byte position within the image, lo/hi
002996                    ; R12: amount of bytes the core asked for
002997                    ; Output: Carry=1: the block is in the buffer of the SD controller
002998                    ; Carry=0: use the FAT32 library path instead
002999                    ; R8 .. R12 unchanged
003000  8899  E0C0        SDB_VD_RDBLK                INCRB
003001  889A  0800                                    MOVE R8, R0
003002  889B  0904                                    MOVE R9, R1
003003  889C  0A08                                    MOVE R10, R2
003004  889D  0B0C                                    MOVE R11, R3
003005  889E  0C10                                    MOVE R12, R4
003006  889F  FFB0  0068                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
003007  88A1  FFAA  0021                              RBRA _SDB_VRD_NO, !C
003008  88A3  0914                                    MOVE R9, R5                      ; R5/R6: LBA
003009  88A4  0A18                                    MOVE R10, R6
003010  88A5  FFB0  FC8E                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
003011  88A7  FFAA  0017                              RBRA _SDB_VRD_GRD, !C            ; no: nothing was touched
003012  88A9  0520                                    MOVE R5, R8
003013  88AA  0624                                    MOVE R6, R9
003014  88AB  FFB0  FC7B                              RSUB SDB_SDRD, 1
003015  88AD  CFA0  0000                              CMP 0, R8
003016  88AF  FFAB  0005                              RBRA _SDB_VRD_SDE, !Z            ; SD error: try the slow path
003017  88B1  0020                                    MOVE R0, R8
003018  88B2  AFB8  0004                              OR 0x0004, R14                   ; set Carry
003019  88B4  FFA0  0011                              RBRA _SDB_VRD_R, 1
003020  88B6  FFB0  FC76  _SDB_VRD_SDE                RSUB SDB_SDERR, 1
003021  88B8  FFB0  FCC4                              RSUB SDB_GUARD_OUT, 1
003022  88BA  0FA0  8E15                              MOVE SDB_RD_STAT, R8
003023  88BC  0FA1  0006                              MOVE SDB_R_SDERR, @R8
003024  88BE  FFA0  0004                              RBRA _SDB_VRD_NO, 1
003025  88C0  0FA0  8E15  _SDB_VRD_GRD                MOVE SDB_RD_STAT, R8
003026  88C2  0FA1  0005                              MOVE SDB_R_GUARD, @R8
003027  88C4  0020        _SDB_VRD_NO                 MOVE R0, R8
003028  88C5  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
003029  88C7  0124        _SDB_VRD_R                  MOVE R1, R9
003030  88C8  0228                                    MOVE R2, R10
003031  88C9  032C                                    MOVE R3, R11
003032  88CA  0430                                    MOVE R4, R12
003033  88CB  E100                                    DECRB
003034  88CC  0DBC                                    MOVE @R13++, R15
003035                    
003036                    ; SDB_VD_RDDONE
003037                    ; Called by HANDLE_DRV_RD after SDB_SD2VD has emptied the buffer: puts the
003038                    ; FAT32 library's sector back into it.
003039                    ;
003040                    ; Input: none
003041                    ; Output: none, all registers unchanged
003042  88CD  FFB0  FCAF  SDB_VD_RDDONE               RSUB SDB_GUARD_OUT, 1
003043  88CF  0DBC                                    MOVE @R13++, R15
003044                    
003045                    ; SDB_VD_WRBLK
003046                    ; Writes one virtual drive block: maps the byte position to an LBA, copies
003047                    ; the internal block buffer of the drive into the buffer of the SD controller
003048                    ; and writes it. The caller acknowledges sd_wr_i afterwards.
003049                    ;
003050                    ; Input: R8: virtual drive number
003051                    ; R9: file handle of the disk image
003052                    ; R10/R11: byte position within the image, lo/hi
003053                    ; R12: amount of bytes the core wants to write
003054                    ; Output: Carry=1: the block has been written to the SD card
003055                    ; Carry=0: nothing was written, use the FAT32 library path instead
003056                    ; R8 .. R12 unchanged
003057  88D0  E0C0        SDB_VD_WRBLK                INCRB
003058  88D1  0800                                    MOVE R8, R0
003059  88D2  0904                                    MOVE R9, R1
003060  88D3  0A08                                    MOVE R10, R2
003061  88D4  0B0C                                    MOVE R11, R3
003062  88D5  0C10                                    MOVE R12, R4
003063  88D6  FFB0  0031                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
003064  88D8  FFAA  0026                              RBRA _SDB_VWR_NO, !C
003065  88DA  0914                                    MOVE R9, R5                      ; R5/R6: LBA
003066  88DB  0A18                                    MOVE R10, R6
003067  88DC  FFB0  FC57                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
003068  88DE  FFAA  001C                              RBRA _SDB_VWR_GRD, !C            ; no: nothing was touched
003069  88E0  0020                                    MOVE R0, R8
003070  88E1  FFB0  FF70                              RSUB SDB_VD2SD, 1
003071  88E3  0520                                    MOVE R5, R8
003072  88E4  0624                                    MOVE R6, R9
003073  88E5  FFB0  FC44                              RSUB SDB_SDWR, 1
003074  88E7  CFA0  0000                              CMP 0, R8
003075  88E9  FFAB  0007                              RBRA _SDB_VWR_SDE, !Z
003076  88EB  FFB0  FC91                              RSUB SDB_GUARD_OUT, 1            ; the write is done, restore
003077  88ED  0020                                    MOVE R0, R8
003078  88EE  AFB8  0004                              OR 0x0004, R14                   ; set Carry
003079  88F0  FFA0  0011                              RBRA _SDB_VWR_R, 1
003080  88F2  FFB0  FC3A  _SDB_VWR_SDE                RSUB SDB_SDERR, 1                ; SD error: try the slow path
003081  88F4  FFB0  FC88                              RSUB SDB_GUARD_OUT, 1
003082  88F6  0FA0  8E15                              MOVE SDB_RD_STAT, R8
003083  88F8  0FA1  0006                              MOVE SDB_R_SDERR, @R8
003084  88FA  FFA0  0004                              RBRA _SDB_VWR_NO, 1
003085  88FC  0FA0  8E15  _SDB_VWR_GRD                MOVE SDB_RD_STAT, R8
003086  88FE  0FA1  0005                              MOVE SDB_R_GUARD, @R8
003087  8900  0020        _SDB_VWR_NO                 MOVE R0, R8
003088  8901  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
003089  8903  0124        _SDB_VWR_R                  MOVE R1, R9
003090  8904  0228                                    MOVE R2, R10
003091  8905  032C                                    MOVE R3, R11
003092  8906  0430                                    MOVE R4, R12
003093  8907  E100                                    DECRB
003094  8908  0DBC                                    MOVE @R13++, R15
003095                    
003096                    ; Common preparation for SDB_VD_RDBLK / SDB_VD_WRBLK. Expects the inputs in
003097                    ; the caller's R0 (drive), R1 (FDH), R2/R3 (byte position) and R4 (amount of
003098                    ; bytes) and returns Carry=1 plus the LBA in R9/R10. Runs in the caller's
003099                    ; register bank on purpose. Touches nothing outside our own variables.
003100  8909  0FAC  8E15  _SDB_PREP                   MOVE SDB_RD_STAT, R11
003101  890B  0FAD  0001                              MOVE SDB_R_SIZE, @R11
003102  890D  0FA0  0200                              MOVE 0x0200, R8
003103  890F  C420                                    CMP R4, R8                       ; exactly one block?
003104  8910  FFAB  0026                              RBRA _SDB_PREP_NO, !Z            ; no: let the FAT32 path do
003105  8912  0FAD  0002                              MOVE SDB_R_ALIGN, @R11           ; ..partial/multi blocks
003106  8914  0220                                    MOVE R2, R8
003107  8915  9FA0  01FF                              AND 0x01FF, R8                   ; block aligned?
003108  8917  FFAB  001F                              RBRA _SDB_PREP_NO, !Z            ; no
003109  8919  0FAD  0003                              MOVE SDB_R_MAP, @R11
003110  891B  0020                                    MOVE R0, R8
003111  891C  FFB0  FBDE                              RSUB SDB_VDMAP, 1
003112  891E  0830                                    MOVE R8, R12                     ; R12: map (R11 stays the..
003113  891F  0124                                    MOVE R1, R9                      ; ..status pointer)
003114  8920  FFB0  FBF3                              RSUB SDB_CHECK, 1
003115  8922  FFAA  0014                              RBRA _SDB_PREP_NO, !C
003116  8924  0FAD  0004                              MOVE SDB_R_RANGE, @R11
003117  8926  0224                                    MOVE R2, R9
003118  8927  0328                                    MOVE R3, R10
003119  8928  FFB0  FC8A                              RSUB SDB_B2BLK, 1
003120  892A  0C20                                    MOVE R12, R8
003121  892B  FFB0  FD00                              RSUB SDB_LBA, 1
003122  892D  FFAA  0009                              RBRA _SDB_PREP_NO, !C
003123  892F  0FA0  8E16                              MOVE SDB_RD_LBA, R8              ; remember it for the log
003124  8931  0922                                    MOVE R9, @R8++
003125  8932  0A21                                    MOVE R10, @R8
003126  8933  0FAD  0000                              MOVE SDB_R_OK, @R11
003127  8935  AFB8  0004                              OR 0x0004, R14                   ; set Carry
003128  8937  0DBC                                    MOVE @R13++, R15
003129  8938  9FB8  FFFB  _SDB_PREP_NO                AND 0xFFFB, R14                  ; clear Carry
003130  893A  0DBC                                    MOVE @R13++, R15
003131                    
003132                    ; SDB_FREAD_FAST
003133                    ; Streams whole 512-byte blocks of a mapped file directly from the SD card
003134                    ; into an M2M byte streaming device and then positions the file handle right
003135                    ; behind them, so that the caller's byte loop reads the rest as usual.
003136                    ;
003137                    ; It deliberately stops one whole block short of the end of the file, so that
003138                    ; the position it hands over is always strictly inside the file and the
003139                    ; caller reaches EOF through the FAT32 library, exactly as before.
003140                    ;
003141                    ; The final f32_fseek is what restores the library: a seek unconditionally
003142                    ; re-reads the sector into the hardware buffer and re-claims ownership, so
003143                    ; afterwards the library is in a state it produced itself. If anything at all
003144                    ; goes wrong the file position is put back where it was and Carry=0 is
003145                    ; returned, i.e. the caller sees "nothing happened".
003146                    ;
003147                    ; Input: R8: file handle (FDH)
003148                    ; R9: pointer to the block map
003149                    ; R10: target device id
003150                    ; R11: target 4k window
003151                    ; R12: target address within the window
003152                    ; Output: Carry=1: R11/R12 updated, the file position is behind the data
003153                    ; Carry=0: nothing was transferred, the file position is unchanged
003154                    ; and R11/R12 are unchanged
003155  893B  E0C0        SDB_FREAD_FAST              INCRB
003156  893C  0800                                    MOVE R8, R0                      ; R0: FDH
003157  893D  0904                                    MOVE R9, R1                      ; R1: map
003158  893E  0A08                                    MOVE R10, R2                     ; R2: target device
003159  893F  0B0C                                    MOVE R11, R3                     ; R3: target 4k window
003160  8940  0C10                                    MOVE R12, R4                     ; R4: target address
003161                    
003162  8941  0FA0  8E13                              MOVE SDB_FF_STAT, R8
003163  8943  0FA1  0001                              MOVE SDB_B_NOMAP, @R8
003164  8945  0FA0  8E14                              MOVE SDB_FF_BLKS, R8
003165  8947  0FA1  0000                              MOVE 0, @R8
003166                    
003167  8949  0120                                    MOVE R1, R8
003168  894A  0024                                    MOVE R0, R9
003169  894B  FFB0  FBC8                              RSUB SDB_CHECK, 1
003170  894D  FFAA  0090                              RBRA _SDBFF_NO, !C
003171                    
003172                                                ; only from the very beginning of the file
003173  894F  0020                                    MOVE R0, R8
003174  8950  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
003175  8952  CFA1  0000                              CMP 0, @R8
003176  8954  FFAB  0089                              RBRA _SDBFF_NO, !Z
003177  8956  0020                                    MOVE R0, R8
003178  8957  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
003179  8959  CFA1  0000                              CMP 0, @R8
003180  895B  FFAB  0082                              RBRA _SDBFF_NO, !Z
003181                    
003182                                                ; how many whole blocks do we take? Always one less than the
003183                                                ; file has, so that the handover position is strictly inside
003184                                                ; the file and the caller still reaches EOF through the
003185                                                ; library. A CRT/ROM file is never 32 MB or larger, so one
003186                                                ; word of block count is plenty and anything else is refused.
003187  895D  0120                                    MOVE R1, R8
003188  895E  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
003189  8960  CFA1  0000                              CMP 0, @R8
003190  8962  FFAB  007B                              RBRA _SDBFF_NO, !Z
003191  8964  0120                                    MOVE R1, R8
003192  8965  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
003193  8967  085C                                    MOVE @R8, R7                     ; R7: blocks still to do
003194  8968  3F9C  0001                              SUB 1, R7
003195  896A  FFA3  0073                              RBRA _SDBFF_NO, Z                ; a one block file: byte loop
003196  896C  FFA4  0071                              RBRA _SDBFF_NO, N                ; cannot happen: TBLK was 0
003197                    
003198  896E  0FA0  8E13                              MOVE SDB_FF_STAT, R8
003199  8970  0FA1  000B                              MOVE SDB_B_GUARD, @R8
003200  8972  FFB0  FBC1                              RSUB SDB_GUARD_IN, 1             ; nothing touched if it fails
003201  8974  FFAA  0069                              RBRA _SDBFF_NO, !C
003202                    
003203  8976  B514                                    XOR R5, R5                       ; R5/R6: block index
003204  8977  B618                                    XOR R6, R6
003205                    
003206  8978  CF9C  0000  _SDBFF_LOOP                 CMP 0, R7
003207  897A  FFA3  0020                              RBRA _SDBFF_DONE, Z
003208  897C  0120                                    MOVE R1, R8
003209  897D  0524                                    MOVE R5, R9
003210  897E  0628                                    MOVE R6, R10
003211  897F  FFB0  FCAC                              RSUB SDB_LBA, 1
003212  8981  FFAA  0019                              RBRA _SDBFF_DONE, !C
003213                    
003214                    
003215                    
003216                    
003217  8983  0920                                    MOVE R9, R8
003218  8984  0A24                                    MOVE R10, R9
003219  8985  FFB0  FBA1                              RSUB SDB_SDRD, 1
003220  8987  CFA0  0000                              CMP 0, R8
003221  8989  FFAB  000F                              RBRA _SDBFF_SDE, !Z              ; SD error: stop here
003222  898B  0220                                    MOVE R2, R8
003223  898C  0324                                    MOVE R3, R9
003224  898D  0428                                    MOVE R4, R10
003225  898E  FFB0  FEE5                              RSUB SDB_SD2DEV, 1
003226  8990  090C                                    MOVE R9, R3
003227  8991  0A10                                    MOVE R10, R4
003228  8992  1F94  0001                              ADD 1, R5
003229  8994  2F98  0000                              ADDC 0, R6
003230  8996  3F9C  0001                              SUB 1, R7
003231  8998  FFA0  FFDE                              RBRA _SDBFF_LOOP, 1
003232                    
003233  899A  FFB0  FB92  _SDBFF_SDE                  RSUB SDB_SDERR, 1
003234                    
003235                                                ; the hardware buffer is ours now; whatever we do next, the
003236                                                ; library has to be put back. A seek does that properly.
003237  899C  0FA0  8E14  _SDBFF_DONE                 MOVE SDB_FF_BLKS, R8
003238  899E  0521                                    MOVE R5, @R8
003239  899F  CF94  0000                              CMP 0, R5                        ; anything transferred?
003240  89A1  FFAB  0004                              RBRA _SDBFF_SEEK, !Z
003241  89A3  CF98  0000                              CMP 0, R6
003242  89A5  FFA3  0029                              RBRA _SDBFF_REW, Z               ; no: just put it back
003243                    
003244  89A7  0FA0  8E13  _SDBFF_SEEK                 MOVE SDB_FF_STAT, R8
003245  89A9  0FA1  000C                              MOVE SDB_B_SEEK, @R8
003246  89AB  0524                                    MOVE R5, R9                      ; file position = blocks * 512
003247  89AC  0628                                    MOVE R6, R10
003248  89AD  FFB0  FC18                              RSUB SDB_BLK2B, 1
003249  89AF  092C                                    MOVE R9, R11                     ; R11/R12: expected position
003250  89B0  0A30                                    MOVE R10, R12
003251  89B1  0020                                    MOVE R0, R8
003252  89B2  FF90  0054                              ASUB f32_fseek, 1
003253  89B4  CFA4  0000                              CMP 0, R9                        ; seek reported success?
003254  89B6  FFAB  0018                              RBRA _SDBFF_REW, !Z
003255  89B8  0020                                    MOVE R0, R8                      ; ..and actually got there?
003256  89B9  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
003257  89BB  C86C                                    CMP @R8, R11
003258  89BC  FFAB  0012                              RBRA _SDBFF_REW, !Z
003259  89BE  0020                                    MOVE R0, R8
003260  89BF  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
003261  89C1  C870                                    CMP @R8, R12
003262  89C2  FFAB  000C                              RBRA _SDBFF_REW, !Z
003263                    
003264  89C4  0FA0  8E13                              MOVE SDB_FF_STAT, R8
003265  89C6  0FA1  0000                              MOVE SDB_B_OK, @R8
003266  89C8  FFB0  FBC3                              RSUB SDB_GUARD_CLR, 1            ; the seek put the library..
003267  89CA  032C                                    MOVE R3, R11                     ; ..back, nobody to tell
003268  89CB  0430                                    MOVE R4, R12
003269  89CC  AFB8  0004                              OR 0x0004, R14                   ; set Carry
003270  89CE  FFA0  0011                              RBRA _SDBFF_RET, 1
003271                    
003272                                                ; Put the file back to the start and report "nothing done".
003273                                                ; The caller has not seen the updated target pointers, so it
003274                                                ; simply overwrites whatever we already transferred. The seek
003275                                                ; also restores the library's sector buffer; if even that
003276                                                ; fails, the buffer is marked unknown.
003277  89D0  0020        _SDBFF_REW                  MOVE R0, R8
003278  89D1  B924                                    XOR R9, R9
003279  89D2  BA28                                    XOR R10, R10
003280  89D3  FF90  0054                              ASUB f32_fseek, 1
003281  89D5  CFA4  0000                              CMP 0, R9
003282  89D7  FFAB  0004                              RBRA _SDBFF_RW1, !Z
003283  89D9  FFB0  FBB2                              RSUB SDB_GUARD_CLR, 1            ; the rewind put it back
003284  89DB  FFA0  0002                              RBRA _SDBFF_NO, 1
003285  89DD  FFB0  FBB5  _SDBFF_RW1                  RSUB SDB_ORPHAN, 1               ; not even that worked
003286                    
003287  89DF  9FB8  FFFB  _SDBFF_NO                   AND 0xFFFB, R14                  ; clear Carry
003288  89E1              _SDBFF_RET                  
003289  89E1  E100                                    DECRB
003290  89E2  0DBC                                    MOVE @R13++, R15

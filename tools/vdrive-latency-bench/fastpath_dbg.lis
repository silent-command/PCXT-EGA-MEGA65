002572  86B5  1FA0  0006                              ADD FAT32$FDH_SIZE_HI, R8
002573  86B7  0868                                    MOVE @R8, R10
002574  86B8  FFB0  FEFA                              RSUB SDB_B2BLK, 1
002575  86BA  0120                                    MOVE R1, R8
002576  86BB  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
002577  86BD  0921                                    MOVE R9, @R8
002578  86BE  0120                                    MOVE R1, R8
002579  86BF  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
002580  86C1  0A21                                    MOVE R10, @R8

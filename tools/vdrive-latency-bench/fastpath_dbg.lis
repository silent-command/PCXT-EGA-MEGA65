001751  8401  0FA4  8DDD                              MOVE SDB_RM_MAP, R9
001752  8403  0FA8  00AB                              MOVE 0x00AB, R10                 ; target device (ignored here)
001753  8405  BB2C                                    XOR R11, R11                     ; target 4k window
001754  8406  0FB0  7000                              MOVE M2M$RAMROM_DATA, R12        ; plain RAM in the emulator
001755  8408  FFB0  0531                              RSUB SDB_FREAD_FAST, 1
001756  840A  FFAA  0079                              RBRA _CR_NO, !C

001106  8096  BB2C                                    XOR R11, R11
001107  8097  0FB0  0100                              MOVE 0x0100, R12                 ; 256 bytes: not a block
001108  8099  FFB0  07FE                              RSUB SDB_VD_RDBLK, 1
001109  809B  FFA2  0004                              RBRA _T2_F1, C
001110  809D  0FA0  8A5D                              MOVE S_OK, R8
001111  809F  FFA0  0004                              RBRA _T2_P1, 1
001112  80A1  0FA0  8A62  _T2_F1                      MOVE S_FAIL, R8
001113  80A3  FFB0  042B                              RSUB BUMPFAIL, 1
001114  80A5  FF90  0008  _T2_P1                      ASUB puts, 1
001115                    
001116  80A7  0FA0  8B5C                              MOVE S_T2B, R8
001117  80A9  FF90  0008                              ASUB puts, 1
001118  80AB  B820                                    XOR R8, R8
001119  80AC  0FA4  89E3                              MOVE HANDLE_FILE, R9
001120  80AE  0FA8  0100                              MOVE 0x0100, R10                 ; byte position 256
001121  80B0  BB2C                                    XOR R11, R11
001122  80B1  0FB0  0200                              MOVE 0x0200, R12
001123  80B3  FFB0  07E4                              RSUB SDB_VD_RDBLK, 1
001124  80B5  FFA2  0004                              RBRA _T2_F2, C
001125  80B7  0FA0  8A5D                              MOVE S_OK, R8
001126  80B9  FFA0  0004                              RBRA _T2_P2, 1
001127  80BB  0FA0  8A62  _T2_F2                      MOVE S_FAIL, R8
001128  80BD  FFB0  0411                              RSUB BUMPFAIL, 1
001129  80BF  FF90  0008  _T2_P2                      ASUB puts, 1

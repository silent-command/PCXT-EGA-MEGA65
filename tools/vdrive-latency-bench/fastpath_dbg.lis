001631  837A  E100        _WRB_R                      DECRB
001632  837B  0DBC                                    MOVE @R13++, R15
001633                    
001634                    ; ---- read 512 bytes with f32_fread. R8: FDH, R9: destination buffer
001635  837C  E0C0        FREAD512                    INCRB

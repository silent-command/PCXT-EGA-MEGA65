001506                    ; ---- fill a 512 word buffer with a seeded pattern. R8: buffer, R9: seed
001507  82DF  E0C0        PATTERN                     INCRB
001508  82E0  0800                                    MOVE R8, R0
001509  82E1  0904                                    MOVE R9, R1
001510  82E2  B208                                    XOR R2, R2
001511  82E3  0102        _PAT_L                      MOVE R1, @R0++
001512  82E4  1F84  001F                              ADD 0x001F, R1
001513  82E6  9F84  00FF                              AND 0x00FF, R1
001514  82E8  1F88  0001                              ADD 1, R2
001515  82EA  CF88  0200                              CMP 0x0200, R2
001516  82EC  FFAB  FFF5                              RBRA _PAT_L, !Z
001517  82EE  E100                                    DECRB
001518  82EF  0DBC                                    MOVE @R13++, R15
001519                    
001520                    ; ---- copy the 512 byte SD controller buffer into a word buffer. R8: buffer
001521  82F0  E0C0        SD2MEM                      INCRB
001522  82F1  0F80  FF22                              MOVE IO$SD_DATA_POS, R0
001523  82F3  0F84  FF23                              MOVE IO$SD_DATA, R1
001524  82F5  0808                                    MOVE R8, R2
001525  82F6  B30C                                    XOR R3, R3
001526  82F7  0301        _S2M_L                      MOVE R3, @R0
001527  82F8  014A                                    MOVE @R1, @R2++
001528  82F9  1F8C  0001                              ADD 1, R3
001529  82FB  CF8C  0200                              CMP 0x0200, R3
001530  82FD  FFAB  FFF8                              RBRA _S2M_L, !Z
001531  82FF  E100                                    DECRB
001532  8300  0DBC                                    MOVE @R13++, R15

000001                    ; PCXT-EGA-MEGA65: latency bench for the SD-direct vdrive block path.
000002                    ; Counts QNICE instructions for the pieces of shell.asm HANDLE_DRV_RD.
000003                    
000004                    ;;
000005                    ;; sysdef.asm: This file contains definitions to simplify assembler programming
000006                    ;; and for accessing the various hardware registers via MMIO
000007                    ;;
000008                    ;
000009                    ;***************************************************************************************
000010                    ;* Assembler macros which make life much easier:
000011                    ;***************************************************************************************
000012                    ;
000013                    
000014                    
000015                    
000016                    
000017                    
000018                    ;
000019                    ; Some register short names:
000020                    ;
000021                    
000022                    
000023                    
000024                    
000025                    ;
000026                    ;***************************************************************************************
000027                    ;* IO-page addresses: Default: 8 registers per block
000028                    ;***************************************************************************************
000029                    ;
000030                    IO$AREA_START               .EQU 0xFF00
000031                    ;
000032                    ;---------------------------------------------------------------------------------------
000033                    ; Block FF00: FUNDAMENTAL IO
000034                    ;---------------------------------------------------------------------------------------
000035                    ;
000036                    ; Switch-register:
000037                    ;
000038                    IO$SWITCH_REG               .EQU 0xFF00                      ; 16 binary keys
000039                    ;
000040                    ; Registers for TIL-display:
000041                    ;
000042                    IO$TIL_DISPLAY              .EQU 0xFF01                      ; Address of TIL-display
000043                    IO$TIL_MASK                 .EQU 0xFF02                      ; Mask register of TIL display
000044                    ;
000045                    ; USB-keyboard-registers:
000046                    ;
000047                    IO$KBD_STATE                .EQU 0xFF04                      ; Status register of USB keyboard
000048                    ; Bit 0 (read only): New ASCII character avaiable for reading
000049                    ; (bits 7 downto 0 of Read register)
000050                    ; Bit 1 (read only): New special key available for reading
000051                    ; (bits 15 downto 8 of Read register)
000052                    ; Bits 2..4 (read/write): Locales: 000 = US English keyboard layout,
000053                    ; 001 = German layout, others: reserved for more locales
000054                    ; Bits 5..7 (read only): Modifiers: 5 = shift, 6 = alt, 7 = ctrl
000055                    ; Only valid, when bits 0 and/or 1 are '1'
000056                    ;
000057                    IO$KBD_DATA                 .EQU 0xFF05                      ; Data register of USB keyboard
000058                    ; Contains the ASCII character in bits 7 downto 0 or the special key code
000059                    ; in 15 downto 8. The "or" is meant exclusive, i.e. it cannot happen that
000060                    ; one transmission contains an ASCII character PLUS a special character.
000061                    ;
000062                    ;---------------------------------------------------------------------------------------
000063                    ; Block FF08: SYSTEM COUNTERS
000064                    ;---------------------------------------------------------------------------------------
000065                    ;
000066                    ; CYCLE-COUNT-registers
000067                    ;
000068                    IO$CYC_LO                   .EQU 0xFF08                      ; low word of 48-bit counter
000069                    IO$CYC_MID                  .EQU 0xFF09                      ; middle word of 48-bit counter
000070                    IO$CYC_HI                   .EQU 0xFF0A                      ; high word of 48-bit counter
000071                    IO$CYC_STATE                .EQU 0xFF0B                      ; status register
000072                    ; Bit 0 (write only): Reset counter to zero and start counting, i.e.
000073                    ; bit 1 is automatically set to 1 when resetting
000074                    ; Bit 1 (read/write): Start/stop counter
000075                    ;
000076                    ; INSTRUCTION-COUNT-registers
000077                    ;
000078                    IO$INS_LO                   .EQU 0xFF0C                      ; low word of 48-bit counter
000079                    IO$INS_MID                  .EQU 0xFF0D                      ; middle word of 48-bit counter
000080                    IO$INS_HI                   .EQU 0xFF0E                      ; high word of 48-bit counter
000081                    IO$INS_STATE                .EQU 0xFF0F                      ; status register
000082                    ; Bit 0 (write only): Reset counter to zero and start counting, i.e.
000083                    ; bit 1 is automatically set to 1 when resetting
000084                    ; Bit 1 (read/write): Start/stop counter
000085                    ;
000086                    ;---------------------------------------------------------------------------------------
000087                    ; Block FF10: UART
000088                    ;---------------------------------------------------------------------------------------
000089                    ;
000090                    ; QNICE-FPGA supports: IO$UART_SRA, IO$UART_RHRA and IO$UART_THRA
000091                    ; The other registers are mentioned for completeness to map real hardware (16550)
000092                    ;
000093                    IO$UART_BASE_ADDRESS        .EQU 0xFF10
000094                    IO$UART_MR1A                .EQU 0xFF10                      ; n/a
000095                    IO$UART_MR1B                .EQU 0xFF10                      ; n/a
000096                    IO$UART_SRA                 .EQU 0xFF11                      ; Status register (relative to base address)
000097                    IO$UART_RHRA                .EQU 0xFF12                      ; Receiving register (relative to base address)
000098                    IO$UART_THRA                .EQU 0xFF13                      ; Transmitting register (relative to base address)
000099                    ;
000100                    ;---------------------------------------------------------------------------------------
000101                    ; Block FF18: EAE
000102                    ;---------------------------------------------------------------------------------------
000103                    ;
000104                    ; EAE (Extended Arithmetic Element) registers:
000105                    ;
000106                    IO$EAE_OPERAND_0            .EQU 0xFF18
000107                    IO$EAE_OPERAND_1            .EQU 0xFF19
000108                    IO$EAE_RESULT_LO            .EQU 0xFF1A
000109                    IO$EAE_RESULT_HI            .EQU 0xFF1B
000110                    IO$EAE_CSR                  .EQU 0xFF1C                      ; Command and Status Register
000111                    ;
000112                    ; EAE-Opcodes (CSR): 0x0000 MULU 32-bit result in LO HI
000113                    ; 0x0001 MULS 32-bit result in LO HI
000114                    ; 0x0002 DIVU result in LO, modulo in HI
000115                    ; 0x0003 DIVS result in LO, modulo in HI
000116                    ; Bit 15 of CSR is the busy bit. If it is set, the EAE is still busy crunching numbers.
000117                    ;
000118                    ;---------------------------------------------------------------------------------------
000119                    ; Block FF20: SD CARD
000120                    ;---------------------------------------------------------------------------------------
000121                    ;
000122                    ; SD CARD INTERFACE registers
000123                    ;
000124                    IO$SD_BASE_ADDRESS          .EQU 0xFF20
000125                    IO$SD_ADDR_LO               .EQU 0xFF20                      ; low word of 32bit linear SD card block address
000126                    IO$SD_ADDR_HI               .EQU 0xFF21                      ; high word of 32bit linear SD card block address
000127                    IO$SD_DATA_POS              .EQU 0xFF22 ; "Cursor" to navigate the 512-byte data buffer
000128                    IO$SD_DATA                  .EQU 0xFF23                      ; read/write 1 byte from/to the 512-byte data buffer
000129                    IO$SD_ERROR                 .EQU 0xFF24                      ; error code of last operation (read only)
000130                    IO$SD_CSR                   .EQU 0xFF25                      ; Command and Status Register (write to execute command)
000131                    ;
000132                    ; SD-Opcodes (CSR): 0x0000 Reset SD card
000133                    ; 0x0001 Read 512 bytes from the linear block address
000134                    ; 0x0002 Write 512 bytes to the linear block address
000135                    ; Bits 0 .. 2 are write-only (reading always returns 0)
000136                    ; Bits 13 .. 12 return the card type: 00 = no card / unknown card
000137                    ; 01 = SD V1
000138                    ; 10 = SD V2
000139                    ; 11 = SDHC
000140                    ; Bit 14 of the CSR is the error bit: 1, if the last operation failed. In such
000141                    ; a case, the error code is in IO$SD_ERROR and
000142                    ; you need to reset the controller to go on
000143                    ; Bit 15 of the CSR is the busy bit: 1, if current operation is still running
000144                    ;
000145                    ;---------------------------------------------------------------------------------------
000146                    ; Block FF28: TIMER 0 and 1
000147                    ;---------------------------------------------------------------------------------------
000148                    ;
000149                    ; Interrupt timer: There are two timers capable of generating interrupts.
000150                    ; Each timer is controlled by three 16 bit registers:
000151                    ;
000152                    ; IO$TIMER_x_PRE: The 100 kHz timer clock is divided by the value stored in
000153                    ; this device register. 100 (which corresponds to 0x0064 in
000154                    ; the prescaler register) yields a 1 millisecond pulse which
000155                    ; in turn is fed to the actual counter.
000156                    ; IO$TIMER_x_CNT: When the number of output pulses from the prescaler circuit
000157                    ; equals the number stored in this register, an interrupt will
000158                    ; be generated (if the interrupt address is 0x0000, the
000159                    ; interrupt will be suppressed).
000160                    ; IO$TIMER_x_INT: This register contains the address of the desired interrupt
000161                    ; service routine.
000162                    ;
000163                    IO$TIMER_BASE_ADDRESS       .EQU 0xFF28
000164                    IO$TIMER_0_PRE              .EQU 0xFF28
000165                    IO$TIMER_0_CNT              .EQU 0xFF29
000166                    IO$TIMER_0_INT              .EQU 0xFF2A
000167                    IO$TIMER_1_PRE              .EQU 0xFF2B
000168                    IO$TIMER_1_CNT              .EQU 0xFF2C
000169                    IO$TIMER_1_INT              .EQU 0xFF2D
000170                    ;
000171                    ;---------------------------------------------------------------------------------------
000172                    ; Block FF30: VGA (double block, 16 registers)
000173                    ;---------------------------------------------------------------------------------------
000174                    ;
000175                    VGA$STATE                   .EQU 0xFF30                      ; VGA status register
000176                                                ; Bits 11-10: Hardware scrolling / offset enable: Bit #10 enables the use
000177                                                ; of the offset register #4 (display offset) and bit #11
000178                                                ; enables the use of register #5 (read/write offset).
000179                                                ; Bit 9: Busy: VGA is currently busy, e.g. clearing the screen,
000180                                                ; printing, etc. While busy, commands will be ignored, but
000181                                                ; they can still be written into the registers, though
000182                                                ; Bit 8: Set bit to clear screen. Read bit to find out, if clear
000183                                                ; screen is still active
000184                                                ; Bit 7: VGA enable (1 = on; 0: no VGA signal is generated)
000185                                                ; Bit 6: Hardware cursor enable
000186                                                ; Bit 5: Hardware cursor blink enable
000187                                                ; Bit 4: Hardware cursor mode: 1 - small
000188                                                ; 0 - large
000189                                                ; Bits 2-0: Output color for the whole screen, bits (2, 1, 0) = RGB
000190                    VGA$CR_X                    .EQU 0xFF31                      ; VGA cursor X position
000191                    VGA$CR_Y                    .EQU 0xFF32                      ; VGA cursor Y position
000192                    VGA$CHAR                    .EQU 0xFF33                      ; write: VGA character to be displayed
000193                                                ; read: character "under" the cursor
000194                    VGA$OFFS_DISPLAY            .EQU 0xFF34                      ; Offset in bytes that is used when displaying
000195                                                ; the video RAM. Scrolling forward one line
000196                                                ; means adding 0x50 to this register.
000197                                                ; Only works, if bit #10 in VGA$STATE is set.
000198                    VGA$OFFS_RW                 .EQU 0xFF35                      ; Offset in bytes that is used, when you read
000199                                                ; or write to the video RAM using VGA$CHAR.
000200                                                ; Works independently from VGA$OFFS_DISPLAY.
000201                                                ; Active, when bit #11 in VGA$STATE is set.
000202                    VGA$HDMI_H_MIN              .EQU 0xFF36                      ; HDMI Data Enable: X: minimum valid column
000203                    VGA$HDMI_H_MAX              .EQU 0xFF37                      ; HDMI Data Enable: X: maximum valid column
000204                    VGA$HDMI_V_MAX              .EQU 0xFF38                      ; HDMI Data Enable: Y: maximum row (line)
000205                    ;
000206                    ;---------------------------------------------------------------------------------------
000207                    ; Block FFF0: MEGA65 (double block, 16 registers)
000208                    ;---------------------------------------------------------------------------------------
000209                    ;
000210                    ; HyperRAM
000211                    ;
000212                    IO$M65HRAM_LO               .EQU 0xFFF0                      ; Low word of address (15 downto 0)
000213                    IO$M65HRAM_HI               .EQU 0xFFF1                      ; High word of address (26 downto 16)
000214                    IO$M65HRAM_DATA8            .EQU 0xFFF2                      ; HyperRAM native 8-bit data in/out
000215                    IO$M65HRAM_DATA16           .EQU 0xFFF3                      ; HyperRAM 16-bit data in/out
000216                    
000217                    ;
000218                    ;***************************************************************************************
000219                    ;* Constant definitions
000220                    ;***************************************************************************************
000221                    ;
000222                    
000223                    ; ========== VGA ==========
000224                    
000225                    VGA$MAX_X                   .EQU 79                          ; Max. X-coordinate in decimal!
000226                    VGA$MAX_Y                   .EQU 39                          ; Max. Y-coordinate in decimal!
000227                    VGA$MAX_CHARS               .EQU 3200                        ; 80 * 40 chars
000228                    VGA$CHARS_PER_LINE          .EQU 80
000229                    
000230                    VGA$EN_HW_CURSOR            .EQU 0x0040                      ; Show hardware cursor
000231                    VGA$EN_HW_SCRL              .EQU 0x0C00                      ; Hardware scrolling enable
000232                    VGA$CLR_SCRN                .EQU 0x0100                      ; Clear screen
000233                    VGA$BUSY                    .EQU 0x0200                      ; VGA is currently performing a task
000234                    
000235                    VGA$COLOR_RED               .EQU 0x0004
000236                    VGA$COLOR_GREEN             .EQU 0x0002
000237                    VGA$COLOR_BLUE              .EQU 0x0001
000238                    VGA$COLOR_WHITE             .EQU 0x0007
000239                    
000240                    ; ========== CYCLE COUNTER ==========
000241                    
000242                    CYC$RESET                   .EQU 0x0001                      ; Reset cycle counter
000243                    CYC$RUN                     .EQU 0x0002                      ; Start/stop counter
000244                    
000245                    ; ========== CYCLE COUNTER ==========
000246                    
000247                    INS$RESET                   .EQU 0x0001                      ; Reset instruction counter
000248                    INS$RUN                     .EQU 0x0002                      ; Start/stop counter
000249                    
000250                    ; ========== EAE ==========
000251                    
000252                    EAE$MULU                    .EQU 0x0000                      ; Unsigned 16 bit multiplication
000253                    EAE$MULS                    .EQU 0x0001                      ; Signed 16 bit multiplication
000254                    EAE$DIVU                    .EQU 0x0002                      ; Unsigned 16 bit division with remainder
000255                    EAE$DIVS                    .EQU 0x0003                      ; Signed 16 bit division with remainder
000256                    EAE$BUSY                    .EQU 0x8000                      ; Busy flag (1 = operation still running)
000257                    
000258                    ; ========== SD CARD ==========
000259                    
000260                    SD$CMD_RESET                .EQU 0x0000                      ; Reset SD card
000261                    SD$CMD_READ                 .EQU 0x0001                      ; Read 512 bytes from SD to internal buffer
000262                    SD$CMD_WRITE                .EQU 0x0002                      ; Write 512 bytes from int. buf. to SD
000263                    SD$BIT_ERROR                .EQU 0x4000                      ; Error flag: 1, if last operation failed
000264                    SD$BIT_BUSY                 .EQU 0x8000                      ; Busy flag: 1, if current op. is still running
000265                    SD$TIMEOUT_MID              .EQU 0x0479                      ; equals ~75.000.000 cycles, i.e. 1.5sec @ 50 MHz
000266                    
000267                    SD$ERR_MASK                 .EQU 0x00FF                      ; AND mask for errors: HI byte = state machine info, so mask it for error checks
000268                    SD$ERR_R1_ERROR             .EQU 0x0001                      ; SD Card R1 error (R1 bit 6-0)
000269                    SD$ERR_CRC_OR_TIMEOUT       .EQU 0x0002                      ; Read CRC error or Write Timeout error
000270                    SD$ERR_RESPONSE_TOKEN       .EQU 0x0003                      ; Data Response Token error (Token bit 3)
000271                    SD$ERR_ERROR_TOKEN          .EQU 0x0004                      ; Data Error Token error (Token bit 3-0)
000272                    SD$ERR_WRITE_PROTECT        .EQU 0x0005                      ; SD Card Write Protect switch
000273                    SD$ERR_CARD_UNUSABLE        .EQU 0x0006                      ; Unusable SD card
000274                    SD$ERR_NO_CARD              .EQU 0x0007                      ; No SD card (no response from CMD0)
000275                    SD$ERR_READ_TIMEOUT         .EQU 0x0008 ; Timeout while trying to receive the read start token "FE"
000276                    SD$ERR_READWRITEJAM         .EQU 0xEE21                      ; Trying to write while pending read or trying to read while pending write
000277                    SD$ERR_TIMEOUT              .EQU 0xEEFF                      ; General timeout
000278                    
000279                    SD$CT_SD_V1                 .EQU 0x0001                      ; Card type: SD Version 1
000280                    SD$CT_SD_V2                 .EQU 0x0002                      ; Card type: SD Version 2
000281                    SD$CT_SDHC                  .EQU 0x0003                      ; Card type: SDHC (or SDXC)
000282                    
000283                    ; ========== FAT32 =============
000284                    
000285                    ; FAT32 ERROR CODES
000286                    
000287                    FAT32$ERR_MBR               .EQU 0xEE10                      ; no or illegal Master Boot Record (MBR) found
000288                    FAT32$ERR_PARTITION_NO      .EQU 0xEE11                      ; the partition number needs to be in the range 1 .. 4
000289                    FAT32$ERR_PARTTBL           .EQU 0xEE12                      ; no or illegal partition table entry found (e.g. no FAT32 partition)
000290                    FAT32$ERR_NOTIMPL           .EQU 0xEE13                      ; functionality is not implemented
000291                    FAT32$ERR_SIZE              .EQU 0xEE14                      ; partition size or volume size too large (see doc/constraints.txt)
000292                    FAT32$ERR_NOFAT32           .EQU 0xEE15                      ; illegal volume id (either not 512 bytes per sector, or not 2 FATs or wrong magic)
000293                    FAT32$ERR_ILLEGAL_SIC       .EQU 0xEE16                      ; trying to read/write a sector within a cluster that is out of range
000294                    FAT32$ERR_ILLEGAL_CLUS      .EQU 0xEE17                      ; trying to access an illegal cluster number
000295                    FAT32$ERR_CORRUPT_DH        .EQU 0xEE18                      ; corrupt directory handle (e.g. because current to-be-read offs > sector size)
000296                    FAT32$ERR_DIRNOTFOUND       .EQU 0xEE19                      ; directory not found (illegal path name passed to change directory command)
000297                    FAT32$ERR_FILENOTFOUND      .EQU 0xEE20                      ; file not found
000298                    FAT23$ERR_SEEKTOOLARGE      .EQU 0xEE21                      ; seek position > file size
000299                    
000300                    ; FAT32 STATUS CODES
000301                    
000302                    FAT32$EOF                   .EQU 0xEEEE                      ; end of file reached
000303                    
000304                    ; LAYOUT OF THE MOUNT DATA STRUCTURE (DEVICE HANDLE)
000305                    
000306                    FAT32$DEV_RESET             .EQU 0x0000                      ; pointer to device reset function
000307                    FAT32$DEV_BLOCK_READ        .EQU 0x0001                      ; pointer to 512-byte block read function
000308                    FAT32$DEV_BLOCK_WRITE       .EQU 0x0002                      ; pointer to 512-byte block write function
000309                    FAT32$DEV_BYTE_READ         .EQU 0x0003                      ; pointer to 1-byte read function (within block buffer)
000310                    FAT32$DEV_BYTE_WRITE        .EQU 0x0004                      ; pointer to 1-byte write function (within block buffer)
000311                    FAT32$DEV_PARTITION         .EQU 0x0005                      ; number of partition to be mounted
000312                    FAT32$DEV_FS_LO             .EQU 0x0006                      ; file system start address (LBA): low word
000313                    FAT32$DEV_FS_HI             .EQU 0x0007                      ; file system start address (LBA): high word
000314                    FAT32$DEV_FAT_LO            .EQU 0x0008                      ; fat start address (LBA): low word
000315                    FAT32$DEV_FAT_HI            .EQU 0x0009                      ; fat start address (LBA): high word
000316                    FAT32$DEV_CLUSTER_LO        .EQU 0x000A                      ; cluster start address (LBA): low word
000317                    FAT32$DEV_CLUSTER_HI        .EQU 0x000B                      ; cluster start address (LBA): high word
000318                    FAT32$DEV_SECT_PER_CLUS     .EQU 0x000C                      ; sectors per cluster
000319                    FAT32$DEV_RD_1STCLUS_LO     .EQU 0x000D                      ; root directory first cluster: low word
000320                    FAT32$DEV_RD_1STCLUS_HI     .EQU 0x000E                      ; root directory first cluster: high word
000321                    FAT32$DEV_AD_1STCLUS_LO     .EQU 0x000F                      ; currently active directory first cluster: low word
000322                    FAT32$DEV_AD_1STCLUS_HI     .EQU 0x0010                      ; currently active directory first cluster: high word
000323                    FAT32$DEV_BUFFERED_FDH      .EQU 0x0011                      ; FDH which is responsible for the current 512 byte hardware buffer filling
000324                    
000325                    FAT32$DEV_STRUCT_SIZE       .EQU 0x0012                      ; size (words) of the mount data structure (device handle)
000326                    
000327                    ; LAYOUT OF THE FILE HANDLE AND DIRECTORY HANDLE (FDH)
000328                    
000329                    FAT32$FDH_DEVICE            .EQU 0x0000                      ; pointer to the device handle
000330                    FAT32$FDH_CLUSTER_LO        .EQU 0x0001                      ; current cluster (low word)
000331                    FAT32$FDH_CLUSTER_HI        .EQU 0x0002                      ; current cluster (high word)
000332                    FAT32$FDH_SECTOR            .EQU 0x0003                      ; current sector
000333                    FAT32$FDH_INDEX             .EQU 0x0004                      ; current byte index within current sector
000334                    FAT32$FDH_SIZE_LO           .EQU 0x0005                      ; only if FDH is a file: low word of file size, otherwise undefined
000335                    FAT32$FDH_SIZE_HI           .EQU 0x0006                      ; only if FDH is a file: high word of file size, otherwise undefined
000336                    FAT32$FDH_ACCESS_LO         .EQU 0x0007                      ; only if FDH is a file: low word of already read/written amount of bytes
000337                    FAT32$FDH_ACCESS_HI         .EQU 0x0008                      ; only if FDH is a file: high word of already read/written amount of bytes
000338                    FAT32$FDH_START_CLUS_LO     .EQU 0x0009                      ; only if FDH is a file: start of file: cluster (low word)
000339                    FAT32$FDH_START_CLUS_HI     .EQU 0x000A                      ; only if FDH is a file: start of file: cluster (high word)
000340                    FAT32$FDH_FLAGS             .EQU 0x000B                      ; status flags
000341                    
000342                    FAT32$FDH_STRUCT_SIZE       .EQU 0x000C                      ; size of the directory handle structure
000343                    
000344                    ; Flags used by FAT32$FDH_FLAGS
000345                    
000346                    FAT32$FDHF_DIRTY            .EQU 0x0001                      ; bit 0: sector buffer is dirty due to a write access
000347                    
000348                    ; FILE ATTRIBUTES
000349                    
000350                    FAT32$FA_READ_ONLY          .EQU 0x0001                      ; read only file
000351                    FAT32$FA_HIDDEN             .EQU 0x0002                      ; hidden file
000352                    FAT32$FA_SYSTEM             .EQU 0x0004                      ; system file
000353                    FAT32$FA_VOLUME_ID          .EQU 0x0008                      ; volume id (name of the volume)
000354                    FAT32$FA_DIR                .EQU 0x0010                      ; directory
000355                    FAT32$FA_ARCHIVE            .EQU 0x0020                      ; archive flag
000356                    
000357                    FAT32$FA_DEFAULT            .EQU 0x0035                      ; browse for non hidden files and directories but not for the volume id
000358                    FAT32$FA_ALL                .EQU 0x0037                      ; browse for all files, but not for the volume id
000359                    
000360                    ; LAYOUT OF THE DIRECTORY ENTRY STRUCTURE
000361                    
000362                    FAT32$DE_NAME               .EQU 0x0000                      ; volume, file or directory name, zero terminated (max 256 characters)
000363                    FAT32$DE_ATTRIB             .EQU 0x0101                      ; file attributes (read-only, hidden, system, volume id, directory, archive)
000364                    FAT32$DE_SIZE_LO            .EQU 0x0102                      ; file size: low word
000365                    FAT32$DE_SIZE_HI            .EQU 0x0103                      ; file size: high word
000366                    FAT32$DE_YEAR               .EQU 0x0104                      ; last file write: year (valid range 1980 .. 2107)
000367                    FAT32$DE_MONTH              .EQU 0x0105                      ; last file write: month
000368                    FAT32$DE_DAY                .EQU 0x0106                      ; last file write: day
000369                    FAT32$DE_HOUR               .EQU 0x0107                      ; last file write: hour
000370                    FAT32$DE_MINUTE             .EQU 0x0108                      ; last file write: minute
000371                    FAT32$DE_SECOND             .EQU 0x0109                      ; last file write: second (in 2 second steps, valid range 0 .. 58)
000372                    FAT32$DE_CLUS_LO            .EQU 0x010A                      ; start cluster: low word
000373                    FAT32$DE_CLUS_HI            .EQU 0x010B                      ; start cluster: high word
000374                    
000375                    FAT32$DE_STRUCT_SIZE        .EQU 0x010C                      ; size (words) of the directory entry data structure of the
000376                    
000377                    ; DISPLAY FLAGS FOR FILE ENTRY PRETTY PRINTER
000378                    
000379                    FAT32$PRINT_SHOW_DIR        .EQU 0x0001 ; show "<DIR>" indicator
000380                    FAT32$PRINT_SHOW_ATTRIB     .EQU 0x0002 ; show attributes as "HRSA"
000381                    FAT32$PRINT_SHOW_SIZE       .EQU 0x0004                      ; show file size
000382                    FAT32$PRINT_SHOW_DATE       .EQU 0x0008                      ; show file date as YYYY-MM-DD
000383                    FAT32$PRINT_SHOW_TIME       .EQU 0x0010                      ; show file time as HH:MM
000384                    
000385                    FAT32$PRINT_DEFAULT         .EQU 0x001D                      ; print <DIR> indicator, size, date and time (no attributes)
000386                    FAT32$PRINT_ALL             .EQU 0x001F                      ; print all details
000387                    
000388                    ; ========== KEYBOARD ==========
000389                    
000390                    ; STATUS REGISTER
000391                    
000392                    KBD$NEW_ASCII               .EQU 0x0001                      ; new ascii character available
000393                    KBD$NEW_SPECIAL             .EQU 0x0002                      ; new special key available
000394                    KBD$NEW_ANY                 .EQU 0x0003                      ; any new key available
000395                    
000396                    KBD$ASCII                   .EQU 0x00FF                      ; mask the special keys
000397                    KBD$SPECIAL                 .EQU 0xFF00                      ; mask the ascii keys
000398                    
000399                    KBD$LOCALE                  .EQU 0x001C                      ; bit mask for checking locales
000400                    KBD$LOCALE_US               .EQU 0x0000                      ; default: US keyboard layout
000401                    KBD$LOCALE_DE               .EQU 0x0004                      ; DE: German keyboard layout
000402                    
000403                    KBD$MODIFIERS               .EQU 0x00E0                      ; bit mask for checking modifiers
000404                    KBD$SHIFT                   .EQU 0x0020 ; modifier "SHIFT" pressed
000405                    KBD$ALT                     .EQU 0x0040 ; modifier "ALT" pressed
000406                    KBD$CTRL                    .EQU 0x0080 ; modifier "CTRL" pressed
000407                    
000408                    ; READ REGISTER: COMMON ASCII CODES
000409                    
000410                    KBD$SPACE                   .EQU 0x0020
000411                    KBD$ENTER                   .EQU 0x000D
000412                    KBD$ESC                     .EQU 0x001B
000413                    KBD$TAB                     .EQU 0x0009
000414                    KBD$BACKSPACE               .EQU 0x0008
000415                    
000416                    ; READ REGISTER: SPECIAL KEYS
000417                    
000418                    KBD$F1                      .EQU 0x0100
000419                    KBD$F2                      .EQU 0x0200
000420                    KBD$F3                      .EQU 0x0300
000421                    KBD$F4                      .EQU 0x0400
000422                    KBD$F5                      .EQU 0x0500
000423                    KBD$F6                      .EQU 0x0600
000424                    KBD$F7                      .EQU 0x0700

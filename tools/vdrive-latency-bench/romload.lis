000885                    ; ----------------------------------------------------------------------------
000886                    ; Virtual Drives Device for MiSTer "SD" interface (vdrives.vhd)
000887                    ; ----------------------------------------------------------------------------
000888                    
000889                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000890                    VD_NUM                      .EQU 0x7000                      ; amount of virtual drives
000891                    VD_DEVICE                   .EQU 0x7001                      ; address of the vdrives.vhd device
000892                    VD_RAM_BUFFERS              .EQU 0x7100                      ; array of RAM buffers to store dsk images
000893                    VD_BUF_SDDIRECT             .EQU 0xAAAA ; "buffer" value: no RAM buffer, the image
000894                                                ; stays on the SD card and blocks are
000895                                                ; transferred on request (see shell.asm)
000896                    
000897                    ; window selectors for vdrives.vhd
000898                    VD_WIN_CAD                  .EQU 0x0000                      ; control and data registers
000899                    VD_WIN_DRV                  .EQU 0x0001                      ; drive 0, next window = drive 1, ...
000900                    
000901                    ; VD_WIN_CAD: control and data registers
000902                    VD_IMG_MOUNT                .EQU 0x7000                      ; image mounted, lowest bit = drive 0
000903                    VD_RO                       .EQU 0x7001                      ; read-only for currently mounted drive
000904                    VD_SIZE_L                   .EQU 0x7002                      ; image file size, low word
000905                    VD_SIZE_H                   .EQU 0x7003                      ; image file size, high word
000906                    VD_TYPE                     .EQU 0x7004                      ; image file type (2-bit value)
000907                    VD_B_ADDR                   .EQU 0x7005                      ; drive buffer: address
000908                    VD_B_DOUT                   .EQU 0x7006                      ; drive buffer: data out (to drive)
000909                    VD_B_WREN                   .EQU 0x7007                      ; drive buffer: write enable (also needs ack)
000910                    VD_VDNUM                    .EQU 0x7008                      ; number of virtual drives
000911                    VD_BLKSZ                    .EQU 0x7009                      ; block size for LBA in bytes
000912                    VD_DRV_MOUNT                .EQU 0x700A                      ; drive mounted, lowest bit = drive 0
000913                    
000914                    ; VD_WIN_DRV (and onwards): virtual drive specific registers
000915                    VD_LBA_L                    .EQU 0x7000                      ; SD LBA low word
000916                    VD_LBA_H                    .EQU 0x7001                      ; SD LBA high word
000917                    VD_BLKCNT                   .EQU 0x7002                      ; SD block count
000918                    VD_BYTES_L                  .EQU 0x7003                      ; SD block address in bytes: low word
000919                    VD_BYTES_H                  .EQU 0x7004                      ; SD block address in bytes: high word
000920                    VD_SIZEB                    .EQU 0x7005                      ; SD block data amount in bytes
000921                    VD_4K_WIN                   .EQU 0x7006                      ; SD block address in 4k win logic: window
000922                    VD_4K_OFFS                  .EQU 0x7007                      ; SD block address in 4k win logic: offset
000923                    VD_RD                       .EQU 0x7008                      ; SD read request
000924                    VD_WR                       .EQU 0x7009                      ; SD write request
000925                    VD_ACK                      .EQU 0x700A                      ; SD acknowledge
000926                    VD_B_DIN                    .EQU 0x700B                      ; drive buffer: data in (from drive)
000927                    VD_CACHE_DIRTY              .EQU 0x700C                      ; cache dirty flag
000928                    VD_CACHE_FLUSHING           .EQU 0x700D                      ; cache flushing flag
000929                    VD_CACHE_FLUSH_ST           .EQU 0x700E                      ; cache flushing can start now
000930                    VD_CACHE_FLUSH_DE           .EQU 0x700F                      ; delay in ms between VD_WR and FLUSH_ST

000001                    ; CRT/ROM auto load cost: the byte loop of M2M/rom/crts-and-roms.asm
000002                    ; (_CRMA_3) against the block path of M2M/rom/sdblock.asm, for one 16 KB
000003                    ; ROM file. MODE at 0xA000:
000004                    ; 0 = mount and open only (baseline, subtracted by run.sh)
000005                    ; 1 = the original byte loop: f32_fread plus a device/window select per byte
000006                    ; 2 = SDB_FREAD_FAST plus the byte-wise tail
000007                    ; ****************************************************************************
000008                    ; MiSTer2MEGA65 (M2M) QNICE ROM
000009                    ;
000010                    ; sdblock_cfg.asm: the single build switch for the direct SD block access in
000011                    ; sdblock.asm and for its serial logging.
000012                    ;
000013                    ; ----------------------------------------------------------------------------
000014                    ; SDB_DEBUG: log what the fast path does on the serial console at boot
000015                    ; ----------------------------------------------------------------------------
000016                    ; Remove the ";" in front of the #define to switch the log on, put it back to
000017                    ; switch it off, then rebuild with CORE/m2m-rom/make_rom.sh. No keyboard is
000018                    ; involved: the ROM auto loader runs by itself and the virtual drive lines
000019                    ; appear as soon as an image is mounted.
000020                    ;
000021                    ; This lives in its own file and NOT in sdblock.asm because the C
000022                    ; preprocessor runs once, top to bottom, over the whole concatenated source.
000023                    ; sdblock.asm is included at the *end* of shell.asm, so a #define in it is
000024                    ; not yet known while shell.asm's own body, crts-and-roms.asm and everything
000025                    ; else above it are being processed - their #ifdef SDB_DEBUG blocks would be
000026                    ; silently dropped. Include this file first and the flag is visible
000027                    ; everywhere.
000028                    ;
000029                    ; That is not hypothetical: it is exactly how the first instrumented build
000030                    ; ended up with a working map-build log (inside sdblock.asm, after the
000031                    ; define) and no virtual drive log at all (in shell.asm, before it).
000032                    ; ****************************************************************************
000033                    
000034                    ;#define SDB_DEBUG
000035                    
000036                    ; tools/vdrive-latency-bench/run.sh passes -DSDB_NODEBUG for its timing runs,
000037                    ; so that the cycle counts it reports are those of the shipping build no
000038                    ; matter how the switch above is set.
000039                    ;;
000040                    ;; sysdef.asm: This file contains definitions to simplify assembler programming
000041                    ;; and for accessing the various hardware registers via MMIO
000042                    ;;
000043                    ;
000044                    ;***************************************************************************************
000045                    ;* Assembler macros which make life much easier:
000046                    ;***************************************************************************************
000047                    ;
000048                    
000049                    
000050                    
000051                    
000052                    
000053                    ;
000054                    ; Some register short names:
000055                    ;
000056                    
000057                    
000058                    
000059                    
000060                    ;
000061                    ;***************************************************************************************
000062                    ;* IO-page addresses: Default: 8 registers per block
000063                    ;***************************************************************************************
000064                    ;
000065                    IO$AREA_START               .EQU 0xFF00
000066                    ;
000067                    ;---------------------------------------------------------------------------------------
000068                    ; Block FF00: FUNDAMENTAL IO
000069                    ;---------------------------------------------------------------------------------------
000070                    ;
000071                    ; Switch-register:
000072                    ;
000073                    IO$SWITCH_REG               .EQU 0xFF00                      ; 16 binary keys
000074                    ;
000075                    ; Registers for TIL-display:
000076                    ;
000077                    IO$TIL_DISPLAY              .EQU 0xFF01                      ; Address of TIL-display
000078                    IO$TIL_MASK                 .EQU 0xFF02                      ; Mask register of TIL display
000079                    ;
000080                    ; USB-keyboard-registers:
000081                    ;
000082                    IO$KBD_STATE                .EQU 0xFF04                      ; Status register of USB keyboard
000083                    ; Bit 0 (read only): New ASCII character avaiable for reading
000084                    ; (bits 7 downto 0 of Read register)
000085                    ; Bit 1 (read only): New special key available for reading
000086                    ; (bits 15 downto 8 of Read register)
000087                    ; Bits 2..4 (read/write): Locales: 000 = US English keyboard layout,
000088                    ; 001 = German layout, others: reserved for more locales
000089                    ; Bits 5..7 (read only): Modifiers: 5 = shift, 6 = alt, 7 = ctrl
000090                    ; Only valid, when bits 0 and/or 1 are '1'
000091                    ;
000092                    IO$KBD_DATA                 .EQU 0xFF05                      ; Data register of USB keyboard
000093                    ; Contains the ASCII character in bits 7 downto 0 or the special key code
000094                    ; in 15 downto 8. The "or" is meant exclusive, i.e. it cannot happen that
000095                    ; one transmission contains an ASCII character PLUS a special character.
000096                    ;
000097                    ;---------------------------------------------------------------------------------------
000098                    ; Block FF08: SYSTEM COUNTERS
000099                    ;---------------------------------------------------------------------------------------
000100                    ;
000101                    ; CYCLE-COUNT-registers
000102                    ;
000103                    IO$CYC_LO                   .EQU 0xFF08                      ; low word of 48-bit counter
000104                    IO$CYC_MID                  .EQU 0xFF09                      ; middle word of 48-bit counter
000105                    IO$CYC_HI                   .EQU 0xFF0A                      ; high word of 48-bit counter
000106                    IO$CYC_STATE                .EQU 0xFF0B                      ; status register
000107                    ; Bit 0 (write only): Reset counter to zero and start counting, i.e.
000108                    ; bit 1 is automatically set to 1 when resetting
000109                    ; Bit 1 (read/write): Start/stop counter
000110                    ;
000111                    ; INSTRUCTION-COUNT-registers
000112                    ;
000113                    IO$INS_LO                   .EQU 0xFF0C                      ; low word of 48-bit counter
000114                    IO$INS_MID                  .EQU 0xFF0D                      ; middle word of 48-bit counter
000115                    IO$INS_HI                   .EQU 0xFF0E                      ; high word of 48-bit counter
000116                    IO$INS_STATE                .EQU 0xFF0F                      ; status register
000117                    ; Bit 0 (write only): Reset counter to zero and start counting, i.e.
000118                    ; bit 1 is automatically set to 1 when resetting
000119                    ; Bit 1 (read/write): Start/stop counter
000120                    ;
000121                    ;---------------------------------------------------------------------------------------
000122                    ; Block FF10: UART
000123                    ;---------------------------------------------------------------------------------------
000124                    ;
000125                    ; QNICE-FPGA supports: IO$UART_SRA, IO$UART_RHRA and IO$UART_THRA
000126                    ; The other registers are mentioned for completeness to map real hardware (16550)
000127                    ;
000128                    IO$UART_BASE_ADDRESS        .EQU 0xFF10
000129                    IO$UART_MR1A                .EQU 0xFF10                      ; n/a
000130                    IO$UART_MR1B                .EQU 0xFF10                      ; n/a
000131                    IO$UART_SRA                 .EQU 0xFF11                      ; Status register (relative to base address)
000132                    IO$UART_RHRA                .EQU 0xFF12                      ; Receiving register (relative to base address)
000133                    IO$UART_THRA                .EQU 0xFF13                      ; Transmitting register (relative to base address)
000134                    ;
000135                    ;---------------------------------------------------------------------------------------
000136                    ; Block FF18: EAE
000137                    ;---------------------------------------------------------------------------------------
000138                    ;
000139                    ; EAE (Extended Arithmetic Element) registers:
000140                    ;
000141                    IO$EAE_OPERAND_0            .EQU 0xFF18
000142                    IO$EAE_OPERAND_1            .EQU 0xFF19
000143                    IO$EAE_RESULT_LO            .EQU 0xFF1A
000144                    IO$EAE_RESULT_HI            .EQU 0xFF1B
000145                    IO$EAE_CSR                  .EQU 0xFF1C                      ; Command and Status Register
000146                    ;
000147                    ; EAE-Opcodes (CSR): 0x0000 MULU 32-bit result in LO HI
000148                    ; 0x0001 MULS 32-bit result in LO HI
000149                    ; 0x0002 DIVU result in LO, modulo in HI
000150                    ; 0x0003 DIVS result in LO, modulo in HI
000151                    ; Bit 15 of CSR is the busy bit. If it is set, the EAE is still busy crunching numbers.
000152                    ;
000153                    ;---------------------------------------------------------------------------------------
000154                    ; Block FF20: SD CARD
000155                    ;---------------------------------------------------------------------------------------
000156                    ;
000157                    ; SD CARD INTERFACE registers
000158                    ;
000159                    IO$SD_BASE_ADDRESS          .EQU 0xFF20
000160                    IO$SD_ADDR_LO               .EQU 0xFF20                      ; low word of 32bit linear SD card block address
000161                    IO$SD_ADDR_HI               .EQU 0xFF21                      ; high word of 32bit linear SD card block address
000162                    IO$SD_DATA_POS              .EQU 0xFF22 ; "Cursor" to navigate the 512-byte data buffer
000163                    IO$SD_DATA                  .EQU 0xFF23                      ; read/write 1 byte from/to the 512-byte data buffer
000164                    IO$SD_ERROR                 .EQU 0xFF24                      ; error code of last operation (read only)
000165                    IO$SD_CSR                   .EQU 0xFF25                      ; Command and Status Register (write to execute command)
000166                    ;
000167                    ; SD-Opcodes (CSR): 0x0000 Reset SD card
000168                    ; 0x0001 Read 512 bytes from the linear block address
000169                    ; 0x0002 Write 512 bytes to the linear block address
000170                    ; Bits 0 .. 2 are write-only (reading always returns 0)
000171                    ; Bits 13 .. 12 return the card type: 00 = no card / unknown card
000172                    ; 01 = SD V1
000173                    ; 10 = SD V2
000174                    ; 11 = SDHC
000175                    ; Bit 14 of the CSR is the error bit: 1, if the last operation failed. In such
000176                    ; a case, the error code is in IO$SD_ERROR and
000177                    ; you need to reset the controller to go on
000178                    ; Bit 15 of the CSR is the busy bit: 1, if current operation is still running
000179                    ;
000180                    ;---------------------------------------------------------------------------------------
000181                    ; Block FF28: TIMER 0 and 1
000182                    ;---------------------------------------------------------------------------------------
000183                    ;
000184                    ; Interrupt timer: There are two timers capable of generating interrupts.
000185                    ; Each timer is controlled by three 16 bit registers:
000186                    ;
000187                    ; IO$TIMER_x_PRE: The 100 kHz timer clock is divided by the value stored in
000188                    ; this device register. 100 (which corresponds to 0x0064 in
000189                    ; the prescaler register) yields a 1 millisecond pulse which
000190                    ; in turn is fed to the actual counter.
000191                    ; IO$TIMER_x_CNT: When the number of output pulses from the prescaler circuit
000192                    ; equals the number stored in this register, an interrupt will
000193                    ; be generated (if the interrupt address is 0x0000, the
000194                    ; interrupt will be suppressed).
000195                    ; IO$TIMER_x_INT: This register contains the address of the desired interrupt
000196                    ; service routine.
000197                    ;
000198                    IO$TIMER_BASE_ADDRESS       .EQU 0xFF28
000199                    IO$TIMER_0_PRE              .EQU 0xFF28
000200                    IO$TIMER_0_CNT              .EQU 0xFF29
000201                    IO$TIMER_0_INT              .EQU 0xFF2A
000202                    IO$TIMER_1_PRE              .EQU 0xFF2B
000203                    IO$TIMER_1_CNT              .EQU 0xFF2C
000204                    IO$TIMER_1_INT              .EQU 0xFF2D
000205                    ;
000206                    ;---------------------------------------------------------------------------------------
000207                    ; Block FF30: VGA (double block, 16 registers)
000208                    ;---------------------------------------------------------------------------------------
000209                    ;
000210                    VGA$STATE                   .EQU 0xFF30                      ; VGA status register
000211                                                ; Bits 11-10: Hardware scrolling / offset enable: Bit #10 enables the use
000212                                                ; of the offset register #4 (display offset) and bit #11
000213                                                ; enables the use of register #5 (read/write offset).
000214                                                ; Bit 9: Busy: VGA is currently busy, e.g. clearing the screen,
000215                                                ; printing, etc. While busy, commands will be ignored, but
000216                                                ; they can still be written into the registers, though
000217                                                ; Bit 8: Set bit to clear screen. Read bit to find out, if clear
000218                                                ; screen is still active
000219                                                ; Bit 7: VGA enable (1 = on; 0: no VGA signal is generated)
000220                                                ; Bit 6: Hardware cursor enable
000221                                                ; Bit 5: Hardware cursor blink enable
000222                                                ; Bit 4: Hardware cursor mode: 1 - small
000223                                                ; 0 - large
000224                                                ; Bits 2-0: Output color for the whole screen, bits (2, 1, 0) = RGB
000225                    VGA$CR_X                    .EQU 0xFF31                      ; VGA cursor X position
000226                    VGA$CR_Y                    .EQU 0xFF32                      ; VGA cursor Y position
000227                    VGA$CHAR                    .EQU 0xFF33                      ; write: VGA character to be displayed
000228                                                ; read: character "under" the cursor
000229                    VGA$OFFS_DISPLAY            .EQU 0xFF34                      ; Offset in bytes that is used when displaying
000230                                                ; the video RAM. Scrolling forward one line
000231                                                ; means adding 0x50 to this register.
000232                                                ; Only works, if bit #10 in VGA$STATE is set.
000233                    VGA$OFFS_RW                 .EQU 0xFF35                      ; Offset in bytes that is used, when you read
000234                                                ; or write to the video RAM using VGA$CHAR.
000235                                                ; Works independently from VGA$OFFS_DISPLAY.
000236                                                ; Active, when bit #11 in VGA$STATE is set.
000237                    VGA$HDMI_H_MIN              .EQU 0xFF36                      ; HDMI Data Enable: X: minimum valid column
000238                    VGA$HDMI_H_MAX              .EQU 0xFF37                      ; HDMI Data Enable: X: maximum valid column
000239                    VGA$HDMI_V_MAX              .EQU 0xFF38                      ; HDMI Data Enable: Y: maximum row (line)
000240                    ;
000241                    ;---------------------------------------------------------------------------------------
000242                    ; Block FFF0: MEGA65 (double block, 16 registers)
000243                    ;---------------------------------------------------------------------------------------
000244                    ;
000245                    ; HyperRAM
000246                    ;
000247                    IO$M65HRAM_LO               .EQU 0xFFF0                      ; Low word of address (15 downto 0)
000248                    IO$M65HRAM_HI               .EQU 0xFFF1                      ; High word of address (26 downto 16)
000249                    IO$M65HRAM_DATA8            .EQU 0xFFF2                      ; HyperRAM native 8-bit data in/out
000250                    IO$M65HRAM_DATA16           .EQU 0xFFF3                      ; HyperRAM 16-bit data in/out
000251                    
000252                    ;
000253                    ;***************************************************************************************
000254                    ;* Constant definitions
000255                    ;***************************************************************************************
000256                    ;
000257                    
000258                    ; ========== VGA ==========
000259                    
000260                    VGA$MAX_X                   .EQU 79                          ; Max. X-coordinate in decimal!
000261                    VGA$MAX_Y                   .EQU 39                          ; Max. Y-coordinate in decimal!
000262                    VGA$MAX_CHARS               .EQU 3200                        ; 80 * 40 chars
000263                    VGA$CHARS_PER_LINE          .EQU 80
000264                    
000265                    VGA$EN_HW_CURSOR            .EQU 0x0040                      ; Show hardware cursor
000266                    VGA$EN_HW_SCRL              .EQU 0x0C00                      ; Hardware scrolling enable
000267                    VGA$CLR_SCRN                .EQU 0x0100                      ; Clear screen
000268                    VGA$BUSY                    .EQU 0x0200                      ; VGA is currently performing a task
000269                    
000270                    VGA$COLOR_RED               .EQU 0x0004
000271                    VGA$COLOR_GREEN             .EQU 0x0002
000272                    VGA$COLOR_BLUE              .EQU 0x0001
000273                    VGA$COLOR_WHITE             .EQU 0x0007
000274                    
000275                    ; ========== CYCLE COUNTER ==========
000276                    
000277                    CYC$RESET                   .EQU 0x0001                      ; Reset cycle counter
000278                    CYC$RUN                     .EQU 0x0002                      ; Start/stop counter
000279                    
000280                    ; ========== CYCLE COUNTER ==========
000281                    
000282                    INS$RESET                   .EQU 0x0001                      ; Reset instruction counter
000283                    INS$RUN                     .EQU 0x0002                      ; Start/stop counter
000284                    
000285                    ; ========== EAE ==========
000286                    
000287                    EAE$MULU                    .EQU 0x0000                      ; Unsigned 16 bit multiplication
000288                    EAE$MULS                    .EQU 0x0001                      ; Signed 16 bit multiplication
000289                    EAE$DIVU                    .EQU 0x0002                      ; Unsigned 16 bit division with remainder
000290                    EAE$DIVS                    .EQU 0x0003                      ; Signed 16 bit division with remainder
000291                    EAE$BUSY                    .EQU 0x8000                      ; Busy flag (1 = operation still running)
000292                    
000293                    ; ========== SD CARD ==========
000294                    
000295                    SD$CMD_RESET                .EQU 0x0000                      ; Reset SD card
000296                    SD$CMD_READ                 .EQU 0x0001                      ; Read 512 bytes from SD to internal buffer
000297                    SD$CMD_WRITE                .EQU 0x0002                      ; Write 512 bytes from int. buf. to SD
000298                    SD$BIT_ERROR                .EQU 0x4000                      ; Error flag: 1, if last operation failed
000299                    SD$BIT_BUSY                 .EQU 0x8000                      ; Busy flag: 1, if current op. is still running
000300                    SD$TIMEOUT_MID              .EQU 0x0479                      ; equals ~75.000.000 cycles, i.e. 1.5sec @ 50 MHz
000301                    
000302                    SD$ERR_MASK                 .EQU 0x00FF                      ; AND mask for errors: HI byte = state machine info, so mask it for error checks
000303                    SD$ERR_R1_ERROR             .EQU 0x0001                      ; SD Card R1 error (R1 bit 6-0)
000304                    SD$ERR_CRC_OR_TIMEOUT       .EQU 0x0002                      ; Read CRC error or Write Timeout error
000305                    SD$ERR_RESPONSE_TOKEN       .EQU 0x0003                      ; Data Response Token error (Token bit 3)
000306                    SD$ERR_ERROR_TOKEN          .EQU 0x0004                      ; Data Error Token error (Token bit 3-0)
000307                    SD$ERR_WRITE_PROTECT        .EQU 0x0005                      ; SD Card Write Protect switch
000308                    SD$ERR_CARD_UNUSABLE        .EQU 0x0006                      ; Unusable SD card
000309                    SD$ERR_NO_CARD              .EQU 0x0007                      ; No SD card (no response from CMD0)
000310                    SD$ERR_READ_TIMEOUT         .EQU 0x0008 ; Timeout while trying to receive the read start token "FE"
000311                    SD$ERR_READWRITEJAM         .EQU 0xEE21                      ; Trying to write while pending read or trying to read while pending write
000312                    SD$ERR_TIMEOUT              .EQU 0xEEFF                      ; General timeout
000313                    
000314                    SD$CT_SD_V1                 .EQU 0x0001                      ; Card type: SD Version 1
000315                    SD$CT_SD_V2                 .EQU 0x0002                      ; Card type: SD Version 2
000316                    SD$CT_SDHC                  .EQU 0x0003                      ; Card type: SDHC (or SDXC)
000317                    
000318                    ; ========== FAT32 =============
000319                    
000320                    ; FAT32 ERROR CODES
000321                    
000322                    FAT32$ERR_MBR               .EQU 0xEE10                      ; no or illegal Master Boot Record (MBR) found
000323                    FAT32$ERR_PARTITION_NO      .EQU 0xEE11                      ; the partition number needs to be in the range 1 .. 4
000324                    FAT32$ERR_PARTTBL           .EQU 0xEE12                      ; no or illegal partition table entry found (e.g. no FAT32 partition)
000325                    FAT32$ERR_NOTIMPL           .EQU 0xEE13                      ; functionality is not implemented
000326                    FAT32$ERR_SIZE              .EQU 0xEE14                      ; partition size or volume size too large (see doc/constraints.txt)
000327                    FAT32$ERR_NOFAT32           .EQU 0xEE15                      ; illegal volume id (either not 512 bytes per sector, or not 2 FATs or wrong magic)
000328                    FAT32$ERR_ILLEGAL_SIC       .EQU 0xEE16                      ; trying to read/write a sector within a cluster that is out of range
000329                    FAT32$ERR_ILLEGAL_CLUS      .EQU 0xEE17                      ; trying to access an illegal cluster number
000330                    FAT32$ERR_CORRUPT_DH        .EQU 0xEE18                      ; corrupt directory handle (e.g. because current to-be-read offs > sector size)
000331                    FAT32$ERR_DIRNOTFOUND       .EQU 0xEE19                      ; directory not found (illegal path name passed to change directory command)
000332                    FAT32$ERR_FILENOTFOUND      .EQU 0xEE20                      ; file not found
000333                    FAT23$ERR_SEEKTOOLARGE      .EQU 0xEE21                      ; seek position > file size
000334                    
000335                    ; FAT32 STATUS CODES
000336                    
000337                    FAT32$EOF                   .EQU 0xEEEE                      ; end of file reached
000338                    
000339                    ; LAYOUT OF THE MOUNT DATA STRUCTURE (DEVICE HANDLE)
000340                    
000341                    FAT32$DEV_RESET             .EQU 0x0000                      ; pointer to device reset function
000342                    FAT32$DEV_BLOCK_READ        .EQU 0x0001                      ; pointer to 512-byte block read function
000343                    FAT32$DEV_BLOCK_WRITE       .EQU 0x0002                      ; pointer to 512-byte block write function
000344                    FAT32$DEV_BYTE_READ         .EQU 0x0003                      ; pointer to 1-byte read function (within block buffer)
000345                    FAT32$DEV_BYTE_WRITE        .EQU 0x0004                      ; pointer to 1-byte write function (within block buffer)
000346                    FAT32$DEV_PARTITION         .EQU 0x0005                      ; number of partition to be mounted
000347                    FAT32$DEV_FS_LO             .EQU 0x0006                      ; file system start address (LBA): low word
000348                    FAT32$DEV_FS_HI             .EQU 0x0007                      ; file system start address (LBA): high word
000349                    FAT32$DEV_FAT_LO            .EQU 0x0008                      ; fat start address (LBA): low word
000350                    FAT32$DEV_FAT_HI            .EQU 0x0009                      ; fat start address (LBA): high word
000351                    FAT32$DEV_CLUSTER_LO        .EQU 0x000A                      ; cluster start address (LBA): low word
000352                    FAT32$DEV_CLUSTER_HI        .EQU 0x000B                      ; cluster start address (LBA): high word
000353                    FAT32$DEV_SECT_PER_CLUS     .EQU 0x000C                      ; sectors per cluster
000354                    FAT32$DEV_RD_1STCLUS_LO     .EQU 0x000D                      ; root directory first cluster: low word
000355                    FAT32$DEV_RD_1STCLUS_HI     .EQU 0x000E                      ; root directory first cluster: high word
000356                    FAT32$DEV_AD_1STCLUS_LO     .EQU 0x000F                      ; currently active directory first cluster: low word
000357                    FAT32$DEV_AD_1STCLUS_HI     .EQU 0x0010                      ; currently active directory first cluster: high word
000358                    FAT32$DEV_BUFFERED_FDH      .EQU 0x0011                      ; FDH which is responsible for the current 512 byte hardware buffer filling
000359                    
000360                    FAT32$DEV_STRUCT_SIZE       .EQU 0x0012                      ; size (words) of the mount data structure (device handle)
000361                    
000362                    ; LAYOUT OF THE FILE HANDLE AND DIRECTORY HANDLE (FDH)
000363                    
000364                    FAT32$FDH_DEVICE            .EQU 0x0000                      ; pointer to the device handle
000365                    FAT32$FDH_CLUSTER_LO        .EQU 0x0001                      ; current cluster (low word)
000366                    FAT32$FDH_CLUSTER_HI        .EQU 0x0002                      ; current cluster (high word)
000367                    FAT32$FDH_SECTOR            .EQU 0x0003                      ; current sector
000368                    FAT32$FDH_INDEX             .EQU 0x0004                      ; current byte index within current sector
000369                    FAT32$FDH_SIZE_LO           .EQU 0x0005                      ; only if FDH is a file: low word of file size, otherwise undefined
000370                    FAT32$FDH_SIZE_HI           .EQU 0x0006                      ; only if FDH is a file: high word of file size, otherwise undefined
000371                    FAT32$FDH_ACCESS_LO         .EQU 0x0007                      ; only if FDH is a file: low word of already read/written amount of bytes
000372                    FAT32$FDH_ACCESS_HI         .EQU 0x0008                      ; only if FDH is a file: high word of already read/written amount of bytes
000373                    FAT32$FDH_START_CLUS_LO     .EQU 0x0009                      ; only if FDH is a file: start of file: cluster (low word)
000374                    FAT32$FDH_START_CLUS_HI     .EQU 0x000A                      ; only if FDH is a file: start of file: cluster (high word)
000375                    FAT32$FDH_FLAGS             .EQU 0x000B                      ; status flags
000376                    
000377                    FAT32$FDH_STRUCT_SIZE       .EQU 0x000C                      ; size of the directory handle structure
000378                    
000379                    ; Flags used by FAT32$FDH_FLAGS
000380                    
000381                    FAT32$FDHF_DIRTY            .EQU 0x0001                      ; bit 0: sector buffer is dirty due to a write access
000382                    
000383                    ; FILE ATTRIBUTES
000384                    
000385                    FAT32$FA_READ_ONLY          .EQU 0x0001                      ; read only file
000386                    FAT32$FA_HIDDEN             .EQU 0x0002                      ; hidden file
000387                    FAT32$FA_SYSTEM             .EQU 0x0004                      ; system file
000388                    FAT32$FA_VOLUME_ID          .EQU 0x0008                      ; volume id (name of the volume)
000389                    FAT32$FA_DIR                .EQU 0x0010                      ; directory
000390                    FAT32$FA_ARCHIVE            .EQU 0x0020                      ; archive flag
000391                    
000392                    FAT32$FA_DEFAULT            .EQU 0x0035                      ; browse for non hidden files and directories but not for the volume id
000393                    FAT32$FA_ALL                .EQU 0x0037                      ; browse for all files, but not for the volume id
000394                    
000395                    ; LAYOUT OF THE DIRECTORY ENTRY STRUCTURE
000396                    
000397                    FAT32$DE_NAME               .EQU 0x0000                      ; volume, file or directory name, zero terminated (max 256 characters)
000398                    FAT32$DE_ATTRIB             .EQU 0x0101                      ; file attributes (read-only, hidden, system, volume id, directory, archive)
000399                    FAT32$DE_SIZE_LO            .EQU 0x0102                      ; file size: low word
000400                    FAT32$DE_SIZE_HI            .EQU 0x0103                      ; file size: high word
000401                    FAT32$DE_YEAR               .EQU 0x0104                      ; last file write: year (valid range 1980 .. 2107)
000402                    FAT32$DE_MONTH              .EQU 0x0105                      ; last file write: month
000403                    FAT32$DE_DAY                .EQU 0x0106                      ; last file write: day
000404                    FAT32$DE_HOUR               .EQU 0x0107                      ; last file write: hour
000405                    FAT32$DE_MINUTE             .EQU 0x0108                      ; last file write: minute
000406                    FAT32$DE_SECOND             .EQU 0x0109                      ; last file write: second (in 2 second steps, valid range 0 .. 58)
000407                    FAT32$DE_CLUS_LO            .EQU 0x010A                      ; start cluster: low word
000408                    FAT32$DE_CLUS_HI            .EQU 0x010B                      ; start cluster: high word
000409                    
000410                    FAT32$DE_STRUCT_SIZE        .EQU 0x010C                      ; size (words) of the directory entry data structure of the
000411                    
000412                    ; DISPLAY FLAGS FOR FILE ENTRY PRETTY PRINTER
000413                    
000414                    FAT32$PRINT_SHOW_DIR        .EQU 0x0001 ; show "<DIR>" indicator
000415                    FAT32$PRINT_SHOW_ATTRIB     .EQU 0x0002 ; show attributes as "HRSA"
000416                    FAT32$PRINT_SHOW_SIZE       .EQU 0x0004                      ; show file size
000417                    FAT32$PRINT_SHOW_DATE       .EQU 0x0008                      ; show file date as YYYY-MM-DD
000418                    FAT32$PRINT_SHOW_TIME       .EQU 0x0010                      ; show file time as HH:MM
000419                    
000420                    FAT32$PRINT_DEFAULT         .EQU 0x001D                      ; print <DIR> indicator, size, date and time (no attributes)
000421                    FAT32$PRINT_ALL             .EQU 0x001F                      ; print all details
000422                    
000423                    ; ========== KEYBOARD ==========

000541                    ; ****************************************************************************
000542                    ; MiSTer2MEGA65 (M2M) QNICE ROM
000543                    ;
000544                    ; System definition file for registers and MMIO
000545                    ;
000546                    ; done by sy2002 in 2022 and licensed under GPL v3
000547                    ; ****************************************************************************
000548                    
000549                    ; ----------------------------------------------------------------------------
000550                    ; Control and status register
000551                    ; ----------------------------------------------------------------------------
000552                    
000553                    M2M$CSR                     .EQU 0xFFE0
000554                                                ; Bit 0: Reset the MiSTer core
000555                                                ; Bit 1: Pause the MiSTer core
000556                                                ; Bit 2: Show On-Screen-Menu (OSM) as an overlay over core output
000557                                                ; Bit 3: Keyboard connection between M65 keyb. and the core
000558                                                ; Bit 4: Joy. port 1 connection between M65 joy. port and core
000559                                                ; Bit 5: Joy. port 2 connection between M65 joy. port and core
000560                                                ; Bit 6: SD Card: Mode: 0=Auto: SD card automatically switches
000561                                                ; between the internal card (bottom tray) and the external
000562                                                ; card (back slot). The external card has higher precedence.
000563                                                ; Bit 7: SD Card: If Mode=1: 0=force internal / 1=force external
000564                                                ; Bit 8: SD Card: Currently active: 0=internal / 1=external
000565                                                ; Bit 9: SD Card: Internal SD card detected
000566                                                ; Bit 10: SD Card: External SD card detected
000567                                                ; Bit 11: Ascal autoset: If set to 1: M2M$ASCAL_MODE (which is
000568                                                ; controlling QNICE ouput port ascal_mode_o) is automatically
000569                                                ; kept in sync with ascal_mode_i
000570                                                ; Bits 12..15: RESERVED
000571                                                ;
000572                                                ; Bits 8, 9, 10 are read-only
000573                    
000574                    M2M$CSR_RESET               .EQU 0x0001
000575                    M2M$CSR_UN_RESET            .EQU 0xFFFE
000576                    M2M$CSR_PAUSE               .EQU 0x0002
000577                    M2M$CSR_UN_PAUSE            .EQU 0xFFFD
000578                    M2M$CSR_OSM                 .EQU 0x0004
000579                    M2M$CSR_UN_OSM              .EQU 0xFFFB
000580                    M2M$CSR_KBD                 .EQU 0x0008
000581                    M2M$CSR_UN_KBD              .EQU 0xFFF7
000582                    M2M$CSR_JOY1                .EQU 0x0010
000583                    M2M$CSR_UN_JOY1             .EQU 0xFFEF
000584                    M2M$CSR_JOY2                .EQU 0x0020
000585                    M2M$CSR_UN_JOY2             .EQU 0xFFDF
000586                    M2M$CSR_SD_MODE             .EQU 0x0040
000587                    M2M$CSR_UN_SD_MODE          .EQU 0xFFBF
000588                    M2M$CSR_SD_FORCE            .EQU 0x0080
000589                    M2M$CSR_UN_SD_FORCE         .EQU 0xFF7F
000590                    M2M$CSR_SD_ACTIVE           .EQU 0x0100
000591                    M2M$CSR_UN_SD_ACTIVE        .EQU 0xFEFF
000592                    M2M$CSR_SD_DET_INT          .EQU 0x0200
000593                    M2M$CSR_UN_SD_DET_INT       .EQU 0xFDFF
000594                    M2M$CSR_SD_DET_EXT          .EQU 0x0400
000595                    M2M$CSR_UN_SD_DET_EXT       .EQU 0xFBFF
000596                    M2M$CSR_ASCAL_AUTO          .EQU 0x0800
000597                    M2M$CSR_UN_ASCAL_AUTO       .EQU 0xF7FF
000598                    
000599                    M2M$CSR_KBD_JOY             .EQU 0x0038
000600                    M2M$CSR_UN_KBD_JOY          .EQU 0xFFC7
000601                    
000602                    ; ----------------------------------------------------------------------------
000603                    ; VGA and On-Screen-Menu (OSM)
000604                    ; ----------------------------------------------------------------------------
000605                    
000606                    ; All coordinates and sizes in the OSM context are specified in characters
000607                    ; The high-byte of the 16-bit value is always x or dx and the low-byte y or dy
000608                    
000609                    ; When bit 2 of the CSR = 1, then the OSM is shown at the coordinates
000610                    ; and in the size given by these two registers, i.e. these registers are used
000611                    ; by the display hardware
000612                    M2M$OSM_XY                  .EQU 0xFFE1                      ; x|y coordinates
000613                    M2M$OSM_DXDY                .EQU 0xFFE2                      ; dx|dy width and height
000614                    
000615                    ; Screen attributes: Single bits
000616                    M2M$SA_INVERSE              .EQU 0x80
000617                    M2M$SA_DARK                 .EQU 0x40
000618                    M2M$SA_BG_RED               .EQU 0x20
000619                    M2M$SA_BG_GREEN             .EQU 0x10
000620                    M2M$SA_BG_BLUE              .EQU 0x08
000621                    M2M$SA_FG_RED               .EQU 0x04
000622                    M2M$SA_FG_GREEN             .EQU 0x02
000623                    M2M$SA_FG_BLUE              .EQU 0x01
000624                    
000625                    ; Screen attributes: Common bit-combinations
000626                    M2M$SA_COL_STD              .EQU 0x0B                        ; cyan font on blue background
000627                    M2M$SA_COL_STD_INV          .EQU 0x8B                        ; inverse standard
000628                    M2M$SA_COL_TTLE             .EQU 0x0E                        ; Title: Yellow on blue background
000629                    M2M$SA_COL_TTLE_INV         .EQU 0x8E                        ; inverse Title
000630                    M2M$SA_COL_SEL              .EQU 0x0F                        ; selection: white font on blue background
000631                    
000632                    ; Special characters in font Anikki-16x16
000633                    M2M$FC_TL                   .EQU 201                         ; fat top/left corner
000634                    M2M$FC_SH                   .EQU 205                         ; fat straight horizontal
000635                    M2M$FC_TR                   .EQU 187                         ; fat top/right corner
000636                    M2M$FC_SV                   .EQU 186                         ; fat straight vertical
000637                    M2M$FC_BL                   .EQU 200                         ; fat bottom/left corner
000638                    M2M$FC_BR                   .EQU 188                         ; fat bottom/right corner
000639                    M2M$FC_HE_LEFT              .EQU 185                         ; fat straight horiz. line ends: left part
000640                    M2M$FC_HE_RIGHT             .EQU 204                         ; fat straight horiz. line ends: right part
000641                    M2M$NC_SH                   .EQU 196                         ; normal straight horizontal
000642                    M2M$NC_VE_LEFT              .EQU 199                         ; normal vertical line end: left part
000643                    M2M$NC_VE_RIGHT             .EQU 182                         ; normal vertical line end: right part
000644                    M2M$DIR_L                   .EQU 17                          ; left char for displaying a directory
000645                    M2M$DIR_R                   .EQU 16                          ; right char for displaying a directory
000646                    M2M$OPT_SEL_MULTI           .EQU 7                           ; selection char for options menu: multi-sel.
000647                    M2M$OPT_SEL_SINGLE          .EQU 61                          ; ditto for single select
000648                    M2M$LD_PROGRESS             .EQU 254                         ; character used for progress bar
000649                    M2M$LD_SPACE                .EQU 32                          ; space character
000650                    
000651                    ; ----------------------------------------------------------------------------
000652                    ; HDMI: Avalon Scaler (ascal.vhd)
000653                    ; ----------------------------------------------------------------------------
000654                    
000655                    M2M$ASCAL_MODE              .EQU 0xFFE3                      ; ascal mode register
000656                                                ; this reg. is read-only if CSR bit 11 = 1
000657                    
000658                    ; ascal mode: bits 2 downto 0
000659                    M2M$ASCAL_NEAREST           .EQU 0x0000                      ; Nearest neighbor
000660                    M2M$ASCAL_BILINEAR          .EQU 0x0001                      ; Bilinear
000661                    M2M$ASCAL_SBILINEAR         .EQU 0x0002                      ; Sharp Bilinear
000662                    M2M$ASCAL_BICUBIC           .EQU 0x0003                      ; Bicubic
000663                    M2M$ASCAL_POLYPHASE         .EQU 0x0004                      ; Polyphase filter (used for CRT emulation)
000664                    
000665                    ; ascal Polyphase addresses
000666                    M2M$ASCAL_PP_HORIZ          .EQU 0x0000
000667                    M2M$ASCAL_PP_VERT           .EQU 0x0100
000668                    
000669                    ; ascal mode: bits 3 and 4
000670                    M2M$ASCAL_TRIPLEBUF         .EQU 0x0008                      ; Activate triple-buffering
000671                    M2M$ASCAL_RESERVED          .EQU 0x0010                      ; reserved (see ascal.vhd)
000672                    
000673                    ; ----------------------------------------------------------------------------
000674                    ; Special-purpose and general-purpose 16-bit input flags
000675                    ; Read-only; direct pass through from SOC inputs, not buffered in a register.
000676                    ; (Currently reserved and not used, yet)
000677                    ; ----------------------------------------------------------------------------
000678                    
000679                    ; special-purpose register that gets its semantics via the Shell firmware
000680                    M2M$SPECIAL                 .EQU 0xFFE4
000681                    
000682                    ; general-purpose register, can be freely used and is not used by the Shell
000683                    M2M$GENERAL                 .EQU 0xFFE5
000684                    
000685                    ; ----------------------------------------------------------------------------
000686                    ; Keyboard for the framework (independent from the keyboard of the core)
000687                    ; ----------------------------------------------------------------------------
000688                    
000689                    ; Low active realtime snapshot of the currently pressed keys (read-only)
000690                    ; (MMIO "qnice_keys_o" register of m2m_keys.vhd)
000691                    M2M$KEYBOARD                .EQU 0xFFE8
000692                    
000693                    ; Typematic delay (DLY) and typematic repeat (SPD)
000694                    ; DLY: How long needs the key to be pressed, until the typematic repeat starts
000695                    ; SPD: How fast will the pressed key be repeated
000696                    ; IMPORTANT: These values are empiric and relative to QNICE V1.61
000697                    M2M$TYPEMATIC_DLY           .EQU 0x8000                      ; ~0.5sec in QNICE V1.61
000698                    M2M$TYPEMATIC_SPD           .EQU 0x1000                      ; ~12 per sec
000699                    
000700                    ; Definition of the bits in M2M$KEYBOARD
000701                    M2M$KEY_UP                  .EQU 0x0001
000702                    M2M$KEY_DOWN                .EQU 0x0002
000703                    M2M$KEY_LEFT                .EQU 0x0004
000704                    M2M$KEY_RIGHT               .EQU 0x0008
000705                    M2M$KEY_RETURN              .EQU 0x0010
000706                    M2M$KEY_SPACE               .EQU 0x0020
000707                    M2M$KEY_RUNSTOP             .EQU 0x0040
000708                    M2M$KEY_HELP                .EQU 0x0080
000709                    M2M$KEY_F1                  .EQU 0x0100
000710                    M2M$KEY_F3                  .EQU 0x0200
000711                    
000712                    ; ----------------------------------------------------------------------------
000713                    ; 256-bit General purpose control flags
000714                    ; ----------------------------------------------------------------------------
000715                    
000716                    ; 256-bit directly controled by the programmer (not used by the Shell)
000717                    ; Select a window between 0 and 15 in M2M$CFD_ADDR and access the control
000718                    ; flags sliced into 16-bit chunks via M2M$CFD_DATA
000719                    ; exposed by QNICE via control_d_o
000720                    M2M$CFD_ADDR                .EQU 0xFFF0
000721                    M2M$CFD_DATA                .EQU 0xFFF1
000722                    
000723                    ; 256-bit controled by the Shell via the options menu, i.e. the menu that
000724                    ; opens when the core is running and the user presses "Help" on the keyboard:
000725                    ; the bit order is: bit 0 = topmost menu entry, the mapping is 1-to-1 to
000726                    ; OPTM_ITEMS / OPTM_GROUPS in config.vhd
000727                    ; exposed by QNICE via control_m_o; M2M$CFM_ADDR runs from 0 to 15
000728                    M2M$CFM_ADDR                .EQU 0xFFF2
000729                    M2M$CFM_DATA                .EQU 0xFFF3
000730                    
000731                    ; ----------------------------------------------------------------------------
000732                    ; MMIO 4k-segmented access to RAMs, ROMs and similarily behaving devices
000733                    ; ----------------------------------------------------------------------------
000734                    
000735                    M2M$RAMROM_DEV              .EQU 0xFFF4
000736                                                ; Devices 0x0000 .. 0x00FF: RESERVED (see below)
000737                                                ; Devices 0x0100 .. 0xFFFF: Free to be used for any RAM, ROM or device
000738                                                ; that behaves like a RAM or ROM from the
000739                                                ; perspective of QNICE
000740                    
000741                    M2M$VRAM_DATA               .EQU 0x0000                      ; Device for VRAM: Data
000742                    M2M$VRAM_ATTR               .EQU 0x0001                      ; Device for VRAM: Attributes
000743                    M2M$CONFIG                  .EQU 0x0002                      ; Static Shell config data (config.vhd)
000744                    M2M$ASCAL_PPHASE            .EQU 0x0003                      ; ascal.vhd Polyphase filter RAM
000745                    M2M$HYPERRAM                .EQU 0x0004                      ; Device for the built-in 8MB of HyperRAM
000746                    M2M$SDRAM                   .EQU 0x0005                      ; @TODO/RESERVED for future R4 boards
000747                    
000748                    M2M$SYS_INFO                .EQU 0x00FF                      ; Device for System Info
000749                    
000750                    M2M$RAMROM_4KWIN            .EQU 0xFFF5                      ; 4k window selector
000751                    M2M$RAMROM_DATA             .EQU 0x7000                      ; 4k MMIO window to read/write
000752                    
000753                    ; ----------------------------------------------------------------------------
000754                    ; Sysinfo device: Selectors and addresses
000755                    ; ----------------------------------------------------------------------------
000756                    
000757                    ; Selectors (4k windows)
000758                    M2M$SYS_VDRIVES             .EQU 0x0000                      ; vdrives constants (globals.vhd)
000759                    M2M$SYS_VGA                 .EQU 0x0010                      ; gfx adaptor 0: VGA
000760                    M2M$SYS_HDMI                .EQU 0x0011                      ; gfx adaptor 1: HDMI
000761                    M2M$SYS_CRTSANDROMS         .EQU 0x0020                      ; sim. CRTs. & ROMs (globals.vhd)
000762                    M2M$SYS_CORE                .EQU 0x0030                      ; info about the MiSTer core
000763                    
000764                    ; The following read-only registers are meant to be used by the QNICE
000765                    ; firmware. They enable the ability to specify the hardware screen resolution
000766                    ; in characters as well as the start coordinates and size of the main screen.
000767                    ; The position and size of the option menu is deducted.
000768                    M2M$SYS_DXDY                .EQU 0x7000
000769                    M2M$SHELL_M_XY              .EQU 0x7001                      ; main screen: x|y start coordinates
000770                    M2M$SHELL_M_DXDY            .EQU 0x7002                      ; main screen: dx|dy width and height
000771                    
000772                    ; M2M$SYS_CORE registers: measurement from ASCAL
000773                    M2M$SYS_CORE_X              .EQU 0x7000                      ; visible dx measurement from ASCAL
000774                    M2M$SYS_CORE_Y              .EQU 0x7001                      ; visible dy measurement from ASCAL
000775                    
000776                    ; M2M$SYS_CORE registers: measurement from M2M component
000777                    M2M$SYS_CORE_H_PXLS         .EQU 0x7002                      ; visible dx
000778                    M2M$SYS_CORE_V_PXLS         .EQU 0x7003                      ; visible dy
000779                    M2M$SYS_CORE_H_PLSE         .EQU 0x7004                      ; horizontal pulse
000780                    M2M$SYS_CORE_H_BP           .EQU 0x7005                      ; horizontal back porch
000781                    M2M$SYS_CORE_H_FP           .EQU 0x7006                      ; horizontal front porch
000782                    M2M$SYS_CORE_V_PLSE         .EQU 0x7007                      ; vertical pulse
000783                    M2M$SYS_CORE_V_BP           .EQU 0x7008                      ; vertical back porch
000784                    M2M$SYS_CORE_V_FP           .EQU 0x7009                      ; vertical front porch
000785                    M2M$SYS_CORE_H_FREQ         .EQU 0x700A                      ; horizontal frequency in Hz
000786                    
000787                    ; ----------------------------------------------------------------------------
000788                    ; Static Shell configuration data (config.vhd): Selectors and addresses
000789                    ; ----------------------------------------------------------------------------
000790                    
000791                    ; Selectors (4k windows)
000792                    
000793                    M2M$CFG_WHS                 .EQU 0x1000                      ; Welcome & Help screens
000794                    M2M$CFG_DIR_START           .EQU 0x0100                      ; Start folder for file browser
000795                    M2M$CFG_CFG_FILE            .EQU 0x0101                      ; Config file for OSM persistence
000796                    M2M$CFG_GENERAL             .EQU 0x0110                      ; General configuration settings
000797                    M2M$CFG_CORENAME            .EQU 0x0200                      ; String: name and version of core
000798                    
000799                    M2M$CFG_OPTM_ITEMS          .EQU 0x0300 ; "Help" menu / Options menu items
000800                    M2M$CFG_OPTM_GROUPS         .EQU 0x0301                      ; Menu groups
000801                    M2M$CFG_OPTM_STDSEL         .EQU 0x0302                      ; Menu items that are selected by default
000802                    M2M$CFG_OPTM_LINES          .EQU 0x0303                      ; Separator lines
000803                    M2M$CFG_OPTM_START          .EQU 0x0304                      ; Position of very first cursor pos
000804                    M2M$CFG_OPTM_ICOUNT         .EQU 0x0305                      ; Amount of menu items
000805                    M2M$CFG_OPTM_MOUNT          .EQU 0x0306                      ; Menu item = mount a drive
000806                    M2M$CFG_OPTM_SINGLE         .EQU 0x0307                      ; Single-select menu item
000807                    M2M$CFG_OPTM_MSTR           .EQU 0x0308                      ; Mount string to display instead of %s
000808                    M2M$CFG_OPTM_DIM            .EQU 0x0309                      ; DX and DY of Options/Help menu
000809                    M2M$CFG_OPTM_SSTR           .EQU 0x030A                      ; Saving string to display instead of %s
000810                    M2M$CFG_OPTM_HELP           .EQU 0x0310                      ; Menu item = show a help menu
000811                    M2M$CFG_OPTM_CRTROM         .EQU 0x0311                      ; Menu item = manually load CRT/ROM
000812                    M2M$CFG_OPTM_CRSTR          .EQU 0x0312                      ; CRT/ROM load str. to show instead of %s
000813                    
000814                    ; M2M$CFG_WHS
000815                    
000816                    M2M$WHS_PAGES               .EQU 0x7FFF                      ; Amount of pages in current WHS element
000817                    M2M$WHS_WELCOME             .EQU 0x0000                      ; WHS array element: Welcome page
000818                    M2M$WHS_HELP_INDEX          .EQU 0x0001                      ; WHS array: Help pages start with index 1
000819                    M2M$WHS_HELP_NEXT           .EQU 0x0100                      ; WHS array element: Next help structure
000820                    M2M$WHS_PAGE_NEXT           .EQU 0x0001                      ; WHS array element: Next page / prev page
000821                    
000822                    ; M2M$CFG_OPTM_DIM: Addresses
000823                    
000824                    M2M$SHELL_O_DX              .EQU 0x7000                      ; Width of Help/Options menu
000825                    M2M$SHELL_O_DY              .EQU 0x7001                      ; Height of Help/Options menu
000826                    
000827                    ; M2M$CFG_GENERAL Addresses
000828                    
000829                    M2M$CFG_RP_COUNTER          .EQU 0x7001 ; keep reset for a "QNICE loop while"
000830                    M2M$CFG_RP_PAUSE            .EQU 0x7002                      ; pause core when any OSD opens
000831                    M2M$CFG_RP_WELCOME          .EQU 0x7003                      ; show the welcome screen in general
000832                    M2M$CFG_RP_WLCM_RST         .EQU 0x7004                      ; show welcome screen after reset
000833                    M2M$CFG_RP_KB_RST           .EQU 0x7005                      ; connect the keyboard at reset
000834                    M2M$CFG_RP_J1_RST           .EQU 0x7006                      ; connect the joystick 1 at reset
000835                    M2M$CFG_RP_J2_RST           .EQU 0x7007                      ; connect the joystick 2 at reset
000836                    M2M$CFG_RP_KB_OSD           .EQU 0x7008                      ; connect the keyboard at OSD
000837                    M2M$CFG_RP_J1_OSD           .EQU 0x7009                      ; connect the joystick 1 at OSD
000838                    M2M$CFG_RP_J2_OSD           .EQU 0x700A                      ; connect the joystick 2 at OSD
000839                    
000840                    M2M$CFG_ASCAL_USAGE         .EQU 0x700B                      ; firmware treatment of ascal mode
000841                    M2M$CFG_ASCAL_MODE          .EQU 0x700C                      ; hardcoded ascal mode, if applicable
000842                    
000843                    M2M$CFG_VD_AT_DELAY         .EQU 0x700D                      ; Anti-Thrashing delay (virtual drives)
000844                    M2M$CFG_VD_ITERSIZE         .EQU 0x700E                      ; Bytes that are saving per flushing-iter.
000845                    
000846                    M2M$CFG_SAVEOSDCFG          .EQU 0x700F                      ; Remember on-screen-menu settings
000847                    
000848                    ; M2M$CFG_ASCAL_USAGE modes
000849                    M2M$CFG_AUSE_CFG            .EQU 0x0000                      ; use ASCAL_MODE from config.vhd
000850                    M2M$CFG_AUSE_CUSTOM         .EQU 0x0001                      ; controlled via custom QNICE assembly
000851                    M2M$CFG_AUSE_AUTO           .EQU 0x0002                      ; auto-sync via M2M$CFG_ASCAL_USAGE
000852                    
000853                    ; ----------------------------------------------------------------------------
000854                    ; Virtual Drives Device for MiSTer "SD" interface (vdrives.vhd)
000855                    ; ----------------------------------------------------------------------------
000856                    
000857                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000858                    VD_NUM                      .EQU 0x7000                      ; amount of virtual drives
000859                    VD_DEVICE                   .EQU 0x7001                      ; address of the vdrives.vhd device
000860                    VD_RAM_BUFFERS              .EQU 0x7100                      ; array of RAM buffers to store dsk images
000861                    VD_BUF_SDDIRECT             .EQU 0xAAAA ; "buffer" value: no RAM buffer, the image
000862                                                ; stays on the SD card and blocks are
000863                                                ; transferred on request (see shell.asm)
000864                    
000865                    ; window selectors for vdrives.vhd
000866                    VD_WIN_CAD                  .EQU 0x0000                      ; control and data registers
000867                    VD_WIN_DRV                  .EQU 0x0001                      ; drive 0, next window = drive 1, ...
000868                    
000869                    ; VD_WIN_CAD: control and data registers
000870                    VD_IMG_MOUNT                .EQU 0x7000                      ; image mounted, lowest bit = drive 0
000871                    VD_RO                       .EQU 0x7001                      ; read-only for currently mounted drive
000872                    VD_SIZE_L                   .EQU 0x7002                      ; image file size, low word
000873                    VD_SIZE_H                   .EQU 0x7003                      ; image file size, high word
000874                    VD_TYPE                     .EQU 0x7004                      ; image file type (2-bit value)
000875                    VD_B_ADDR                   .EQU 0x7005                      ; drive buffer: address
000876                    VD_B_DOUT                   .EQU 0x7006                      ; drive buffer: data out (to drive)
000877                    VD_B_WREN                   .EQU 0x7007                      ; drive buffer: write enable (also needs ack)
000878                    VD_VDNUM                    .EQU 0x7008                      ; number of virtual drives
000879                    VD_BLKSZ                    .EQU 0x7009                      ; block size for LBA in bytes
000880                    VD_DRV_MOUNT                .EQU 0x700A                      ; drive mounted, lowest bit = drive 0
000881                    
000882                    ; VD_WIN_DRV (and onwards): virtual drive specific registers
000883                    VD_LBA_L                    .EQU 0x7000                      ; SD LBA low word
000884                    VD_LBA_H                    .EQU 0x7001                      ; SD LBA high word
000885                    VD_BLKCNT                   .EQU 0x7002                      ; SD block count
000886                    VD_BYTES_L                  .EQU 0x7003                      ; SD block address in bytes: low word
000887                    VD_BYTES_H                  .EQU 0x7004                      ; SD block address in bytes: high word
000888                    VD_SIZEB                    .EQU 0x7005                      ; SD block data amount in bytes
000889                    VD_4K_WIN                   .EQU 0x7006                      ; SD block address in 4k win logic: window
000890                    VD_4K_OFFS                  .EQU 0x7007                      ; SD block address in 4k win logic: offset
000891                    VD_RD                       .EQU 0x7008                      ; SD read request
000892                    VD_WR                       .EQU 0x7009                      ; SD write request
000893                    VD_ACK                      .EQU 0x700A                      ; SD acknowledge
000894                    VD_B_DIN                    .EQU 0x700B                      ; drive buffer: data in (from drive)
000895                    VD_CACHE_DIRTY              .EQU 0x700C                      ; cache dirty flag
000896                    VD_CACHE_FLUSHING           .EQU 0x700D                      ; cache flushing flag
000897                    VD_CACHE_FLUSH_ST           .EQU 0x700E                      ; cache flushing can start now
000898                    VD_CACHE_FLUSH_DE           .EQU 0x700F                      ; delay in ms between VD_WR and FLUSH_ST
000899                    
000900                    ; ----------------------------------------------------------------------------
000901                    ; Automatically and manually loadable cartridges and ROMs
000902                    ; ----------------------------------------------------------------------------
000903                    
000904                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000905                    CRTROM_MAN_NUM_A            .EQU 0x7000                      ; amount of manually loadable CRTs/ROMs
000906                    CRTROM_AUT_NUM_A            .EQU 0x7001                      ; amount of automatically loadable ROMs
000907                    CRTROM_MAN_BUFFERS          .EQU 0x7100                      ; array of records: manually loadable
000908                    CRTROM_AUT_BUFFERS          .EQU 0x7200                      ; array of records: automatically loadable
000909                    CRTROM_AUT_FILES            .EQU 0x7300                      ; auto-load filesnames
000910                    
000911                    ; Type of byte streaming device for receiving the CRT/ROM data
000912                    CRTROM_TYPE_DEVICE          .EQU 0x0000                      ; any QNICE compatible device
000913                    CRTROM_TYPE_HYPRAM          .EQU 0x0001                      ; HyperRAM
000914                    CRTROM_TYPE_SDRAM           .EQU 0x0002                      ; @TODO/RESERVED for future R4 boards
000915                    CRTROM_TYPE_MNDTRY          .EQU 0x0003                      ; mandatory ROM
000916                    CTRROM_TYPE_OPTNL           .EQU 0x0004                      ; optional ROM
000917                    
000918                    ; Control and status registers of a CRT/ROM device
000919                    CRTROM_CSR_4KWIN            .EQU 0xFFFF                      ; 4K window in the device addr. space
000920                    
000921                    CRTROM_CSR_STATUS           .EQU 0x7000                      ; QNICE to device: load status (see below)
000922                    CRTROM_CSR_FS_LO            .EQU 0x7001                      ; filesize of CRT/ROM: low word
000923                    CRTROM_CSR_FS_HI            .EQU 0x7002                      ; filesize of CRT/ROM: high word
000924                    CRTROM_CSR_PARSEST          .EQU 0x7010                      ; device to QNICE: parse status
000925                    CRTROM_CSR_PARSEE1          .EQU 0x7011                      ; device to QNICE: error code
000926                    CRTROM_CSR_ADDR_LO          .EQU 0x7012                      ; device to QNICE: load address low word
000927                    CRTROM_CSR_ADDR_HI          .EQU 0x7013                      ; device to QNICE: load address high word
000928                    CRTROM_CSR_ERR_STRT         .EQU 0x7100                      ; device to QNICE: status string
000929                    
000930                    ; QNICE to device: CRT/ROM load status
000931                    CRTROM_CSR_ST_IDLE          .EQU 0x0000                      ; device is initialized, no loading
000932                    CRTROM_CSR_ST_LDNG          .EQU 0x0001                      ; loading takes place
000933                    CRTROM_CSR_ST_ERR           .EQU 0x0002                      ; loading failed
000934                    CRTROM_CSR_ST_OK            .EQU 0x0003                      ; loading successful
000935                    
000936                    ; Device to QNICE: Parsing status
000937                    CRTROM_CSR_PT_IDLE          .EQU 0x0000                      ; parser is idle
000938                    CRTROM_CSR_PT_PRSNG         .EQU 0x0001                      ; parser is parsing
000939                    CRTROM_CSR_PT_OK            .EQU 0x0002                      ; parsing successful
000940                    CRTROM_CSR_PT_ERR           .EQU 0x0003                      ; parsing error
000941                    
000942                    ; ----------------------------------------------------------------------------
000943                    ; Situation and context identifiers for custom messages
000944                    ; ----------------------------------------------------------------------------
000945                    
000946                    CTX_MASK_CTX                .EQU 0xFF00                      ; used to mask out the lower byte
000947                    CTX_MASK_PARAM              .EQU 0x00FF                      ; used to mask out the higher byte
000948                    
000949                    ; Trying to mount a disk or a rom image. The lower byte contains the
000950                    ; core-specific disk or rom image type and core specific code can use this
000951                    ; to filter for the right types and to output context-sensitive messages
000952                    CTX_MOUNT_DISKIMG           .EQU 0x0100                      ; trying to mount a disk image
000953                    CTX_LOAD_ROM                .EQU 0x0200                      ; trying to mount a rom image
000954                    
000955                    ; The filter function returned an empty linked list. This happens when there
000956                    ; is no file that fits the criteria in the root folder and additionally the
000957                    ; root folder has no sub-directory
000958                    CMSG_BROWSENOTHING          .EQU 0x0001
000959                                                .ORG 0x8000
000960  8000  0FB4  FEE0                              MOVE 0xFEE0, R13
000961  8002  0FA0  855C                              MOVE HANDLE_DEV, R8
000962  8004  0FA4  0001                              MOVE 1, R9
000963  8006  FF90  0044                              ASUB f32_mnt_sd, 1
000964  8008  0FA0  855C                              MOVE HANDLE_DEV, R8
000965  800A  0FA4  8543                              MOVE HANDLE_FILE, R9
000966  800C  0FA8  854F                              MOVE STR_FILE, R10
000967  800E  BB2C                                    XOR R11, R11
000968  800F  FF90  0050                              ASUB f32_fopen, 1
000969                    
000970  8011  0F88  00AB                              MOVE 0x00AB, R2                  ; R2: target device
000971  8013  B30C                                    XOR R3, R3                       ; R3: target 4k window
000972  8014  0F90  7000                              MOVE M2M$RAMROM_DATA, R4         ; R4: next 4k win indicator
000973  8016  1F90  1000                              ADD 0x1000, R4
000974  8018  0F94  7000                              MOVE M2M$RAMROM_DATA, R5         ; R5: target address
000975                    
000976  801A  0F84  A000                              MOVE MODE, R1
000977  801C  0144                                    MOVE @R1, R1
000978  801D  CF84  0000                              CMP 0, R1
000979  801F  FFA3  002F                              RBRA _DONE, Z
000980  8021  CF84  0001                              CMP 1, R1
000981  8023  FFA3  0013                              RBRA _OLD, Z
000982                    
000983                                                ; ---- the new path
000984  8025  0FA0  8543                              MOVE HANDLE_FILE, R8
000985  8027  0FA4  85F9                              MOVE SDB_RM_MAP, R9
000986  8029  FFB0  01EB                              RSUB SDB_MAP_BUILD, 1
000987  802B  0FA0  8543                              MOVE HANDLE_FILE, R8
000988  802D  0FA4  85F9                              MOVE SDB_RM_MAP, R9
000989  802F  0228                                    MOVE R2, R10
000990  8030  032C                                    MOVE R3, R11
000991  8031  0530                                    MOVE R5, R12
000992  8032  FFB0  046D                              RSUB SDB_FREAD_FAST, 1
000993  8034  FFAA  0002                              RBRA _OLD, !C
000994  8036  0B0C                                    MOVE R11, R3
000995  8037  0C14                                    MOVE R12, R5
000996                    
000997                                                ; ---- the byte loop, verbatim from crts-and-roms.asm
000998  8038  0FA0  8543  _OLD                        MOVE HANDLE_FILE, R8
000999  803A  FF90  0052                              ASUB f32_fread, 1
001000  803C  CFA8  EEEE                              CMP FAT32$EOF, R10
001001  803E  FFA3  0010                              RBRA _DONE, Z
001002  8040  0FA0  FFF4                              MOVE M2M$RAMROM_DEV, R8
001003  8042  0221                                    MOVE R2, @R8
001004  8043  0FA0  FFF5                              MOVE M2M$RAMROM_4KWIN, R8
001005  8045  0321                                    MOVE R3, @R8
001006  8046  0916                                    MOVE R9, @R5++
001007  8047  C414                                    CMP R4, R5
001008  8048  FFAB  FFEE                              RBRA _OLD, !Z
001009  804A  0F94  7000                              MOVE M2M$RAMROM_DATA, R5
001010  804C  1F8C  0001                              ADD 1, R3
001011  804E  FFA0  FFE8                              RBRA _OLD, 1
001012                    
001013  8050  E000        _DONE                       HALT
001014                    
001015                    ; ****************************************************************************
001016                    ; MiSTer2MEGA65 (M2M) QNICE ROM
001017                    ;
001018                    ; sdblock.asm: direct 512-byte block access to files on the SD card
001019                    ;
001020                    ; The FAT32 library of the QNICE Monitor only offers a byte-wise API
001021                    ; (f32_fread / f32_fwrite). Every single byte revalidates the cluster and the
001022                    ; sector of the file handle, which costs about 107 instructions per byte, and
001023                    ; f32_fseek walks the cluster chain from the start of the file, which makes a
001024                    ; random access at the far end of a 42 MB image cost seconds.
001025                    ;
001026                    ; This module resolves the on-disk layout of a file *once* into a compact
001027                    ; extent table and can then map "block N of the file" to an absolute SD card
001028                    ; LBA. A block is then one SD$READ_BLOCK plus a tight copy loop out of the
001029                    ; 512-byte buffer of the SD controller.
001030                    ;
001031                    ; ----------------------------------------------------------------------------
001032                    ; THE TWO RULES
001033                    ; ----------------------------------------------------------------------------
001034                    ;
001035                    ; (1) The FAT32 library must never be able to tell that we were here.
001036                    ;
001037                    ; The 512-byte "sector buffer" of the FAT32 library IS the 512-byte
001038                    ; hardware buffer of the SD controller; the device handle only remembers
001039                    ; *which* file handle filled it (FAT32$DEV_BUFFERED_FDH). Every direct
001040                    ; access destroys the library's buffer while the library still believes
001041                    ; it holds a particular sector.
001042                    ;
001043                    ; Earlier versions of this file solved that by pointing
001044                    ; FAT32$DEV_BUFFERED_FDH at a dummy handle, i.e. by reaching into the
001045                    ; library's bookkeeping. That is not done any more. Instead:
001046                    ;
001047                    ; * SDB_GUARD_IN works out, *before* anything is touched, which sector
001048                    ; the library believes is in the buffer and whether that sector can
001049                    ; be read back. If it cannot, the fast path is refused and nothing
001050                    ; is touched at all.
001051                    ; * a dirty buffer is written back through the library first.
001052                    ; * SDB_GUARD_OUT reads that very sector back, so the buffer holds
001053                    ; exactly what it held before.
001054                    ; * SDB_FREAD_FAST, which moves the file position anyway, restores the
001055                    ; library state the library's own way: with an f32_fseek, which
001056                    ; unconditionally re-reads the sector and re-claims ownership.
001057                    ;
001058                    ; The one remaining poke, SDB_ORPHAN, exists only for the case where the
001059                    ; restoring read itself fails, i.e. where the card is already broken. It
001060                    ; is strictly better than leaving the library with a buffer that holds
001061                    ; something else than it thinks.
001062                    ;
001063                    ; (2) Any error anywhere leaves the caller with "nothing happened".
001064                    ;
001065                    ; Every entry point returns Carry=0 on any problem, and the byte-wise
001066                    ; FAT32 path then does all of the work exactly as it did before this
001067                    ; file existed. In particular:
001068                    ;
001069                    ; * an SD card error latches the controller into its error state (see
001070                    ; the IO$SD_CSR description in sysdef.asm: "you need to reset the
001071                    ; controller to go on"), which would make every *subsequent* library
001072                    ; access fail too. SDB_SDERR therefore issues SD$RESET after any
001073                    ; failed SD operation before we hand back control.
001074                    ; * SDB_FREAD_FAST never seeks to the end of the file. It always leaves
001075                    ; at least one whole block to the byte loop, so the file position it
001076                    ; hands over is strictly inside the file and the caller reaches EOF
001077                    ; through the library, the way it always did.
001078                    ; * every seek is verified against FAT32$FDH_ACCESS afterwards.
001079                    ;
001080                    ; ----------------------------------------------------------------------------
001081                    ; Serial logging
001082                    ; ----------------------------------------------------------------------------
001083                    ; To log what the fast path does to the serial console at boot (no keyboard
001084                    ; needed), remove the ";" in front of the #define below and rebuild the ROM
001085                    ; with CORE/m2m-rom/make_rom.sh. Put the ";" back to switch it off again.
001086                    ;
001087                    ;#define SDB_DEBUG
001088                    ;
001089                    ; This file needs the environment of shell.asm.
001090                    ;
001091                    ; done for the PCXT-EGA-MEGA65 port and licensed under GPL v3
001092                    ; ****************************************************************************
001093                    
001094                    ; ----------------------------------------------------------------------------
001095                    ; Layout of a block map (see SDB_VD_MAPS / SDB_RM_MAP in shell_vars.asm)
001096                    ; ----------------------------------------------------------------------------
001097                    
001098                    ; Maximum amount of extents (runs of physically consecutive clusters) that we
001099                    ; are willing to remember for one file. A freshly copied image file normally
001100                    ; is one single extent. Files that would need more extents than this fall
001101                    ; back to the FAT32 library path.
001102                    SDB_MAX_EXT                 .EQU 8
001103                    
001104                    SDB_M_NEXT                  .EQU 0                           ; amount of valid extents; 0 = no map
001105                    SDB_M_FDH                   .EQU 1                           ; FDH this map was built for
001106                    SDB_M_TBLK_LO               .EQU 2                           ; amount of *whole* 512-byte blocks..
001107                    SDB_M_TBLK_HI               .EQU 3                           ; ..in the file (filesize / 512)
001108                    SDB_M_BAIL                  .EQU 4                           ; why there is no map (SDB_B_*)
001109                    SDB_M_EXT                   .EQU 5                           ; start of the extent array
001110                    
001111                    ; one extent: amount of blocks (lo/hi) and the absolute SD card LBA (lo/hi)
001112                    ; of the first of them
001113                    SDB_E_NBLK_LO               .EQU 0
001114                    SDB_E_NBLK_HI               .EQU 1
001115                    SDB_E_LBA_LO                .EQU 2
001116                    SDB_E_LBA_HI                .EQU 3
001117                    SDB_E_SIZE                  .EQU 4
001118                    
001119                    ; size of one map in words: SDB_M_EXT + SDB_E_SIZE * SDB_MAX_EXT = 5 + 4*8
001120                    ; = 37, rounded up to 40 to leave room
001121                    SDB_M_SIZE                  .EQU 40
001122                    
001123                    ; Amount of virtual drives that SDB_VD_MAPS in shell_vars.asm has room for.
001124                    ; The QNICE assembler cannot evaluate expressions in .BLOCK, so the size of
001125                    ; SDB_VD_MAPS is the literal SDB_M_SIZE * SDB_VD_MAX_N and both have to be
001126                    ; kept in sync by hand. Virtual drives beyond SDB_VD_MAX_N are not broken,
001127                    ; they just always use the (slow) FAT32 library path.
001128                    SDB_VD_MAX_N                .EQU 3
001129                    
001130                    ; Why a map could not be built. Logged, and also readable from SDB_M_BAIL.
001131                    SDB_B_OK                    .EQU 0
001132                    SDB_B_NOMAP                 .EQU 1                           ; no map slot for this drive
001133                    SDB_B_NODEV                 .EQU 2                           ; file handle has no device handle
001134                    SDB_B_NOSPC                 .EQU 3                           ; sectors per cluster is zero
001135                    SDB_B_EMPTY                 .EQU 4                           ; file is shorter than one block
001136                    SDB_B_BADSTART              .EQU 5                           ; start cluster < 2
001137                    SDB_B_FRAG                  .EQU 6                           ; more extents than SDB_MAX_EXT
001138                    SDB_B_FATERR                .EQU 7                           ; could not read a FAT sector
001139                    SDB_B_BADCLUS               .EQU 8                           ; illegal cluster in the chain
001140                    SDB_B_SHORT                 .EQU 9                           ; chain ends before the file does
001141                    SDB_B_LBA                   .EQU 10                          ; LBA arithmetic out of range
001142                    SDB_B_GUARD                 .EQU 11                          ; buffer could not be made restorable
001143                    SDB_B_SEEK                  .EQU 12                          ; restoring seek failed
001144                    
001145                    ; end-of-chain marker: everything >= 0x0FFFFFF8 terminates a FAT32 chain,
001146                    ; and everything >= 0x0FFFFFF0 is reserved, so refuse all of it
001147                    SDB_EOC_HI                  .EQU 0x0FFF
001148                    SDB_EOC_LO                  .EQU 0xFFF0
001149                    
001150                    ; ----------------------------------------------------------------------------
001151                    ; Housekeeping
001152                    ; ----------------------------------------------------------------------------
001153                    
001154                    ; SDB_INVAL_ALL
001155                    ; Invalidates all block maps, i.e. everything falls back to the FAT32 library
001156                    ; until the maps are rebuilt. Called from VD_INIT and whenever the SD card
001157                    ; changes. Also clears the two zero-filled helper structures, because the
001158                    ; variables live in uninitialized RAM.
001159                    ;
001160                    ; Input: none
001161                    ; Output: none, all registers unchanged
001162  8051  E0C0        SDB_INVAL_ALL               INCRB
001163  8052  0F80  8581                              MOVE SDB_VD_MAPS, R0
001164  8054  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001165  8056  0F81  0000  _SDBIA_L                    MOVE 0, @R0
001166  8058  1F80  0028                              ADD SDB_M_SIZE, R0
001167  805A  3F84  0001                              SUB 1, R1
001168  805C  FFAB  FFF8                              RBRA _SDBIA_L, !Z
001169  805E  0F80  85F9                              MOVE SDB_RM_MAP, R0
001170  8060  0F81  0000                              MOVE 0, @R0
001171  8062  0F80  8621                              MOVE SDB_NULL_MAP, R0
001172  8064  0F81  0000                              MOVE 0, @R0
001173  8066  0F80  8630                              MOVE SDB_G_VAL, R0
001174  8068  0F81  0000                              MOVE 0, @R0
001175                    
001176                                                ; SDB_DUMMY_FDH must read as an all-zero, and therefore never
001177                                                ; dirty, file handle: SDB_ORPHAN hands it to FAT32$FLUSH
001178  806A  0F80  8622                              MOVE SDB_DUMMY_FDH, R0
001179  806C  0F84  000C                              MOVE FAT32$FDH_STRUCT_SIZE, R1
001180  806E  0F82  0000  _SDBIA_L2                   MOVE 0, @R0++
001181  8070  3F84  0001                              SUB 1, R1
001182  8072  FFAB  FFFA                              RBRA _SDBIA_L2, !Z
001183  8074  E100                                    DECRB
001184  8075  0DBC                                    MOVE @R13++, R15
001185                    
001186                    ; SDB_VDMAP
001187                    ; Returns the block map that belongs to a virtual drive. Drives that have no
001188                    ; map (see SDB_VD_MAX_N) get the permanently empty SDB_NULL_MAP, which makes
001189                    ; SDB_CHECK fail and therefore forces the FAT32 library path.
001190                    ;
001191                    ; Input: R8: virtual drive number
001192                    ; Output: R8: pointer to the block map
001193  8076  E0C0        SDB_VDMAP                   INCRB
001194  8077  0800                                    MOVE R8, R0
001195  8078  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001196  807A  C100                                    CMP R1, R0                       ; drive number < maximum?
001197  807B  FFA4  0004                              RBRA _SDBVM_OK, N                ; yes
001198  807D  0FA0  8621                              MOVE SDB_NULL_MAP, R8            ; no: never mapped
001199  807F  FFA0  000C                              RBRA _SDBVM_D, 1
001200  8081  0FA0  8581  _SDBVM_OK                   MOVE SDB_VD_MAPS, R8
001201  8083  CF80  0000  _SDBVM_L                    CMP 0, R0
001202  8085  FFA3  0006                              RBRA _SDBVM_D, Z
001203  8087  1FA0  0028                              ADD SDB_M_SIZE, R8
001204  8089  3F80  0001                              SUB 1, R0
001205  808B  FFA0  FFF6                              RBRA _SDBVM_L, 1
001206  808D  E100        _SDBVM_D                    DECRB
001207  808E  0DBC                                    MOVE @R13++, R15
001208                    
001209                    ; SDB_CHECK
001210                    ; Is the given map valid and does it belong to the given file handle?
001211                    ;
001212                    ; Input: R8: pointer to the block map
001213                    ; R9: file handle (FDH)
001214                    ; Output: Carry=1 if the map can be used, all registers unchanged
001215  808F  E0C0        SDB_CHECK                   INCRB
001216  8090  CFA1  0000                              CMP 0, @R8                       ; any extents?
001217  8092  FFA3  000A                              RBRA _SDBC_NO, Z                 ; no: unusable
001218  8094  0800                                    MOVE R8, R0
001219  8095  1F80  0001                              ADD SDB_M_FDH, R0
001220  8097  C064                                    CMP @R0, R9                      ; built for this file handle?
001221  8098  FFAB  0004                              RBRA _SDBC_NO, !Z                ; no: unusable
001222  809A  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001223  809C  FFA0  0002                              RBRA _SDBC_R, 1
001224  809E  9FB8  FFFB  _SDBC_NO                    AND 0xFFFB, R14                  ; clear Carry
001225  80A0  E100        _SDBC_R                     DECRB
001226  80A1  0DBC                                    MOVE @R13++, R15
001227                    
001228                    ; SDB_SDERR
001229                    ; Called after a failed SD card operation. The controller latches its error
001230                    ; state and refuses everything until it is reset, which would turn our
001231                    ; problem into a fatal error in the *next* FAT32 library call. Reset it, so
001232                    ; that the fallback path starts from a clean controller.
001233                    ;
001234                    ; Input: R8: the error code (only used for logging)
001235                    ; Output: none, R8 unchanged
001236  80A2  E0C0        SDB_SDERR                   INCRB
001237  80A3  0800                                    MOVE R8, R0
001238                    
001239                    
001240                    
001241                    
001242                    
001243                    
001244                    
001245  80A4  FF90  003A                              ASUB sd_reset, 1
001246  80A6  0020                                    MOVE R0, R8
001247  80A7  E100                                    DECRB
001248  80A8  0DBC                                    MOVE @R13++, R15
001249                    
001250                    ; ----------------------------------------------------------------------------
001251                    ; Guarding the FAT32 library's sector buffer
001252                    ; ----------------------------------------------------------------------------
001253                    
001254                    ; SDB_GUARD_IN
001255                    ; Prepares for direct SD card access. Works out which sector the FAT32
001256                    ; library believes the hardware buffer holds and remembers its LBA so that
001257                    ; SDB_GUARD_OUT can put it back, and writes the buffer back first if it is
001258                    ; dirty. Refuses (Carry=0) without touching anything if the sector cannot be
001259                    ; identified or the write-back fails.
001260                    ;
001261                    ; Input: none
001262                    ; Output: Carry=1: direct access is allowed
001263                    ; Carry=0: do not touch the SD card, nothing has been touched
001264                    ; all registers unchanged
001265  80A9  FF90  005E  SDB_GUARD_IN                ASUB enter, 1
001266                    
001267  80AB  0FA0  8630                              MOVE SDB_G_VAL, R8               ; nothing to restore yet
001268  80AD  0FA1  0000                              MOVE 0, @R8
001269                    
001270  80AF  0FA0  855C                              MOVE HANDLE_DEV, R8              ; who claims the buffer?
001271  80B1  FFB0  003D                              RSUB _SDB_OWNER, 1
001272  80B3  FFA2  0008                              RBRA _SDBGI_HAVE, C
001273  80B5  0FA0  856E                              MOVE CONFIG_DEVH, R8
001274  80B7  FFB0  0037                              RSUB _SDB_OWNER, 1
001275  80B9  FFA2  0002                              RBRA _SDBGI_HAVE, C
001276  80BB  FFA0  002A                              RBRA _SDBGI_OK, 1                ; nobody: nothing to restore
001277                    
001278                                                ; R8: device handle, R9: owning FDH
001279  80BD  0800        _SDBGI_HAVE                 MOVE R8, R0
001280  80BE  0904                                    MOVE R9, R1
001281                    
001282  80BF  0120                                    MOVE R1, R8                      ; dirty? then write it back
001283  80C0  1FA0  000B                              ADD FAT32$FDH_FLAGS, R8
001284  80C2  0860                                    MOVE @R8, R8
001285  80C3  9FA0  0001                              AND FAT32$FDHF_DIRTY, R8
001286  80C5  FFA3  0007                              RBRA _SDBGI_CLEAN, Z
001287  80C7  0120                                    MOVE R1, R8
001288  80C8  FF90  0068                              ASUB f32_fflush, 1
001289  80CA  CFA4  0000                              CMP 0, R9
001290  80CC  FFAB  001D                              RBRA _SDBGI_NO, !Z               ; cannot write back: refuse
001291                    
001292                                                ; which sector does the library think it is holding?
001293  80CE  0120        _SDBGI_CLEAN                MOVE R1, R8
001294  80CF  1FA0  0001                              ADD FAT32$FDH_CLUSTER_LO, R8
001295  80D1  0864                                    MOVE @R8, R9
001296  80D2  0120                                    MOVE R1, R8
001297  80D3  1FA0  0002                              ADD FAT32$FDH_CLUSTER_HI, R8
001298  80D5  0868                                    MOVE @R8, R10
001299  80D6  0120                                    MOVE R1, R8
001300  80D7  1FA0  0003                              ADD FAT32$FDH_SECTOR, R8
001301  80D9  086C                                    MOVE @R8, R11
001302  80DA  0020                                    MOVE R0, R8
001303  80DB  FFB0  0089                              RSUB SDB_CLULBA, 1
001304  80DD  FFAA  000C                              RBRA _SDBGI_NO, !C               ; cannot be restored: refuse
001305                    
001306  80DF  0FA0  862E                              MOVE SDB_G_LBA, R8
001307  80E1  0922                                    MOVE R9, @R8++
001308  80E2  0A21                                    MOVE R10, @R8
001309  80E3  0FA0  8630                              MOVE SDB_G_VAL, R8
001310  80E5  0FA1  0001                              MOVE 1, @R8
001311                    
001312  80E7  AFB8  0004  _SDBGI_OK                   OR 0x0004, R14                   ; set Carry
001313  80E9  FFA0  0002                              RBRA _SDBGI_RET, 1
001314  80EB  9FB8  FFFB  _SDBGI_NO                   AND 0xFFFB, R14                  ; clear Carry
001315  80ED  FF90  0060  _SDBGI_RET                  ASUB leave, 1
001316  80EF  0DBC                                    MOVE @R13++, R15
001317                    
001318                    ; Input: R8: device handle
001319                    ; Output: Carry=1 and R9 = the FDH that claims the buffer, R8 unchanged
001320  80F0  E0C0        _SDB_OWNER                  INCRB
001321  80F1  CFA1  0000                              CMP 0, @R8                       ; device handle initialized?
001322  80F3  FFA3  000A                              RBRA _SDB_OWN_NO, Z
001323  80F5  0800                                    MOVE R8, R0
001324  80F6  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001325  80F8  0064                                    MOVE @R0, R9
001326  80F9  FFA3  0004                              RBRA _SDB_OWN_NO, Z              ; nobody claims it
001327  80FB  AFB8  0004                              OR 0x0004, R14
001328  80FD  FFA0  0002                              RBRA _SDB_OWN_R, 1
001329  80FF  9FB8  FFFB  _SDB_OWN_NO                 AND 0xFFFB, R14
001330  8101  E100        _SDB_OWN_R                  DECRB
001331  8102  0DBC                                    MOVE @R13++, R15
001332                    
001333                    ; SDB_GUARD_OUT
001334                    ; Puts the hardware buffer back to the sector SDB_GUARD_IN identified, so
001335                    ; that the FAT32 library finds exactly what it left behind.
001336                    ;
001337                    ; Input: none
001338                    ; Output: none, all registers unchanged
001339  8103  FF90  005E  SDB_GUARD_OUT               ASUB enter, 1
001340  8105  0FA0  8630                              MOVE SDB_G_VAL, R8
001341  8107  CFA1  0000                              CMP 0, @R8
001342  8109  FFA3  0018                              RBRA _SDBGO_RET, Z               ; nothing to restore
001343                    
001344  810B  0FA0  862E                              MOVE SDB_G_LBA, R8
001345  810D  08A8                                    MOVE @R8++, R10
001346  810E  086C                                    MOVE @R8, R11
001347  810F  0A20                                    MOVE R10, R8
001348  8110  0B24                                    MOVE R11, R9
001349  8111  FF90  003C                              ASUB sd_r_block, 1
001350  8113  CFA0  0000                              CMP 0, R8
001351  8115  FFA3  000C                              RBRA _SDBGO_RET, Z               ; restored
001352                    
001353                                                ; the restoring read failed, so the card is already broken.
001354                                                ; Reset the controller, try once more, and if that fails too
001355                                                ; make sure the library re-reads instead of trusting a buffer
001356                                                ; that now holds something else than it believes.
001357  8117  FFB0  FF89                              RSUB SDB_SDERR, 1
001358  8119  0A20                                    MOVE R10, R8
001359  811A  0B24                                    MOVE R11, R9
001360  811B  FF90  003C                              ASUB sd_r_block, 1
001361  811D  CFA0  0000                              CMP 0, R8
001362  811F  FFA3  0002                              RBRA _SDBGO_RET, Z
001363  8121  FFB0  0003                              RSUB SDB_ORPHAN, 1
001364  8123  FF90  0060  _SDBGO_RET                  ASUB leave, 1
001365  8125  0DBC                                    MOVE @R13++, R15
001366                    
001367                    ; SDB_ORPHAN
001368                    ; Last resort, only used when the hardware buffer could not be restored: tell
001369                    ; both device handles that the buffer contents are unknown, so that the
001370                    ; library re-reads rather than serving something stale.
001371                    ;
001372                    ; "Unknown" is expressed by handing the buffer to SDB_DUMMY_FDH, an all-zero
001373                    ; and therefore never dirty file handle, and not by the obvious 0: FAT32$FLUSH
001374                    ; returns immediately when called with R8 = 0 and then leaves R9 - its error
001375                    ; code - untouched, and FAT32$FILE_SEEK checks that stale R9 right after
001376                    ; calling it, so a seek would silently do nothing.
001377                    ;
001378                    ; Input: none
001379                    ; Output: none, all registers unchanged
001380  8126  FF90  005E  SDB_ORPHAN                  ASUB enter, 1
001381                    
001382                    
001383                    
001384                    
001385                    
001386  8128  0FA0  855C                              MOVE HANDLE_DEV, R8
001387  812A  FFB0  0007                              RSUB _SDB_ORPH1, 1
001388  812C  0FA0  856E                              MOVE CONFIG_DEVH, R8
001389  812E  FFB0  0003                              RSUB _SDB_ORPH1, 1
001390  8130  FF90  0060                              ASUB leave, 1
001391  8132  0DBC                                    MOVE @R13++, R15
001392                    
001393  8133  E0C0        _SDB_ORPH1                  INCRB
001394  8134  0804                                    MOVE R8, R1
001395  8135  CFA1  0000                              CMP 0, @R8
001396  8137  FFA3  0006                              RBRA _SDB_ORPH_R, Z
001397  8139  0800                                    MOVE R8, R0
001398  813A  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001399  813C  0F88  8622                              MOVE SDB_DUMMY_FDH, R2
001400  813E  0201                                    MOVE R2, @R0
001401  813F  0120        _SDB_ORPH_R                 MOVE R1, R8
001402  8140  E100                                    DECRB
001403  8141  0DBC                                    MOVE @R13++, R15
001404                    
001405                    ; ----------------------------------------------------------------------------
001406                    ; 32-bit helpers
001407                    ; ----------------------------------------------------------------------------
001408                    
001409                    ; SDB_B2BLK
001410                    ; Converts a byte position into a 512-byte block index (unsigned 32 bit).
001411                    ;
001412                    ; Input: R9/R10: byte position lo/hi
001413                    ; Output: R9/R10: block index lo/hi
001414  8142  E0C0        SDB_B2BLK                   INCRB
001415  8143  0A00                                    MOVE R10, R0
001416  8144  9F80  01FF                              AND 0x01FF, R0                   ; bits that move down into..
001417  8146  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the low word; clear X so..
001418  8148  5F80  0007                              SHL 7, R0                        ; ..SHL shifts in zeros
001419  814A  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001420  814C  6FA4  0009                              SHR 9, R9
001421  814E  1024                                    ADD R0, R9
001422  814F  9FB8  FFFB                              AND 0xFFFB, R14
001423  8151  6FA8  0009                              SHR 9, R10
001424  8153  E100                                    DECRB
001425  8154  0DBC                                    MOVE @R13++, R15
001426                    
001427                    ; SDB_BLK2B
001428                    ; Converts a 512-byte block index into a byte position (unsigned 32 bit).
001429                    ;
001430                    ; Input: R9/R10: block index lo/hi
001431                    ; Output: R9/R10: byte position lo/hi
001432  8155  E0C0        SDB_BLK2B                   INCRB
001433  8156  0900                                    MOVE R9, R0
001434  8157  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001435  8159  6F80  0007                              SHR 7, R0                        ; bits that move up into..
001436  815B  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the high word; clear X
001437  815D  5FA8  0009                              SHL 9, R10
001438  815F  1028                                    ADD R0, R10
001439  8160  9FB8  FFFD                              AND 0xFFFD, R14
001440  8162  5FA4  0009                              SHL 9, R9
001441  8164  E100                                    DECRB
001442  8165  0DBC                                    MOVE @R13++, R15
001443                    
001444                    ; SDB_CLULBA
001445                    ; The absolute SD card LBA of one sector within one cluster, i.e. exactly
001446                    ; what FAT32$RW_SIC computes, with every range check spelled out.
001447                    ;
001448                    ; Input: R8: device handle
001449                    ; R9/R10: cluster lo/hi
001450                    ; R11: sector within the cluster
001451                    ; Output: Carry=1: R9/R10 = LBA lo/hi
001452                    ; Carry=0: the cluster or the sector is out of range
001453                    ; R8, R11 unchanged
001454  8166  E0C0        SDB_CLULBA                  INCRB
001455  8167  0800                                    MOVE R8, R0                      ; R0: device handle
001456  8168  0B04                                    MOVE R11, R1                     ; R1: sector
001457                    
001458  8169  CFA8  0000                              CMP 0, R10                       ; cluster >= 2?
001459  816B  FFAB  0006                              RBRA _SDBCL_C1, !Z
001460  816D  CFA4  0001                              CMP 1, R9
001461  816F  FFA4  0044                              RBRA _SDBCL_NO, N                ; cluster = 0
001462  8171  FFA3  0042                              RBRA _SDBCL_NO, Z                ; cluster = 1
001463  8173  CFA8  0FFF  _SDBCL_C1                   CMP SDB_EOC_HI, R10              ; cluster < 0x0FFFFFF0?
001464  8175  FFAB  0006                              RBRA _SDBCL_C2, !Z
001465  8177  C93E  FFF0                              CMP R9, SDB_EOC_LO
001466  8179  FFA4  003A                              RBRA _SDBCL_NO, N
001467  817B  FFA3  0038                              RBRA _SDBCL_NO, Z
001468  817D  CA3E  0FFF  _SDBCL_C2                   CMP R10, 0x0FFF                  ; and inside 28 bits at all?
001469  817F  FFA4  0034                              RBRA _SDBCL_NO, N
001470                    
001471  8181  0008                                    MOVE R0, R2                      ; R2: sectors per cluster
001472  8182  1F88  000C                              ADD FAT32$DEV_SECT_PER_CLUS, R2
001473  8184  0248                                    MOVE @R2, R2
001474  8185  FFA3  002E                              RBRA _SDBCL_NO, Z
001475  8187  020C                                    MOVE R2, R3
001476  8188  3F8C  0001                              SUB 1, R3
001477  818A  C10C                                    CMP R1, R3                       ; sector inside the cluster?
001478  818B  FFA4  0028                              RBRA _SDBCL_NO, N
001479                    
001480  818D  0920                                    MOVE R9, R8                      ; (cluster - 2) * spc
001481  818E  0A24                                    MOVE R10, R9
001482  818F  3FA0  0002                              SUB 2, R8
001483  8191  4FA4  0000                              SUBC 0, R9
001484  8193  0228                                    MOVE R2, R10
001485  8194  BB2C                                    XOR R11, R11
001486  8195  FF90  0032                              ASUB mulu32, 1                   ; R11|R10|R9|R8 = 64 bit
001487  8197  CFA8  0000                              CMP 0, R10                       ; more than 32 bits?
001488  8199  FFAB  001A                              RBRA _SDBCL_NO, !Z
001489  819B  CFAC  0000                              CMP 0, R11
001490  819D  FFAB  0016                              RBRA _SDBCL_NO, !Z
001491                    
001492  819F  002C                                    MOVE R0, R11                     ; plus cluster_begin_lba
001493  81A0  1FAC  000A                              ADD FAT32$DEV_CLUSTER_LO, R11
001494  81A2  0BA8                                    MOVE @R11++, R10
001495  81A3  0B6C                                    MOVE @R11, R11
001496  81A4  1A20                                    ADD R10, R8
001497  81A5  2B24                                    ADDC R11, R9
001498  81A6  FFA2  000D                              RBRA _SDBCL_NO, C                ; 32-bit overflow
001499  81A8  1120                                    ADD R1, R8                       ; plus the sector
001500  81A9  2FA4  0000                              ADDC 0, R9
001501  81AB  FFA2  0008                              RBRA _SDBCL_NO, C
001502                    
001503  81AD  0928                                    MOVE R9, R10                     ; return the LBA in R9/R10
001504  81AE  0824                                    MOVE R8, R9
001505  81AF  0020                                    MOVE R0, R8
001506  81B0  012C                                    MOVE R1, R11
001507  81B1  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001508  81B3  FFA0  0004                              RBRA _SDBCL_RET, 1
001509  81B5  0020        _SDBCL_NO                   MOVE R0, R8
001510  81B6  012C                                    MOVE R1, R11
001511  81B7  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
001512  81B9  E100        _SDBCL_RET                  DECRB
001513  81BA  0DBC                                    MOVE @R13++, R15
001514                    
001515                    ; SDB_LBA
001516                    ; Maps a block index within the file to an absolute SD card LBA.
001517                    ;
001518                    ; Input: R8: pointer to the block map
001519                    ; R9/R10: block index lo/hi
001520                    ; Output: Carry=1: R9/R10 = LBA lo/hi
001521                    ; Carry=0: the block cannot be mapped (use the FAT32 library)
001522                    ; R8 unchanged
001523  81BB  E0C0        SDB_LBA                     INCRB
001524  81BC  0800                                    MOVE R8, R0                      ; R0: map
001525  81BD  0904                                    MOVE R9, R1                      ; R1/R2: remaining block idx
001526  81BE  0A08                                    MOVE R10, R2
001527  81BF  004C                                    MOVE @R0, R3                     ; R3: amount of extents
001528  81C0  FFA3  0037                              RBRA _SDBL_NO, Z
001529                    
001530                                                ; reject anything that is not completely inside the file
001531  81C2  0010                                    MOVE R0, R4
001532  81C3  1F90  0003                              ADD SDB_M_TBLK_HI, R4
001533  81C5  C211                                    CMP R2, @R4
001534  81C6  FFA4  0031                              RBRA _SDBL_NO, N                 ; idx_hi > total_hi
001535  81C8  FFAB  0008                              RBRA _SDBL_C1, !Z                ; idx_hi < total_hi: inside
001536  81CA  0010                                    MOVE R0, R4
001537  81CB  1F90  0002                              ADD SDB_M_TBLK_LO, R4
001538  81CD  C111                                    CMP R1, @R4
001539  81CE  FFA4  0029                              RBRA _SDBL_NO, N                 ; idx_lo > total_lo
001540  81D0  FFA3  0027                              RBRA _SDBL_NO, Z                 ; idx_lo = total_lo: outside
001541                    
001542  81D2  0010        _SDBL_C1                    MOVE R0, R4
001543  81D3  1F90  0005                              ADD SDB_M_EXT, R4                ; R4: current extent
001544  81D5  0454        _SDBL_LOOP                  MOVE @R4, R5                     ; R5/R6: blocks in extent
001545  81D6  0418                                    MOVE R4, R6
001546  81D7  1F98  0001                              ADD SDB_E_NBLK_HI, R6
001547  81D9  0658                                    MOVE @R6, R6
001548  81DA  C218                                    CMP R2, R6                       ; remainder < extent size?
001549  81DB  FFA4  0014                              RBRA _SDBL_NEXT, N               ; rem_hi > ext_hi: no
001550  81DD  FFAB  0005                              RBRA _SDBL_HIT, !Z               ; rem_hi < ext_hi: yes
001551  81DF  C114                                    CMP R1, R5
001552  81E0  FFA4  000F                              RBRA _SDBL_NEXT, N               ; rem_lo > ext_lo: no
001553  81E2  FFA3  000D                              RBRA _SDBL_NEXT, Z               ; rem_lo = ext_lo: no
001554                    
001555  81E4  0418        _SDBL_HIT                   MOVE R4, R6
001556  81E5  1F98  0002                              ADD SDB_E_LBA_LO, R6
001557  81E7  06A4                                    MOVE @R6++, R9                   ; R9/R10: LBA of the extent
001558  81E8  0668                                    MOVE @R6, R10
001559  81E9  1124                                    ADD R1, R9                       ; plus the remainder
001560  81EA  2228                                    ADDC R2, R10
001561  81EB  FFA2  000C                              RBRA _SDBL_NO, C                 ; 32-bit overflow
001562  81ED  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001563  81EF  FFA0  000A                              RBRA _SDBL_RET, 1
001564                    
001565  81F1  3504        _SDBL_NEXT                  SUB R5, R1                       ; remainder -= extent size
001566  81F2  4608                                    SUBC R6, R2
001567  81F3  1F90  0004                              ADD SDB_E_SIZE, R4               ; next extent
001568  81F5  3F8C  0001                              SUB 1, R3
001569  81F7  FFAB  FFDC                              RBRA _SDBL_LOOP, !Z
001570  81F9  9FB8  FFFB  _SDBL_NO                    AND 0xFFFB, R14                  ; clear Carry
001571  81FB  E100        _SDBL_RET                   DECRB
001572  81FC  0DBC                                    MOVE @R13++, R15
001573                    
001574                    ; Unsigned 32-bit "A >= B" for two little-endian word pairs in memory.
001575                    ; The answer is returned in the Carry flag and not in N/Z, because MOVE @R13++, R15 is
001576                    ; a MOVE (see sysdef.asm) and a MOVE overwrites N and Z but not the Carry.
001577                    ; Input: R8: pointer to A (lo, hi), R9: pointer to B (lo, hi)
001578                    ; Output: Carry=1 if A >= B, R8 and R9 unchanged
001579  81FD  E0C0        _SDB_GE32                   INCRB
001580  81FE  0800                                    MOVE R8, R0
001581  81FF  0904                                    MOVE R9, R1
001582  8200  1F80  0001                              ADD 1, R0
001583  8202  1F84  0001                              ADD 1, R1
001584  8204  C045                                    CMP @R0, @R1                     ; high words
001585  8205  FFA4  000B                              RBRA _SDB_G32Y, N                ; A_hi > B_hi
001586  8207  FFAB  0005                              RBRA _SDB_G32N, !Z               ; A_hi < B_hi
001587  8209  C865                                    CMP @R8, @R9                     ; low words
001588  820A  FFA4  0006                              RBRA _SDB_G32Y, N
001589  820C  FFA3  0004                              RBRA _SDB_G32Y, Z
001590  820E  9FB8  FFFB  _SDB_G32N                   AND 0xFFFB, R14                  ; clear Carry
001591  8210  FFA0  0002                              RBRA _SDB_G32R, 1
001592  8212  AFB8  0004  _SDB_G32Y                   OR 0x0004, R14                   ; set Carry
001593  8214  E100        _SDB_G32R                   DECRB
001594  8215  0DBC                                    MOVE @R13++, R15
001595                    
001596                    ; ----------------------------------------------------------------------------
001597                    ; Building the map
001598                    ; ----------------------------------------------------------------------------
001599                    
001600                    ; SDB_MAP_BUILD
001601                    ; Walks the FAT cluster chain of an open file once and stores the result as
001602                    ; an extent table, so that SDB_LBA can map blocks to LBAs afterwards. Costs
001603                    ; one SD card block read per 128 clusters of the file.
001604                    ;
001605                    ; Reads FAT sectors directly and therefore destroys the FAT32 library's
001606                    ; sector buffer, so it guards and restores it (see THE TWO RULES above). It
001607                    ; never modifies the file handle: the file position is the same afterwards.
001608                    ;
001609                    ; Input: R8: file handle (FDH)
001610                    ; R9: pointer to the block map to be filled
001611                    ; Output: none. The map is left invalid (extent count = 0, reason in
001612                    ; SDB_M_BAIL) when the file cannot be described, which makes all
001613                    ; callers fall back silently.
001614  8216  FF90  005E  SDB_MAP_BUILD               ASUB enter, 1
001615                    
001616  8218  0800                                    MOVE R8, R0                      ; R0: FDH
001617  8219  0904                                    MOVE R9, R1                      ; R1: map
001618                    
001619  821A  0F85  0000                              MOVE 0, @R1                      ; invalid until proven good
001620  821C  0108                                    MOVE R1, R2
001621  821D  1F88  0004                              ADD SDB_M_BAIL, R2
001622  821F  0F89  0001                              MOVE SDB_B_NOMAP, @R2
001623  8221  0F88  8621                              MOVE SDB_NULL_MAP, R2            ; no real map for this drive?
001624  8223  C204                                    CMP R2, R1
001625  8224  FFA3  0100                              RBRA _SDBMB_RET, Z               ; then there is nothing to do
001626                    
001627  8226  0108                                    MOVE R1, R2
001628  8227  1F88  0001                              ADD SDB_M_FDH, R2
001629  8229  0009                                    MOVE R0, @R2                     ; remember the file handle
001630                    
001631  822A  0FA0  0002                              MOVE SDB_B_NODEV, R8
001632  822C  FFB0  00FB                              RSUB _SDB_BAIL, 1
001633  822E  0008                                    MOVE R0, R2
001634  822F  1F88  0000                              ADD FAT32$FDH_DEVICE, R2
001635  8231  0248                                    MOVE @R2, R2                     ; R2: device handle
001636  8232  FFA3  00F2                              RBRA _SDBMB_RET, Z
001637                    

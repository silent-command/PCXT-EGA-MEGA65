000932                    ; ----------------------------------------------------------------------------
000933                    ; Automatically and manually loadable cartridges and ROMs
000934                    ; ----------------------------------------------------------------------------
000935                    
000936                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000937                    CRTROM_MAN_NUM_A            .EQU 0x7000                      ; amount of manually loadable CRTs/ROMs
000938                    CRTROM_AUT_NUM_A            .EQU 0x7001                      ; amount of automatically loadable ROMs
000939                    CRTROM_MAN_BUFFERS          .EQU 0x7100                      ; array of records: manually loadable
000940                    CRTROM_AUT_BUFFERS          .EQU 0x7200                      ; array of records: automatically loadable
000941                    CRTROM_AUT_FILES            .EQU 0x7300                      ; auto-load filesnames
000942                    
000943                    ; Type of byte streaming device for receiving the CRT/ROM data
000944                    CRTROM_TYPE_DEVICE          .EQU 0x0000                      ; any QNICE compatible device
000945                    CRTROM_TYPE_HYPRAM          .EQU 0x0001                      ; HyperRAM
000946                    CRTROM_TYPE_SDRAM           .EQU 0x0002                      ; @TODO/RESERVED for future R4 boards
000947                    CRTROM_TYPE_MNDTRY          .EQU 0x0003                      ; mandatory ROM
000948                    CTRROM_TYPE_OPTNL           .EQU 0x0004                      ; optional ROM
000949                    
000950                    ; Control and status registers of a CRT/ROM device
000951                    CRTROM_CSR_4KWIN            .EQU 0xFFFF                      ; 4K window in the device addr. space
000952                    
000953                    CRTROM_CSR_STATUS           .EQU 0x7000                      ; QNICE to device: load status (see below)
000954                    CRTROM_CSR_FS_LO            .EQU 0x7001                      ; filesize of CRT/ROM: low word
000955                    CRTROM_CSR_FS_HI            .EQU 0x7002                      ; filesize of CRT/ROM: high word
000956                    CRTROM_CSR_PARSEST          .EQU 0x7010                      ; device to QNICE: parse status
000957                    CRTROM_CSR_PARSEE1          .EQU 0x7011                      ; device to QNICE: error code
000958                    CRTROM_CSR_ADDR_LO          .EQU 0x7012                      ; device to QNICE: load address low word
000959                    CRTROM_CSR_ADDR_HI          .EQU 0x7013                      ; device to QNICE: load address high word
000960                    CRTROM_CSR_ERR_STRT         .EQU 0x7100                      ; device to QNICE: status string
000961                    
000962                    ; QNICE to device: CRT/ROM load status
000963                    CRTROM_CSR_ST_IDLE          .EQU 0x0000                      ; device is initialized, no loading
000964                    CRTROM_CSR_ST_LDNG          .EQU 0x0001                      ; loading takes place
000965                    CRTROM_CSR_ST_ERR           .EQU 0x0002                      ; loading failed
000966                    CRTROM_CSR_ST_OK            .EQU 0x0003                      ; loading successful
000967                    
000968                    ; Device to QNICE: Parsing status
000969                    CRTROM_CSR_PT_IDLE          .EQU 0x0000                      ; parser is idle
000970                    CRTROM_CSR_PT_PRSNG         .EQU 0x0001                      ; parser is parsing
000971                    CRTROM_CSR_PT_OK            .EQU 0x0002                      ; parsing successful
000972                    CRTROM_CSR_PT_ERR           .EQU 0x0003                      ; parsing error
000973                    
000974                    ; ----------------------------------------------------------------------------
000975                    ; Situation and context identifiers for custom messages
000976                    ; ----------------------------------------------------------------------------
000977                    
000978                    CTX_MASK_CTX                .EQU 0xFF00                      ; used to mask out the lower byte
000979                    CTX_MASK_PARAM              .EQU 0x00FF                      ; used to mask out the higher byte
000980                    
000981                    ; Trying to mount a disk or a rom image. The lower byte contains the
000982                    ; core-specific disk or rom image type and core specific code can use this
000983                    ; to filter for the right types and to output context-sensitive messages
000984                    CTX_MOUNT_DISKIMG           .EQU 0x0100                      ; trying to mount a disk image
000985                    CTX_LOAD_ROM                .EQU 0x0200                      ; trying to mount a rom image
000986                    
000987                    ; The filter function returned an empty linked list. This happens when there
000988                    ; is no file that fits the criteria in the root folder and additionally the
000989                    ; root folder has no sub-directory
000990                    CMSG_BROWSENOTHING          .EQU 0x0001
000991                                                .ORG 0x8000
000992  8000  0FB4  FEE0                              MOVE 0xFEE0, R13
000993  8002  0FA0  8576                              MOVE HANDLE_DEV, R8
000994  8004  0FA4  0001                              MOVE 1, R9
000995  8006  FF90  0044                              ASUB f32_mnt_sd, 1
000996  8008  0FA0  8576                              MOVE HANDLE_DEV, R8
000997  800A  0FA4  855D                              MOVE HANDLE_FILE, R9
000998  800C  0FA8  8569                              MOVE STR_FILE, R10
000999  800E  BB2C                                    XOR R11, R11
001000  800F  FF90  0050                              ASUB f32_fopen, 1
001001                    
001002  8011  0F88  00AB                              MOVE 0x00AB, R2                  ; R2: target device
001003  8013  B30C                                    XOR R3, R3                       ; R3: target 4k window
001004  8014  0F90  7000                              MOVE M2M$RAMROM_DATA, R4         ; R4: next 4k win indicator
001005  8016  1F90  1000                              ADD 0x1000, R4
001006  8018  0F94  7000                              MOVE M2M$RAMROM_DATA, R5         ; R5: target address
001007                    
001008  801A  0F84  A000                              MOVE MODE, R1
001009  801C  0144                                    MOVE @R1, R1
001010  801D  CF84  0000                              CMP 0, R1
001011  801F  FFA3  002F                              RBRA _DONE, Z
001012  8021  CF84  0001                              CMP 1, R1
001013  8023  FFA3  0013                              RBRA _OLD, Z
001014                    
001015                                                ; ---- the new path
001016  8025  0FA0  855D                              MOVE HANDLE_FILE, R8
001017  8027  0FA4  8613                              MOVE SDB_RM_MAP, R9
001018  8029  FFB0  01D7                              RSUB SDB_MAP_BUILD, 1
001019  802B  0FA0  855D                              MOVE HANDLE_FILE, R8
001020  802D  0FA4  8613                              MOVE SDB_RM_MAP, R9
001021  802F  0228                                    MOVE R2, R10
001022  8030  032C                                    MOVE R3, R11
001023  8031  0530                                    MOVE R5, R12
001024  8032  FFB0  0481                              RSUB SDB_FREAD_FAST, 1
001025  8034  FFAA  0002                              RBRA _OLD, !C
001026  8036  0B0C                                    MOVE R11, R3
001027  8037  0C14                                    MOVE R12, R5
001028                    
001029                                                ; ---- the byte loop, verbatim from crts-and-roms.asm
001030  8038  0FA0  855D  _OLD                        MOVE HANDLE_FILE, R8
001031  803A  FF90  0052                              ASUB f32_fread, 1
001032  803C  CFA8  EEEE                              CMP FAT32$EOF, R10
001033  803E  FFA3  0010                              RBRA _DONE, Z
001034  8040  0FA0  FFF4                              MOVE M2M$RAMROM_DEV, R8
001035  8042  0221                                    MOVE R2, @R8
001036  8043  0FA0  FFF5                              MOVE M2M$RAMROM_4KWIN, R8
001037  8045  0321                                    MOVE R3, @R8
001038  8046  0916                                    MOVE R9, @R5++
001039  8047  C414                                    CMP R4, R5
001040  8048  FFAB  FFEE                              RBRA _OLD, !Z
001041  804A  0F94  7000                              MOVE M2M$RAMROM_DATA, R5
001042  804C  1F8C  0001                              ADD 1, R3
001043  804E  FFA0  FFE8                              RBRA _OLD, 1
001044                    
001045  8050  E000        _DONE                       HALT
001046                    
001047                    ; ****************************************************************************
001048                    ; MiSTer2MEGA65 (M2M) QNICE ROM
001049                    ;
001050                    ; sdblock.asm: direct 512-byte block access to files on the SD card
001051                    ;
001052                    ; The FAT32 library of the QNICE Monitor only offers a byte-wise API
001053                    ; (f32_fread / f32_fwrite). Every single byte revalidates the cluster and the
001054                    ; sector of the file handle, which costs about 107 instructions per byte, and
001055                    ; f32_fseek walks the cluster chain from the start of the file, which makes a
001056                    ; random access at the far end of a 42 MB image cost seconds.
001057                    ;
001058                    ; This module resolves the on-disk layout of a file *once* into a compact
001059                    ; extent table and can then map "block N of the file" to an absolute SD card
001060                    ; LBA. A block is then one SD$READ_BLOCK plus a tight copy loop out of the
001061                    ; 512-byte buffer of the SD controller.
001062                    ;
001063                    ; ----------------------------------------------------------------------------
001064                    ; THE TWO RULES
001065                    ; ----------------------------------------------------------------------------
001066                    ;
001067                    ; (1) The FAT32 library must never be able to tell that we were here.
001068                    ;
001069                    ; The 512-byte "sector buffer" of the FAT32 library IS the 512-byte
001070                    ; hardware buffer of the SD controller; the device handle only remembers
001071                    ; *which* file handle filled it (FAT32$DEV_BUFFERED_FDH). Every direct
001072                    ; access destroys the library's buffer while the library still believes
001073                    ; it holds a particular sector.
001074                    ;
001075                    ; Earlier versions of this file solved that by pointing
001076                    ; FAT32$DEV_BUFFERED_FDH at a dummy handle, i.e. by reaching into the
001077                    ; library's bookkeeping. That is not done any more. Instead:
001078                    ;
001079                    ; * SDB_GUARD_IN works out, *before* anything is touched, which sector
001080                    ; the library believes is in the buffer and whether that sector can
001081                    ; be read back. If it cannot, the fast path is refused and nothing
001082                    ; is touched at all.
001083                    ; * a dirty buffer is written back through the library first.
001084                    ; * SDB_GUARD_OUT reads that very sector back, so the buffer holds
001085                    ; exactly what it held before.
001086                    ; * SDB_FREAD_FAST, which moves the file position anyway, restores the
001087                    ; library state the library's own way: with an f32_fseek, which
001088                    ; unconditionally re-reads the sector and re-claims ownership.
001089                    ;
001090                    ; The one remaining poke, SDB_ORPHAN, exists only for the case where the
001091                    ; restoring read itself fails, i.e. where the card is already broken. It
001092                    ; is strictly better than leaving the library with a buffer that holds
001093                    ; something else than it thinks.
001094                    ;
001095                    ; (2) Any error anywhere leaves the caller with "nothing happened".
001096                    ;
001097                    ; Every entry point returns Carry=0 on any problem, and the byte-wise
001098                    ; FAT32 path then does all of the work exactly as it did before this
001099                    ; file existed. In particular:
001100                    ;
001101                    ; * an SD card error latches the controller into its error state (see
001102                    ; the IO$SD_CSR description in sysdef.asm: "you need to reset the
001103                    ; controller to go on"), which would make every *subsequent* library
001104                    ; access fail too. SDB_SDERR therefore issues SD$RESET after any
001105                    ; failed SD operation before we hand back control.
001106                    ; * SDB_FREAD_FAST never seeks to the end of the file. It always leaves
001107                    ; at least one whole block to the byte loop, so the file position it
001108                    ; hands over is strictly inside the file and the caller reaches EOF
001109                    ; through the library, the way it always did.
001110                    ; * every seek is verified against FAT32$FDH_ACCESS afterwards.
001111                    ;
001112                    ; ----------------------------------------------------------------------------
001113                    ; Serial logging
001114                    ; ----------------------------------------------------------------------------
001115                    ; The switch is SDB_DEBUG in M2M/rom/sdblock_cfg.asm, which shell.asm includes
001116                    ; as its very first line. It must NOT be defined here: this file is included
001117                    ; at the end of shell.asm, and the C preprocessor runs once from top to
001118                    ; bottom, so a #define here would be invisible to every #ifdef above it.
001119                    ;
001120                    ; This file needs the environment of shell.asm.
001121                    ;
001122                    ; done for the PCXT-EGA-MEGA65 port and licensed under GPL v3
001123                    ; ****************************************************************************
001124                    
001125                    ; ----------------------------------------------------------------------------
001126                    ; Layout of a block map (see SDB_VD_MAPS / SDB_RM_MAP in shell_vars.asm)
001127                    ; ----------------------------------------------------------------------------
001128                    
001129                    ; Maximum amount of extents (runs of physically consecutive clusters) that we
001130                    ; are willing to remember for one file. A freshly copied image file normally
001131                    ; is one single extent. Files that would need more extents than this fall
001132                    ; back to the FAT32 library path.
001133                    SDB_MAX_EXT                 .EQU 8
001134                    
001135                    SDB_M_NEXT                  .EQU 0                           ; amount of valid extents; 0 = no map
001136                    SDB_M_FDH                   .EQU 1                           ; FDH this map was built for
001137                    SDB_M_TBLK_LO               .EQU 2                           ; amount of *whole* 512-byte blocks..
001138                    SDB_M_TBLK_HI               .EQU 3                           ; ..in the file (filesize / 512)
001139                    SDB_M_BAIL                  .EQU 4                           ; why there is no map (SDB_B_*)
001140                    SDB_M_EXT                   .EQU 5                           ; start of the extent array
001141                    
001142                    ; one extent: amount of blocks (lo/hi) and the absolute SD card LBA (lo/hi)
001143                    ; of the first of them
001144                    SDB_E_NBLK_LO               .EQU 0
001145                    SDB_E_NBLK_HI               .EQU 1
001146                    SDB_E_LBA_LO                .EQU 2
001147                    SDB_E_LBA_HI                .EQU 3
001148                    SDB_E_SIZE                  .EQU 4
001149                    
001150                    ; size of one map in words: SDB_M_EXT + SDB_E_SIZE * SDB_MAX_EXT = 5 + 4*8
001151                    ; = 37, rounded up to 40 to leave room
001152                    SDB_M_SIZE                  .EQU 40
001153                    
001154                    ; Amount of virtual drives that SDB_VD_MAPS in shell_vars.asm has room for.
001155                    ; The QNICE assembler cannot evaluate expressions in .BLOCK, so the size of
001156                    ; SDB_VD_MAPS is the literal SDB_M_SIZE * SDB_VD_MAX_N and both have to be
001157                    ; kept in sync by hand. Virtual drives beyond SDB_VD_MAX_N are not broken,
001158                    ; they just always use the (slow) FAT32 library path.
001159                    SDB_VD_MAX_N                .EQU 3
001160                    
001161                    ; Why a map could not be built. Logged, and also readable from SDB_M_BAIL.
001162                    SDB_B_OK                    .EQU 0
001163                    SDB_B_NOMAP                 .EQU 1                           ; no map slot for this drive
001164                    SDB_B_NODEV                 .EQU 2                           ; file handle has no device handle
001165                    SDB_B_NOSPC                 .EQU 3                           ; sectors per cluster is zero
001166                    SDB_B_EMPTY                 .EQU 4                           ; file is shorter than one block
001167                    SDB_B_BADSTART              .EQU 5                           ; start cluster < 2
001168                    SDB_B_FRAG                  .EQU 6                           ; more extents than SDB_MAX_EXT
001169                    SDB_B_FATERR                .EQU 7                           ; could not read a FAT sector
001170                    SDB_B_BADCLUS               .EQU 8                           ; illegal cluster in the chain
001171                    SDB_B_SHORT                 .EQU 9                           ; chain ends before the file does
001172                    SDB_B_LBA                   .EQU 10                          ; LBA arithmetic out of range
001173                    SDB_B_GUARD                 .EQU 11                          ; buffer could not be made restorable
001174                    SDB_B_SEEK                  .EQU 12                          ; restoring seek failed
001175                    
001176                    ; Why one virtual drive block request did or did not take the fast path.
001177                    ; Left in SDB_RD_STAT by SDB_VD_RDBLK / SDB_VD_WRBLK after every request, so
001178                    ; it can be read out even in a build without the serial log.
001179                    SDB_R_OK                    .EQU 0                           ; fast path taken
001180                    SDB_R_SIZE                  .EQU 1                           ; VD_SIZEB is not exactly 512
001181                    SDB_R_ALIGN                 .EQU 2                           ; byte position is not block aligned
001182                    SDB_R_MAP                   .EQU 3                           ; no usable map for this drive/handle
001183                    SDB_R_RANGE                 .EQU 4                           ; block is outside the mapped file
001184                    SDB_R_GUARD                 .EQU 5                           ; buffer could not be made restorable
001185                    SDB_R_SDERR                 .EQU 6                           ; the SD card operation failed
001186                    
001187                    ; end-of-chain marker: everything >= 0x0FFFFFF8 terminates a FAT32 chain,
001188                    ; and everything >= 0x0FFFFFF0 is reserved, so refuse all of it
001189                    SDB_EOC_HI                  .EQU 0x0FFF
001190                    SDB_EOC_LO                  .EQU 0xFFF0
001191                    
001192                    ; ----------------------------------------------------------------------------
001193                    ; Housekeeping
001194                    ; ----------------------------------------------------------------------------
001195                    
001196                    ; SDB_INVAL_ALL
001197                    ; Invalidates all block maps, i.e. everything falls back to the FAT32 library
001198                    ; until the maps are rebuilt. Called from VD_INIT and whenever the SD card
001199                    ; changes. Also clears the two zero-filled helper structures, because the
001200                    ; variables live in uninitialized RAM.
001201                    ;
001202                    ; Input: none
001203                    ; Output: none, all registers unchanged
001204  8051  E0C0        SDB_INVAL_ALL               INCRB
001205  8052  0F80  859B                              MOVE SDB_VD_MAPS, R0
001206  8054  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001207  8056  0F81  0000  _SDBIA_L                    MOVE 0, @R0
001208  8058  1F80  0028                              ADD SDB_M_SIZE, R0
001209  805A  3F84  0001                              SUB 1, R1
001210  805C  FFAB  FFF8                              RBRA _SDBIA_L, !Z
001211  805E  0F80  8613                              MOVE SDB_RM_MAP, R0
001212  8060  0F81  0000                              MOVE 0, @R0
001213  8062  0F80  863B                              MOVE SDB_NULL_MAP, R0
001214  8064  0F81  0000                              MOVE 0, @R0
001215  8066  0F80  8648                              MOVE SDB_G_VAL, R0
001216  8068  0F81  0000                              MOVE 0, @R0
001217                    
001218                                                ; SDB_DUMMY_FDH must read as an all-zero, and therefore never
001219                                                ; dirty, file handle: SDB_ORPHAN hands it to FAT32$FLUSH
001220  806A  0F80  863C                              MOVE SDB_DUMMY_FDH, R0
001221  806C  0F84  000C                              MOVE FAT32$FDH_STRUCT_SIZE, R1
001222  806E  0F82  0000  _SDBIA_L2                   MOVE 0, @R0++
001223  8070  3F84  0001                              SUB 1, R1
001224  8072  FFAB  FFFA                              RBRA _SDBIA_L2, !Z
001225  8074  E100                                    DECRB
001226  8075  0DBC                                    MOVE @R13++, R15
001227                    
001228                    ; SDB_VDMAP
001229                    ; Returns the block map that belongs to a virtual drive. Drives that have no
001230                    ; map (see SDB_VD_MAX_N) get the permanently empty SDB_NULL_MAP, which makes
001231                    ; SDB_CHECK fail and therefore forces the FAT32 library path.
001232                    ;
001233                    ; Input: R8: virtual drive number
001234                    ; Output: R8: pointer to the block map
001235  8076  E0C0        SDB_VDMAP                   INCRB
001236  8077  0800                                    MOVE R8, R0
001237  8078  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001238  807A  C100                                    CMP R1, R0                       ; drive number < maximum?
001239  807B  FFA4  0004                              RBRA _SDBVM_OK, N                ; yes
001240  807D  0FA0  863B                              MOVE SDB_NULL_MAP, R8            ; no: never mapped
001241  807F  FFA0  000C                              RBRA _SDBVM_D, 1
001242  8081  0FA0  859B  _SDBVM_OK                   MOVE SDB_VD_MAPS, R8
001243  8083  CF80  0000  _SDBVM_L                    CMP 0, R0
001244  8085  FFA3  0006                              RBRA _SDBVM_D, Z
001245  8087  1FA0  0028                              ADD SDB_M_SIZE, R8
001246  8089  3F80  0001                              SUB 1, R0
001247  808B  FFA0  FFF6                              RBRA _SDBVM_L, 1
001248  808D  E100        _SDBVM_D                    DECRB
001249  808E  0DBC                                    MOVE @R13++, R15
001250                    
001251                    ; SDB_CHECK
001252                    ; Is the given map valid and does it belong to the given file handle?
001253                    ;
001254                    ; Input: R8: pointer to the block map
001255                    ; R9: file handle (FDH)
001256                    ; Output: Carry=1 if the map can be used, all registers unchanged
001257  808F  E0C0        SDB_CHECK                   INCRB
001258  8090  CFA1  0000                              CMP 0, @R8                       ; any extents?
001259  8092  FFA3  000A                              RBRA _SDBC_NO, Z                 ; no: unusable
001260  8094  0800                                    MOVE R8, R0
001261  8095  1F80  0001                              ADD SDB_M_FDH, R0
001262  8097  C064                                    CMP @R0, R9                      ; built for this file handle?
001263  8098  FFAB  0004                              RBRA _SDBC_NO, !Z                ; no: unusable
001264  809A  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001265  809C  FFA0  0002                              RBRA _SDBC_R, 1
001266  809E  9FB8  FFFB  _SDBC_NO                    AND 0xFFFB, R14                  ; clear Carry
001267  80A0  E100        _SDBC_R                     DECRB
001268  80A1  0DBC                                    MOVE @R13++, R15
001269                    
001270                    ; ----------------------------------------------------------------------------
001271                    ; Every SD card access of the fast path goes through these two wrappers, so
001272                    ; that the time the card itself needs can be measured separately from
001273                    ; everything else, and so that the number of card accesses per virtual drive
001274                    ; request is countable. Without SDB_DEBUG they are a plain call.
001275                    ; ----------------------------------------------------------------------------
001276                    
001277                    ; SDB_SDRD: read one 512-byte block into the SD controller's buffer
001278                    ; Input: R8/R9 = LBA lo/hi
001279                    ; Output: R8 = 0, or the error code
001280  80A2              SDB_SDRD                    
001281                    
001282                    
001283                    
001284  80A2  FF90  003C                              ASUB sd_r_block, 1
001285                    
001286                    
001287                    
001288  80A4  0DBC                                    MOVE @R13++, R15
001289                    
001290                    ; SDB_SDWR: write the SD controller's buffer to one 512-byte block
001291                    ; Input: R8/R9 = LBA lo/hi
001292                    ; Output: R8 = 0, or the error code
001293  80A5              SDB_SDWR                    
001294                    
001295                    
001296                    
001297  80A5  FF90  003E                              ASUB sd_w_block, 1
001298                    
001299                    
001300                    
001301  80A7  0DBC                                    MOVE @R13++, R15
001302                    ; SDB_SDERR
001303                    ; Called after a failed SD card operation. The controller latches its error
001304                    ; state and refuses everything until it is reset, which would turn our
001305                    ; problem into a fatal error in the *next* FAT32 library call. Reset it, so
001306                    ; that the fallback path starts from a clean controller.
001307                    ;
001308                    ; Input: R8: the error code (only used for logging)
001309                    ; Output: none, R8 unchanged
001310  80A8  E0C0        SDB_SDERR                   INCRB
001311  80A9  0800                                    MOVE R8, R0
001312                    
001313                    
001314                    
001315                    
001316                    
001317                    
001318                    
001319  80AA  FF90  003A                              ASUB sd_reset, 1
001320  80AC  0020                                    MOVE R0, R8
001321  80AD  E100                                    DECRB
001322  80AE  0DBC                                    MOVE @R13++, R15
001323                    
001324                    ; ----------------------------------------------------------------------------
001325                    ; Guarding the FAT32 library's sector buffer
001326                    ; ----------------------------------------------------------------------------
001327                    
001328                    ; SDB_GUARD_IN
001329                    ; Prepares for direct SD card access. Writes the FAT32 library's sector
001330                    ; buffer back first if it is dirty, and notes whether a real file handle
001331                    ; currently claims the buffer, so that SDB_GUARD_OUT can tell that handle
001332                    ; afterwards that the contents are no longer what it thinks. Refuses
001333                    ; (Carry=0) without touching anything if the write-back fails.
001334                    ;
001335                    ; This used to remember the sector's LBA and read it back in
001336                    ; SDB_GUARD_OUT. That was a second SD card access per virtual drive request,
001337                    ; about 1.5 ms of hardware time out of 3.4 ms, for something that the
001338                    ; library's own re-read mechanism does for free. It also could only ever
001339                    ; satisfy one of the two device handles that share the one hardware buffer,
001340                    ; whereas marking tells both.
001341                    ;
001342                    ; Input: none
001343                    ; Output: Carry=1: direct access is allowed
001344                    ; Carry=0: do not touch the SD card, nothing has been touched
001345                    ; all registers unchanged
001346  80AF  FF90  005E  SDB_GUARD_IN                ASUB enter, 1
001347                    
001348  80B1  0FA0  8648                              MOVE SDB_G_VAL, R8               ; nobody to tell yet
001349  80B3  0FA1  0000                              MOVE 0, @R8
001350                    
001351  80B5  0FA0  8576                              MOVE HANDLE_DEV, R8              ; who claims the buffer?
001352  80B7  FFB0  0027                              RSUB _SDB_OWNER, 1
001353  80B9  FFA2  0008                              RBRA _SDBGI_HAVE, C
001354  80BB  0FA0  8588                              MOVE CONFIG_DEVH, R8
001355  80BD  FFB0  0021                              RSUB _SDB_OWNER, 1
001356  80BF  FFA2  0002                              RBRA _SDBGI_HAVE, C
001357  80C1  FFA0  0014                              RBRA _SDBGI_OK, 1                ; nobody: nothing to do
001358                    
001359                                                ; R8: device handle, R9: owning FDH
001360  80C3  0904        _SDBGI_HAVE                 MOVE R9, R1
001361                    
001362  80C4  0120                                    MOVE R1, R8                      ; dirty? then write it back
001363  80C5  1FA0  000B                              ADD FAT32$FDH_FLAGS, R8
001364  80C7  0860                                    MOVE @R8, R8
001365  80C8  9FA0  0001                              AND FAT32$FDHF_DIRTY, R8
001366  80CA  FFA3  0007                              RBRA _SDBGI_CLEAN, Z
001367  80CC  0120                                    MOVE R1, R8
001368  80CD  FF90  0068                              ASUB f32_fflush, 1
001369  80CF  CFA4  0000                              CMP 0, R9
001370  80D1  FFAB  0008                              RBRA _SDBGI_NO, !Z               ; cannot write back: refuse
001371                    
001372  80D3  0FA0  8648  _SDBGI_CLEAN                MOVE SDB_G_VAL, R8               ; a real handle owns it, so
001373  80D5  0FA1  0001                              MOVE 1, @R8                      ; ..it has to be told later
001374                    
001375  80D7  AFB8  0004  _SDBGI_OK                   OR 0x0004, R14                   ; set Carry
001376  80D9  FFA0  0002                              RBRA _SDBGI_RET, 1
001377  80DB  9FB8  FFFB  _SDBGI_NO                   AND 0xFFFB, R14                  ; clear Carry
001378  80DD  FF90  0060  _SDBGI_RET                  ASUB leave, 1
001379  80DF  0DBC                                    MOVE @R13++, R15
001380                    
001381                    ; Input: R8: device handle
001382                    ; Output: Carry=1 and R9 = the FDH that claims the buffer, R8 unchanged
001383                    ;
001384                    ; SDB_DUMMY_FDH is our own "the contents are unknown" marker and must not be
001385                    ; reported as an owner: otherwise the request after an orphaned one would try
001386                    ; to write back and mark a handle that is not a real file, and - since the
001387                    ; dummy has cluster 0 - would have been refused outright by the old
001388                    ; restore-based guard.
001389  80E0  E0C0        _SDB_OWNER                  INCRB
001390  80E1  CFA1  0000                              CMP 0, @R8                       ; device handle initialized?
001391  80E3  FFA3  000F                              RBRA _SDB_OWN_NO, Z
001392  80E5  0800                                    MOVE R8, R0
001393  80E6  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001394  80E8  0064                                    MOVE @R0, R9
001395  80E9  FFA3  0009                              RBRA _SDB_OWN_NO, Z              ; nobody claims it
001396  80EB  0F80  863C                              MOVE SDB_DUMMY_FDH, R0
001397  80ED  C024                                    CMP R0, R9                       ; already marked as unknown?
001398  80EE  FFA3  0004                              RBRA _SDB_OWN_NO, Z              ; then there is no owner
001399  80F0  AFB8  0004                              OR 0x0004, R14
001400  80F2  FFA0  0002                              RBRA _SDB_OWN_R, 1
001401  80F4  9FB8  FFFB  _SDB_OWN_NO                 AND 0xFFFB, R14
001402  80F6  E100        _SDB_OWN_R                  DECRB
001403  80F7  0DBC                                    MOVE @R13++, R15
001404                    
001405                    ; SDB_GUARD_OUT
001406                    ; The direct access is done and the hardware buffer now holds our block. Tell
001407                    ; whoever claimed it that its contents are unknown, so that the FAT32 library
001408                    ; re-reads instead of trusting it.
001409                    ;
001410                    ; Input: none
001411                    ; Output: none, all registers unchanged
001412  80F8  FF90  005E  SDB_GUARD_OUT               ASUB enter, 1
001413  80FA  0FA0  8648                              MOVE SDB_G_VAL, R8
001414  80FC  CFA1  0000                              CMP 0, @R8
001415  80FE  FFA3  0004                              RBRA _SDBGO_RET, Z               ; nobody had claimed it
001416  8100  0FA1  0000                              MOVE 0, @R8
001417  8102  FFB0  000A                              RSUB SDB_ORPHAN, 1
001418  8104  FF90  0060  _SDBGO_RET                  ASUB leave, 1
001419  8106  0DBC                                    MOVE @R13++, R15
001420                    
001421                    ; SDB_GUARD_CLR
001422                    ; The library has been put back by other means - SDB_FREAD_FAST finishes with
001423                    ; an f32_fseek, which re-reads the sector and re-claims ownership itself - so
001424                    ; there is nothing left to mark.
001425                    ;
001426                    ; Input: none
001427                    ; Output: none, all registers unchanged
001428  8107  E0C0        SDB_GUARD_CLR               INCRB
001429  8108  0F80  8648                              MOVE SDB_G_VAL, R0
001430  810A  0F81  0000                              MOVE 0, @R0
001431  810C  E100                                    DECRB
001432  810D  0DBC                                    MOVE @R13++, R15
001433                    
001434                    ; SDB_ORPHAN
001435                    ; Tells both device handles that the contents of the 512-byte hardware buffer
001436                    ; are unknown, so that the library re-reads rather than serving something we
001437                    ; overwrote. This is the same mechanism the library uses on itself: READ_FDH
001438                    ; compares FAT32$DEV_BUFFERED_FDH with the handle it was called for and
001439                    ; re-reads through FAT32$RW_SIC whenever they differ.
001440                    ;
001441                    ; "Unknown" is expressed by handing the buffer to SDB_DUMMY_FDH, an all-zero
001442                    ; and therefore never dirty file handle, and not by the obvious 0: FAT32$FLUSH
001443                    ; returns immediately when called with R8 = 0 and then leaves R9 - its error
001444                    ; code - untouched, and FAT32$FILE_SEEK checks that stale R9 right after
001445                    ; calling it, so a seek would silently do nothing.
001446                    ;
001447                    ; Note what this does NOT do: it issues no SD card access of its own, so it
001448                    ; cannot produce an LBA, and therefore cannot reproduce anything of the shape
001449                    ; that made hardware run 1 fatal (a wild LBA latching the controller's error
001450                    ; state). All of the guards against that - stopping one block short of the
001451                    ; end of a file, verifying FAT32$FDH_ACCESS after every seek, validating every
001452                    ; LBA in SDB_CLULBA, and resetting the controller after a failed access - are
001453                    ; untouched.
001454                    ;
001455                    ; Input: none
001456                    ; Output: none, all registers unchanged
001457  810E  FF90  005E  SDB_ORPHAN                  ASUB enter, 1
001458                    
001459                    
001460                    
001461                    
001462                    
001463  8110  0FA0  8576                              MOVE HANDLE_DEV, R8
001464  8112  FFB0  000B                              RSUB _SDB_ORPH1, 1
001465  8114  0FA0  8588                              MOVE CONFIG_DEVH, R8
001466  8116  FFB0  0007                              RSUB _SDB_ORPH1, 1
001467  8118  0FA0  8648                              MOVE SDB_G_VAL, R8               ; everybody has been told
001468  811A  0FA1  0000                              MOVE 0, @R8
001469  811C  FF90  0060                              ASUB leave, 1
001470  811E  0DBC                                    MOVE @R13++, R15
001471                    
001472  811F  E0C0        _SDB_ORPH1                  INCRB
001473  8120  0804                                    MOVE R8, R1
001474  8121  CFA1  0000                              CMP 0, @R8
001475  8123  FFA3  0006                              RBRA _SDB_ORPH_R, Z
001476  8125  0800                                    MOVE R8, R0
001477  8126  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001478  8128  0F88  863C                              MOVE SDB_DUMMY_FDH, R2
001479  812A  0201                                    MOVE R2, @R0
001480  812B  0120        _SDB_ORPH_R                 MOVE R1, R8
001481  812C  E100                                    DECRB
001482  812D  0DBC                                    MOVE @R13++, R15
001483                    
001484                    ; ----------------------------------------------------------------------------
001485                    ; 32-bit helpers
001486                    ; ----------------------------------------------------------------------------
001487                    
001488                    ; SDB_B2BLK
001489                    ; Converts a byte position into a 512-byte block index (unsigned 32 bit).
001490                    ;
001491                    ; Input: R9/R10: byte position lo/hi
001492                    ; Output: R9/R10: block index lo/hi
001493  812E  E0C0        SDB_B2BLK                   INCRB
001494  812F  0A00                                    MOVE R10, R0
001495  8130  9F80  01FF                              AND 0x01FF, R0                   ; bits that move down into..
001496  8132  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the low word; clear X so..
001497  8134  5F80  0007                              SHL 7, R0                        ; ..SHL shifts in zeros
001498  8136  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001499  8138  6FA4  0009                              SHR 9, R9
001500  813A  1024                                    ADD R0, R9
001501  813B  9FB8  FFFB                              AND 0xFFFB, R14
001502  813D  6FA8  0009                              SHR 9, R10
001503  813F  E100                                    DECRB
001504  8140  0DBC                                    MOVE @R13++, R15
001505                    
001506                    ; SDB_BLK2B
001507                    ; Converts a 512-byte block index into a byte position (unsigned 32 bit).
001508                    ;
001509                    ; Input: R9/R10: block index lo/hi
001510                    ; Output: R9/R10: byte position lo/hi
001511  8141  E0C0        SDB_BLK2B                   INCRB
001512  8142  0900                                    MOVE R9, R0
001513  8143  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001514  8145  6F80  0007                              SHR 7, R0                        ; bits that move up into..
001515  8147  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the high word; clear X
001516  8149  5FA8  0009                              SHL 9, R10
001517  814B  1028                                    ADD R0, R10
001518  814C  9FB8  FFFD                              AND 0xFFFD, R14
001519  814E  5FA4  0009                              SHL 9, R9
001520  8150  E100                                    DECRB
001521  8151  0DBC                                    MOVE @R13++, R15
001522                    
001523                    ; SDB_CLULBA
001524                    ; The absolute SD card LBA of one sector within one cluster, i.e. exactly
001525                    ; what FAT32$RW_SIC computes, with every range check spelled out.
001526                    ;
001527                    ; Input: R8: device handle
001528                    ; R9/R10: cluster lo/hi
001529                    ; R11: sector within the cluster
001530                    ; Output: Carry=1: R9/R10 = LBA lo/hi
001531                    ; Carry=0: the cluster or the sector is out of range
001532                    ; R8, R11 unchanged
001533  8152  E0C0        SDB_CLULBA                  INCRB
001534  8153  0800                                    MOVE R8, R0                      ; R0: device handle
001535  8154  0B04                                    MOVE R11, R1                     ; R1: sector
001536                    
001537  8155  CFA8  0000                              CMP 0, R10                       ; cluster >= 2?
001538  8157  FFAB  0006                              RBRA _SDBCL_C1, !Z
001539  8159  CFA4  0001                              CMP 1, R9
001540  815B  FFA4  0044                              RBRA _SDBCL_NO, N                ; cluster = 0
001541  815D  FFA3  0042                              RBRA _SDBCL_NO, Z                ; cluster = 1
001542  815F  CFA8  0FFF  _SDBCL_C1                   CMP SDB_EOC_HI, R10              ; cluster < 0x0FFFFFF0?
001543  8161  FFAB  0006                              RBRA _SDBCL_C2, !Z
001544  8163  C93E  FFF0                              CMP R9, SDB_EOC_LO
001545  8165  FFA4  003A                              RBRA _SDBCL_NO, N
001546  8167  FFA3  0038                              RBRA _SDBCL_NO, Z
001547  8169  CA3E  0FFF  _SDBCL_C2                   CMP R10, 0x0FFF                  ; and inside 28 bits at all?
001548  816B  FFA4  0034                              RBRA _SDBCL_NO, N
001549                    
001550  816D  0008                                    MOVE R0, R2                      ; R2: sectors per cluster
001551  816E  1F88  000C                              ADD FAT32$DEV_SECT_PER_CLUS, R2
001552  8170  0248                                    MOVE @R2, R2
001553  8171  FFA3  002E                              RBRA _SDBCL_NO, Z
001554  8173  020C                                    MOVE R2, R3
001555  8174  3F8C  0001                              SUB 1, R3
001556  8176  C10C                                    CMP R1, R3                       ; sector inside the cluster?
001557  8177  FFA4  0028                              RBRA _SDBCL_NO, N
001558                    
001559  8179  0920                                    MOVE R9, R8                      ; (cluster - 2) * spc
001560  817A  0A24                                    MOVE R10, R9
001561  817B  3FA0  0002                              SUB 2, R8
001562  817D  4FA4  0000                              SUBC 0, R9
001563  817F  0228                                    MOVE R2, R10
001564  8180  BB2C                                    XOR R11, R11
001565  8181  FF90  0032                              ASUB mulu32, 1                   ; R11|R10|R9|R8 = 64 bit
001566  8183  CFA8  0000                              CMP 0, R10                       ; more than 32 bits?
001567  8185  FFAB  001A                              RBRA _SDBCL_NO, !Z
001568  8187  CFAC  0000                              CMP 0, R11
001569  8189  FFAB  0016                              RBRA _SDBCL_NO, !Z
001570                    
001571  818B  002C                                    MOVE R0, R11                     ; plus cluster_begin_lba
001572  818C  1FAC  000A                              ADD FAT32$DEV_CLUSTER_LO, R11
001573  818E  0BA8                                    MOVE @R11++, R10
001574  818F  0B6C                                    MOVE @R11, R11
001575  8190  1A20                                    ADD R10, R8
001576  8191  2B24                                    ADDC R11, R9
001577  8192  FFA2  000D                              RBRA _SDBCL_NO, C                ; 32-bit overflow
001578  8194  1120                                    ADD R1, R8                       ; plus the sector
001579  8195  2FA4  0000                              ADDC 0, R9
001580  8197  FFA2  0008                              RBRA _SDBCL_NO, C
001581                    
001582  8199  0928                                    MOVE R9, R10                     ; return the LBA in R9/R10
001583  819A  0824                                    MOVE R8, R9
001584  819B  0020                                    MOVE R0, R8
001585  819C  012C                                    MOVE R1, R11
001586  819D  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001587  819F  FFA0  0004                              RBRA _SDBCL_RET, 1
001588  81A1  0020        _SDBCL_NO                   MOVE R0, R8
001589  81A2  012C                                    MOVE R1, R11
001590  81A3  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
001591  81A5  E100        _SDBCL_RET                  DECRB
001592  81A6  0DBC                                    MOVE @R13++, R15
001593                    
001594                    ; SDB_LBA
001595                    ; Maps a block index within the file to an absolute SD card LBA.
001596                    ;
001597                    ; Input: R8: pointer to the block map
001598                    ; R9/R10: block index lo/hi
001599                    ; Output: Carry=1: R9/R10 = LBA lo/hi
001600                    ; Carry=0: the block cannot be mapped (use the FAT32 library)
001601                    ; R8 unchanged
001602  81A7  E0C0        SDB_LBA                     INCRB
001603  81A8  0800                                    MOVE R8, R0                      ; R0: map
001604  81A9  0904                                    MOVE R9, R1                      ; R1/R2: remaining block idx
001605  81AA  0A08                                    MOVE R10, R2
001606  81AB  004C                                    MOVE @R0, R3                     ; R3: amount of extents
001607  81AC  FFA3  0037                              RBRA _SDBL_NO, Z
001608                    
001609                                                ; reject anything that is not completely inside the file
001610  81AE  0010                                    MOVE R0, R4
001611  81AF  1F90  0003                              ADD SDB_M_TBLK_HI, R4
001612  81B1  C211                                    CMP R2, @R4
001613  81B2  FFA4  0031                              RBRA _SDBL_NO, N                 ; idx_hi > total_hi
001614  81B4  FFAB  0008                              RBRA _SDBL_C1, !Z                ; idx_hi < total_hi: inside
001615  81B6  0010                                    MOVE R0, R4
001616  81B7  1F90  0002                              ADD SDB_M_TBLK_LO, R4
001617  81B9  C111                                    CMP R1, @R4
001618  81BA  FFA4  0029                              RBRA _SDBL_NO, N                 ; idx_lo > total_lo
001619  81BC  FFA3  0027                              RBRA _SDBL_NO, Z                 ; idx_lo = total_lo: outside
001620                    
001621  81BE  0010        _SDBL_C1                    MOVE R0, R4
001622  81BF  1F90  0005                              ADD SDB_M_EXT, R4                ; R4: current extent
001623  81C1  0454        _SDBL_LOOP                  MOVE @R4, R5                     ; R5/R6: blocks in extent
001624  81C2  0418                                    MOVE R4, R6
001625  81C3  1F98  0001                              ADD SDB_E_NBLK_HI, R6
001626  81C5  0658                                    MOVE @R6, R6
001627  81C6  C218                                    CMP R2, R6                       ; remainder < extent size?
001628  81C7  FFA4  0014                              RBRA _SDBL_NEXT, N               ; rem_hi > ext_hi: no
001629  81C9  FFAB  0005                              RBRA _SDBL_HIT, !Z               ; rem_hi < ext_hi: yes
001630  81CB  C114                                    CMP R1, R5
001631  81CC  FFA4  000F                              RBRA _SDBL_NEXT, N               ; rem_lo > ext_lo: no
001632  81CE  FFA3  000D                              RBRA _SDBL_NEXT, Z               ; rem_lo = ext_lo: no
001633                    
001634  81D0  0418        _SDBL_HIT                   MOVE R4, R6
001635  81D1  1F98  0002                              ADD SDB_E_LBA_LO, R6
001636  81D3  06A4                                    MOVE @R6++, R9                   ; R9/R10: LBA of the extent
001637  81D4  0668                                    MOVE @R6, R10
001638  81D5  1124                                    ADD R1, R9                       ; plus the remainder
001639  81D6  2228                                    ADDC R2, R10
001640  81D7  FFA2  000C                              RBRA _SDBL_NO, C                 ; 32-bit overflow
001641  81D9  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001642  81DB  FFA0  000A                              RBRA _SDBL_RET, 1
001643                    
001644  81DD  3504        _SDBL_NEXT                  SUB R5, R1                       ; remainder -= extent size
001645  81DE  4608                                    SUBC R6, R2
001646  81DF  1F90  0004                              ADD SDB_E_SIZE, R4               ; next extent
001647  81E1  3F8C  0001                              SUB 1, R3
001648  81E3  FFAB  FFDC                              RBRA _SDBL_LOOP, !Z
001649  81E5  9FB8  FFFB  _SDBL_NO                    AND 0xFFFB, R14                  ; clear Carry
001650  81E7  E100        _SDBL_RET                   DECRB
001651  81E8  0DBC                                    MOVE @R13++, R15
001652                    
001653                    ; Unsigned 32-bit "A >= B" for two little-endian word pairs in memory.
001654                    ; The answer is returned in the Carry flag and not in N/Z, because MOVE @R13++, R15 is
001655                    ; a MOVE (see sysdef.asm) and a MOVE overwrites N and Z but not the Carry.
001656                    ; Input: R8: pointer to A (lo, hi), R9: pointer to B (lo, hi)
001657                    ; Output: Carry=1 if A >= B, R8 and R9 unchanged

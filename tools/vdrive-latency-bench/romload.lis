001660  81EB  0904                                    MOVE R9, R1
001661  81EC  1F80  0001                              ADD 1, R0
001662  81EE  1F84  0001                              ADD 1, R1
001663  81F0  C045                                    CMP @R0, @R1                     ; high words
001664  81F1  FFA4  000B                              RBRA _SDB_G32Y, N                ; A_hi > B_hi
001665  81F3  FFAB  0005                              RBRA _SDB_G32N, !Z               ; A_hi < B_hi
001666  81F5  C865                                    CMP @R8, @R9                     ; low words
001667  81F6  FFA4  0006                              RBRA _SDB_G32Y, N
001668  81F8  FFA3  0004                              RBRA _SDB_G32Y, Z
001669  81FA  9FB8  FFFB  _SDB_G32N                   AND 0xFFFB, R14                  ; clear Carry
001670  81FC  FFA0  0002                              RBRA _SDB_G32R, 1
001671  81FE  AFB8  0004  _SDB_G32Y                   OR 0x0004, R14                   ; set Carry
001672  8200  E100        _SDB_G32R                   DECRB
001673  8201  0DBC                                    MOVE @R13++, R15

002021  8398  5F94  0008                              SHL 8, R5
002022  839A  1528                                    ADD R5, R10
002023  839B  9FA8  0FFF                              AND 0x0FFF, R10                  ; FAT32 entries are 28 bit
002024  839D  0020                                    MOVE R0, R8
002025  839E  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002026  83A0  FFA0  0005                              RBRA _SDB_FN_RET, 1
002027                    
002028  83A2  FFB0  FD04  _SDB_FN_SDE                 RSUB SDB_SDERR, 1
002029  83A4  0020        _SDB_FN_ERR                 MOVE R0, R8
002030  83A5  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002031  83A7  E100        _SDB_FN_RET                 DECRB
002032  83A8  0DBC                                    MOVE @R13++, R15
002033                    
002034                    ; ----------------------------------------------------------------------------
002035                    ; Block transfers
002036                    ; ----------------------------------------------------------------------------
002037                    
002038                    ; SDB_SD2VD
002039                    ; Copies the 512 bytes in the buffer of the SD controller into the internal
002040                    ; block buffer of a virtual drive. Device and 4k window selection are hoisted
002041                    ; out of the loop, which is what makes this about twenty times faster than
002042                    ; the original per-byte VD_CAD_WRITE sequence.
002043                    ;
002044                    ; Input: R8: virtual drive number (only used for the vdrives device select)
002045                    ; Output: none, all registers unchanged
002046  83A9  E0C0        SDB_SD2VD                   INCRB
002047  83AA  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002048  83AC  0F84  859A                              MOVE VDRIVES_DEVICE, R1
002049  83AE  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002050  83AF  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0
002051  83B1  0F81  0000                              MOVE VD_WIN_CAD, @R0             ; control and data registers
002052                    
002053  83B3  0F80  FF22                              MOVE IO$SD_DATA_POS, R0
002054  83B5  0F84  FF23                              MOVE IO$SD_DATA, R1
002055  83B7  0F88  7005                              MOVE VD_B_ADDR, R2
002056  83B9  0F8C  7006                              MOVE VD_B_DOUT, R3
002057  83BB  0F90  7007                              MOVE VD_B_WREN, R4
002058  83BD  B514                                    XOR R5, R5
002059  83BE  0501        _SDB_S2V_L                  MOVE R5, @R0                     ; position in the SD buffer
002060  83BF  0509                                    MOVE R5, @R2                     ; address in the drive buffer
002061  83C0  014D                                    MOVE @R1, @R3                    ; the byte itself
002062  83C1  0F91  0001                              MOVE 1, @R4                      ; strobe write enable
002063  83C3  0F91  0000                              MOVE 0, @R4
002064  83C5  1F94  0001                              ADD 1, R5
002065  83C7  CF94  0200                              CMP 0x0200, R5
002066  83C9  FFAB  FFF3                              RBRA _SDB_S2V_L, !Z
002067  83CB  E100                                    DECRB
002068  83CC  0DBC                                    MOVE @R13++, R15
002069                    
002070                    ; SDB_VD2SD
002071                    ; Copies the 512 bytes from the internal block buffer of a virtual drive into
002072                    ; the buffer of the SD controller. The drive buffer address register lives in
002073                    ; the control/data window while the data register lives in the drive window,
002074                    ; so the window selector has to be toggled per byte; the device selection is
002075                    ; still hoisted out of the loop.
002076                    ;
002077                    ; Input: R8: virtual drive number
002078                    ; Output: none, all registers unchanged
002079  83CD  E0C0        SDB_VD2SD                   INCRB
002080  83CE  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002081  83D0  0F84  859A                              MOVE VDRIVES_DEVICE, R1
002082  83D2  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002083                    
002084  83D3  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002085  83D5  0F84  0001                              MOVE VD_WIN_DRV, R1
002086  83D7  1804                                    ADD R8, R1                       ; R1: window of this drive
002087  83D8  0F88  FF22                              MOVE IO$SD_DATA_POS, R2
002088  83DA  0F8C  FF23                              MOVE IO$SD_DATA, R3
002089  83DC  0F90  7005                              MOVE VD_B_ADDR, R4
002090  83DE  0F94  700B                              MOVE VD_B_DIN, R5
002091  83E0  B618                                    XOR R6, R6
002092  83E1  0F81  0000  _SDB_V2S_L                  MOVE VD_WIN_CAD, @R0             ; control and data registers
002093  83E3  0611                                    MOVE R6, @R4                     ; address in the drive buffer
002094  83E4  0101                                    MOVE R1, @R0                     ; drive specific registers
002095  83E5  0609                                    MOVE R6, @R2                     ; position in the SD buffer
002096  83E6  054D                                    MOVE @R5, @R3                    ; the byte itself
002097  83E7  1F98  0001                              ADD 1, R6
002098  83E9  CF98  0200                              CMP 0x0200, R6
002099  83EB  FFAB  FFF4                              RBRA _SDB_V2S_L, !Z
002100  83ED  E100                                    DECRB
002101  83EE  0DBC                                    MOVE @R13++, R15
002102                    
002103                    ; SDB_SD2DEV
002104                    ; Copies the 512 bytes in the buffer of the SD controller into an M2M byte
002105                    ; streaming device (a CRT/ROM load target), handling the 4k window boundary.
002106                    ;
002107                    ; Input: R8: target device id
002108                    ; R9: target 4k window
002109                    ; R10: target address within the window (M2M$RAMROM_DATA based)
002110                    ; Output: R9/R10: window and address behind the last written byte
002111                    ; R8 unchanged
002112  83EF  E0C0        SDB_SD2DEV                  INCRB
002113  83F0  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002114  83F2  0801                                    MOVE R8, @R0
002115  83F3  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002116  83F5  0901                                    MOVE R9, @R0
002117  83F6  0F84  FF22                              MOVE IO$SD_DATA_POS, R1
002118  83F8  0F88  FF23                              MOVE IO$SD_DATA, R2
002119  83FA  0F8C  7000                              MOVE M2M$RAMROM_DATA, R3
002120  83FC  1F8C  1000                              ADD 0x1000, R3                   ; R3: end of window marker
002121  83FE  B410                                    XOR R4, R4                       ; R4: position in the SD buf
002122  83FF  0F94  0200                              MOVE 0x0200, R5                  ; R5: bytes still to go
002123                                                ; One instruction has to sit between writing IO$SD_DATA_POS
002124                                                ; and reading IO$SD_DATA, exactly like SD$READ_BYTE does: the
002125                                                ; buffer is a block RAM with a registered output, see
002126                                                ; M2M/QNICE/vhdl/byte_bram.vhd. The ADD below is that
002127                                                ; instruction and does useful work at the same time.
002128  8401  0405        _SDB_S2D_L                  MOVE R4, @R1                     ; position in the SD buffer
002129  8402  1F90  0001                              ADD 1, R4
002130  8404  026A                                    MOVE @R2, @R10++                 ; the byte itself
002131  8405  C328                                    CMP R3, R10                      ; 4k window boundary?
002132  8406  FFAB  0005                              RBRA _SDB_S2D_1, !Z              ; no
002133  8408  0FA8  7000                              MOVE M2M$RAMROM_DATA, R10        ; yes: next window
002134  840A  1FA4  0001                              ADD 1, R9
002135  840C  0901                                    MOVE R9, @R0
002136  840D  3F94  0001  _SDB_S2D_1                  SUB 1, R5
002137  840F  FFAB  FFF0                              RBRA _SDB_S2D_L, !Z
002138  8411  E100                                    DECRB
002139  8412  0DBC                                    MOVE @R13++, R15
002140                    
002141                    ; ----------------------------------------------------------------------------
002142                    ; High level entry points
002143                    ; ----------------------------------------------------------------------------
002144                    
002145                    ; SDB_VD_RDBLK
002146                    ; Prepares one virtual drive block read: maps the byte position to an LBA and
002147                    ; reads that block into the buffer of the SD controller. On success the
002148                    ; caller acknowledges sd_rd_i and then calls SDB_SD2VD.
002149                    ;
002150                    ; Input: R8: virtual drive number
002151                    ; R9: file handle of the disk image
002152                    ; R10/R11: byte position within the image, lo/hi
002153                    ; R12: amount of bytes the core asked for
002154                    ; Output: Carry=1: the block is in the buffer of the SD controller
002155                    ; Carry=0: use the FAT32 library path instead
002156                    ; R8 .. R12 unchanged
002157  8413  E0C0        SDB_VD_RDBLK                INCRB
002158  8414  0800                                    MOVE R8, R0
002159  8415  0904                                    MOVE R9, R1
002160  8416  0A08                                    MOVE R10, R2
002161  8417  0B0C                                    MOVE R11, R3
002162  8418  0C10                                    MOVE R12, R4
002163  8419  FFB0  0068                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002164  841B  FFAA  0021                              RBRA _SDB_VRD_NO, !C
002165  841D  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002166  841E  0A18                                    MOVE R10, R6
002167  841F  FFB0  FC8E                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002168  8421  FFAA  0017                              RBRA _SDB_VRD_GRD, !C            ; no: nothing was touched
002169  8423  0520                                    MOVE R5, R8
002170  8424  0624                                    MOVE R6, R9
002171  8425  FFB0  FC7B                              RSUB SDB_SDRD, 1
002172  8427  CFA0  0000                              CMP 0, R8
002173  8429  FFAB  0005                              RBRA _SDB_VRD_SDE, !Z            ; SD error: try the slow path
002174  842B  0020                                    MOVE R0, R8
002175  842C  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002176  842E  FFA0  0011                              RBRA _SDB_VRD_R, 1
002177  8430  FFB0  FC76  _SDB_VRD_SDE                RSUB SDB_SDERR, 1
002178  8432  FFB0  FCC4                              RSUB SDB_GUARD_OUT, 1
002179  8434  0FA0  864B                              MOVE SDB_RD_STAT, R8
002180  8436  0FA1  0006                              MOVE SDB_R_SDERR, @R8
002181  8438  FFA0  0004                              RBRA _SDB_VRD_NO, 1
002182  843A  0FA0  864B  _SDB_VRD_GRD                MOVE SDB_RD_STAT, R8
002183  843C  0FA1  0005                              MOVE SDB_R_GUARD, @R8
002184  843E  0020        _SDB_VRD_NO                 MOVE R0, R8
002185  843F  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002186  8441  0124        _SDB_VRD_R                  MOVE R1, R9
002187  8442  0228                                    MOVE R2, R10
002188  8443  032C                                    MOVE R3, R11
002189  8444  0430                                    MOVE R4, R12
002190  8445  E100                                    DECRB
002191  8446  0DBC                                    MOVE @R13++, R15
002192                    
002193                    ; SDB_VD_RDDONE
002194                    ; Called by HANDLE_DRV_RD after SDB_SD2VD has emptied the buffer: puts the
002195                    ; FAT32 library's sector back into it.
002196                    ;
002197                    ; Input: none
002198                    ; Output: none, all registers unchanged
002199  8447  FFB0  FCAF  SDB_VD_RDDONE               RSUB SDB_GUARD_OUT, 1
002200  8449  0DBC                                    MOVE @R13++, R15
002201                    
002202                    ; SDB_VD_WRBLK
002203                    ; Writes one virtual drive block: maps the byte position to an LBA, copies
002204                    ; the internal block buffer of the drive into the buffer of the SD controller
002205                    ; and writes it. The caller acknowledges sd_wr_i afterwards.
002206                    ;
002207                    ; Input: R8: virtual drive number
002208                    ; R9: file handle of the disk image
002209                    ; R10/R11: byte position within the image, lo/hi
002210                    ; R12: amount of bytes the core wants to write
002211                    ; Output: Carry=1: the block has been written to the SD card
002212                    ; Carry=0: nothing was written, use the FAT32 library path instead
002213                    ; R8 .. R12 unchanged
002214  844A  E0C0        SDB_VD_WRBLK                INCRB
002215  844B  0800                                    MOVE R8, R0
002216  844C  0904                                    MOVE R9, R1
002217  844D  0A08                                    MOVE R10, R2
002218  844E  0B0C                                    MOVE R11, R3
002219  844F  0C10                                    MOVE R12, R4
002220  8450  FFB0  0031                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002221  8452  FFAA  0026                              RBRA _SDB_VWR_NO, !C
002222  8454  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002223  8455  0A18                                    MOVE R10, R6
002224  8456  FFB0  FC57                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002225  8458  FFAA  001C                              RBRA _SDB_VWR_GRD, !C            ; no: nothing was touched
002226  845A  0020                                    MOVE R0, R8
002227  845B  FFB0  FF70                              RSUB SDB_VD2SD, 1
002228  845D  0520                                    MOVE R5, R8
002229  845E  0624                                    MOVE R6, R9
002230  845F  FFB0  FC44                              RSUB SDB_SDWR, 1
002231  8461  CFA0  0000                              CMP 0, R8
002232  8463  FFAB  0007                              RBRA _SDB_VWR_SDE, !Z
002233  8465  FFB0  FC91                              RSUB SDB_GUARD_OUT, 1            ; the write is done, restore
002234  8467  0020                                    MOVE R0, R8
002235  8468  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002236  846A  FFA0  0011                              RBRA _SDB_VWR_R, 1
002237  846C  FFB0  FC3A  _SDB_VWR_SDE                RSUB SDB_SDERR, 1                ; SD error: try the slow path
002238  846E  FFB0  FC88                              RSUB SDB_GUARD_OUT, 1
002239  8470  0FA0  864B                              MOVE SDB_RD_STAT, R8
002240  8472  0FA1  0006                              MOVE SDB_R_SDERR, @R8
002241  8474  FFA0  0004                              RBRA _SDB_VWR_NO, 1
002242  8476  0FA0  864B  _SDB_VWR_GRD                MOVE SDB_RD_STAT, R8
002243  8478  0FA1  0005                              MOVE SDB_R_GUARD, @R8
002244  847A  0020        _SDB_VWR_NO                 MOVE R0, R8
002245  847B  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002246  847D  0124        _SDB_VWR_R                  MOVE R1, R9
002247  847E  0228                                    MOVE R2, R10
002248  847F  032C                                    MOVE R3, R11
002249  8480  0430                                    MOVE R4, R12
002250  8481  E100                                    DECRB
002251  8482  0DBC                                    MOVE @R13++, R15
002252                    
002253                    ; Common preparation for SDB_VD_RDBLK / SDB_VD_WRBLK. Expects the inputs in
002254                    ; the caller's R0 (drive), R1 (FDH), R2/R3 (byte position) and R4 (amount of
002255                    ; bytes) and returns Carry=1 plus the LBA in R9/R10. Runs in the caller's
002256                    ; register bank on purpose. Touches nothing outside our own variables.
002257  8483  0FAC  864B  _SDB_PREP                   MOVE SDB_RD_STAT, R11
002258  8485  0FAD  0001                              MOVE SDB_R_SIZE, @R11
002259  8487  0FA0  0200                              MOVE 0x0200, R8
002260  8489  C420                                    CMP R4, R8                       ; exactly one block?
002261  848A  FFAB  0026                              RBRA _SDB_PREP_NO, !Z            ; no: let the FAT32 path do
002262  848C  0FAD  0002                              MOVE SDB_R_ALIGN, @R11           ; ..partial/multi blocks
002263  848E  0220                                    MOVE R2, R8
002264  848F  9FA0  01FF                              AND 0x01FF, R8                   ; block aligned?
002265  8491  FFAB  001F                              RBRA _SDB_PREP_NO, !Z            ; no
002266  8493  0FAD  0003                              MOVE SDB_R_MAP, @R11
002267  8495  0020                                    MOVE R0, R8
002268  8496  FFB0  FBDE                              RSUB SDB_VDMAP, 1
002269  8498  0830                                    MOVE R8, R12                     ; R12: map (R11 stays the..
002270  8499  0124                                    MOVE R1, R9                      ; ..status pointer)
002271  849A  FFB0  FBF3                              RSUB SDB_CHECK, 1
002272  849C  FFAA  0014                              RBRA _SDB_PREP_NO, !C
002273  849E  0FAD  0004                              MOVE SDB_R_RANGE, @R11
002274  84A0  0224                                    MOVE R2, R9
002275  84A1  0328                                    MOVE R3, R10
002276  84A2  FFB0  FC8A                              RSUB SDB_B2BLK, 1
002277  84A4  0C20                                    MOVE R12, R8
002278  84A5  FFB0  FD00                              RSUB SDB_LBA, 1
002279  84A7  FFAA  0009                              RBRA _SDB_PREP_NO, !C
002280  84A9  0FA0  864C                              MOVE SDB_RD_LBA, R8              ; remember it for the log
002281  84AB  0922                                    MOVE R9, @R8++
002282  84AC  0A21                                    MOVE R10, @R8
002283  84AD  0FAD  0000                              MOVE SDB_R_OK, @R11
002284  84AF  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002285  84B1  0DBC                                    MOVE @R13++, R15
002286  84B2  9FB8  FFFB  _SDB_PREP_NO                AND 0xFFFB, R14                  ; clear Carry
002287  84B4  0DBC                                    MOVE @R13++, R15
002288                    
002289                    ; SDB_FREAD_FAST
002290                    ; Streams whole 512-byte blocks of a mapped file directly from the SD card
002291                    ; into an M2M byte streaming device and then positions the file handle right
002292                    ; behind them, so that the caller's byte loop reads the rest as usual.
002293                    ;
002294                    ; It deliberately stops one whole block short of the end of the file, so that
002295                    ; the position it hands over is always strictly inside the file and the
002296                    ; caller reaches EOF through the FAT32 library, exactly as before.
002297                    ;
002298                    ; The final f32_fseek is what restores the library: a seek unconditionally
002299                    ; re-reads the sector into the hardware buffer and re-claims ownership, so
002300                    ; afterwards the library is in a state it produced itself. If anything at all
002301                    ; goes wrong the file position is put back where it was and Carry=0 is
002302                    ; returned, i.e. the caller sees "nothing happened".
002303                    ;
002304                    ; Input: R8: file handle (FDH)
002305                    ; R9: pointer to the block map
002306                    ; R10: target device id
002307                    ; R11: target 4k window
002308                    ; R12: target address within the window
002309                    ; Output: Carry=1: R11/R12 updated, the file position is behind the data
002310                    ; Carry=0: nothing was transferred, the file position is unchanged
002311                    ; and R11/R12 are unchanged
002312  84B5  E0C0        SDB_FREAD_FAST              INCRB
002313  84B6  0800                                    MOVE R8, R0                      ; R0: FDH
002314  84B7  0904                                    MOVE R9, R1                      ; R1: map
002315  84B8  0A08                                    MOVE R10, R2                     ; R2: target device
002316  84B9  0B0C                                    MOVE R11, R3                     ; R3: target 4k window
002317  84BA  0C10                                    MOVE R12, R4                     ; R4: target address
002318                    
002319  84BB  0FA0  8649                              MOVE SDB_FF_STAT, R8
002320  84BD  0FA1  0001                              MOVE SDB_B_NOMAP, @R8
002321  84BF  0FA0  864A                              MOVE SDB_FF_BLKS, R8
002322  84C1  0FA1  0000                              MOVE 0, @R8
002323                    
002324  84C3  0120                                    MOVE R1, R8
002325  84C4  0024                                    MOVE R0, R9
002326  84C5  FFB0  FBC8                              RSUB SDB_CHECK, 1
002327  84C7  FFAA  0090                              RBRA _SDBFF_NO, !C
002328                    
002329                                                ; only from the very beginning of the file
002330  84C9  0020                                    MOVE R0, R8
002331  84CA  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002332  84CC  CFA1  0000                              CMP 0, @R8
002333  84CE  FFAB  0089                              RBRA _SDBFF_NO, !Z
002334  84D0  0020                                    MOVE R0, R8
002335  84D1  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002336  84D3  CFA1  0000                              CMP 0, @R8
002337  84D5  FFAB  0082                              RBRA _SDBFF_NO, !Z
002338                    
002339                                                ; how many whole blocks do we take? Always one less than the
002340                                                ; file has, so that the handover position is strictly inside
002341                                                ; the file and the caller still reaches EOF through the
002342                                                ; library. A CRT/ROM file is never 32 MB or larger, so one
002343                                                ; word of block count is plenty and anything else is refused.
002344  84D7  0120                                    MOVE R1, R8
002345  84D8  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
002346  84DA  CFA1  0000                              CMP 0, @R8
002347  84DC  FFAB  007B                              RBRA _SDBFF_NO, !Z
002348  84DE  0120                                    MOVE R1, R8
002349  84DF  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
002350  84E1  085C                                    MOVE @R8, R7                     ; R7: blocks still to do
002351  84E2  3F9C  0001                              SUB 1, R7
002352  84E4  FFA3  0073                              RBRA _SDBFF_NO, Z                ; a one block file: byte loop
002353  84E6  FFA4  0071                              RBRA _SDBFF_NO, N                ; cannot happen: TBLK was 0
002354                    
002355  84E8  0FA0  8649                              MOVE SDB_FF_STAT, R8
002356  84EA  0FA1  000B                              MOVE SDB_B_GUARD, @R8
002357  84EC  FFB0  FBC1                              RSUB SDB_GUARD_IN, 1             ; nothing touched if it fails
002358  84EE  FFAA  0069                              RBRA _SDBFF_NO, !C
002359                    
002360  84F0  B514                                    XOR R5, R5                       ; R5/R6: block index
002361  84F1  B618                                    XOR R6, R6
002362                    
002363  84F2  CF9C  0000  _SDBFF_LOOP                 CMP 0, R7
002364  84F4  FFA3  0020                              RBRA _SDBFF_DONE, Z
002365  84F6  0120                                    MOVE R1, R8
002366  84F7  0524                                    MOVE R5, R9
002367  84F8  0628                                    MOVE R6, R10
002368  84F9  FFB0  FCAC                              RSUB SDB_LBA, 1
002369  84FB  FFAA  0019                              RBRA _SDBFF_DONE, !C
002370                    
002371                    
002372                    
002373                    
002374  84FD  0920                                    MOVE R9, R8
002375  84FE  0A24                                    MOVE R10, R9
002376  84FF  FFB0  FBA1                              RSUB SDB_SDRD, 1
002377  8501  CFA0  0000                              CMP 0, R8
002378  8503  FFAB  000F                              RBRA _SDBFF_SDE, !Z              ; SD error: stop here
002379  8505  0220                                    MOVE R2, R8
002380  8506  0324                                    MOVE R3, R9
002381  8507  0428                                    MOVE R4, R10
002382  8508  FFB0  FEE5                              RSUB SDB_SD2DEV, 1
002383  850A  090C                                    MOVE R9, R3
002384  850B  0A10                                    MOVE R10, R4
002385  850C  1F94  0001                              ADD 1, R5
002386  850E  2F98  0000                              ADDC 0, R6
002387  8510  3F9C  0001                              SUB 1, R7
002388  8512  FFA0  FFDE                              RBRA _SDBFF_LOOP, 1
002389                    
002390  8514  FFB0  FB92  _SDBFF_SDE                  RSUB SDB_SDERR, 1
002391                    
002392                                                ; the hardware buffer is ours now; whatever we do next, the
002393                                                ; library has to be put back. A seek does that properly.
002394  8516  0FA0  864A  _SDBFF_DONE                 MOVE SDB_FF_BLKS, R8
002395  8518  0521                                    MOVE R5, @R8
002396  8519  CF94  0000                              CMP 0, R5                        ; anything transferred?
002397  851B  FFAB  0004                              RBRA _SDBFF_SEEK, !Z
002398  851D  CF98  0000                              CMP 0, R6
002399  851F  FFA3  0029                              RBRA _SDBFF_REW, Z               ; no: just put it back
002400                    
002401  8521  0FA0  8649  _SDBFF_SEEK                 MOVE SDB_FF_STAT, R8
002402  8523  0FA1  000C                              MOVE SDB_B_SEEK, @R8
002403  8525  0524                                    MOVE R5, R9                      ; file position = blocks * 512
002404  8526  0628                                    MOVE R6, R10
002405  8527  FFB0  FC18                              RSUB SDB_BLK2B, 1
002406  8529  092C                                    MOVE R9, R11                     ; R11/R12: expected position
002407  852A  0A30                                    MOVE R10, R12
002408  852B  0020                                    MOVE R0, R8
002409  852C  FF90  0054                              ASUB f32_fseek, 1
002410  852E  CFA4  0000                              CMP 0, R9                        ; seek reported success?
002411  8530  FFAB  0018                              RBRA _SDBFF_REW, !Z
002412  8532  0020                                    MOVE R0, R8                      ; ..and actually got there?
002413  8533  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002414  8535  C86C                                    CMP @R8, R11
002415  8536  FFAB  0012                              RBRA _SDBFF_REW, !Z
002416  8538  0020                                    MOVE R0, R8
002417  8539  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002418  853B  C870                                    CMP @R8, R12
002419  853C  FFAB  000C                              RBRA _SDBFF_REW, !Z
002420                    
002421  853E  0FA0  8649                              MOVE SDB_FF_STAT, R8
002422  8540  0FA1  0000                              MOVE SDB_B_OK, @R8
002423  8542  FFB0  FBC3                              RSUB SDB_GUARD_CLR, 1            ; the seek put the library..
002424  8544  032C                                    MOVE R3, R11                     ; ..back, nobody to tell
002425  8545  0430                                    MOVE R4, R12
002426  8546  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002427  8548  FFA0  0011                              RBRA _SDBFF_RET, 1
002428                    
002429                                                ; Put the file back to the start and report "nothing done".
002430                                                ; The caller has not seen the updated target pointers, so it
002431                                                ; simply overwrites whatever we already transferred. The seek
002432                                                ; also restores the library's sector buffer; if even that
002433                                                ; fails, the buffer is marked unknown.
002434  854A  0020        _SDBFF_REW                  MOVE R0, R8
002435  854B  B924                                    XOR R9, R9
002436  854C  BA28                                    XOR R10, R10
002437  854D  FF90  0054                              ASUB f32_fseek, 1
002438  854F  CFA4  0000                              CMP 0, R9
002439  8551  FFAB  0004                              RBRA _SDBFF_RW1, !Z
002440  8553  FFB0  FBB2                              RSUB SDB_GUARD_CLR, 1            ; the rewind put it back
002441  8555  FFA0  0002                              RBRA _SDBFF_NO, 1
002442  8557  FFB0  FBB5  _SDBFF_RW1                  RSUB SDB_ORPHAN, 1               ; not even that worked
002443                    
002444  8559  9FB8  FFFB  _SDBFF_NO                   AND 0xFFFB, R14                  ; clear Carry
002445  855B              _SDBFF_RET                  
002446  855B  E100                                    DECRB
002447  855C  0DBC                                    MOVE @R13++, R15
002448                    

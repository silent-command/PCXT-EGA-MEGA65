000869                    M2M$CFG_RP_J1_OSD           .EQU 0x7009                      ; connect the joystick 1 at OSD
000870                    M2M$CFG_RP_J2_OSD           .EQU 0x700A                      ; connect the joystick 2 at OSD
000871                    

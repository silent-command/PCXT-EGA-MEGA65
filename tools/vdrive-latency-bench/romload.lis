001955                    ; ----------------------------------------------------------------------------
001956                    ; Block transfers
001957                    ; ----------------------------------------------------------------------------
001958                    
001959                    ; SDB_SD2VD
001960                    ; Copies the 512 bytes in the buffer of the SD controller into the internal
001961                    ; block buffer of a virtual drive. Device and 4k window selection are hoisted
001962                    ; out of the loop, which is what makes this about twenty times faster than
001963                    ; the original per-byte VD_CAD_WRITE sequence.
001964                    ;
001965                    ; Input: R8: virtual drive number (only used for the vdrives device select)
001966                    ; Output: none, all registers unchanged
001967  83BD  E0C0        SDB_SD2VD                   INCRB
001968  83BE  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
001969  83C0  0F84  8580                              MOVE VDRIVES_DEVICE, R1
001970  83C2  0141                                    MOVE @R1, @R0                    ; select the vdrives device
001971  83C3  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0
001972  83C5  0F81  0000                              MOVE VD_WIN_CAD, @R0             ; control and data registers
001973                    
001974  83C7  0F80  FF22                              MOVE IO$SD_DATA_POS, R0
001975  83C9  0F84  FF23                              MOVE IO$SD_DATA, R1
001976  83CB  0F88  7005                              MOVE VD_B_ADDR, R2
001977  83CD  0F8C  7006                              MOVE VD_B_DOUT, R3
001978  83CF  0F90  7007                              MOVE VD_B_WREN, R4
001979  83D1  B514                                    XOR R5, R5
001980  83D2  0501        _SDB_S2V_L                  MOVE R5, @R0                     ; position in the SD buffer
001981  83D3  0509                                    MOVE R5, @R2                     ; address in the drive buffer
001982  83D4  014D                                    MOVE @R1, @R3                    ; the byte itself
001983  83D5  0F91  0001                              MOVE 1, @R4                      ; strobe write enable
001984  83D7  0F91  0000                              MOVE 0, @R4
001985  83D9  1F94  0001                              ADD 1, R5
001986  83DB  CF94  0200                              CMP 0x0200, R5
001987  83DD  FFAB  FFF3                              RBRA _SDB_S2V_L, !Z
001988  83DF  E100                                    DECRB
001989  83E0  0DBC                                    MOVE @R13++, R15
001990                    
001991                    ; SDB_VD2SD
001992                    ; Copies the 512 bytes from the internal block buffer of a virtual drive into
001993                    ; the buffer of the SD controller. The drive buffer address register lives in
001994                    ; the control/data window while the data register lives in the drive window,
001995                    ; so the window selector has to be toggled per byte; the device selection is
001996                    ; still hoisted out of the loop.
001997                    ;
001998                    ; Input: R8: virtual drive number
001999                    ; Output: none, all registers unchanged
002000  83E1  E0C0        SDB_VD2SD                   INCRB
002001  83E2  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002002  83E4  0F84  8580                              MOVE VDRIVES_DEVICE, R1
002003  83E6  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002004                    
002005  83E7  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002006  83E9  0F84  0001                              MOVE VD_WIN_DRV, R1
002007  83EB  1804                                    ADD R8, R1                       ; R1: window of this drive
002008  83EC  0F88  FF22                              MOVE IO$SD_DATA_POS, R2
002009  83EE  0F8C  FF23                              MOVE IO$SD_DATA, R3
002010  83F0  0F90  7005                              MOVE VD_B_ADDR, R4
002011  83F2  0F94  700B                              MOVE VD_B_DIN, R5
002012  83F4  B618                                    XOR R6, R6
002013  83F5  0F81  0000  _SDB_V2S_L                  MOVE VD_WIN_CAD, @R0             ; control and data registers
002014  83F7  0611                                    MOVE R6, @R4                     ; address in the drive buffer
002015  83F8  0101                                    MOVE R1, @R0                     ; drive specific registers
002016  83F9  0609                                    MOVE R6, @R2                     ; position in the SD buffer
002017  83FA  054D                                    MOVE @R5, @R3                    ; the byte itself
002018  83FB  1F98  0001                              ADD 1, R6
002019  83FD  CF98  0200                              CMP 0x0200, R6
002020  83FF  FFAB  FFF4                              RBRA _SDB_V2S_L, !Z
002021  8401  E100                                    DECRB
002022  8402  0DBC                                    MOVE @R13++, R15
002023                    
002024                    ; SDB_SD2DEV
002025                    ; Copies the 512 bytes in the buffer of the SD controller into an M2M byte
002026                    ; streaming device (a CRT/ROM load target), handling the 4k window boundary.
002027                    ;
002028                    ; Input: R8: target device id
002029                    ; R9: target 4k window
002030                    ; R10: target address within the window (M2M$RAMROM_DATA based)
002031                    ; Output: R9/R10: window and address behind the last written byte
002032                    ; R8 unchanged
002033  8403  E0C0        SDB_SD2DEV                  INCRB
002034  8404  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002035  8406  0801                                    MOVE R8, @R0
002036  8407  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002037  8409  0901                                    MOVE R9, @R0
002038  840A  0F84  FF22                              MOVE IO$SD_DATA_POS, R1
002039  840C  0F88  FF23                              MOVE IO$SD_DATA, R2
002040  840E  0F8C  7000                              MOVE M2M$RAMROM_DATA, R3
002041  8410  1F8C  1000                              ADD 0x1000, R3                   ; R3: end of window marker
002042  8412  B410                                    XOR R4, R4                       ; R4: position in the SD buf
002043  8413  0F94  0200                              MOVE 0x0200, R5                  ; R5: bytes still to go
002044                                                ; One instruction has to sit between writing IO$SD_DATA_POS
002045                                                ; and reading IO$SD_DATA, exactly like SD$READ_BYTE does: the
002046                                                ; buffer is a block RAM with a registered output, see
002047                                                ; M2M/QNICE/vhdl/byte_bram.vhd. The ADD below is that
002048                                                ; instruction and does useful work at the same time.
002049  8415  0405        _SDB_S2D_L                  MOVE R4, @R1                     ; position in the SD buffer
002050  8416  1F90  0001                              ADD 1, R4
002051  8418  026A                                    MOVE @R2, @R10++                 ; the byte itself
002052  8419  C328                                    CMP R3, R10                      ; 4k window boundary?
002053  841A  FFAB  0005                              RBRA _SDB_S2D_1, !Z              ; no
002054  841C  0FA8  7000                              MOVE M2M$RAMROM_DATA, R10        ; yes: next window
002055  841E  1FA4  0001                              ADD 1, R9
002056  8420  0901                                    MOVE R9, @R0
002057  8421  3F94  0001  _SDB_S2D_1                  SUB 1, R5
002058  8423  FFAB  FFF0                              RBRA _SDB_S2D_L, !Z
002059  8425  E100                                    DECRB
002060  8426  0DBC                                    MOVE @R13++, R15
002061                    
002062                    ; ----------------------------------------------------------------------------
002063                    ; High level entry points
002064                    ; ----------------------------------------------------------------------------
002065                    
002066                    ; SDB_VD_RDBLK
002067                    ; Prepares one virtual drive block read: maps the byte position to an LBA and
002068                    ; reads that block into the buffer of the SD controller. On success the
002069                    ; caller acknowledges sd_rd_i and then calls SDB_SD2VD.
002070                    ;
002071                    ; Input: R8: virtual drive number
002072                    ; R9: file handle of the disk image
002073                    ; R10/R11: byte position within the image, lo/hi
002074                    ; R12: amount of bytes the core asked for
002075                    ; Output: Carry=1: the block is in the buffer of the SD controller
002076                    ; Carry=0: use the FAT32 library path instead
002077                    ; R8 .. R12 unchanged
002078  8427  E0C0        SDB_VD_RDBLK                INCRB
002079  8428  0800                                    MOVE R8, R0
002080  8429  0904                                    MOVE R9, R1
002081  842A  0A08                                    MOVE R10, R2
002082  842B  0B0C                                    MOVE R11, R3
002083  842C  0C10                                    MOVE R12, R4
002084  842D  FFB0  0054                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002085  842F  FFAA  0017                              RBRA _SDB_VRD_NO, !C
002086  8431  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002087  8432  0A18                                    MOVE R10, R6
002088  8433  FFB0  FC74                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002089  8435  FFAA  0011                              RBRA _SDB_VRD_NO, !C             ; no: nothing was touched
002090  8437  0520                                    MOVE R5, R8
002091  8438  0624                                    MOVE R6, R9
002092  8439  FF90  003C                              ASUB sd_r_block, 1
002093  843B  CFA0  0000                              CMP 0, R8
002094  843D  FFAB  0005                              RBRA _SDB_VRD_SDE, !Z            ; SD error: try the slow path
002095  843F  0020                                    MOVE R0, R8
002096  8440  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002097  8442  FFA0  0007                              RBRA _SDB_VRD_R, 1
002098  8444  FFB0  FC5C  _SDB_VRD_SDE                RSUB SDB_SDERR, 1
002099  8446  FFB0  FCBB                              RSUB SDB_GUARD_OUT, 1
002100  8448  0020        _SDB_VRD_NO                 MOVE R0, R8
002101  8449  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002102  844B  0124        _SDB_VRD_R                  MOVE R1, R9
002103  844C  0228                                    MOVE R2, R10
002104  844D  032C                                    MOVE R3, R11
002105  844E  0430                                    MOVE R4, R12
002106  844F  E100                                    DECRB
002107  8450  0DBC                                    MOVE @R13++, R15
002108                    
002109                    ; SDB_VD_RDDONE
002110                    ; Called by HANDLE_DRV_RD after SDB_SD2VD has emptied the buffer: puts the
002111                    ; FAT32 library's sector back into it.
002112                    ;
002113                    ; Input: none
002114                    ; Output: none, all registers unchanged
002115  8451  FFB0  FCB0  SDB_VD_RDDONE               RSUB SDB_GUARD_OUT, 1
002116  8453  0DBC                                    MOVE @R13++, R15
002117                    
002118                    ; SDB_VD_WRBLK
002119                    ; Writes one virtual drive block: maps the byte position to an LBA, copies
002120                    ; the internal block buffer of the drive into the buffer of the SD controller
002121                    ; and writes it. The caller acknowledges sd_wr_i afterwards.
002122                    ;
002123                    ; Input: R8: virtual drive number
002124                    ; R9: file handle of the disk image
002125                    ; R10/R11: byte position within the image, lo/hi
002126                    ; R12: amount of bytes the core wants to write
002127                    ; Output: Carry=1: the block has been written to the SD card
002128                    ; Carry=0: nothing was written, use the FAT32 library path instead
002129                    ; R8 .. R12 unchanged
002130  8454  E0C0        SDB_VD_WRBLK                INCRB
002131  8455  0800                                    MOVE R8, R0
002132  8456  0904                                    MOVE R9, R1
002133  8457  0A08                                    MOVE R10, R2
002134  8458  0B0C                                    MOVE R11, R3
002135  8459  0C10                                    MOVE R12, R4
002136  845A  FFB0  0027                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002137  845C  FFAA  001C                              RBRA _SDB_VWR_NO, !C
002138  845E  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002139  845F  0A18                                    MOVE R10, R6
002140  8460  FFB0  FC47                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002141  8462  FFAA  0016                              RBRA _SDB_VWR_NO, !C             ; no: nothing was touched
002142  8464  0020                                    MOVE R0, R8
002143  8465  FFB0  FF7A                              RSUB SDB_VD2SD, 1
002144  8467  0520                                    MOVE R5, R8
002145  8468  0624                                    MOVE R6, R9
002146  8469  FF90  003E                              ASUB sd_w_block, 1
002147  846B  CFA0  0000                              CMP 0, R8
002148  846D  FFAB  0007                              RBRA _SDB_VWR_SDE, !Z
002149  846F  FFB0  FC92                              RSUB SDB_GUARD_OUT, 1            ; the write is done, restore
002150  8471  0020                                    MOVE R0, R8
002151  8472  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002152  8474  FFA0  0007                              RBRA _SDB_VWR_R, 1
002153  8476  FFB0  FC2A  _SDB_VWR_SDE                RSUB SDB_SDERR, 1                ; SD error: try the slow path
002154  8478  FFB0  FC89                              RSUB SDB_GUARD_OUT, 1
002155  847A  0020        _SDB_VWR_NO                 MOVE R0, R8
002156  847B  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002157  847D  0124        _SDB_VWR_R                  MOVE R1, R9
002158  847E  0228                                    MOVE R2, R10
002159  847F  032C                                    MOVE R3, R11
002160  8480  0430                                    MOVE R4, R12
002161  8481  E100                                    DECRB
002162  8482  0DBC                                    MOVE @R13++, R15
002163                    
002164                    ; Common preparation for SDB_VD_RDBLK / SDB_VD_WRBLK. Expects the inputs in
002165                    ; the caller's R0 (drive), R1 (FDH), R2/R3 (byte position) and R4 (amount of
002166                    ; bytes) and returns Carry=1 plus the LBA in R9/R10. Runs in the caller's
002167                    ; register bank on purpose. Touches nothing outside our own variables.
002168  8483  0FA0  0200  _SDB_PREP                   MOVE 0x0200, R8
002169  8485  C420                                    CMP R4, R8                       ; exactly one block?
002170  8486  FFAB  0016                              RBRA _SDB_PREP_NO, !Z            ; no: let the FAT32 path do
002171  8488  0220                                    MOVE R2, R8                      ; ..partial/multi blocks
002172  8489  9FA0  01FF                              AND 0x01FF, R8                   ; block aligned?
002173  848B  FFAB  0011                              RBRA _SDB_PREP_NO, !Z            ; no
002174  848D  0020                                    MOVE R0, R8
002175  848E  FFB0  FBE6                              RSUB SDB_VDMAP, 1
002176  8490  082C                                    MOVE R8, R11                     ; R11: map
002177  8491  0124                                    MOVE R1, R9
002178  8492  FFB0  FBFB                              RSUB SDB_CHECK, 1
002179  8494  FFAA  0008                              RBRA _SDB_PREP_NO, !C
002180  8496  0224                                    MOVE R2, R9
002181  8497  0328                                    MOVE R3, R10
002182  8498  FFB0  FCA8                              RSUB SDB_B2BLK, 1
002183  849A  0B20                                    MOVE R11, R8
002184  849B  FFB0  FD1E                              RSUB SDB_LBA, 1                  ; sets/clears Carry
002185  849D  0DBC                                    MOVE @R13++, R15
002186  849E  9FB8  FFFB  _SDB_PREP_NO                AND 0xFFFB, R14                  ; clear Carry
002187  84A0  0DBC                                    MOVE @R13++, R15
002188                    
002189                    ; SDB_FREAD_FAST
002190                    ; Streams whole 512-byte blocks of a mapped file directly from the SD card
002191                    ; into an M2M byte streaming device and then positions the file handle right
002192                    ; behind them, so that the caller's byte loop reads the rest as usual.
002193                    ;
002194                    ; It deliberately stops one whole block short of the end of the file, so that
002195                    ; the position it hands over is always strictly inside the file and the
002196                    ; caller reaches EOF through the FAT32 library, exactly as before.
002197                    ;
002198                    ; The final f32_fseek is what restores the library: a seek unconditionally
002199                    ; re-reads the sector into the hardware buffer and re-claims ownership, so
002200                    ; afterwards the library is in a state it produced itself. If anything at all
002201                    ; goes wrong the file position is put back where it was and Carry=0 is
002202                    ; returned, i.e. the caller sees "nothing happened".
002203                    ;
002204                    ; Input: R8: file handle (FDH)
002205                    ; R9: pointer to the block map
002206                    ; R10: target device id
002207                    ; R11: target 4k window
002208                    ; R12: target address within the window
002209                    ; Output: Carry=1: R11/R12 updated, the file position is behind the data
002210                    ; Carry=0: nothing was transferred, the file position is unchanged
002211                    ; and R11/R12 are unchanged
002212  84A1  E0C0        SDB_FREAD_FAST              INCRB
002213  84A2  0800                                    MOVE R8, R0                      ; R0: FDH
002214  84A3  0904                                    MOVE R9, R1                      ; R1: map
002215  84A4  0A08                                    MOVE R10, R2                     ; R2: target device
002216  84A5  0B0C                                    MOVE R11, R3                     ; R3: target 4k window
002217  84A6  0C10                                    MOVE R12, R4                     ; R4: target address
002218                    
002219  84A7  0FA0  8631                              MOVE SDB_FF_STAT, R8
002220  84A9  0FA1  0001                              MOVE SDB_B_NOMAP, @R8
002221  84AB  0FA0  8632                              MOVE SDB_FF_BLKS, R8
002222  84AD  0FA1  0000                              MOVE 0, @R8
002223                    
002224  84AF  0120                                    MOVE R1, R8
002225  84B0  0024                                    MOVE R0, R9
002226  84B1  FFB0  FBDC                              RSUB SDB_CHECK, 1
002227  84B3  FFAA  008A                              RBRA _SDBFF_NO, !C
002228                    
002229                                                ; only from the very beginning of the file
002230  84B5  0020                                    MOVE R0, R8
002231  84B6  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002232  84B8  CFA1  0000                              CMP 0, @R8
002233  84BA  FFAB  0083                              RBRA _SDBFF_NO, !Z
002234  84BC  0020                                    MOVE R0, R8
002235  84BD  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002236  84BF  CFA1  0000                              CMP 0, @R8
002237  84C1  FFAB  007C                              RBRA _SDBFF_NO, !Z
002238                    
002239                                                ; how many whole blocks do we take? Always one less than the
002240                                                ; file has, so that the handover position is strictly inside
002241                                                ; the file and the caller still reaches EOF through the
002242                                                ; library. A CRT/ROM file is never 32 MB or larger, so one
002243                                                ; word of block count is plenty and anything else is refused.
002244  84C3  0120                                    MOVE R1, R8
002245  84C4  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
002246  84C6  CFA1  0000                              CMP 0, @R8
002247  84C8  FFAB  0075                              RBRA _SDBFF_NO, !Z
002248  84CA  0120                                    MOVE R1, R8
002249  84CB  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
002250  84CD  085C                                    MOVE @R8, R7                     ; R7: blocks still to do
002251  84CE  3F9C  0001                              SUB 1, R7
002252  84D0  FFA3  006D                              RBRA _SDBFF_NO, Z                ; a one block file: byte loop
002253  84D2  FFA4  006B                              RBRA _SDBFF_NO, N                ; cannot happen: TBLK was 0
002254                    
002255  84D4  0FA0  8631                              MOVE SDB_FF_STAT, R8
002256  84D6  0FA1  000B                              MOVE SDB_B_GUARD, @R8
002257  84D8  FFB0  FBCF                              RSUB SDB_GUARD_IN, 1             ; nothing touched if it fails
002258  84DA  FFAA  0063                              RBRA _SDBFF_NO, !C
002259                    
002260  84DC  B514                                    XOR R5, R5                       ; R5/R6: block index
002261  84DD  B618                                    XOR R6, R6
002262                    
002263  84DE  CF9C  0000  _SDBFF_LOOP                 CMP 0, R7
002264  84E0  FFA3  0020                              RBRA _SDBFF_DONE, Z
002265  84E2  0120                                    MOVE R1, R8
002266  84E3  0524                                    MOVE R5, R9
002267  84E4  0628                                    MOVE R6, R10
002268  84E5  FFB0  FCD4                              RSUB SDB_LBA, 1
002269  84E7  FFAA  0019                              RBRA _SDBFF_DONE, !C
002270                    
002271                    
002272                    
002273                    
002274  84E9  0920                                    MOVE R9, R8
002275  84EA  0A24                                    MOVE R10, R9
002276  84EB  FF90  003C                              ASUB sd_r_block, 1
002277  84ED  CFA0  0000                              CMP 0, R8
002278  84EF  FFAB  000F                              RBRA _SDBFF_SDE, !Z              ; SD error: stop here
002279  84F1  0220                                    MOVE R2, R8
002280  84F2  0324                                    MOVE R3, R9
002281  84F3  0428                                    MOVE R4, R10
002282  84F4  FFB0  FF0D                              RSUB SDB_SD2DEV, 1
002283  84F6  090C                                    MOVE R9, R3
002284  84F7  0A10                                    MOVE R10, R4
002285  84F8  1F94  0001                              ADD 1, R5
002286  84FA  2F98  0000                              ADDC 0, R6
002287  84FC  3F9C  0001                              SUB 1, R7
002288  84FE  FFA0  FFDE                              RBRA _SDBFF_LOOP, 1
002289                    
002290  8500  FFB0  FBA0  _SDBFF_SDE                  RSUB SDB_SDERR, 1
002291                    
002292                                                ; the hardware buffer is ours now; whatever we do next, the
002293                                                ; library has to be put back. A seek does that properly.
002294  8502  0FA0  8632  _SDBFF_DONE                 MOVE SDB_FF_BLKS, R8
002295  8504  0521                                    MOVE R5, @R8
002296  8505  CF94  0000                              CMP 0, R5                        ; anything transferred?
002297  8507  FFAB  0004                              RBRA _SDBFF_SEEK, !Z
002298  8509  CF98  0000                              CMP 0, R6
002299  850B  FFA3  0027                              RBRA _SDBFF_REW, Z               ; no: just put it back
002300                    
002301  850D  0FA0  8631  _SDBFF_SEEK                 MOVE SDB_FF_STAT, R8
002302  850F  0FA1  000C                              MOVE SDB_B_SEEK, @R8
002303  8511  0524                                    MOVE R5, R9                      ; file position = blocks * 512
002304  8512  0628                                    MOVE R6, R10
002305  8513  FFB0  FC40                              RSUB SDB_BLK2B, 1
002306  8515  092C                                    MOVE R9, R11                     ; R11/R12: expected position
002307  8516  0A30                                    MOVE R10, R12
002308  8517  0020                                    MOVE R0, R8
002309  8518  FF90  0054                              ASUB f32_fseek, 1
002310  851A  CFA4  0000                              CMP 0, R9                        ; seek reported success?
002311  851C  FFAB  0016                              RBRA _SDBFF_REW, !Z
002312  851E  0020                                    MOVE R0, R8                      ; ..and actually got there?
002313  851F  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002314  8521  C86C                                    CMP @R8, R11
002315  8522  FFAB  0010                              RBRA _SDBFF_REW, !Z
002316  8524  0020                                    MOVE R0, R8
002317  8525  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002318  8527  C870                                    CMP @R8, R12
002319  8528  FFAB  000A                              RBRA _SDBFF_REW, !Z
002320                    
002321  852A  0FA0  8631                              MOVE SDB_FF_STAT, R8
002322  852C  0FA1  0000                              MOVE SDB_B_OK, @R8
002323  852E  032C                                    MOVE R3, R11
002324  852F  0430                                    MOVE R4, R12
002325  8530  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002326  8532  FFA0  000D                              RBRA _SDBFF_RET, 1
002327                    
002328                                                ; Put the file back to the start and report "nothing done".
002329                                                ; The caller has not seen the updated target pointers, so it
002330                                                ; simply overwrites whatever we already transferred. The seek
002331                                                ; also restores the library's sector buffer; if even that
002332                                                ; fails, the buffer is marked unknown.
002333  8534  0020        _SDBFF_REW                  MOVE R0, R8
002334  8535  B924                                    XOR R9, R9
002335  8536  BA28                                    XOR R10, R10
002336  8537  FF90  0054                              ASUB f32_fseek, 1
002337  8539  CFA4  0000                              CMP 0, R9
002338  853B  FFA3  0002                              RBRA _SDBFF_NO, Z
002339  853D  FFB0  FBE7                              RSUB SDB_ORPHAN, 1
002340                    
002341  853F  9FB8  FFFB  _SDBFF_NO                   AND 0xFFFB, R14                  ; clear Carry
002342  8541              _SDBFF_RET                  
002343  8541  E100                                    DECRB
002344  8542  0DBC                                    MOVE @R13++, R15
002345                    

001857                    ; SDB_FAT_NEXT
001858                    ; Reads the FAT32 chain successor of a cluster. Uses a one entry cache for
001859                    ; the FAT sector, so a run of consecutive clusters costs one SD card block
001860                    ; read per 128 clusters. Expects SDB_GUARD_IN to have been called.
001861                    ;
001862                    ; Input: R8: device handle
001863                    ; R9/R10: cluster lo/hi
001864                    ; Output: Carry=1: R9/R10 = successor cluster lo/hi (28 bit)
001865                    ; Carry=0: the FAT sector could not be read
001866                    ; R8 unchanged
001867  8348  E0C0        SDB_FAT_NEXT                INCRB
001868  8349  0800                                    MOVE R8, R0                      ; R0: device handle
001869  834A  0904                                    MOVE R9, R1                      ; R1: byte offset in sector
001870  834B  9F84  007F                              AND 0x007F, R1                   ; 128 FAT entries per sector
001871  834D  9FB8  FFFD                              AND 0xFFFD, R14                  ; clear X
001872  834F  5F84  0002                              SHL 2, R1                        ; 4 bytes per entry
001873                    
001874                                                ; FAT sector number = cluster / 128
001875  8351  0A08                                    MOVE R10, R2
001876  8352  9F88  007F                              AND 0x007F, R2
001877  8354  9FB8  FFFD                              AND 0xFFFD, R14
001878  8356  5F88  0009                              SHL 9, R2
001879  8358  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C
001880  835A  6FA4  0007                              SHR 7, R9
001881  835C  1224                                    ADD R2, R9
001882  835D  9FB8  FFFB                              AND 0xFFFB, R14
001883  835F  6FA8  0007                              SHR 7, R10
001884                    
001885  8361  0008                                    MOVE R0, R2                      ; plus the FAT start LBA
001886  8362  1F88  0008                              ADD FAT32$DEV_FAT_LO, R2
001887  8364  028C                                    MOVE @R2++, R3
001888  8365  0248                                    MOVE @R2, R2
001889  8366  1324                                    ADD R3, R9
001890  8367  2228                                    ADDC R2, R10
001891  8368  FFA2  004E                              RBRA _SDB_FN_ERR, C              ; 32-bit overflow
001892                    
001893                                                ; is this sector already in the hardware buffer?
001894  836A  0F88  863F                              MOVE SDB_S_FCVAL, R2
001895  836C  CF89  0000                              CMP 0, @R2
001896  836E  FFA3  000A                              RBRA _SDB_FN_RD, Z
001897  8370  0F88  863D                              MOVE SDB_S_FCLBA, R2
001898  8372  C264                                    CMP @R2, R9
001899  8373  FFAB  0005                              RBRA _SDB_FN_RD, !Z
001900  8375  1F88  0001                              ADD 1, R2
001901  8377  C268                                    CMP @R2, R10
001902  8378  FFA3  0016                              RBRA _SDB_FN_BUF, Z
001903                    
001904  837A  0F88  863F  _SDB_FN_RD                  MOVE SDB_S_FCVAL, R2             ; cache is stale in any case
001905  837C  0F89  0000                              MOVE 0, @R2
001906  837E  0908                                    MOVE R9, R2                      ; R2/R3: remember the LBA
001907  837F  0A0C                                    MOVE R10, R3
001908  8380  0220                                    MOVE R2, R8
001909  8381  0324                                    MOVE R3, R9
001910  8382  FF90  003C                              ASUB sd_r_block, 1
001911  8384  CFA0  0000                              CMP 0, R8
001912  8386  FFAB  002E                              RBRA _SDB_FN_SDE, !Z
001913  8388  0FA0  863D                              MOVE SDB_S_FCLBA, R8
001914  838A  0222                                    MOVE R2, @R8++
001915  838B  0321                                    MOVE R3, @R8
001916  838C  0FA0  863F                              MOVE SDB_S_FCVAL, R8
001917  838E  0FA1  0001                              MOVE 1, @R8
001918                    
001919                                                ; read the 32-bit little-endian FAT entry. Keep one
001920                                                ; instruction between writing IO$SD_DATA_POS and reading
001921                                                ; IO$SD_DATA, exactly like SD$READ_BYTE does: the buffer is a
001922                                                ; block RAM whose output is registered (see byte_bram.vhd).
001923  8390  0F88  FF22  _SDB_FN_BUF                 MOVE IO$SD_DATA_POS, R2
001924  8392  0F8C  FF23                              MOVE IO$SD_DATA, R3
001925  8394  0110                                    MOVE R1, R4                      ; R4: walking byte offset
001926  8395  0409                                    MOVE R4, @R2
001927  8396  1F90  0001                              ADD 1, R4                        ; spacing, and the next offset
001928  8398  0364                                    MOVE @R3, R9                     ; byte 0
001929  8399  0409                                    MOVE R4, @R2
001930  839A  1F90  0001                              ADD 1, R4
001931  839C  0354                                    MOVE @R3, R5                     ; byte 1
001932  839D  9FB8  FFFD                              AND 0xFFFD, R14
001933  839F  5F94  0008                              SHL 8, R5
001934  83A1  1524                                    ADD R5, R9
001935  83A2  0409                                    MOVE R4, @R2
001936  83A3  1F90  0001                              ADD 1, R4
001937  83A5  0368                                    MOVE @R3, R10                    ; byte 2
001938  83A6  0409                                    MOVE R4, @R2
001939  83A7  1F90  0001                              ADD 1, R4
001940  83A9  0354                                    MOVE @R3, R5                     ; byte 3
001941  83AA  9FB8  FFFD                              AND 0xFFFD, R14
001942  83AC  5F94  0008                              SHL 8, R5
001943  83AE  1528                                    ADD R5, R10
001944  83AF  9FA8  0FFF                              AND 0x0FFF, R10                  ; FAT32 entries are 28 bit
001945  83B1  0020                                    MOVE R0, R8
001946  83B2  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001947  83B4  FFA0  0005                              RBRA _SDB_FN_RET, 1
001948                    
001949  83B6  FFB0  FCEA  _SDB_FN_SDE                 RSUB SDB_SDERR, 1
001950  83B8  0020        _SDB_FN_ERR                 MOVE R0, R8
001951  83B9  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
001952  83BB  E100        _SDB_FN_RET                 DECRB
001953  83BC  0DBC                                    MOVE @R13++, R15

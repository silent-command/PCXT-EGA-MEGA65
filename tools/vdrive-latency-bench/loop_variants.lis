000937                    ; Automatically and manually loadable cartridges and ROMs
000938                    ; ----------------------------------------------------------------------------
000939                    
000940                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000941                    CRTROM_MAN_NUM_A            .EQU 0x7000                      ; amount of manually loadable CRTs/ROMs
000942                    CRTROM_AUT_NUM_A            .EQU 0x7001                      ; amount of automatically loadable ROMs
000943                    CRTROM_MAN_BUFFERS          .EQU 0x7100                      ; array of records: manually loadable
000944                    CRTROM_AUT_BUFFERS          .EQU 0x7200                      ; array of records: automatically loadable
000945                    CRTROM_AUT_FILES            .EQU 0x7300                      ; auto-load filesnames
000946                    
000947                    ; Type of byte streaming device for receiving the CRT/ROM data
000948                    CRTROM_TYPE_DEVICE          .EQU 0x0000                      ; any QNICE compatible device
000949                    CRTROM_TYPE_HYPRAM          .EQU 0x0001                      ; HyperRAM
000950                    CRTROM_TYPE_SDRAM           .EQU 0x0002                      ; @TODO/RESERVED for future R4 boards
000951                    CRTROM_TYPE_MNDTRY          .EQU 0x0003                      ; mandatory ROM
000952                    CTRROM_TYPE_OPTNL           .EQU 0x0004                      ; optional ROM
000953                    
000954                    ; Control and status registers of a CRT/ROM device
000955                    CRTROM_CSR_4KWIN            .EQU 0xFFFF                      ; 4K window in the device addr. space
000956                    
000957                    CRTROM_CSR_STATUS           .EQU 0x7000                      ; QNICE to device: load status (see below)
000958                    CRTROM_CSR_FS_LO            .EQU 0x7001                      ; filesize of CRT/ROM: low word
000959                    CRTROM_CSR_FS_HI            .EQU 0x7002                      ; filesize of CRT/ROM: high word
000960                    CRTROM_CSR_PARSEST          .EQU 0x7010                      ; device to QNICE: parse status
000961                    CRTROM_CSR_PARSEE1          .EQU 0x7011                      ; device to QNICE: error code
000962                    CRTROM_CSR_ADDR_LO          .EQU 0x7012                      ; device to QNICE: load address low word
000963                    CRTROM_CSR_ADDR_HI          .EQU 0x7013                      ; device to QNICE: load address high word
000964                    CRTROM_CSR_ERR_STRT         .EQU 0x7100                      ; device to QNICE: status string
000965                    
000966                    ; QNICE to device: CRT/ROM load status
000967                    CRTROM_CSR_ST_IDLE          .EQU 0x0000                      ; device is initialized, no loading
000968                    CRTROM_CSR_ST_LDNG          .EQU 0x0001                      ; loading takes place
000969                    CRTROM_CSR_ST_ERR           .EQU 0x0002                      ; loading failed
000970                    CRTROM_CSR_ST_OK            .EQU 0x0003                      ; loading successful
000971                    
000972                    ; Device to QNICE: Parsing status
000973                    CRTROM_CSR_PT_IDLE          .EQU 0x0000                      ; parser is idle
000974                    CRTROM_CSR_PT_PRSNG         .EQU 0x0001                      ; parser is parsing
000975                    CRTROM_CSR_PT_OK            .EQU 0x0002                      ; parsing successful
000976                    CRTROM_CSR_PT_ERR           .EQU 0x0003                      ; parsing error

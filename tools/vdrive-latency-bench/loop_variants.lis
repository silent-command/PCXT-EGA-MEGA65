002496  8618  E0C0        CAD_WRITE                   INCRB
002497  8619  0F80  872F                              MOVE SIM_RAMROM_DEV, R0
002498  861B  0F84  8731                              MOVE SIM_VDRIVES_DEV, R1
002499  861D  0141                                    MOVE @R1, @R0
002500  861E  0F80  8730                              MOVE SIM_RAMROM_4KWIN, R0
002501  8620  0F81  0100                              MOVE 0x0100, @R0
002502  8622  0921                                    MOVE R9, @R8
002503  8623  E100                                    DECRB
002504  8624  0DBC                                    MOVE @R13++, R15

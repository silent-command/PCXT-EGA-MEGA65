001193                    ; ****************************************************************************
001194                    ; MiSTer2MEGA65 (M2M) QNICE ROM
001195                    ;
001196                    ; sdblock.asm: direct 512-byte block access to files on the SD card
001197                    ;
001198                    ; The FAT32 library of the QNICE Monitor only offers a byte-wise API
001199                    ; (f32_fread / f32_fwrite). Every single byte revalidates the cluster and the
001200                    ; sector of the file handle, which costs about 107 instructions per byte, and
001201                    ; f32_fseek walks the cluster chain from the start of the file, which makes a
001202                    ; random access at the far end of a 42 MB image cost seconds.
001203                    ;
001204                    ; This module resolves the on-disk layout of a file *once* into a compact
001205                    ; extent table and can then map "block N of the file" to an absolute SD card
001206                    ; LBA. A block is then one SD$READ_BLOCK plus a tight copy loop out of the
001207                    ; 512-byte buffer of the SD controller.
001208                    ;
001209                    ; ----------------------------------------------------------------------------
001210                    ; THE TWO RULES
001211                    ; ----------------------------------------------------------------------------
001212                    ;
001213                    ; (1) The FAT32 library must never be able to tell that we were here.
001214                    ;
001215                    ; The 512-byte "sector buffer" of the FAT32 library IS the 512-byte
001216                    ; hardware buffer of the SD controller; the device handle only remembers
001217                    ; *which* file handle filled it (FAT32$DEV_BUFFERED_FDH). Every direct
001218                    ; access destroys the library's buffer while the library still believes
001219                    ; it holds a particular sector.
001220                    ;
001221                    ; Earlier versions of this file solved that by pointing
001222                    ; FAT32$DEV_BUFFERED_FDH at a dummy handle, i.e. by reaching into the
001223                    ; library's bookkeeping. That is not done any more. Instead:
001224                    ;
001225                    ; * SDB_GUARD_IN works out, *before* anything is touched, which sector
001226                    ; the library believes is in the buffer and whether that sector can
001227                    ; be read back. If it cannot, the fast path is refused and nothing
001228                    ; is touched at all.
001229                    ; * a dirty buffer is written back through the library first.
001230                    ; * SDB_GUARD_OUT reads that very sector back, so the buffer holds
001231                    ; exactly what it held before.
001232                    ; * SDB_FREAD_FAST, which moves the file position anyway, restores the
001233                    ; library state the library's own way: with an f32_fseek, which
001234                    ; unconditionally re-reads the sector and re-claims ownership.
001235                    ;
001236                    ; The one remaining poke, SDB_ORPHAN, exists only for the case where the
001237                    ; restoring read itself fails, i.e. where the card is already broken. It
001238                    ; is strictly better than leaving the library with a buffer that holds
001239                    ; something else than it thinks.
001240                    ;
001241                    ; (2) Any error anywhere leaves the caller with "nothing happened".
001242                    ;
001243                    ; Every entry point returns Carry=0 on any problem, and the byte-wise
001244                    ; FAT32 path then does all of the work exactly as it did before this
001245                    ; file existed. In particular:
001246                    ;
001247                    ; * an SD card error latches the controller into its error state (see
001248                    ; the IO$SD_CSR description in sysdef.asm: "you need to reset the
001249                    ; controller to go on"), which would make every *subsequent* library
001250                    ; access fail too. SDB_SDERR therefore issues SD$RESET after any
001251                    ; failed SD operation before we hand back control.
001252                    ; * SDB_FREAD_FAST never seeks to the end of the file. It always leaves
001253                    ; at least one whole block to the byte loop, so the file position it
001254                    ; hands over is strictly inside the file and the caller reaches EOF
001255                    ; through the library, the way it always did.
001256                    ; * every seek is verified against FAT32$FDH_ACCESS afterwards.
001257                    ;
001258                    ; ----------------------------------------------------------------------------
001259                    ; Serial logging
001260                    ; ----------------------------------------------------------------------------
001261                    ; The switch is SDB_DEBUG in M2M/rom/sdblock_cfg.asm, which shell.asm includes
001262                    ; as its very first line. It must NOT be defined here: this file is included
001263                    ; at the end of shell.asm, and the C preprocessor runs once from top to
001264                    ; bottom, so a #define here would be invisible to every #ifdef above it.
001265                    ;
001266                    ; This file needs the environment of shell.asm.
001267                    ;
001268                    ; done for the PCXT-EGA-MEGA65 port and licensed under GPL v3
001269                    ; ****************************************************************************
001270                    
001271                    ; ----------------------------------------------------------------------------
001272                    ; Layout of a block map (see SDB_VD_MAPS / SDB_RM_MAP in shell_vars.asm)
001273                    ; ----------------------------------------------------------------------------
001274                    
001275                    ; Maximum amount of extents (runs of physically consecutive clusters) that we
001276                    ; are willing to remember for one file. A freshly copied image file normally
001277                    ; is one single extent. Files that would need more extents than this fall
001278                    ; back to the FAT32 library path.
001279                    SDB_MAX_EXT                 .EQU 8
001280                    
001281                    SDB_M_NEXT                  .EQU 0                           ; amount of valid extents; 0 = no map
001282                    SDB_M_FDH                   .EQU 1                           ; FDH this map was built for
001283                    SDB_M_TBLK_LO               .EQU 2                           ; amount of *whole* 512-byte blocks..
001284                    SDB_M_TBLK_HI               .EQU 3                           ; ..in the file (filesize / 512)
001285                    SDB_M_BAIL                  .EQU 4                           ; why there is no map (SDB_B_*)
001286                    SDB_M_EXT                   .EQU 5                           ; start of the extent array
001287                    
001288                    ; one extent: amount of blocks (lo/hi) and the absolute SD card LBA (lo/hi)
001289                    ; of the first of them
001290                    SDB_E_NBLK_LO               .EQU 0
001291                    SDB_E_NBLK_HI               .EQU 1
001292                    SDB_E_LBA_LO                .EQU 2
001293                    SDB_E_LBA_HI                .EQU 3
001294                    SDB_E_SIZE                  .EQU 4
001295                    
001296                    ; size of one map in words: SDB_M_EXT + SDB_E_SIZE * SDB_MAX_EXT = 5 + 4*8
001297                    ; = 37, rounded up to 40 to leave room
001298                    SDB_M_SIZE                  .EQU 40
001299                    
001300                    ; Amount of virtual drives that SDB_VD_MAPS in shell_vars.asm has room for.
001301                    ; The QNICE assembler cannot evaluate expressions in .BLOCK, so the size of
001302                    ; SDB_VD_MAPS is the literal SDB_M_SIZE * SDB_VD_MAX_N and both have to be
001303                    ; kept in sync by hand. Virtual drives beyond SDB_VD_MAX_N are not broken,
001304                    ; they just always use the (slow) FAT32 library path.
001305                    SDB_VD_MAX_N                .EQU 3
001306                    
001307                    ; Why a map could not be built. Logged, and also readable from SDB_M_BAIL.
001308                    SDB_B_OK                    .EQU 0
001309                    SDB_B_NOMAP                 .EQU 1                           ; no map slot for this drive
001310                    SDB_B_NODEV                 .EQU 2                           ; file handle has no device handle
001311                    SDB_B_NOSPC                 .EQU 3                           ; sectors per cluster is zero
001312                    SDB_B_EMPTY                 .EQU 4                           ; file is shorter than one block
001313                    SDB_B_BADSTART              .EQU 5                           ; start cluster < 2
001314                    SDB_B_FRAG                  .EQU 6                           ; more extents than SDB_MAX_EXT
001315                    SDB_B_FATERR                .EQU 7                           ; could not read a FAT sector
001316                    SDB_B_BADCLUS               .EQU 8                           ; illegal cluster in the chain
001317                    SDB_B_SHORT                 .EQU 9                           ; chain ends before the file does
001318                    SDB_B_LBA                   .EQU 10                          ; LBA arithmetic out of range
001319                    SDB_B_GUARD                 .EQU 11                          ; buffer could not be made restorable
001320                    SDB_B_SEEK                  .EQU 12                          ; restoring seek failed
001321                    
001322                    ; Why one virtual drive block request did or did not take the fast path.
001323                    ; Left in SDB_RD_STAT by SDB_VD_RDBLK / SDB_VD_WRBLK after every request, so
001324                    ; it can be read out even in a build without the serial log.
001325                    SDB_R_OK                    .EQU 0                           ; fast path taken
001326                    SDB_R_SIZE                  .EQU 1                           ; VD_SIZEB is not exactly 512
001327                    SDB_R_ALIGN                 .EQU 2                           ; byte position is not block aligned
001328                    SDB_R_MAP                   .EQU 3                           ; no usable map for this drive/handle
001329                    SDB_R_RANGE                 .EQU 4                           ; block is outside the mapped file
001330                    SDB_R_GUARD                 .EQU 5                           ; buffer could not be made restorable
001331                    SDB_R_SDERR                 .EQU 6                           ; the SD card operation failed
001332                    
001333                    ; end-of-chain marker: everything >= 0x0FFFFFF8 terminates a FAT32 chain,
001334                    ; and everything >= 0x0FFFFFF0 is reserved, so refuse all of it
001335                    SDB_EOC_HI                  .EQU 0x0FFF
001336                    SDB_EOC_LO                  .EQU 0xFFF0
001337                    
001338                    ; ----------------------------------------------------------------------------
001339                    ; Housekeeping
001340                    ; ----------------------------------------------------------------------------
001341                    
001342                    ; SDB_INVAL_ALL
001343                    ; Invalidates all block maps, i.e. everything falls back to the FAT32 library
001344                    ; until the maps are rebuilt. Called from VD_INIT and whenever the SD card
001345                    ; changes. Also clears the two zero-filled helper structures, because the
001346                    ; variables live in uninitialized RAM.
001347                    ;
001348                    ; Input: none
001349                    ; Output: none, all registers unchanged
001350  8126  E0C0        SDB_INVAL_ALL               INCRB
001351  8127  0F80  868A                              MOVE SDB_VD_MAPS, R0
001352  8129  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001353  812B  0F81  0000  _SDBIA_L                    MOVE 0, @R0
001354  812D  1F80  0028                              ADD SDB_M_SIZE, R0
001355  812F  3F84  0001                              SUB 1, R1
001356  8131  FFAB  FFF8                              RBRA _SDBIA_L, !Z
001357  8133  0F80  8702                              MOVE SDB_RM_MAP, R0
001358  8135  0F81  0000                              MOVE 0, @R0
001359  8137  0F80  872A                              MOVE SDB_NULL_MAP, R0
001360  8139  0F81  0000                              MOVE 0, @R0
001361  813B  0F80  8737                              MOVE SDB_G_VAL, R0
001362  813D  0F81  0000                              MOVE 0, @R0
001363                    
001364                                                ; SDB_DUMMY_FDH must read as an all-zero, and therefore never
001365                                                ; dirty, file handle: SDB_ORPHAN hands it to FAT32$FLUSH
001366  813F  0F80  872B                              MOVE SDB_DUMMY_FDH, R0
001367  8141  0F84  000C                              MOVE FAT32$FDH_STRUCT_SIZE, R1
001368  8143  0F82  0000  _SDBIA_L2                   MOVE 0, @R0++
001369  8145  3F84  0001                              SUB 1, R1
001370  8147  FFAB  FFFA                              RBRA _SDBIA_L2, !Z
001371  8149  E100                                    DECRB
001372  814A  0DBC                                    MOVE @R13++, R15
001373                    
001374                    ; SDB_VDMAP
001375                    ; Returns the block map that belongs to a virtual drive. Drives that have no
001376                    ; map (see SDB_VD_MAX_N) get the permanently empty SDB_NULL_MAP, which makes
001377                    ; SDB_CHECK fail and therefore forces the FAT32 library path.
001378                    ;
001379                    ; Input: R8: virtual drive number
001380                    ; Output: R8: pointer to the block map
001381  814B  E0C0        SDB_VDMAP                   INCRB
001382  814C  0800                                    MOVE R8, R0
001383  814D  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001384  814F  C100                                    CMP R1, R0                       ; drive number < maximum?
001385  8150  FFA4  0004                              RBRA _SDBVM_OK, N                ; yes
001386  8152  0FA0  872A                              MOVE SDB_NULL_MAP, R8            ; no: never mapped
001387  8154  FFA0  000C                              RBRA _SDBVM_D, 1
001388  8156  0FA0  868A  _SDBVM_OK                   MOVE SDB_VD_MAPS, R8
001389  8158  CF80  0000  _SDBVM_L                    CMP 0, R0
001390  815A  FFA3  0006                              RBRA _SDBVM_D, Z
001391  815C  1FA0  0028                              ADD SDB_M_SIZE, R8
001392  815E  3F80  0001                              SUB 1, R0
001393  8160  FFA0  FFF6                              RBRA _SDBVM_L, 1
001394  8162  E100        _SDBVM_D                    DECRB
001395  8163  0DBC                                    MOVE @R13++, R15
001396                    
001397                    ; SDB_CHECK
001398                    ; Is the given map valid and does it belong to the given file handle?
001399                    ;
001400                    ; Input: R8: pointer to the block map
001401                    ; R9: file handle (FDH)
001402                    ; Output: Carry=1 if the map can be used, all registers unchanged
001403  8164  E0C0        SDB_CHECK                   INCRB
001404  8165  CFA1  0000                              CMP 0, @R8                       ; any extents?
001405  8167  FFA3  000A                              RBRA _SDBC_NO, Z                 ; no: unusable
001406  8169  0800                                    MOVE R8, R0
001407  816A  1F80  0001                              ADD SDB_M_FDH, R0
001408  816C  C064                                    CMP @R0, R9                      ; built for this file handle?
001409  816D  FFAB  0004                              RBRA _SDBC_NO, !Z                ; no: unusable
001410  816F  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001411  8171  FFA0  0002                              RBRA _SDBC_R, 1
001412  8173  9FB8  FFFB  _SDBC_NO                    AND 0xFFFB, R14                  ; clear Carry
001413  8175  E100        _SDBC_R                     DECRB
001414  8176  0DBC                                    MOVE @R13++, R15
001415                    
001416                    ; ----------------------------------------------------------------------------
001417                    ; Every SD card access of the fast path goes through these two wrappers, so
001418                    ; that the time the card itself needs can be measured separately from
001419                    ; everything else, and so that the number of card accesses per virtual drive
001420                    ; request is countable. Without SDB_DEBUG they are a plain call.
001421                    ; ----------------------------------------------------------------------------
001422                    
001423                    ; SDB_SDRD: read one 512-byte block into the SD controller's buffer
001424                    ; Input: R8/R9 = LBA lo/hi
001425                    ; Output: R8 = 0, or the error code
001426  8177              SDB_SDRD                    
001427                    
001428                    
001429                    
001430  8177  FF90  003C                              ASUB sd_r_block, 1
001431                    
001432                    
001433                    
001434  8179  0DBC                                    MOVE @R13++, R15
001435                    
001436                    ; SDB_SDWR: write the SD controller's buffer to one 512-byte block
001437                    ; Input: R8/R9 = LBA lo/hi
001438                    ; Output: R8 = 0, or the error code
001439  817A              SDB_SDWR                    
001440                    
001441                    
001442                    
001443  817A  FF90  003E                              ASUB sd_w_block, 1
001444                    
001445                    
001446                    
001447  817C  0DBC                                    MOVE @R13++, R15
001448                    ; SDB_SDERR
001449                    ; Called after a failed SD card operation. The controller latches its error
001450                    ; state and refuses everything until it is reset, which would turn our
001451                    ; problem into a fatal error in the *next* FAT32 library call. Reset it, so
001452                    ; that the fallback path starts from a clean controller.
001453                    ;
001454                    ; Input: R8: the error code (only used for logging)
001455                    ; Output: none, R8 unchanged
001456  817D  E0C0        SDB_SDERR                   INCRB
001457  817E  0800                                    MOVE R8, R0
001458                    
001459                    
001460                    
001461                    
001462                    
001463                    
001464                    
001465  817F  FF90  003A                              ASUB sd_reset, 1
001466  8181  0020                                    MOVE R0, R8
001467  8182  E100                                    DECRB
001468  8183  0DBC                                    MOVE @R13++, R15
001469                    
001470                    ; ----------------------------------------------------------------------------
001471                    ; Guarding the FAT32 library's sector buffer
001472                    ; ----------------------------------------------------------------------------
001473                    
001474                    ; SDB_GUARD_IN
001475                    ; Prepares for direct SD card access. Writes the FAT32 library's sector
001476                    ; buffer back first if it is dirty, and notes whether a real file handle
001477                    ; currently claims the buffer, so that SDB_GUARD_OUT can tell that handle
001478                    ; afterwards that the contents are no longer what it thinks. Refuses
001479                    ; (Carry=0) without touching anything if the write-back fails.
001480                    ;
001481                    ; This used to remember the sector's LBA and read it back in
001482                    ; SDB_GUARD_OUT. That was a second SD card access per virtual drive request,
001483                    ; about 1.5 ms of hardware time out of 3.4 ms, for something that the
001484                    ; library's own re-read mechanism does for free. It also could only ever
001485                    ; satisfy one of the two device handles that share the one hardware buffer,
001486                    ; whereas marking tells both.
001487                    ;
001488                    ; Input: none
001489                    ; Output: Carry=1: direct access is allowed
001490                    ; Carry=0: do not touch the SD card, nothing has been touched
001491                    ; all registers unchanged
001492  8184  FF90  005E  SDB_GUARD_IN                ASUB enter, 1
001493                    
001494  8186  0FA0  8737                              MOVE SDB_G_VAL, R8               ; nobody to tell yet
001495  8188  0FA1  0000                              MOVE 0, @R8
001496                    
001497  818A  0FA0  8665                              MOVE HANDLE_DEV, R8              ; who claims the buffer?
001498  818C  FFB0  0027                              RSUB _SDB_OWNER, 1
001499  818E  FFA2  0008                              RBRA _SDBGI_HAVE, C
001500  8190  0FA0  8677                              MOVE CONFIG_DEVH, R8
001501  8192  FFB0  0021                              RSUB _SDB_OWNER, 1
001502  8194  FFA2  0002                              RBRA _SDBGI_HAVE, C
001503  8196  FFA0  0014                              RBRA _SDBGI_OK, 1                ; nobody: nothing to do
001504                    
001505                                                ; R8: device handle, R9: owning FDH
001506  8198  0904        _SDBGI_HAVE                 MOVE R9, R1
001507                    
001508  8199  0120                                    MOVE R1, R8                      ; dirty? then write it back
001509  819A  1FA0  000B                              ADD FAT32$FDH_FLAGS, R8
001510  819C  0860                                    MOVE @R8, R8
001511  819D  9FA0  0001                              AND FAT32$FDHF_DIRTY, R8
001512  819F  FFA3  0007                              RBRA _SDBGI_CLEAN, Z
001513  81A1  0120                                    MOVE R1, R8
001514  81A2  FF90  0068                              ASUB f32_fflush, 1
001515  81A4  CFA4  0000                              CMP 0, R9
001516  81A6  FFAB  0008                              RBRA _SDBGI_NO, !Z               ; cannot write back: refuse
001517                    
001518  81A8  0FA0  8737  _SDBGI_CLEAN                MOVE SDB_G_VAL, R8               ; a real handle owns it, so
001519  81AA  0FA1  0001                              MOVE 1, @R8                      ; ..it has to be told later
001520                    
001521  81AC  AFB8  0004  _SDBGI_OK                   OR 0x0004, R14                   ; set Carry
001522  81AE  FFA0  0002                              RBRA _SDBGI_RET, 1
001523  81B0  9FB8  FFFB  _SDBGI_NO                   AND 0xFFFB, R14                  ; clear Carry
001524  81B2  FF90  0060  _SDBGI_RET                  ASUB leave, 1
001525  81B4  0DBC                                    MOVE @R13++, R15
001526                    
001527                    ; Input: R8: device handle
001528                    ; Output: Carry=1 and R9 = the FDH that claims the buffer, R8 unchanged
001529                    ;
001530                    ; SDB_DUMMY_FDH is our own "the contents are unknown" marker and must not be
001531                    ; reported as an owner: otherwise the request after an orphaned one would try
001532                    ; to write back and mark a handle that is not a real file, and - since the
001533                    ; dummy has cluster 0 - would have been refused outright by the old
001534                    ; restore-based guard.
001535  81B5  E0C0        _SDB_OWNER                  INCRB
001536  81B6  CFA1  0000                              CMP 0, @R8                       ; device handle initialized?
001537  81B8  FFA3  000F                              RBRA _SDB_OWN_NO, Z
001538  81BA  0800                                    MOVE R8, R0
001539  81BB  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001540  81BD  0064                                    MOVE @R0, R9
001541  81BE  FFA3  0009                              RBRA _SDB_OWN_NO, Z              ; nobody claims it
001542  81C0  0F80  872B                              MOVE SDB_DUMMY_FDH, R0
001543  81C2  C024                                    CMP R0, R9                       ; already marked as unknown?
001544  81C3  FFA3  0004                              RBRA _SDB_OWN_NO, Z              ; then there is no owner
001545  81C5  AFB8  0004                              OR 0x0004, R14
001546  81C7  FFA0  0002                              RBRA _SDB_OWN_R, 1
001547  81C9  9FB8  FFFB  _SDB_OWN_NO                 AND 0xFFFB, R14
001548  81CB  E100        _SDB_OWN_R                  DECRB
001549  81CC  0DBC                                    MOVE @R13++, R15
001550                    
001551                    ; SDB_GUARD_OUT
001552                    ; The direct access is done and the hardware buffer now holds our block. Tell
001553                    ; whoever claimed it that its contents are unknown, so that the FAT32 library
001554                    ; re-reads instead of trusting it.
001555                    ;
001556                    ; Input: none
001557                    ; Output: none, all registers unchanged
001558  81CD  FF90  005E  SDB_GUARD_OUT               ASUB enter, 1
001559  81CF  0FA0  8737                              MOVE SDB_G_VAL, R8
001560  81D1  CFA1  0000                              CMP 0, @R8
001561  81D3  FFA3  0004                              RBRA _SDBGO_RET, Z               ; nobody had claimed it
001562  81D5  0FA1  0000                              MOVE 0, @R8
001563  81D7  FFB0  000A                              RSUB SDB_ORPHAN, 1
001564  81D9  FF90  0060  _SDBGO_RET                  ASUB leave, 1
001565  81DB  0DBC                                    MOVE @R13++, R15
001566                    
001567                    ; SDB_GUARD_CLR
001568                    ; The library has been put back by other means - SDB_FREAD_FAST finishes with
001569                    ; an f32_fseek, which re-reads the sector and re-claims ownership itself - so
001570                    ; there is nothing left to mark.
001571                    ;
001572                    ; Input: none
001573                    ; Output: none, all registers unchanged
001574  81DC  E0C0        SDB_GUARD_CLR               INCRB
001575  81DD  0F80  8737                              MOVE SDB_G_VAL, R0
001576  81DF  0F81  0000                              MOVE 0, @R0
001577  81E1  E100                                    DECRB
001578  81E2  0DBC                                    MOVE @R13++, R15
001579                    
001580                    ; SDB_ORPHAN
001581                    ; Tells both device handles that the contents of the 512-byte hardware buffer
001582                    ; are unknown, so that the library re-reads rather than serving something we
001583                    ; overwrote. This is the same mechanism the library uses on itself: READ_FDH
001584                    ; compares FAT32$DEV_BUFFERED_FDH with the handle it was called for and
001585                    ; re-reads through FAT32$RW_SIC whenever they differ.
001586                    ;
001587                    ; "Unknown" is expressed by handing the buffer to SDB_DUMMY_FDH, an all-zero
001588                    ; and therefore never dirty file handle, and not by the obvious 0: FAT32$FLUSH
001589                    ; returns immediately when called with R8 = 0 and then leaves R9 - its error
001590                    ; code - untouched, and FAT32$FILE_SEEK checks that stale R9 right after
001591                    ; calling it, so a seek would silently do nothing.
001592                    ;
001593                    ; Note what this does NOT do: it issues no SD card access of its own, so it
001594                    ; cannot produce an LBA, and therefore cannot reproduce anything of the shape
001595                    ; that made hardware run 1 fatal (a wild LBA latching the controller's error
001596                    ; state). All of the guards against that - stopping one block short of the
001597                    ; end of a file, verifying FAT32$FDH_ACCESS after every seek, validating every
001598                    ; LBA in SDB_CLULBA, and resetting the controller after a failed access - are
001599                    ; untouched.
001600                    ;
001601                    ; Input: none
001602                    ; Output: none, all registers unchanged
001603  81E3  FF90  005E  SDB_ORPHAN                  ASUB enter, 1
001604                    
001605                    
001606                    
001607                    
001608                    
001609  81E5  0FA0  8665                              MOVE HANDLE_DEV, R8
001610  81E7  FFB0  000B                              RSUB _SDB_ORPH1, 1
001611  81E9  0FA0  8677                              MOVE CONFIG_DEVH, R8
001612  81EB  FFB0  0007                              RSUB _SDB_ORPH1, 1
001613  81ED  0FA0  8737                              MOVE SDB_G_VAL, R8               ; everybody has been told
001614  81EF  0FA1  0000                              MOVE 0, @R8
001615  81F1  FF90  0060                              ASUB leave, 1
001616  81F3  0DBC                                    MOVE @R13++, R15
001617                    
001618  81F4  E0C0        _SDB_ORPH1                  INCRB
001619  81F5  0804                                    MOVE R8, R1
001620  81F6  CFA1  0000                              CMP 0, @R8
001621  81F8  FFA3  0006                              RBRA _SDB_ORPH_R, Z
001622  81FA  0800                                    MOVE R8, R0
001623  81FB  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001624  81FD  0F88  872B                              MOVE SDB_DUMMY_FDH, R2
001625  81FF  0201                                    MOVE R2, @R0
001626  8200  0120        _SDB_ORPH_R                 MOVE R1, R8
001627  8201  E100                                    DECRB
001628  8202  0DBC                                    MOVE @R13++, R15
001629                    
001630                    ; ----------------------------------------------------------------------------
001631                    ; 32-bit helpers
001632                    ; ----------------------------------------------------------------------------
001633                    
001634                    ; SDB_B2BLK
001635                    ; Converts a byte position into a 512-byte block index (unsigned 32 bit).
001636                    ;
001637                    ; Input: R9/R10: byte position lo/hi
001638                    ; Output: R9/R10: block index lo/hi
001639  8203  E0C0        SDB_B2BLK                   INCRB
001640  8204  0A00                                    MOVE R10, R0
001641  8205  9F80  01FF                              AND 0x01FF, R0                   ; bits that move down into..
001642  8207  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the low word; clear X so..
001643  8209  5F80  0007                              SHL 7, R0                        ; ..SHL shifts in zeros
001644  820B  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001645  820D  6FA4  0009                              SHR 9, R9
001646  820F  1024                                    ADD R0, R9
001647  8210  9FB8  FFFB                              AND 0xFFFB, R14
001648  8212  6FA8  0009                              SHR 9, R10
001649  8214  E100                                    DECRB

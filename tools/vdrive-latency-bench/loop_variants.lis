001742                    ; ----------------------------------------------------------------------------
001743                    ; Building the map
001744                    ; ----------------------------------------------------------------------------
001745                    
001746                    ; SDB_MAP_BUILD
001747                    ; Walks the FAT cluster chain of an open file once and stores the result as
001748                    ; an extent table, so that SDB_LBA can map blocks to LBAs afterwards. Costs
001749                    ; one SD card block read per 128 clusters of the file.
001750                    ;
001751                    ; Reads FAT sectors directly and therefore destroys the FAT32 library's
001752                    ; sector buffer, so it guards and restores it (see THE TWO RULES above). It
001753                    ; never modifies the file handle: the file position is the same afterwards.
001754                    ;
001755                    ; Input: R8: file handle (FDH)
001756                    ; R9: pointer to the block map to be filled
001757                    ; Output: none. The map is left invalid (extent count = 0, reason in
001758                    ; SDB_M_BAIL) when the file cannot be described, which makes all
001759                    ; callers fall back silently.
001760  82EB  FF90  005E  SDB_MAP_BUILD               ASUB enter, 1
001761                    
001762  82ED  0800                                    MOVE R8, R0                      ; R0: FDH
001763  82EE  0904                                    MOVE R9, R1                      ; R1: map
001764                    
001765  82EF  0F85  0000                              MOVE 0, @R1                      ; invalid until proven good
001766  82F1  0108                                    MOVE R1, R2
001767  82F2  1F88  0004                              ADD SDB_M_BAIL, R2
001768  82F4  0F89  0001                              MOVE SDB_B_NOMAP, @R2
001769  82F6  0F88  8710                              MOVE SDB_NULL_MAP, R2            ; no real map for this drive?
001770  82F8  C204                                    CMP R2, R1
001771  82F9  FFA3  0100                              RBRA _SDBMB_RET, Z               ; then there is nothing to do
001772                    
001773  82FB  0108                                    MOVE R1, R2
001774  82FC  1F88  0001                              ADD SDB_M_FDH, R2
001775  82FE  0009                                    MOVE R0, @R2                     ; remember the file handle
001776                    

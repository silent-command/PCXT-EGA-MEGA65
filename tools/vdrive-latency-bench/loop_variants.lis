001740                    ; SDB_LBA
001741                    ; Maps a block index within the file to an absolute SD card LBA.
001742                    ;
001743                    ; Input: R8: pointer to the block map
001744                    ; R9/R10: block index lo/hi
001745                    ; Output: Carry=1: R9/R10 = LBA lo/hi
001746                    ; Carry=0: the block cannot be mapped (use the FAT32 library)
001747                    ; R8 unchanged
001748  827C  E0C0        SDB_LBA                     INCRB
001749  827D  0800                                    MOVE R8, R0                      ; R0: map
001750  827E  0904                                    MOVE R9, R1                      ; R1/R2: remaining block idx
001751  827F  0A08                                    MOVE R10, R2
001752  8280  004C                                    MOVE @R0, R3                     ; R3: amount of extents
001753  8281  FFA3  0037                              RBRA _SDBL_NO, Z
001754                    
001755                                                ; reject anything that is not completely inside the file
001756  8283  0010                                    MOVE R0, R4
001757  8284  1F90  0003                              ADD SDB_M_TBLK_HI, R4
001758  8286  C211                                    CMP R2, @R4
001759  8287  FFA4  0031                              RBRA _SDBL_NO, N                 ; idx_hi > total_hi
001760  8289  FFAB  0008                              RBRA _SDBL_C1, !Z                ; idx_hi < total_hi: inside
001761  828B  0010                                    MOVE R0, R4
001762  828C  1F90  0002                              ADD SDB_M_TBLK_LO, R4
001763  828E  C111                                    CMP R1, @R4
001764  828F  FFA4  0029                              RBRA _SDBL_NO, N                 ; idx_lo > total_lo
001765  8291  FFA3  0027                              RBRA _SDBL_NO, Z                 ; idx_lo = total_lo: outside
001766                    
001767  8293  0010        _SDBL_C1                    MOVE R0, R4
001768  8294  1F90  0005                              ADD SDB_M_EXT, R4                ; R4: current extent
001769  8296  0454        _SDBL_LOOP                  MOVE @R4, R5                     ; R5/R6: blocks in extent
001770  8297  0418                                    MOVE R4, R6
001771  8298  1F98  0001                              ADD SDB_E_NBLK_HI, R6
001772  829A  0658                                    MOVE @R6, R6
001773  829B  C218                                    CMP R2, R6                       ; remainder < extent size?
001774  829C  FFA4  0014                              RBRA _SDBL_NEXT, N               ; rem_hi > ext_hi: no
001775  829E  FFAB  0005                              RBRA _SDBL_HIT, !Z               ; rem_hi < ext_hi: yes
001776  82A0  C114                                    CMP R1, R5
001777  82A1  FFA4  000F                              RBRA _SDBL_NEXT, N               ; rem_lo > ext_lo: no
001778  82A3  FFA3  000D                              RBRA _SDBL_NEXT, Z               ; rem_lo = ext_lo: no
001779                    
001780  82A5  0418        _SDBL_HIT                   MOVE R4, R6

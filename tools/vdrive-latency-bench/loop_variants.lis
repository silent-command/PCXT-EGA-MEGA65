001704  82BD  0668                                    MOVE @R6, R10
001705  82BE  1124                                    ADD R1, R9                       ; plus the remainder
001706  82BF  2228                                    ADDC R2, R10
001707  82C0  FFA2  000C                              RBRA _SDBL_NO, C                 ; 32-bit overflow
001708  82C2  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001709  82C4  FFA0  000A                              RBRA _SDBL_RET, 1
001710                    
001711  82C6  3504        _SDBL_NEXT                  SUB R5, R1                       ; remainder -= extent size
001712  82C7  4608                                    SUBC R6, R2
001713  82C8  1F90  0004                              ADD SDB_E_SIZE, R4               ; next extent
001714  82CA  3F8C  0001                              SUB 1, R3
001715  82CC  FFAB  FFDC                              RBRA _SDBL_LOOP, !Z

001799                    ; Unsigned 32-bit "A >= B" for two little-endian word pairs in memory.
001800                    ; The answer is returned in the Carry flag and not in N/Z, because MOVE @R13++, R15 is
001801                    ; a MOVE (see sysdef.asm) and a MOVE overwrites N and Z but not the Carry.
001802                    ; Input: R8: pointer to A (lo, hi), R9: pointer to B (lo, hi)
001803                    ; Output: Carry=1 if A >= B, R8 and R9 unchanged
001804  82BE  E0C0        _SDB_GE32                   INCRB
001805  82BF  0800                                    MOVE R8, R0
001806  82C0  0904                                    MOVE R9, R1
001807  82C1  1F80  0001                              ADD 1, R0
001808  82C3  1F84  0001                              ADD 1, R1
001809  82C5  C045                                    CMP @R0, @R1                     ; high words
001810  82C6  FFA4  000B                              RBRA _SDB_G32Y, N                ; A_hi > B_hi
001811  82C8  FFAB  0005                              RBRA _SDB_G32N, !Z               ; A_hi < B_hi
001812  82CA  C865                                    CMP @R8, @R9                     ; low words
001813  82CB  FFA4  0006                              RBRA _SDB_G32Y, N
001814  82CD  FFA3  0004                              RBRA _SDB_G32Y, Z
001815  82CF  9FB8  FFFB  _SDB_G32N                   AND 0xFFFB, R14                  ; clear Carry
001816  82D1  FFA0  0002                              RBRA _SDB_G32R, 1
001817  82D3  AFB8  0004  _SDB_G32Y                   OR 0x0004, R14                   ; set Carry
001818  82D5  E100        _SDB_G32R                   DECRB
001819  82D6  0DBC                                    MOVE @R13++, R15

001712  8258  CFA8  0000                              CMP 0, R10                       ; more than 32 bits?
001713  825A  FFAB  001A                              RBRA _SDBCL_NO, !Z
001714  825C  CFAC  0000                              CMP 0, R11
001715  825E  FFAB  0016                              RBRA _SDBCL_NO, !Z
001716                    
001717  8260  002C                                    MOVE R0, R11                     ; plus cluster_begin_lba
001718  8261  1FAC  000A                              ADD FAT32$DEV_CLUSTER_LO, R11
001719  8263  0BA8                                    MOVE @R11++, R10
001720  8264  0B6C                                    MOVE @R11, R11
001721  8265  1A20                                    ADD R10, R8
001722  8266  2B24                                    ADDC R11, R9
001723  8267  FFA2  000D                              RBRA _SDBCL_NO, C                ; 32-bit overflow
001724  8269  1120                                    ADD R1, R8                       ; plus the sector
001725  826A  2FA4  0000                              ADDC 0, R9
001726  826C  FFA2  0008                              RBRA _SDBCL_NO, C
001727                    
001728  826E  0928                                    MOVE R9, R10                     ; return the LBA in R9/R10
001729  826F  0824                                    MOVE R8, R9
001730  8270  0020                                    MOVE R0, R8
001731  8271  012C                                    MOVE R1, R11
001732  8272  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001733  8274  FFA0  0004                              RBRA _SDBCL_RET, 1

001735  8277  012C                                    MOVE R1, R11
001736  8278  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
001737  827A  E100        _SDBCL_RET                  DECRB
001738  827B  0DBC                                    MOVE @R13++, R15

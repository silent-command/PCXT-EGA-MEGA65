001681  829D  FFAB  0008                              RBRA _SDBL_C1, !Z                ; idx_hi < total_hi: inside
001682  829F  0010                                    MOVE R0, R4
001683  82A0  1F90  0002                              ADD SDB_M_TBLK_LO, R4
001684  82A2  C111                                    CMP R1, @R4
001685  82A3  FFA4  0029                              RBRA _SDBL_NO, N                 ; idx_lo > total_lo
001686  82A5  FFA3  0027                              RBRA _SDBL_NO, Z                 ; idx_lo = total_lo: outside
001687                    
001688  82A7  0010        _SDBL_C1                    MOVE R0, R4

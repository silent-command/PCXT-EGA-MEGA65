001719                    
001720                    ; Unsigned 32-bit "A >= B" for two little-endian word pairs in memory.
001721                    ; The answer is returned in the Carry flag and not in N/Z, because MOVE @R13++, R15 is
001722                    ; a MOVE (see sysdef.asm) and a MOVE overwrites N and Z but not the Carry.
001723                    ; Input: R8: pointer to A (lo, hi), R9: pointer to B (lo, hi)
001724                    ; Output: Carry=1 if A >= B, R8 and R9 unchanged
001725  82D2  E0C0        _SDB_GE32                   INCRB
001726  82D3  0800                                    MOVE R8, R0
001727  82D4  0904                                    MOVE R9, R1
001728  82D5  1F80  0001                              ADD 1, R0
001729  82D7  1F84  0001                              ADD 1, R1
001730  82D9  C045                                    CMP @R0, @R1                     ; high words
001731  82DA  FFA4  000B                              RBRA _SDB_G32Y, N                ; A_hi > B_hi
001732  82DC  FFAB  0005                              RBRA _SDB_G32N, !Z               ; A_hi < B_hi
001733  82DE  C865                                    CMP @R8, @R9                     ; low words
001734  82DF  FFA4  0006                              RBRA _SDB_G32Y, N
001735  82E1  FFA3  0004                              RBRA _SDB_G32Y, Z
001736  82E3  9FB8  FFFB  _SDB_G32N                   AND 0xFFFB, R14                  ; clear Carry
001737  82E5  FFA0  0002                              RBRA _SDB_G32R, 1
001738  82E7  AFB8  0004  _SDB_G32Y                   OR 0x0004, R14                   ; set Carry
001739  82E9  E100        _SDB_G32R                   DECRB
001740  82EA  0DBC                                    MOVE @R13++, R15

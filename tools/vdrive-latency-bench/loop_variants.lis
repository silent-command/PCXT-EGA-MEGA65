001782  82A8  06A4                                    MOVE @R6++, R9                   ; R9/R10: LBA of the extent
001783  82A9  0668                                    MOVE @R6, R10
001784  82AA  1124                                    ADD R1, R9                       ; plus the remainder
001785  82AB  2228                                    ADDC R2, R10
001786  82AC  FFA2  000C                              RBRA _SDBL_NO, C                 ; 32-bit overflow
001787  82AE  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001788  82B0  FFA0  000A                              RBRA _SDBL_RET, 1
001789                    
001790  82B2  3504        _SDBL_NEXT                  SUB R5, R1                       ; remainder -= extent size
001791  82B3  4608                                    SUBC R6, R2
001792  82B4  1F90  0004                              ADD SDB_E_SIZE, R4               ; next extent
001793  82B6  3F8C  0001                              SUB 1, R3
001794  82B8  FFAB  FFDC                              RBRA _SDBL_LOOP, !Z
001795  82BA  9FB8  FFFB  _SDBL_NO                    AND 0xFFFB, R14                  ; clear Carry
001796  82BC  E100        _SDBL_RET                   DECRB

001659  8218  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001660  821A  6F80  0007                              SHR 7, R0                        ; bits that move up into..
001661  821C  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the high word; clear X
001662  821E  5FA8  0009                              SHL 9, R10
001663  8220  1028                                    ADD R0, R10
001664  8221  9FB8  FFFD                              AND 0xFFFD, R14
001665  8223  5FA4  0009                              SHL 9, R9
001666  8225  E100                                    DECRB
001667  8226  0DBC                                    MOVE @R13++, R15

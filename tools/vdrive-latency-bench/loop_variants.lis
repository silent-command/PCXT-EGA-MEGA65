002041                    
002042                    
002043                    
002044                    
002045  83E7  FF90  0060                              ASUB leave, 1
002046  83E9  0DBC                                    MOVE @R13++, R15
002047                    
002048                    ; Stores a bail-out reason in the map, so that the reason survives even
002049                    ; without the serial log. Runs in SDB_MAP_BUILD's own register bank (R1 is
002050                    ; the map there) and must not disturb any register, hence the stack.
002051                    ; Input: R1 = map, R8 = reason. Output: everything unchanged.
002052  83EA  0937        _SDB_BAIL                   MOVE R9, @--R13
002053  83EB  0124                                    MOVE R1, R9
002054  83EC  1FA4  0004                              ADD SDB_M_BAIL, R9
002055  83EE  0825                                    MOVE R8, @R9
002056  83EF  0DA4                                    MOVE @R13++, R9
002057  83F0  0DBC                                    MOVE @R13++, R15
002058                    
002059                    ; Writes one extent: R6/R7 = amount of blocks, SDB_S_RSTART = first cluster,
002060                    ; R5 = destination, R2 = device handle.
002061                    ; Output: Carry=1 if the extent is usable. Clobbers R8..R12, leaves R0..R7.
002062  83F1  0FA0  8755  _SDB_EMIT                   MOVE SDB_S_RSTART, R8
002063  83F3  08A4                                    MOVE @R8++, R9
002064  83F4  0868                                    MOVE @R8, R10
002065  83F5  BB2C                                    XOR R11, R11                     ; sector 0 within the cluster
002066  83F6  0220                                    MOVE R2, R8
002067  83F7  FFB0  FE2E                              RSUB SDB_CLULBA, 1
002068  83F9  FFAA  000D                              RBRA _SDB_EMIT_R, !C             ; Carry is already clear
002069                    
002070  83FB  0520                                    MOVE R5, R8
002071  83FC  0621                                    MOVE R6, @R8
002072  83FD  0520                                    MOVE R5, R8
002073  83FE  1FA0  0001                              ADD SDB_E_NBLK_HI, R8
002074  8400  0721                                    MOVE R7, @R8
002075  8401  0520                                    MOVE R5, R8
002076  8402  1FA0  0002                              ADD SDB_E_LBA_LO, R8
002077  8404  0922                                    MOVE R9, @R8++
002078  8405  0A21                                    MOVE R10, @R8
002079  8406  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002080  8408  0DBC        _SDB_EMIT_R                 MOVE @R13++, R15
002081                    
002082                    ; SDB_FAT_NEXT
002083                    ; Reads the FAT32 chain successor of a cluster. Uses a one entry cache for
002084                    ; the FAT sector, so a run of consecutive clusters costs one SD card block
002085                    ; read per 128 clusters. Expects SDB_GUARD_IN to have been called.
002086                    ;
002087                    ; Input: R8: device handle
002088                    ; R9/R10: cluster lo/hi
002089                    ; Output: Carry=1: R9/R10 = successor cluster lo/hi (28 bit)
002090                    ; Carry=0: the FAT sector could not be read
002091                    ; R8 unchanged
002092  8409  E0C0        SDB_FAT_NEXT                INCRB
002093  840A  0800                                    MOVE R8, R0                      ; R0: device handle
002094  840B  0904                                    MOVE R9, R1                      ; R1: byte offset in sector
002095  840C  9F84  007F                              AND 0x007F, R1                   ; 128 FAT entries per sector
002096  840E  9FB8  FFFD                              AND 0xFFFD, R14                  ; clear X
002097  8410  5F84  0002                              SHL 2, R1                        ; 4 bytes per entry
002098                    
002099                                                ; FAT sector number = cluster / 128
002100  8412  0A08                                    MOVE R10, R2
002101  8413  9F88  007F                              AND 0x007F, R2
002102  8415  9FB8  FFFD                              AND 0xFFFD, R14
002103  8417  5F88  0009                              SHL 9, R2
002104  8419  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C
002105  841B  6FA4  0007                              SHR 7, R9
002106  841D  1224                                    ADD R2, R9
002107  841E  9FB8  FFFB                              AND 0xFFFB, R14
002108  8420  6FA8  0007                              SHR 7, R10
002109                    
002110  8422  0008                                    MOVE R0, R2                      ; plus the FAT start LBA
002111  8423  1F88  0008                              ADD FAT32$DEV_FAT_LO, R2
002112  8425  028C                                    MOVE @R2++, R3
002113  8426  0248                                    MOVE @R2, R2
002114  8427  1324                                    ADD R3, R9
002115  8428  2228                                    ADDC R2, R10
002116  8429  FFA2  004E                              RBRA _SDB_FN_ERR, C              ; 32-bit overflow
002117                    
002118                                                ; is this sector already in the hardware buffer?
002119  842B  0F88  875B                              MOVE SDB_S_FCVAL, R2
002120  842D  CF89  0000                              CMP 0, @R2
002121  842F  FFA3  000A                              RBRA _SDB_FN_RD, Z
002122  8431  0F88  8759                              MOVE SDB_S_FCLBA, R2
002123  8433  C264                                    CMP @R2, R9
002124  8434  FFAB  0005                              RBRA _SDB_FN_RD, !Z
002125  8436  1F88  0001                              ADD 1, R2
002126  8438  C268                                    CMP @R2, R10
002127  8439  FFA3  0016                              RBRA _SDB_FN_BUF, Z
002128                    
002129  843B  0F88  875B  _SDB_FN_RD                  MOVE SDB_S_FCVAL, R2             ; cache is stale in any case
002130  843D  0F89  0000                              MOVE 0, @R2
002131  843F  0908                                    MOVE R9, R2                      ; R2/R3: remember the LBA
002132  8440  0A0C                                    MOVE R10, R3
002133  8441  0220                                    MOVE R2, R8
002134  8442  0324                                    MOVE R3, R9
002135  8443  FFB0  FD32                              RSUB SDB_SDRD, 1
002136  8445  CFA0  0000                              CMP 0, R8
002137  8447  FFAB  002E                              RBRA _SDB_FN_SDE, !Z
002138  8449  0FA0  8759                              MOVE SDB_S_FCLBA, R8
002139  844B  0222                                    MOVE R2, @R8++
002140  844C  0321                                    MOVE R3, @R8
002141  844D  0FA0  875B                              MOVE SDB_S_FCVAL, R8
002142  844F  0FA1  0001                              MOVE 1, @R8
002143                    
002144                                                ; read the 32-bit little-endian FAT entry. Keep one
002145                                                ; instruction between writing IO$SD_DATA_POS and reading
002146                                                ; IO$SD_DATA, exactly like SD$READ_BYTE does: the buffer is a
002147                                                ; block RAM whose output is registered (see byte_bram.vhd).
002148  8451  0F88  FF22  _SDB_FN_BUF                 MOVE IO$SD_DATA_POS, R2
002149  8453  0F8C  FF23                              MOVE IO$SD_DATA, R3
002150  8455  0110                                    MOVE R1, R4                      ; R4: walking byte offset
002151  8456  0409                                    MOVE R4, @R2
002152  8457  1F90  0001                              ADD 1, R4                        ; spacing, and the next offset
002153  8459  0364                                    MOVE @R3, R9                     ; byte 0
002154  845A  0409                                    MOVE R4, @R2
002155  845B  1F90  0001                              ADD 1, R4
002156  845D  0354                                    MOVE @R3, R5                     ; byte 1
002157  845E  9FB8  FFFD                              AND 0xFFFD, R14
002158  8460  5F94  0008                              SHL 8, R5
002159  8462  1524                                    ADD R5, R9
002160  8463  0409                                    MOVE R4, @R2
002161  8464  1F90  0001                              ADD 1, R4
002162  8466  0368                                    MOVE @R3, R10                    ; byte 2
002163  8467  0409                                    MOVE R4, @R2
002164  8468  1F90  0001                              ADD 1, R4
002165  846A  0354                                    MOVE @R3, R5                     ; byte 3
002166  846B  9FB8  FFFD                              AND 0xFFFD, R14
002167  846D  5F94  0008                              SHL 8, R5
002168  846F  1528                                    ADD R5, R10
002169  8470  9FA8  0FFF                              AND 0x0FFF, R10                  ; FAT32 entries are 28 bit
002170  8472  0020                                    MOVE R0, R8
002171  8473  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002172  8475  FFA0  0005                              RBRA _SDB_FN_RET, 1
002173                    
002174  8477  FFB0  FD04  _SDB_FN_SDE                 RSUB SDB_SDERR, 1
002175  8479  0020        _SDB_FN_ERR                 MOVE R0, R8
002176  847A  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002177  847C  E100        _SDB_FN_RET                 DECRB
002178  847D  0DBC                                    MOVE @R13++, R15
002179                    
002180                    ; ----------------------------------------------------------------------------
002181                    ; Block transfers
002182                    ; ----------------------------------------------------------------------------
002183                    
002184                    ; SDB_SD2VD
002185                    ; Copies the 512 bytes in the buffer of the SD controller into the internal
002186                    ; block buffer of a virtual drive. Device and 4k window selection are hoisted
002187                    ; out of the loop, which is what makes this about twenty times faster than
002188                    ; the original per-byte VD_CAD_WRITE sequence.
002189                    ;
002190                    ; Input: R8: virtual drive number (only used for the vdrives device select)
002191                    ; Output: none, all registers unchanged
002192  847E  E0C0        SDB_SD2VD                   INCRB
002193  847F  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002194  8481  0F84  8689                              MOVE VDRIVES_DEVICE, R1
002195  8483  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002196  8484  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0
002197  8486  0F81  0000                              MOVE VD_WIN_CAD, @R0             ; control and data registers
002198                    
002199  8488  0F80  FF22                              MOVE IO$SD_DATA_POS, R0
002200  848A  0F84  FF23                              MOVE IO$SD_DATA, R1
002201  848C  0F88  7005                              MOVE VD_B_ADDR, R2
002202  848E  0F8C  7006                              MOVE VD_B_DOUT, R3
002203  8490  0F90  7007                              MOVE VD_B_WREN, R4
002204  8492  B514                                    XOR R5, R5
002205  8493  0501        _SDB_S2V_L                  MOVE R5, @R0                     ; position in the SD buffer
002206  8494  0509                                    MOVE R5, @R2                     ; address in the drive buffer
002207  8495  014D                                    MOVE @R1, @R3                    ; the byte itself
002208  8496  0F91  0001                              MOVE 1, @R4                      ; strobe write enable
002209  8498  0F91  0000                              MOVE 0, @R4
002210  849A  1F94  0001                              ADD 1, R5
002211  849C  CF94  0200                              CMP 0x0200, R5
002212  849E  FFAB  FFF3                              RBRA _SDB_S2V_L, !Z
002213  84A0  E100                                    DECRB
002214  84A1  0DBC                                    MOVE @R13++, R15
002215                    
002216                    ; SDB_VD2SD
002217                    ; Copies the 512 bytes from the internal block buffer of a virtual drive into
002218                    ; the buffer of the SD controller. The drive buffer address register lives in
002219                    ; the control/data window while the data register lives in the drive window,
002220                    ; so the window selector has to be toggled per byte; the device selection is
002221                    ; still hoisted out of the loop.
002222                    ;
002223                    ; Input: R8: virtual drive number
002224                    ; Output: none, all registers unchanged
002225  84A2  E0C0        SDB_VD2SD                   INCRB
002226  84A3  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002227  84A5  0F84  8689                              MOVE VDRIVES_DEVICE, R1
002228  84A7  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002229                    
002230  84A8  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002231  84AA  0F84  0001                              MOVE VD_WIN_DRV, R1
002232  84AC  1804                                    ADD R8, R1                       ; R1: window of this drive
002233  84AD  0F88  FF22                              MOVE IO$SD_DATA_POS, R2
002234  84AF  0F8C  FF23                              MOVE IO$SD_DATA, R3
002235  84B1  0F90  7005                              MOVE VD_B_ADDR, R4
002236  84B3  0F94  700B                              MOVE VD_B_DIN, R5
002237  84B5  B618                                    XOR R6, R6
002238  84B6  0F81  0000  _SDB_V2S_L                  MOVE VD_WIN_CAD, @R0             ; control and data registers
002239  84B8  0611                                    MOVE R6, @R4                     ; address in the drive buffer
002240  84B9  0101                                    MOVE R1, @R0                     ; drive specific registers
002241  84BA  0609                                    MOVE R6, @R2                     ; position in the SD buffer
002242  84BB  054D                                    MOVE @R5, @R3                    ; the byte itself
002243  84BC  1F98  0001                              ADD 1, R6
002244  84BE  CF98  0200                              CMP 0x0200, R6
002245  84C0  FFAB  FFF4                              RBRA _SDB_V2S_L, !Z
002246  84C2  E100                                    DECRB
002247  84C3  0DBC                                    MOVE @R13++, R15
002248                    
002249                    ; SDB_SD2DEV
002250                    ; Copies the 512 bytes in the buffer of the SD controller into an M2M byte
002251                    ; streaming device (a CRT/ROM load target), handling the 4k window boundary.
002252                    ;
002253                    ; Input: R8: target device id
002254                    ; R9: target 4k window
002255                    ; R10: target address within the window (M2M$RAMROM_DATA based)
002256                    ; Output: R9/R10: window and address behind the last written byte
002257                    ; R8 unchanged
002258  84C4  E0C0        SDB_SD2DEV                  INCRB
002259  84C5  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002260  84C7  0801                                    MOVE R8, @R0
002261  84C8  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002262  84CA  0901                                    MOVE R9, @R0
002263  84CB  0F84  FF22                              MOVE IO$SD_DATA_POS, R1
002264  84CD  0F88  FF23                              MOVE IO$SD_DATA, R2
002265  84CF  0F8C  7000                              MOVE M2M$RAMROM_DATA, R3
002266  84D1  1F8C  1000                              ADD 0x1000, R3                   ; R3: end of window marker
002267  84D3  B410                                    XOR R4, R4                       ; R4: position in the SD buf
002268  84D4  0F94  0200                              MOVE 0x0200, R5                  ; R5: bytes still to go
002269                                                ; One instruction has to sit between writing IO$SD_DATA_POS
002270                                                ; and reading IO$SD_DATA, exactly like SD$READ_BYTE does: the
002271                                                ; buffer is a block RAM with a registered output, see
002272                                                ; M2M/QNICE/vhdl/byte_bram.vhd. The ADD below is that
002273                                                ; instruction and does useful work at the same time.
002274  84D6  0405        _SDB_S2D_L                  MOVE R4, @R1                     ; position in the SD buffer
002275  84D7  1F90  0001                              ADD 1, R4
002276  84D9  026A                                    MOVE @R2, @R10++                 ; the byte itself
002277  84DA  C328                                    CMP R3, R10                      ; 4k window boundary?
002278  84DB  FFAB  0005                              RBRA _SDB_S2D_1, !Z              ; no
002279  84DD  0FA8  7000                              MOVE M2M$RAMROM_DATA, R10        ; yes: next window
002280  84DF  1FA4  0001                              ADD 1, R9
002281  84E1  0901                                    MOVE R9, @R0
002282  84E2  3F94  0001  _SDB_S2D_1                  SUB 1, R5
002283  84E4  FFAB  FFF0                              RBRA _SDB_S2D_L, !Z
002284  84E6  E100                                    DECRB
002285  84E7  0DBC                                    MOVE @R13++, R15
002286                    
002287                    ; ----------------------------------------------------------------------------
002288                    ; High level entry points
002289                    ; ----------------------------------------------------------------------------
002290                    
002291                    ; SDB_VD_RDBLK
002292                    ; Prepares one virtual drive block read: maps the byte position to an LBA and
002293                    ; reads that block into the buffer of the SD controller. On success the
002294                    ; caller acknowledges sd_rd_i and then calls SDB_SD2VD.
002295                    ;
002296                    ; Input: R8: virtual drive number
002297                    ; R9: file handle of the disk image
002298                    ; R10/R11: byte position within the image, lo/hi
002299                    ; R12: amount of bytes the core asked for
002300                    ; Output: Carry=1: the block is in the buffer of the SD controller
002301                    ; Carry=0: use the FAT32 library path instead
002302                    ; R8 .. R12 unchanged
002303  84E8  E0C0        SDB_VD_RDBLK                INCRB
002304  84E9  0800                                    MOVE R8, R0
002305  84EA  0904                                    MOVE R9, R1
002306  84EB  0A08                                    MOVE R10, R2
002307  84EC  0B0C                                    MOVE R11, R3
002308  84ED  0C10                                    MOVE R12, R4
002309  84EE  FFB0  0068                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002310  84F0  FFAA  0021                              RBRA _SDB_VRD_NO, !C
002311  84F2  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002312  84F3  0A18                                    MOVE R10, R6
002313  84F4  FFB0  FC8E                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002314  84F6  FFAA  0017                              RBRA _SDB_VRD_GRD, !C            ; no: nothing was touched
002315  84F8  0520                                    MOVE R5, R8
002316  84F9  0624                                    MOVE R6, R9
002317  84FA  FFB0  FC7B                              RSUB SDB_SDRD, 1
002318  84FC  CFA0  0000                              CMP 0, R8
002319  84FE  FFAB  0005                              RBRA _SDB_VRD_SDE, !Z            ; SD error: try the slow path
002320  8500  0020                                    MOVE R0, R8
002321  8501  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002322  8503  FFA0  0011                              RBRA _SDB_VRD_R, 1
002323  8505  FFB0  FC76  _SDB_VRD_SDE                RSUB SDB_SDERR, 1
002324  8507  FFB0  FCC4                              RSUB SDB_GUARD_OUT, 1
002325  8509  0FA0  873A                              MOVE SDB_RD_STAT, R8
002326  850B  0FA1  0006                              MOVE SDB_R_SDERR, @R8
002327  850D  FFA0  0004                              RBRA _SDB_VRD_NO, 1
002328  850F  0FA0  873A  _SDB_VRD_GRD                MOVE SDB_RD_STAT, R8
002329  8511  0FA1  0005                              MOVE SDB_R_GUARD, @R8
002330  8513  0020        _SDB_VRD_NO                 MOVE R0, R8
002331  8514  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002332  8516  0124        _SDB_VRD_R                  MOVE R1, R9
002333  8517  0228                                    MOVE R2, R10
002334  8518  032C                                    MOVE R3, R11
002335  8519  0430                                    MOVE R4, R12
002336  851A  E100                                    DECRB
002337  851B  0DBC                                    MOVE @R13++, R15
002338                    
002339                    ; SDB_VD_RDDONE
002340                    ; Called by HANDLE_DRV_RD after SDB_SD2VD has emptied the buffer: puts the
002341                    ; FAT32 library's sector back into it.
002342                    ;
002343                    ; Input: none
002344                    ; Output: none, all registers unchanged
002345  851C  FFB0  FCAF  SDB_VD_RDDONE               RSUB SDB_GUARD_OUT, 1
002346  851E  0DBC                                    MOVE @R13++, R15
002347                    
002348                    ; SDB_VD_WRBLK
002349                    ; Writes one virtual drive block: maps the byte position to an LBA, copies
002350                    ; the internal block buffer of the drive into the buffer of the SD controller
002351                    ; and writes it. The caller acknowledges sd_wr_i afterwards.
002352                    ;
002353                    ; Input: R8: virtual drive number
002354                    ; R9: file handle of the disk image
002355                    ; R10/R11: byte position within the image, lo/hi
002356                    ; R12: amount of bytes the core wants to write
002357                    ; Output: Carry=1: the block has been written to the SD card
002358                    ; Carry=0: nothing was written, use the FAT32 library path instead
002359                    ; R8 .. R12 unchanged
002360  851F  E0C0        SDB_VD_WRBLK                INCRB
002361  8520  0800                                    MOVE R8, R0
002362  8521  0904                                    MOVE R9, R1
002363  8522  0A08                                    MOVE R10, R2
002364  8523  0B0C                                    MOVE R11, R3
002365  8524  0C10                                    MOVE R12, R4
002366  8525  FFB0  0031                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002367  8527  FFAA  0026                              RBRA _SDB_VWR_NO, !C
002368  8529  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002369  852A  0A18                                    MOVE R10, R6
002370  852B  FFB0  FC57                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002371  852D  FFAA  001C                              RBRA _SDB_VWR_GRD, !C            ; no: nothing was touched
002372  852F  0020                                    MOVE R0, R8
002373  8530  FFB0  FF70                              RSUB SDB_VD2SD, 1
002374  8532  0520                                    MOVE R5, R8
002375  8533  0624                                    MOVE R6, R9
002376  8534  FFB0  FC44                              RSUB SDB_SDWR, 1
002377  8536  CFA0  0000                              CMP 0, R8
002378  8538  FFAB  0007                              RBRA _SDB_VWR_SDE, !Z
002379  853A  FFB0  FC91                              RSUB SDB_GUARD_OUT, 1            ; the write is done, restore
002380  853C  0020                                    MOVE R0, R8
002381  853D  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002382  853F  FFA0  0011                              RBRA _SDB_VWR_R, 1
002383  8541  FFB0  FC3A  _SDB_VWR_SDE                RSUB SDB_SDERR, 1                ; SD error: try the slow path
002384  8543  FFB0  FC88                              RSUB SDB_GUARD_OUT, 1
002385  8545  0FA0  873A                              MOVE SDB_RD_STAT, R8
002386  8547  0FA1  0006                              MOVE SDB_R_SDERR, @R8
002387  8549  FFA0  0004                              RBRA _SDB_VWR_NO, 1
002388  854B  0FA0  873A  _SDB_VWR_GRD                MOVE SDB_RD_STAT, R8
002389  854D  0FA1  0005                              MOVE SDB_R_GUARD, @R8
002390  854F  0020        _SDB_VWR_NO                 MOVE R0, R8
002391  8550  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002392  8552  0124        _SDB_VWR_R                  MOVE R1, R9
002393  8553  0228                                    MOVE R2, R10
002394  8554  032C                                    MOVE R3, R11
002395  8555  0430                                    MOVE R4, R12
002396  8556  E100                                    DECRB
002397  8557  0DBC                                    MOVE @R13++, R15
002398                    
002399                    ; Common preparation for SDB_VD_RDBLK / SDB_VD_WRBLK. Expects the inputs in
002400                    ; the caller's R0 (drive), R1 (FDH), R2/R3 (byte position) and R4 (amount of
002401                    ; bytes) and returns Carry=1 plus the LBA in R9/R10. Runs in the caller's
002402                    ; register bank on purpose. Touches nothing outside our own variables.
002403  8558  0FAC  873A  _SDB_PREP                   MOVE SDB_RD_STAT, R11
002404  855A  0FAD  0001                              MOVE SDB_R_SIZE, @R11
002405  855C  0FA0  0200                              MOVE 0x0200, R8
002406  855E  C420                                    CMP R4, R8                       ; exactly one block?
002407  855F  FFAB  0026                              RBRA _SDB_PREP_NO, !Z            ; no: let the FAT32 path do
002408  8561  0FAD  0002                              MOVE SDB_R_ALIGN, @R11           ; ..partial/multi blocks
002409  8563  0220                                    MOVE R2, R8
002410  8564  9FA0  01FF                              AND 0x01FF, R8                   ; block aligned?
002411  8566  FFAB  001F                              RBRA _SDB_PREP_NO, !Z            ; no
002412  8568  0FAD  0003                              MOVE SDB_R_MAP, @R11
002413  856A  0020                                    MOVE R0, R8
002414  856B  FFB0  FBDE                              RSUB SDB_VDMAP, 1
002415  856D  0830                                    MOVE R8, R12                     ; R12: map (R11 stays the..
002416  856E  0124                                    MOVE R1, R9                      ; ..status pointer)
002417  856F  FFB0  FBF3                              RSUB SDB_CHECK, 1
002418  8571  FFAA  0014                              RBRA _SDB_PREP_NO, !C
002419  8573  0FAD  0004                              MOVE SDB_R_RANGE, @R11
002420  8575  0224                                    MOVE R2, R9
002421  8576  0328                                    MOVE R3, R10
002422  8577  FFB0  FC8A                              RSUB SDB_B2BLK, 1
002423  8579  0C20                                    MOVE R12, R8
002424  857A  FFB0  FD00                              RSUB SDB_LBA, 1
002425  857C  FFAA  0009                              RBRA _SDB_PREP_NO, !C
002426  857E  0FA0  873B                              MOVE SDB_RD_LBA, R8              ; remember it for the log
002427  8580  0922                                    MOVE R9, @R8++
002428  8581  0A21                                    MOVE R10, @R8
002429  8582  0FAD  0000                              MOVE SDB_R_OK, @R11
002430  8584  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002431  8586  0DBC                                    MOVE @R13++, R15
002432  8587  9FB8  FFFB  _SDB_PREP_NO                AND 0xFFFB, R14                  ; clear Carry
002433  8589  0DBC                                    MOVE @R13++, R15
002434                    
002435                    ; SDB_FREAD_FAST
002436                    ; Streams whole 512-byte blocks of a mapped file directly from the SD card
002437                    ; into an M2M byte streaming device and then positions the file handle right
002438                    ; behind them, so that the caller's byte loop reads the rest as usual.
002439                    ;
002440                    ; It deliberately stops one whole block short of the end of the file, so that
002441                    ; the position it hands over is always strictly inside the file and the
002442                    ; caller reaches EOF through the FAT32 library, exactly as before.
002443                    ;
002444                    ; The final f32_fseek is what restores the library: a seek unconditionally
002445                    ; re-reads the sector into the hardware buffer and re-claims ownership, so
002446                    ; afterwards the library is in a state it produced itself. If anything at all
002447                    ; goes wrong the file position is put back where it was and Carry=0 is
002448                    ; returned, i.e. the caller sees "nothing happened".
002449                    ;
002450                    ; Input: R8: file handle (FDH)
002451                    ; R9: pointer to the block map
002452                    ; R10: target device id
002453                    ; R11: target 4k window
002454                    ; R12: target address within the window
002455                    ; Output: Carry=1: R11/R12 updated, the file position is behind the data
002456                    ; Carry=0: nothing was transferred, the file position is unchanged
002457                    ; and R11/R12 are unchanged
002458  858A  E0C0        SDB_FREAD_FAST              INCRB
002459  858B  0800                                    MOVE R8, R0                      ; R0: FDH
002460  858C  0904                                    MOVE R9, R1                      ; R1: map
002461  858D  0A08                                    MOVE R10, R2                     ; R2: target device
002462  858E  0B0C                                    MOVE R11, R3                     ; R3: target 4k window
002463  858F  0C10                                    MOVE R12, R4                     ; R4: target address
002464                    
002465  8590  0FA0  8738                              MOVE SDB_FF_STAT, R8
002466  8592  0FA1  0001                              MOVE SDB_B_NOMAP, @R8
002467  8594  0FA0  8739                              MOVE SDB_FF_BLKS, R8
002468  8596  0FA1  0000                              MOVE 0, @R8
002469                    
002470  8598  0120                                    MOVE R1, R8
002471  8599  0024                                    MOVE R0, R9
002472  859A  FFB0  FBC8                              RSUB SDB_CHECK, 1
002473  859C  FFAA  0090                              RBRA _SDBFF_NO, !C
002474                    
002475                                                ; only from the very beginning of the file
002476  859E  0020                                    MOVE R0, R8
002477  859F  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002478  85A1  CFA1  0000                              CMP 0, @R8
002479  85A3  FFAB  0089                              RBRA _SDBFF_NO, !Z
002480  85A5  0020                                    MOVE R0, R8
002481  85A6  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002482  85A8  CFA1  0000                              CMP 0, @R8
002483  85AA  FFAB  0082                              RBRA _SDBFF_NO, !Z
002484                    
002485                                                ; how many whole blocks do we take? Always one less than the
002486                                                ; file has, so that the handover position is strictly inside
002487                                                ; the file and the caller still reaches EOF through the
002488                                                ; library. A CRT/ROM file is never 32 MB or larger, so one
002489                                                ; word of block count is plenty and anything else is refused.
002490  85AC  0120                                    MOVE R1, R8
002491  85AD  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
002492  85AF  CFA1  0000                              CMP 0, @R8
002493  85B1  FFAB  007B                              RBRA _SDBFF_NO, !Z
002494  85B3  0120                                    MOVE R1, R8
002495  85B4  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
002496  85B6  085C                                    MOVE @R8, R7                     ; R7: blocks still to do
002497  85B7  3F9C  0001                              SUB 1, R7
002498  85B9  FFA3  0073                              RBRA _SDBFF_NO, Z                ; a one block file: byte loop
002499  85BB  FFA4  0071                              RBRA _SDBFF_NO, N                ; cannot happen: TBLK was 0
002500                    
002501  85BD  0FA0  8738                              MOVE SDB_FF_STAT, R8
002502  85BF  0FA1  000B                              MOVE SDB_B_GUARD, @R8
002503  85C1  FFB0  FBC1                              RSUB SDB_GUARD_IN, 1             ; nothing touched if it fails
002504  85C3  FFAA  0069                              RBRA _SDBFF_NO, !C
002505                    
002506  85C5  B514                                    XOR R5, R5                       ; R5/R6: block index
002507  85C6  B618                                    XOR R6, R6
002508                    
002509  85C7  CF9C  0000  _SDBFF_LOOP                 CMP 0, R7
002510  85C9  FFA3  0020                              RBRA _SDBFF_DONE, Z
002511  85CB  0120                                    MOVE R1, R8
002512  85CC  0524                                    MOVE R5, R9
002513  85CD  0628                                    MOVE R6, R10
002514  85CE  FFB0  FCAC                              RSUB SDB_LBA, 1
002515  85D0  FFAA  0019                              RBRA _SDBFF_DONE, !C
002516                    
002517                    
002518                    
002519                    
002520  85D2  0920                                    MOVE R9, R8
002521  85D3  0A24                                    MOVE R10, R9
002522  85D4  FFB0  FBA1                              RSUB SDB_SDRD, 1
002523  85D6  CFA0  0000                              CMP 0, R8
002524  85D8  FFAB  000F                              RBRA _SDBFF_SDE, !Z              ; SD error: stop here
002525  85DA  0220                                    MOVE R2, R8
002526  85DB  0324                                    MOVE R3, R9
002527  85DC  0428                                    MOVE R4, R10
002528  85DD  FFB0  FEE5                              RSUB SDB_SD2DEV, 1
002529  85DF  090C                                    MOVE R9, R3
002530  85E0  0A10                                    MOVE R10, R4
002531  85E1  1F94  0001                              ADD 1, R5
002532  85E3  2F98  0000                              ADDC 0, R6
002533  85E5  3F9C  0001                              SUB 1, R7
002534  85E7  FFA0  FFDE                              RBRA _SDBFF_LOOP, 1
002535                    
002536  85E9  FFB0  FB92  _SDBFF_SDE                  RSUB SDB_SDERR, 1
002537                    
002538                                                ; the hardware buffer is ours now; whatever we do next, the
002539                                                ; library has to be put back. A seek does that properly.
002540  85EB  0FA0  8739  _SDBFF_DONE                 MOVE SDB_FF_BLKS, R8
002541  85ED  0521                                    MOVE R5, @R8
002542  85EE  CF94  0000                              CMP 0, R5                        ; anything transferred?
002543  85F0  FFAB  0004                              RBRA _SDBFF_SEEK, !Z
002544  85F2  CF98  0000                              CMP 0, R6
002545  85F4  FFA3  0029                              RBRA _SDBFF_REW, Z               ; no: just put it back
002546                    
002547  85F6  0FA0  8738  _SDBFF_SEEK                 MOVE SDB_FF_STAT, R8
002548  85F8  0FA1  000C                              MOVE SDB_B_SEEK, @R8
002549  85FA  0524                                    MOVE R5, R9                      ; file position = blocks * 512
002550  85FB  0628                                    MOVE R6, R10
002551  85FC  FFB0  FC18                              RSUB SDB_BLK2B, 1
002552  85FE  092C                                    MOVE R9, R11                     ; R11/R12: expected position
002553  85FF  0A30                                    MOVE R10, R12
002554  8600  0020                                    MOVE R0, R8
002555  8601  FF90  0054                              ASUB f32_fseek, 1
002556  8603  CFA4  0000                              CMP 0, R9                        ; seek reported success?
002557  8605  FFAB  0018                              RBRA _SDBFF_REW, !Z
002558  8607  0020                                    MOVE R0, R8                      ; ..and actually got there?
002559  8608  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002560  860A  C86C                                    CMP @R8, R11
002561  860B  FFAB  0012                              RBRA _SDBFF_REW, !Z
002562  860D  0020                                    MOVE R0, R8
002563  860E  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002564  8610  C870                                    CMP @R8, R12
002565  8611  FFAB  000C                              RBRA _SDBFF_REW, !Z
002566                    
002567  8613  0FA0  8738                              MOVE SDB_FF_STAT, R8
002568  8615  0FA1  0000                              MOVE SDB_B_OK, @R8
002569  8617  FFB0  FBC3                              RSUB SDB_GUARD_CLR, 1            ; the seek put the library..
002570  8619  032C                                    MOVE R3, R11                     ; ..back, nobody to tell
002571  861A  0430                                    MOVE R4, R12
002572  861B  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002573  861D  FFA0  0011                              RBRA _SDBFF_RET, 1
002574                    
002575                                                ; Put the file back to the start and report "nothing done".
002576                                                ; The caller has not seen the updated target pointers, so it
002577                                                ; simply overwrites whatever we already transferred. The seek
002578                                                ; also restores the library's sector buffer; if even that
002579                                                ; fails, the buffer is marked unknown.
002580  861F  0020        _SDBFF_REW                  MOVE R0, R8
002581  8620  B924                                    XOR R9, R9
002582  8621  BA28                                    XOR R10, R10
002583  8622  FF90  0054                              ASUB f32_fseek, 1
002584  8624  CFA4  0000                              CMP 0, R9
002585  8626  FFAB  0004                              RBRA _SDBFF_RW1, !Z
002586  8628  FFB0  FBB2                              RSUB SDB_GUARD_CLR, 1            ; the rewind put it back
002587  862A  FFA0  0002                              RBRA _SDBFF_NO, 1
002588  862C  FFB0  FBB5  _SDBFF_RW1                  RSUB SDB_ORPHAN, 1               ; not even that worked
002589                    
002590  862E  9FB8  FFFB  _SDBFF_NO                   AND 0xFFFB, R14                  ; clear Carry
002591  8630              _SDBFF_RET                  
002592  8630  E100                                    DECRB
002593  8631  0DBC                                    MOVE @R13++, R15
002594                    

001821                    ; ----------------------------------------------------------------------------
001822                    ; Building the map
001823                    ; ----------------------------------------------------------------------------
001824                    
001825                    ; SDB_MAP_BUILD
001826                    ; Walks the FAT cluster chain of an open file once and stores the result as
001827                    ; an extent table, so that SDB_LBA can map blocks to LBAs afterwards. Costs
001828                    ; one SD card block read per 128 clusters of the file.
001829                    ;
001830                    ; Reads FAT sectors directly and therefore destroys the FAT32 library's
001831                    ; sector buffer, so it guards and restores it (see THE TWO RULES above). It
001832                    ; never modifies the file handle: the file position is the same afterwards.
001833                    ;
001834                    ; Input: R8: file handle (FDH)
001835                    ; R9: pointer to the block map to be filled
001836                    ; Output: none. The map is left invalid (extent count = 0, reason in
001837                    ; SDB_M_BAIL) when the file cannot be described, which makes all
001838                    ; callers fall back silently.
001839  82D7  FF90  005E  SDB_MAP_BUILD               ASUB enter, 1
001840                    
001841  82D9  0800                                    MOVE R8, R0                      ; R0: FDH
001842  82DA  0904                                    MOVE R9, R1                      ; R1: map
001843                    
001844  82DB  0F85  0000                              MOVE 0, @R1                      ; invalid until proven good
001845  82DD  0108                                    MOVE R1, R2
001846  82DE  1F88  0004                              ADD SDB_M_BAIL, R2
001847  82E0  0F89  0001                              MOVE SDB_B_NOMAP, @R2
001848  82E2  0F88  872A                              MOVE SDB_NULL_MAP, R2            ; no real map for this drive?
001849  82E4  C204                                    CMP R2, R1
001850  82E5  FFA3  0100                              RBRA _SDBMB_RET, Z               ; then there is nothing to do
001851                    
001852  82E7  0108                                    MOVE R1, R2
001853  82E8  1F88  0001                              ADD SDB_M_FDH, R2
001854  82EA  0009                                    MOVE R0, @R2                     ; remember the file handle
001855                    
001856  82EB  0FA0  0002                              MOVE SDB_B_NODEV, R8
001857  82ED  FFB0  00FB                              RSUB _SDB_BAIL, 1
001858  82EF  0008                                    MOVE R0, R2
001859  82F0  1F88  0000                              ADD FAT32$FDH_DEVICE, R2
001860  82F2  0248                                    MOVE @R2, R2                     ; R2: device handle
001861  82F3  FFA3  00F2                              RBRA _SDBMB_RET, Z
001862                    
001863  82F5  0FA0  0003                              MOVE SDB_B_NOSPC, R8
001864  82F7  FFB0  00F1                              RSUB _SDB_BAIL, 1
001865  82F9  020C                                    MOVE R2, R3
001866  82FA  1F8C  000C                              ADD FAT32$DEV_SECT_PER_CLUS, R3
001867  82FC  034C                                    MOVE @R3, R3                     ; R3: sectors per cluster
001868  82FD  FFA3  00E8                              RBRA _SDBMB_RET, Z
001869                    
001870                                                ; total amount of whole 512-byte blocks = filesize / 512
001871  82FF  0020                                    MOVE R0, R8
001872  8300  1FA0  0005                              ADD FAT32$FDH_SIZE_LO, R8
001873  8302  0864                                    MOVE @R8, R9
001874  8303  0020                                    MOVE R0, R8
001875  8304  1FA0  0006                              ADD FAT32$FDH_SIZE_HI, R8
001876  8306  0868                                    MOVE @R8, R10
001877  8307  FFB0  FEFA                              RSUB SDB_B2BLK, 1
001878  8309  0120                                    MOVE R1, R8
001879  830A  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
001880  830C  0921                                    MOVE R9, @R8
001881  830D  0120                                    MOVE R1, R8
001882  830E  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
001883  8310  0A21                                    MOVE R10, @R8
001884  8311  0FA0  874F                              MOVE SDB_S_BLEFT, R8             ; blocks still to be mapped
001885  8313  0922                                    MOVE R9, @R8++
001886  8314  0A21                                    MOVE R10, @R8
001887                    
001888                    
001889                    
001890                    
001891                    
001892                    
001893                    
001894  8315  0FA0  0004                              MOVE SDB_B_EMPTY, R8
001895  8317  FFB0  00D1                              RSUB _SDB_BAIL, 1
001896  8319  0FA0  874F                              MOVE SDB_S_BLEFT, R8
001897  831B  CFA1  0000                              CMP 0, @R8
001898  831D  FFAB  0006                              RBRA _SDBMB_C0, !Z
001899  831F  1FA0  0001                              ADD 1, R8
001900  8321  CFA1  0000                              CMP 0, @R8
001901  8323  FFA3  00C2                              RBRA _SDBMB_RET, Z               ; less than one whole block
001902                    
001903                                                ; start cluster of the file
001904  8325  0FA0  0005  _SDBMB_C0                   MOVE SDB_B_BADSTART, R8
001905  8327  FFB0  00C1                              RSUB _SDB_BAIL, 1
001906  8329  0020                                    MOVE R0, R8
001907  832A  1FA0  0009                              ADD FAT32$FDH_START_CLUS_LO, R8
001908  832C  0864                                    MOVE @R8, R9
001909  832D  0020                                    MOVE R0, R8
001910  832E  1FA0  000A                              ADD FAT32$FDH_START_CLUS_HI, R8
001911  8330  0868                                    MOVE @R8, R10
001912  8331  CFA8  0000                              CMP 0, R10                       ; cluster >= 2?
001913  8333  FFAB  0006                              RBRA _SDBMB_C1, !Z
001914  8335  CFA4  0001                              CMP 1, R9
001915  8337  FFA4  00AE                              RBRA _SDBMB_RET, N               ; cluster = 0: unusable
001916  8339  FFA3  00AC                              RBRA _SDBMB_RET, Z               ; cluster = 1: unusable
001917  833B  0FA0  8753  _SDBMB_C1                   MOVE SDB_S_CLU, R8
001918  833D  0922                                    MOVE R9, @R8++
001919  833E  0A21                                    MOVE R10, @R8
001920                    
001921                                                ; from here on the SD controller buffer gets destroyed, so
001922                                                ; make sure we can put it back before touching anything
001923  833F  0FA0  000B                              MOVE SDB_B_GUARD, R8
001924  8341  FFB0  00A7                              RSUB _SDB_BAIL, 1
001925  8343  FFB0  FE3F                              RSUB SDB_GUARD_IN, 1
001926  8345  FFAA  00A0                              RBRA _SDBMB_RET, !C
001927                    
001928  8347  0FA0  875B                              MOVE SDB_S_FCVAL, R8             ; FAT sector cache is empty
001929  8349  0FA1  0000                              MOVE 0, @R8
001930                    
001931  834B  B410                                    XOR R4, R4                       ; R4: amount of extents
001932  834C  0114                                    MOVE R1, R5
001933  834D  1F94  0005                              ADD SDB_M_EXT, R5                ; R5: next extent to write
001934                    
001935                                                ; ---- outer loop: one iteration per extent
001936  834F  0FA0  0006  _SDBMB_EXT                  MOVE SDB_B_FRAG, R8
001937  8351  FFB0  0097                              RSUB _SDB_BAIL, 1
001938  8353  0FA0  0008                              MOVE SDB_MAX_EXT, R8
001939  8355  C420                                    CMP R4, R8                       ; still room for an extent?
001940  8356  FFA4  008D                              RBRA _SDBMB_OUT, N               ; cannot happen
001941  8358  FFA3  008B                              RBRA _SDBMB_OUT, Z               ; no: file is too fragmented
001942                    
001943  835A  0FA0  8753                              MOVE SDB_S_CLU, R8               ; remember the first cluster
001944  835C  0FA4  8755                              MOVE SDB_S_RSTART, R9            ; of this extent
001945  835E  08A6                                    MOVE @R8++, @R9++
001946  835F  0865                                    MOVE @R8, @R9
001947                    
001948  8360  0FA0  8751                              MOVE SDB_S_RBLK, R8              ; blocks in this extent = 0
001949  8362  0FA2  0000                              MOVE 0, @R8++
001950  8364  0FA1  0000                              MOVE 0, @R8
001951                    
001952                                                ; ---- inner loop: follow physically consecutive clusters
001953  8366  0FA0  8751  _SDBMB_RUN                  MOVE SDB_S_RBLK, R8              ; blocks += sectors/cluster
001954  8368  0324                                    MOVE R3, R9
001955  8369  1922                                    ADD R9, @R8++
001956  836A  2FA1  0000                              ADDC 0, @R8
001957                    
001958  836C  0FA0  8751                              MOVE SDB_S_RBLK, R8              ; blocks >= blocks left?
001959  836E  0FA4  874F                              MOVE SDB_S_BLEFT, R9
001960  8370  FFB0  FF4C                              RSUB _SDB_GE32, 1
001961  8372  FFA2  005D                              RBRA _SDBMB_LAST, C              ; yes: this is the last extent
001962                    
001963  8374  0FA0  0007                              MOVE SDB_B_FATERR, R8
001964  8376  FFB0  0072                              RSUB _SDB_BAIL, 1
001965  8378  0FA0  8753                              MOVE SDB_S_CLU, R8               ; next cluster from the FAT
001966  837A  08A4                                    MOVE @R8++, R9
001967  837B  0868                                    MOVE @R8, R10
001968  837C  0220                                    MOVE R2, R8
001969  837D  FFB0  008A                              RSUB SDB_FAT_NEXT, 1
001970  837F  FFAA  0064                              RBRA _SDBMB_OUT, !C              ; read error: no map
001971                    
001972  8381  0FA0  0008                              MOVE SDB_B_BADCLUS, R8
001973  8383  FFB0  0065                              RSUB _SDB_BAIL, 1
001974  8385  CFA8  0000                              CMP 0, R10                       ; free or reserved cluster?
001975  8387  FFAB  0006                              RBRA _SDBMB_N1, !Z
001976  8389  CFA4  0001                              CMP 1, R9
001977  838B  FFA4  0058                              RBRA _SDBMB_OUT, N               ; cluster = 0: unusable
001978  838D  FFA3  0056                              RBRA _SDBMB_OUT, Z               ; cluster = 1: unusable
001979  838F  0FA0  0009  _SDBMB_N1                   MOVE SDB_B_SHORT, R8
001980  8391  FFB0  0057                              RSUB _SDB_BAIL, 1
001981  8393  CFA8  0FFF                              CMP SDB_EOC_HI, R10              ; end of chain?
001982  8395  FFAB  0006                              RBRA _SDBMB_N2, !Z
001983  8397  C93E  FFF0                              CMP R9, SDB_EOC_LO

001108                    ; ---------- V4/V5: the real code from M2M/rom/sdblock.asm
001109                    ; The map is built once (that is the mount time cost, which cancels out
001110                    ; because run.sh differences a 1 block and a 2 block run) and then every
001111                    ; block is one SDB_VD_RDBLK / SDB_VD_WRBLK plus the copy loop.
001112  80B5  FFB0  005A  _V4                         RSUB _VSETUP, 1
001113  80B7  C308        _V4L                        CMP R3, R2
001114  80B8  FFA3  006B                              RBRA _DONE, Z
001115  80BA  FFB0  0062                              RSUB _VPOS, 1                    ; R10/R11: byte position
001116  80BC  B820                                    XOR R8, R8                       ; virtual drive 0
001117  80BD  0FA4  864C                              MOVE HANDLE_FILE, R9
001118  80BF  0FB0  0200                              MOVE 0x0200, R12
001119  80C1  FFB0  0425                              RSUB SDB_VD_RDBLK, 1
001120  80C3  FFAA  004B                              RBRA _VERR, !C
001121  80C5  B820                                    XOR R8, R8
001122  80C6  FFB0  03B6                              RSUB SDB_SD2VD, 1
001123  80C8  FFB0  0452                              RSUB SDB_VD_RDDONE, 1
001124  80CA  1F8C  0001                              ADD 1, R3
001125  80CC  FFA0  FFE9                              RBRA _V4L, 1
001126                    
001127  80CE  FFB0  0041  _V5                         RSUB _VSETUP, 1
001128  80D0  C308        _V5L                        CMP R3, R2
001129  80D1  FFA3  0052                              RBRA _DONE, Z
001130  80D3  FFB0  0049                              RSUB _VPOS, 1
001131  80D5  B820                                    XOR R8, R8
001132  80D6  0FA4  864C                              MOVE HANDLE_FILE, R9
001133  80D8  0FB0  0200                              MOVE 0x0200, R12
001134  80DA  FFB0  0443                              RSUB SDB_VD_WRBLK, 1
001135  80DC  FFAA  0032                              RBRA _VERR, !C
001136  80DE  1F8C  0001                              ADD 1, R3
001137  80E0  FFA0  FFEE                              RBRA _V5L, 1

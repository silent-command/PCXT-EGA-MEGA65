000577                    ; ****************************************************************************
000578                    ; MiSTer2MEGA65 (M2M) QNICE ROM
000579                    ;
000580                    ; System definition file for registers and MMIO
000581                    ;
000582                    ; done by sy2002 in 2022 and licensed under GPL v3
000583                    ; ****************************************************************************
000584                    
000585                    ; ----------------------------------------------------------------------------
000586                    ; Control and status register
000587                    ; ----------------------------------------------------------------------------
000588                    
000589                    M2M$CSR                     .EQU 0xFFE0
000590                                                ; Bit 0: Reset the MiSTer core
000591                                                ; Bit 1: Pause the MiSTer core
000592                                                ; Bit 2: Show On-Screen-Menu (OSM) as an overlay over core output
000593                                                ; Bit 3: Keyboard connection between M65 keyb. and the core
000594                                                ; Bit 4: Joy. port 1 connection between M65 joy. port and core
000595                                                ; Bit 5: Joy. port 2 connection between M65 joy. port and core
000596                                                ; Bit 6: SD Card: Mode: 0=Auto: SD card automatically switches
000597                                                ; between the internal card (bottom tray) and the external
000598                                                ; card (back slot). The external card has higher precedence.
000599                                                ; Bit 7: SD Card: If Mode=1: 0=force internal / 1=force external
000600                                                ; Bit 8: SD Card: Currently active: 0=internal / 1=external
000601                                                ; Bit 9: SD Card: Internal SD card detected
000602                                                ; Bit 10: SD Card: External SD card detected
000603                                                ; Bit 11: Ascal autoset: If set to 1: M2M$ASCAL_MODE (which is
000604                                                ; controlling QNICE ouput port ascal_mode_o) is automatically
000605                                                ; kept in sync with ascal_mode_i
000606                                                ; Bits 12..15: RESERVED
000607                                                ;
000608                                                ; Bits 8, 9, 10 are read-only
000609                    
000610                    M2M$CSR_RESET               .EQU 0x0001
000611                    M2M$CSR_UN_RESET            .EQU 0xFFFE
000612                    M2M$CSR_PAUSE               .EQU 0x0002
000613                    M2M$CSR_UN_PAUSE            .EQU 0xFFFD
000614                    M2M$CSR_OSM                 .EQU 0x0004
000615                    M2M$CSR_UN_OSM              .EQU 0xFFFB
000616                    M2M$CSR_KBD                 .EQU 0x0008
000617                    M2M$CSR_UN_KBD              .EQU 0xFFF7
000618                    M2M$CSR_JOY1                .EQU 0x0010
000619                    M2M$CSR_UN_JOY1             .EQU 0xFFEF
000620                    M2M$CSR_JOY2                .EQU 0x0020
000621                    M2M$CSR_UN_JOY2             .EQU 0xFFDF
000622                    M2M$CSR_SD_MODE             .EQU 0x0040
000623                    M2M$CSR_UN_SD_MODE          .EQU 0xFFBF
000624                    M2M$CSR_SD_FORCE            .EQU 0x0080
000625                    M2M$CSR_UN_SD_FORCE         .EQU 0xFF7F
000626                    M2M$CSR_SD_ACTIVE           .EQU 0x0100
000627                    M2M$CSR_UN_SD_ACTIVE        .EQU 0xFEFF
000628                    M2M$CSR_SD_DET_INT          .EQU 0x0200
000629                    M2M$CSR_UN_SD_DET_INT       .EQU 0xFDFF
000630                    M2M$CSR_SD_DET_EXT          .EQU 0x0400
000631                    M2M$CSR_UN_SD_DET_EXT       .EQU 0xFBFF
000632                    M2M$CSR_ASCAL_AUTO          .EQU 0x0800
000633                    M2M$CSR_UN_ASCAL_AUTO       .EQU 0xF7FF
000634                    
000635                    M2M$CSR_KBD_JOY             .EQU 0x0038
000636                    M2M$CSR_UN_KBD_JOY          .EQU 0xFFC7
000637                    
000638                    ; ----------------------------------------------------------------------------
000639                    ; VGA and On-Screen-Menu (OSM)
000640                    ; ----------------------------------------------------------------------------
000641                    
000642                    ; All coordinates and sizes in the OSM context are specified in characters
000643                    ; The high-byte of the 16-bit value is always x or dx and the low-byte y or dy
000644                    
000645                    ; When bit 2 of the CSR = 1, then the OSM is shown at the coordinates
000646                    ; and in the size given by these two registers, i.e. these registers are used
000647                    ; by the display hardware
000648                    M2M$OSM_XY                  .EQU 0xFFE1                      ; x|y coordinates
000649                    M2M$OSM_DXDY                .EQU 0xFFE2                      ; dx|dy width and height
000650                    
000651                    ; Screen attributes: Single bits
000652                    M2M$SA_INVERSE              .EQU 0x80
000653                    M2M$SA_DARK                 .EQU 0x40
000654                    M2M$SA_BG_RED               .EQU 0x20
000655                    M2M$SA_BG_GREEN             .EQU 0x10
000656                    M2M$SA_BG_BLUE              .EQU 0x08
000657                    M2M$SA_FG_RED               .EQU 0x04
000658                    M2M$SA_FG_GREEN             .EQU 0x02
000659                    M2M$SA_FG_BLUE              .EQU 0x01
000660                    
000661                    ; Screen attributes: Common bit-combinations
000662                    M2M$SA_COL_STD              .EQU 0x0B                        ; cyan font on blue background
000663                    M2M$SA_COL_STD_INV          .EQU 0x8B                        ; inverse standard
000664                    M2M$SA_COL_TTLE             .EQU 0x0E                        ; Title: Yellow on blue background
000665                    M2M$SA_COL_TTLE_INV         .EQU 0x8E                        ; inverse Title
000666                    M2M$SA_COL_SEL              .EQU 0x0F                        ; selection: white font on blue background
000667                    
000668                    ; Special characters in font Anikki-16x16
000669                    M2M$FC_TL                   .EQU 201                         ; fat top/left corner
000670                    M2M$FC_SH                   .EQU 205                         ; fat straight horizontal
000671                    M2M$FC_TR                   .EQU 187                         ; fat top/right corner
000672                    M2M$FC_SV                   .EQU 186                         ; fat straight vertical
000673                    M2M$FC_BL                   .EQU 200                         ; fat bottom/left corner
000674                    M2M$FC_BR                   .EQU 188                         ; fat bottom/right corner
000675                    M2M$FC_HE_LEFT              .EQU 185                         ; fat straight horiz. line ends: left part
000676                    M2M$FC_HE_RIGHT             .EQU 204                         ; fat straight horiz. line ends: right part
000677                    M2M$NC_SH                   .EQU 196                         ; normal straight horizontal
000678                    M2M$NC_VE_LEFT              .EQU 199                         ; normal vertical line end: left part
000679                    M2M$NC_VE_RIGHT             .EQU 182                         ; normal vertical line end: right part
000680                    M2M$DIR_L                   .EQU 17                          ; left char for displaying a directory
000681                    M2M$DIR_R                   .EQU 16                          ; right char for displaying a directory
000682                    M2M$OPT_SEL_MULTI           .EQU 7                           ; selection char for options menu: multi-sel.
000683                    M2M$OPT_SEL_SINGLE          .EQU 61                          ; ditto for single select
000684                    M2M$LD_PROGRESS             .EQU 254                         ; character used for progress bar
000685                    M2M$LD_SPACE                .EQU 32                          ; space character
000686                    
000687                    ; ----------------------------------------------------------------------------
000688                    ; HDMI: Avalon Scaler (ascal.vhd)
000689                    ; ----------------------------------------------------------------------------
000690                    
000691                    M2M$ASCAL_MODE              .EQU 0xFFE3                      ; ascal mode register
000692                                                ; this reg. is read-only if CSR bit 11 = 1
000693                    
000694                    ; ascal mode: bits 2 downto 0
000695                    M2M$ASCAL_NEAREST           .EQU 0x0000                      ; Nearest neighbor
000696                    M2M$ASCAL_BILINEAR          .EQU 0x0001                      ; Bilinear
000697                    M2M$ASCAL_SBILINEAR         .EQU 0x0002                      ; Sharp Bilinear
000698                    M2M$ASCAL_BICUBIC           .EQU 0x0003                      ; Bicubic
000699                    M2M$ASCAL_POLYPHASE         .EQU 0x0004                      ; Polyphase filter (used for CRT emulation)
000700                    
000701                    ; ascal Polyphase addresses
000702                    M2M$ASCAL_PP_HORIZ          .EQU 0x0000
000703                    M2M$ASCAL_PP_VERT           .EQU 0x0100
000704                    
000705                    ; ascal mode: bits 3 and 4
000706                    M2M$ASCAL_TRIPLEBUF         .EQU 0x0008                      ; Activate triple-buffering
000707                    M2M$ASCAL_RESERVED          .EQU 0x0010                      ; reserved (see ascal.vhd)
000708                    
000709                    ; ----------------------------------------------------------------------------
000710                    ; Special-purpose and general-purpose 16-bit input flags
000711                    ; Read-only; direct pass through from SOC inputs, not buffered in a register.
000712                    ; (Currently reserved and not used, yet)
000713                    ; ----------------------------------------------------------------------------
000714                    
000715                    ; special-purpose register that gets its semantics via the Shell firmware
000716                    M2M$SPECIAL                 .EQU 0xFFE4
000717                    
000718                    ; general-purpose register, can be freely used and is not used by the Shell
000719                    M2M$GENERAL                 .EQU 0xFFE5
000720                    
000721                    ; ----------------------------------------------------------------------------
000722                    ; Keyboard for the framework (independent from the keyboard of the core)
000723                    ; ----------------------------------------------------------------------------
000724                    
000725                    ; Low active realtime snapshot of the currently pressed keys (read-only)
000726                    ; (MMIO "qnice_keys_o" register of m2m_keys.vhd)
000727                    M2M$KEYBOARD                .EQU 0xFFE8
000728                    
000729                    ; Typematic delay (DLY) and typematic repeat (SPD)
000730                    ; DLY: How long needs the key to be pressed, until the typematic repeat starts
000731                    ; SPD: How fast will the pressed key be repeated
000732                    ; IMPORTANT: These values are empiric and relative to QNICE V1.61
000733                    M2M$TYPEMATIC_DLY           .EQU 0x8000                      ; ~0.5sec in QNICE V1.61
000734                    M2M$TYPEMATIC_SPD           .EQU 0x1000                      ; ~12 per sec
000735                    
000736                    ; Definition of the bits in M2M$KEYBOARD
000737                    M2M$KEY_UP                  .EQU 0x0001
000738                    M2M$KEY_DOWN                .EQU 0x0002
000739                    M2M$KEY_LEFT                .EQU 0x0004
000740                    M2M$KEY_RIGHT               .EQU 0x0008
000741                    M2M$KEY_RETURN              .EQU 0x0010
000742                    M2M$KEY_SPACE               .EQU 0x0020
000743                    M2M$KEY_RUNSTOP             .EQU 0x0040
000744                    M2M$KEY_HELP                .EQU 0x0080
000745                    M2M$KEY_F1                  .EQU 0x0100
000746                    M2M$KEY_F3                  .EQU 0x0200
000747                    
000748                    ; ----------------------------------------------------------------------------
000749                    ; 256-bit General purpose control flags
000750                    ; ----------------------------------------------------------------------------
000751                    
000752                    ; 256-bit directly controled by the programmer (not used by the Shell)
000753                    ; Select a window between 0 and 15 in M2M$CFD_ADDR and access the control
000754                    ; flags sliced into 16-bit chunks via M2M$CFD_DATA
000755                    ; exposed by QNICE via control_d_o
000756                    M2M$CFD_ADDR                .EQU 0xFFF0
000757                    M2M$CFD_DATA                .EQU 0xFFF1
000758                    
000759                    ; 256-bit controled by the Shell via the options menu, i.e. the menu that
000760                    ; opens when the core is running and the user presses "Help" on the keyboard:
000761                    ; the bit order is: bit 0 = topmost menu entry, the mapping is 1-to-1 to
000762                    ; OPTM_ITEMS / OPTM_GROUPS in config.vhd
000763                    ; exposed by QNICE via control_m_o; M2M$CFM_ADDR runs from 0 to 15
000764                    M2M$CFM_ADDR                .EQU 0xFFF2
000765                    M2M$CFM_DATA                .EQU 0xFFF3
000766                    
000767                    ; ----------------------------------------------------------------------------
000768                    ; MMIO 4k-segmented access to RAMs, ROMs and similarily behaving devices
000769                    ; ----------------------------------------------------------------------------
000770                    
000771                    M2M$RAMROM_DEV              .EQU 0xFFF4
000772                                                ; Devices 0x0000 .. 0x00FF: RESERVED (see below)
000773                                                ; Devices 0x0100 .. 0xFFFF: Free to be used for any RAM, ROM or device
000774                                                ; that behaves like a RAM or ROM from the
000775                                                ; perspective of QNICE
000776                    
000777                    M2M$VRAM_DATA               .EQU 0x0000                      ; Device for VRAM: Data
000778                    M2M$VRAM_ATTR               .EQU 0x0001                      ; Device for VRAM: Attributes
000779                    M2M$CONFIG                  .EQU 0x0002                      ; Static Shell config data (config.vhd)
000780                    M2M$ASCAL_PPHASE            .EQU 0x0003                      ; ascal.vhd Polyphase filter RAM
000781                    M2M$HYPERRAM                .EQU 0x0004                      ; Device for the built-in 8MB of HyperRAM
000782                    M2M$SDRAM                   .EQU 0x0005                      ; @TODO/RESERVED for future R4 boards
000783                    
000784                    M2M$SYS_INFO                .EQU 0x00FF                      ; Device for System Info
000785                    
000786                    M2M$RAMROM_4KWIN            .EQU 0xFFF5                      ; 4k window selector
000787                    M2M$RAMROM_DATA             .EQU 0x7000                      ; 4k MMIO window to read/write
000788                    
000789                    ; ----------------------------------------------------------------------------
000790                    ; Sysinfo device: Selectors and addresses
000791                    ; ----------------------------------------------------------------------------
000792                    
000793                    ; Selectors (4k windows)
000794                    M2M$SYS_VDRIVES             .EQU 0x0000                      ; vdrives constants (globals.vhd)
000795                    M2M$SYS_VGA                 .EQU 0x0010                      ; gfx adaptor 0: VGA
000796                    M2M$SYS_HDMI                .EQU 0x0011                      ; gfx adaptor 1: HDMI
000797                    M2M$SYS_CRTSANDROMS         .EQU 0x0020                      ; sim. CRTs. & ROMs (globals.vhd)
000798                    M2M$SYS_CORE                .EQU 0x0030                      ; info about the MiSTer core
000799                    
000800                    ; The following read-only registers are meant to be used by the QNICE
000801                    ; firmware. They enable the ability to specify the hardware screen resolution
000802                    ; in characters as well as the start coordinates and size of the main screen.
000803                    ; The position and size of the option menu is deducted.
000804                    M2M$SYS_DXDY                .EQU 0x7000
000805                    M2M$SHELL_M_XY              .EQU 0x7001                      ; main screen: x|y start coordinates
000806                    M2M$SHELL_M_DXDY            .EQU 0x7002                      ; main screen: dx|dy width and height
000807                    
000808                    ; M2M$SYS_CORE registers: measurement from ASCAL
000809                    M2M$SYS_CORE_X              .EQU 0x7000                      ; visible dx measurement from ASCAL
000810                    M2M$SYS_CORE_Y              .EQU 0x7001                      ; visible dy measurement from ASCAL
000811                    
000812                    ; M2M$SYS_CORE registers: measurement from M2M component
000813                    M2M$SYS_CORE_H_PXLS         .EQU 0x7002                      ; visible dx
000814                    M2M$SYS_CORE_V_PXLS         .EQU 0x7003                      ; visible dy
000815                    M2M$SYS_CORE_H_PLSE         .EQU 0x7004                      ; horizontal pulse
000816                    M2M$SYS_CORE_H_BP           .EQU 0x7005                      ; horizontal back porch
000817                    M2M$SYS_CORE_H_FP           .EQU 0x7006                      ; horizontal front porch
000818                    M2M$SYS_CORE_V_PLSE         .EQU 0x7007                      ; vertical pulse
000819                    M2M$SYS_CORE_V_BP           .EQU 0x7008                      ; vertical back porch
000820                    M2M$SYS_CORE_V_FP           .EQU 0x7009                      ; vertical front porch
000821                    M2M$SYS_CORE_H_FREQ         .EQU 0x700A                      ; horizontal frequency in Hz
000822                    
000823                    ; ----------------------------------------------------------------------------
000824                    ; Static Shell configuration data (config.vhd): Selectors and addresses
000825                    ; ----------------------------------------------------------------------------
000826                    
000827                    ; Selectors (4k windows)
000828                    
000829                    M2M$CFG_WHS                 .EQU 0x1000                      ; Welcome & Help screens
000830                    M2M$CFG_DIR_START           .EQU 0x0100                      ; Start folder for file browser
000831                    M2M$CFG_CFG_FILE            .EQU 0x0101                      ; Config file for OSM persistence
000832                    M2M$CFG_GENERAL             .EQU 0x0110                      ; General configuration settings
000833                    M2M$CFG_CORENAME            .EQU 0x0200                      ; String: name and version of core
000834                    
000835                    M2M$CFG_OPTM_ITEMS          .EQU 0x0300 ; "Help" menu / Options menu items
000836                    M2M$CFG_OPTM_GROUPS         .EQU 0x0301                      ; Menu groups
000837                    M2M$CFG_OPTM_STDSEL         .EQU 0x0302                      ; Menu items that are selected by default
000838                    M2M$CFG_OPTM_LINES          .EQU 0x0303                      ; Separator lines
000839                    M2M$CFG_OPTM_START          .EQU 0x0304                      ; Position of very first cursor pos
000840                    M2M$CFG_OPTM_ICOUNT         .EQU 0x0305                      ; Amount of menu items
000841                    M2M$CFG_OPTM_MOUNT          .EQU 0x0306                      ; Menu item = mount a drive
000842                    M2M$CFG_OPTM_SINGLE         .EQU 0x0307                      ; Single-select menu item
000843                    M2M$CFG_OPTM_MSTR           .EQU 0x0308                      ; Mount string to display instead of %s
000844                    M2M$CFG_OPTM_DIM            .EQU 0x0309                      ; DX and DY of Options/Help menu
000845                    M2M$CFG_OPTM_SSTR           .EQU 0x030A                      ; Saving string to display instead of %s
000846                    M2M$CFG_OPTM_HELP           .EQU 0x0310                      ; Menu item = show a help menu
000847                    M2M$CFG_OPTM_CRTROM         .EQU 0x0311                      ; Menu item = manually load CRT/ROM
000848                    M2M$CFG_OPTM_CRSTR          .EQU 0x0312                      ; CRT/ROM load str. to show instead of %s
000849                    
000850                    ; M2M$CFG_WHS
000851                    
000852                    M2M$WHS_PAGES               .EQU 0x7FFF                      ; Amount of pages in current WHS element
000853                    M2M$WHS_WELCOME             .EQU 0x0000                      ; WHS array element: Welcome page
000854                    M2M$WHS_HELP_INDEX          .EQU 0x0001                      ; WHS array: Help pages start with index 1

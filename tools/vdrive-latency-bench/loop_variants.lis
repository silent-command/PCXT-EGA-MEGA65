001139                    ; ---------- V6: the current shell.asm write loop, _HDW_SD_LOOP: one
001140                    ; VD_CAD_WRITE plus one VD_DRV_READ plus one f32_fwrite per byte,
001141                    ; and one f32_fflush (an extra SD block write) per block
001142  80E2  0008        _V6                         MOVE R0, R2
001143  80E3  9FB8  FFFB                              AND 0xFFFB, R14
001144  80E5  6F88  0009                              SHR 9, R2                        ; R2: amount of blocks
001145  80E7  B30C                                    XOR R3, R3
001146  80E8  C308        _V6L                        CMP R3, R2
001147  80E9  FFA3  003A                              RBRA _DONE, Z
001148  80EB  0324                                    MOVE R3, R9                      ; VD_SD_SEEK, sequential case
001149  80EC  BA28                                    XOR R10, R10
001150  80ED  FFB0  0127                              RSUB SDB_BLK2B, 1
001151  80EF  0FA0  864C                              MOVE HANDLE_FILE, R8
001152  80F1  FF90  0054                              ASUB f32_fseek, 1
001153  80F3  B618                                    XOR R6, R6
001154  80F4  0FA0  875F  _V6B                        MOVE SIM_B_ADDR, R8              ; address within drive buffer
001155  80F6  0624                                    MOVE R6, R9
001156  80F7  FFB0  0539                              RSUB CAD_WRITE, 1
001157  80F9  0FA0  8762                              MOVE SIM_B_DIN, R8               ; byte from the drive buffer
001158  80FB  FFB0  0542                              RSUB DRV_READ, 1
001159  80FD  0824                                    MOVE R8, R9
001160  80FE  0FA0  864C                              MOVE HANDLE_FILE, R8
001161  8100  FF90  0066                              ASUB f32_fwrite, 1
001162  8102  1F98  0001                              ADD 1, R6
001163  8104  CF98  0200                              CMP 0x0200, R6
001164  8106  FFAB  FFEC                              RBRA _V6B, !Z
001165  8108  0FA0  864C                              MOVE HANDLE_FILE, R8
001166  810A  FF90  0068                              ASUB f32_fflush, 1
001167  810C  1F8C  0001                              ADD 1, R3
001168  810E  FFA0  FFD8                              RBRA _V6L, 1
001169                    
001170  8110  E000        _VERR                       HALT                             ; the map did not work: the
001171                                                ; measurement would be bogus
001172                    
001173                    ; R2: amount of blocks (NBYTES / 512), R3: block counter
001174  8111  0FA0  864C  _VSETUP                     MOVE HANDLE_FILE, R8
001175  8113  0FA4  868A                              MOVE SDB_VD_MAPS, R9
001176  8115  FFB0  01C0                              RSUB SDB_MAP_BUILD, 1
001177  8117  0008                                    MOVE R0, R2
001178  8118  9FB8  FFFB                              AND 0xFFFB, R14
001179  811A  6F88  0009                              SHR 9, R2
001180  811C  B30C                                    XOR R3, R3
001181  811D  0DBC                                    MOVE @R13++, R15
001182                    
001183                    ; R3: block index -> R10/R11: byte position
001184  811E  0324        _VPOS                       MOVE R3, R9
001185  811F  BA28                                    XOR R10, R10
001186  8120  FFB0  00F4                              RSUB SDB_BLK2B, 1
001187  8122  0A2C                                    MOVE R10, R11
001188  8123  0928                                    MOVE R9, R10
001189  8124  0DBC                                    MOVE @R13++, R15

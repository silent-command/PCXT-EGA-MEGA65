001780  8304  1F88  0000                              ADD FAT32$FDH_DEVICE, R2
001781  8306  0248                                    MOVE @R2, R2                     ; R2: device handle
001782  8307  FFA3  00F2                              RBRA _SDBMB_RET, Z

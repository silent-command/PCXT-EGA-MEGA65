001161                    ; ****************************************************************************
001162                    ; MiSTer2MEGA65 (M2M) QNICE ROM
001163                    ;
001164                    ; sdblock.asm: direct 512-byte block access to files on the SD card
001165                    ;
001166                    ; The FAT32 library of the QNICE Monitor only offers a byte-wise API
001167                    ; (f32_fread / f32_fwrite). Every single byte revalidates the cluster and the
001168                    ; sector of the file handle, which costs about 107 instructions per byte, and
001169                    ; f32_fseek walks the cluster chain from the start of the file, which makes a
001170                    ; random access at the far end of a 42 MB image cost seconds.
001171                    ;
001172                    ; This module resolves the on-disk layout of a file *once* into a compact
001173                    ; extent table and can then map "block N of the file" to an absolute SD card
001174                    ; LBA. A block is then one SD$READ_BLOCK plus a tight copy loop out of the
001175                    ; 512-byte buffer of the SD controller.
001176                    ;
001177                    ; ----------------------------------------------------------------------------
001178                    ; THE TWO RULES
001179                    ; ----------------------------------------------------------------------------
001180                    ;
001181                    ; (1) The FAT32 library must never be able to tell that we were here.
001182                    ;
001183                    ; The 512-byte "sector buffer" of the FAT32 library IS the 512-byte
001184                    ; hardware buffer of the SD controller; the device handle only remembers
001185                    ; *which* file handle filled it (FAT32$DEV_BUFFERED_FDH). Every direct
001186                    ; access destroys the library's buffer while the library still believes
001187                    ; it holds a particular sector.
001188                    ;
001189                    ; Earlier versions of this file solved that by pointing
001190                    ; FAT32$DEV_BUFFERED_FDH at a dummy handle, i.e. by reaching into the
001191                    ; library's bookkeeping. That is not done any more. Instead:
001192                    ;
001193                    ; * SDB_GUARD_IN works out, *before* anything is touched, which sector
001194                    ; the library believes is in the buffer and whether that sector can
001195                    ; be read back. If it cannot, the fast path is refused and nothing
001196                    ; is touched at all.
001197                    ; * a dirty buffer is written back through the library first.
001198                    ; * SDB_GUARD_OUT reads that very sector back, so the buffer holds
001199                    ; exactly what it held before.
001200                    ; * SDB_FREAD_FAST, which moves the file position anyway, restores the
001201                    ; library state the library's own way: with an f32_fseek, which
001202                    ; unconditionally re-reads the sector and re-claims ownership.
001203                    ;
001204                    ; The one remaining poke, SDB_ORPHAN, exists only for the case where the
001205                    ; restoring read itself fails, i.e. where the card is already broken. It
001206                    ; is strictly better than leaving the library with a buffer that holds
001207                    ; something else than it thinks.
001208                    ;
001209                    ; (2) Any error anywhere leaves the caller with "nothing happened".
001210                    ;
001211                    ; Every entry point returns Carry=0 on any problem, and the byte-wise
001212                    ; FAT32 path then does all of the work exactly as it did before this
001213                    ; file existed. In particular:
001214                    ;
001215                    ; * an SD card error latches the controller into its error state (see
001216                    ; the IO$SD_CSR description in sysdef.asm: "you need to reset the
001217                    ; controller to go on"), which would make every *subsequent* library
001218                    ; access fail too. SDB_SDERR therefore issues SD$RESET after any
001219                    ; failed SD operation before we hand back control.
001220                    ; * SDB_FREAD_FAST never seeks to the end of the file. It always leaves
001221                    ; at least one whole block to the byte loop, so the file position it
001222                    ; hands over is strictly inside the file and the caller reaches EOF
001223                    ; through the library, the way it always did.
001224                    ; * every seek is verified against FAT32$FDH_ACCESS afterwards.
001225                    ;
001226                    ; ----------------------------------------------------------------------------
001227                    ; Serial logging
001228                    ; ----------------------------------------------------------------------------
001229                    ; To log what the fast path does to the serial console at boot (no keyboard
001230                    ; needed), remove the ";" in front of the #define below and rebuild the ROM
001231                    ; with CORE/m2m-rom/make_rom.sh. Put the ";" back to switch it off again.
001232                    ;
001233                    ;#define SDB_DEBUG
001234                    ;
001235                    ; This file needs the environment of shell.asm.
001236                    ;
001237                    ; done for the PCXT-EGA-MEGA65 port and licensed under GPL v3
001238                    ; ****************************************************************************
001239                    
001240                    ; ----------------------------------------------------------------------------
001241                    ; Layout of a block map (see SDB_VD_MAPS / SDB_RM_MAP in shell_vars.asm)
001242                    ; ----------------------------------------------------------------------------
001243                    
001244                    ; Maximum amount of extents (runs of physically consecutive clusters) that we
001245                    ; are willing to remember for one file. A freshly copied image file normally
001246                    ; is one single extent. Files that would need more extents than this fall
001247                    ; back to the FAT32 library path.
001248                    SDB_MAX_EXT                 .EQU 8
001249                    
001250                    SDB_M_NEXT                  .EQU 0                           ; amount of valid extents; 0 = no map
001251                    SDB_M_FDH                   .EQU 1                           ; FDH this map was built for
001252                    SDB_M_TBLK_LO               .EQU 2                           ; amount of *whole* 512-byte blocks..
001253                    SDB_M_TBLK_HI               .EQU 3                           ; ..in the file (filesize / 512)
001254                    SDB_M_BAIL                  .EQU 4                           ; why there is no map (SDB_B_*)
001255                    SDB_M_EXT                   .EQU 5                           ; start of the extent array
001256                    
001257                    ; one extent: amount of blocks (lo/hi) and the absolute SD card LBA (lo/hi)
001258                    ; of the first of them
001259                    SDB_E_NBLK_LO               .EQU 0
001260                    SDB_E_NBLK_HI               .EQU 1
001261                    SDB_E_LBA_LO                .EQU 2
001262                    SDB_E_LBA_HI                .EQU 3
001263                    SDB_E_SIZE                  .EQU 4
001264                    
001265                    ; size of one map in words: SDB_M_EXT + SDB_E_SIZE * SDB_MAX_EXT = 5 + 4*8
001266                    ; = 37, rounded up to 40 to leave room
001267                    SDB_M_SIZE                  .EQU 40
001268                    
001269                    ; Amount of virtual drives that SDB_VD_MAPS in shell_vars.asm has room for.
001270                    ; The QNICE assembler cannot evaluate expressions in .BLOCK, so the size of
001271                    ; SDB_VD_MAPS is the literal SDB_M_SIZE * SDB_VD_MAX_N and both have to be
001272                    ; kept in sync by hand. Virtual drives beyond SDB_VD_MAX_N are not broken,
001273                    ; they just always use the (slow) FAT32 library path.
001274                    SDB_VD_MAX_N                .EQU 3
001275                    
001276                    ; Why a map could not be built. Logged, and also readable from SDB_M_BAIL.
001277                    SDB_B_OK                    .EQU 0
001278                    SDB_B_NOMAP                 .EQU 1                           ; no map slot for this drive
001279                    SDB_B_NODEV                 .EQU 2                           ; file handle has no device handle
001280                    SDB_B_NOSPC                 .EQU 3                           ; sectors per cluster is zero
001281                    SDB_B_EMPTY                 .EQU 4                           ; file is shorter than one block
001282                    SDB_B_BADSTART              .EQU 5                           ; start cluster < 2
001283                    SDB_B_FRAG                  .EQU 6                           ; more extents than SDB_MAX_EXT
001284                    SDB_B_FATERR                .EQU 7                           ; could not read a FAT sector
001285                    SDB_B_BADCLUS               .EQU 8                           ; illegal cluster in the chain
001286                    SDB_B_SHORT                 .EQU 9                           ; chain ends before the file does
001287                    SDB_B_LBA                   .EQU 10                          ; LBA arithmetic out of range
001288                    SDB_B_GUARD                 .EQU 11                          ; buffer could not be made restorable
001289                    SDB_B_SEEK                  .EQU 12                          ; restoring seek failed
001290                    
001291                    ; end-of-chain marker: everything >= 0x0FFFFFF8 terminates a FAT32 chain,
001292                    ; and everything >= 0x0FFFFFF0 is reserved, so refuse all of it
001293                    SDB_EOC_HI                  .EQU 0x0FFF
001294                    SDB_EOC_LO                  .EQU 0xFFF0
001295                    
001296                    ; ----------------------------------------------------------------------------
001297                    ; Housekeeping
001298                    ; ----------------------------------------------------------------------------
001299                    
001300                    ; SDB_INVAL_ALL
001301                    ; Invalidates all block maps, i.e. everything falls back to the FAT32 library
001302                    ; until the maps are rebuilt. Called from VD_INIT and whenever the SD card
001303                    ; changes. Also clears the two zero-filled helper structures, because the
001304                    ; variables live in uninitialized RAM.
001305                    ;
001306                    ; Input: none
001307                    ; Output: none, all registers unchanged
001308  8126  E0C0        SDB_INVAL_ALL               INCRB
001309  8127  0F80  8670                              MOVE SDB_VD_MAPS, R0
001310  8129  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001311  812B  0F81  0000  _SDBIA_L                    MOVE 0, @R0
001312  812D  1F80  0028                              ADD SDB_M_SIZE, R0
001313  812F  3F84  0001                              SUB 1, R1
001314  8131  FFAB  FFF8                              RBRA _SDBIA_L, !Z
001315  8133  0F80  86E8                              MOVE SDB_RM_MAP, R0
001316  8135  0F81  0000                              MOVE 0, @R0
001317  8137  0F80  8710                              MOVE SDB_NULL_MAP, R0
001318  8139  0F81  0000                              MOVE 0, @R0
001319  813B  0F80  871F                              MOVE SDB_G_VAL, R0
001320  813D  0F81  0000                              MOVE 0, @R0
001321                    
001322                                                ; SDB_DUMMY_FDH must read as an all-zero, and therefore never
001323                                                ; dirty, file handle: SDB_ORPHAN hands it to FAT32$FLUSH
001324  813F  0F80  8711                              MOVE SDB_DUMMY_FDH, R0
001325  8141  0F84  000C                              MOVE FAT32$FDH_STRUCT_SIZE, R1
001326  8143  0F82  0000  _SDBIA_L2                   MOVE 0, @R0++
001327  8145  3F84  0001                              SUB 1, R1
001328  8147  FFAB  FFFA                              RBRA _SDBIA_L2, !Z
001329  8149  E100                                    DECRB
001330  814A  0DBC                                    MOVE @R13++, R15
001331                    
001332                    ; SDB_VDMAP
001333                    ; Returns the block map that belongs to a virtual drive. Drives that have no
001334                    ; map (see SDB_VD_MAX_N) get the permanently empty SDB_NULL_MAP, which makes
001335                    ; SDB_CHECK fail and therefore forces the FAT32 library path.
001336                    ;
001337                    ; Input: R8: virtual drive number
001338                    ; Output: R8: pointer to the block map
001339  814B  E0C0        SDB_VDMAP                   INCRB
001340  814C  0800                                    MOVE R8, R0
001341  814D  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001342  814F  C100                                    CMP R1, R0                       ; drive number < maximum?
001343  8150  FFA4  0004                              RBRA _SDBVM_OK, N                ; yes
001344  8152  0FA0  8710                              MOVE SDB_NULL_MAP, R8            ; no: never mapped
001345  8154  FFA0  000C                              RBRA _SDBVM_D, 1
001346  8156  0FA0  8670  _SDBVM_OK                   MOVE SDB_VD_MAPS, R8
001347  8158  CF80  0000  _SDBVM_L                    CMP 0, R0
001348  815A  FFA3  0006                              RBRA _SDBVM_D, Z
001349  815C  1FA0  0028                              ADD SDB_M_SIZE, R8
001350  815E  3F80  0001                              SUB 1, R0
001351  8160  FFA0  FFF6                              RBRA _SDBVM_L, 1
001352  8162  E100        _SDBVM_D                    DECRB
001353  8163  0DBC                                    MOVE @R13++, R15
001354                    
001355                    ; SDB_CHECK
001356                    ; Is the given map valid and does it belong to the given file handle?
001357                    ;
001358                    ; Input: R8: pointer to the block map
001359                    ; R9: file handle (FDH)
001360                    ; Output: Carry=1 if the map can be used, all registers unchanged
001361  8164  E0C0        SDB_CHECK                   INCRB
001362  8165  CFA1  0000                              CMP 0, @R8                       ; any extents?
001363  8167  FFA3  000A                              RBRA _SDBC_NO, Z                 ; no: unusable
001364  8169  0800                                    MOVE R8, R0
001365  816A  1F80  0001                              ADD SDB_M_FDH, R0
001366  816C  C064                                    CMP @R0, R9                      ; built for this file handle?
001367  816D  FFAB  0004                              RBRA _SDBC_NO, !Z                ; no: unusable
001368  816F  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001369  8171  FFA0  0002                              RBRA _SDBC_R, 1
001370  8173  9FB8  FFFB  _SDBC_NO                    AND 0xFFFB, R14                  ; clear Carry
001371  8175  E100        _SDBC_R                     DECRB
001372  8176  0DBC                                    MOVE @R13++, R15
001373                    
001374                    ; SDB_SDERR
001375                    ; Called after a failed SD card operation. The controller latches its error
001376                    ; state and refuses everything until it is reset, which would turn our
001377                    ; problem into a fatal error in the *next* FAT32 library call. Reset it, so
001378                    ; that the fallback path starts from a clean controller.
001379                    ;
001380                    ; Input: R8: the error code (only used for logging)
001381                    ; Output: none, R8 unchanged
001382  8177  E0C0        SDB_SDERR                   INCRB
001383  8178  0800                                    MOVE R8, R0
001384                    
001385                    
001386                    
001387                    
001388                    
001389                    
001390                    
001391  8179  FF90  003A                              ASUB sd_reset, 1
001392  817B  0020                                    MOVE R0, R8
001393  817C  E100                                    DECRB
001394  817D  0DBC                                    MOVE @R13++, R15
001395                    
001396                    ; ----------------------------------------------------------------------------
001397                    ; Guarding the FAT32 library's sector buffer
001398                    ; ----------------------------------------------------------------------------
001399                    
001400                    ; SDB_GUARD_IN
001401                    ; Prepares for direct SD card access. Works out which sector the FAT32
001402                    ; library believes the hardware buffer holds and remembers its LBA so that
001403                    ; SDB_GUARD_OUT can put it back, and writes the buffer back first if it is
001404                    ; dirty. Refuses (Carry=0) without touching anything if the sector cannot be
001405                    ; identified or the write-back fails.
001406                    ;
001407                    ; Input: none
001408                    ; Output: Carry=1: direct access is allowed
001409                    ; Carry=0: do not touch the SD card, nothing has been touched
001410                    ; all registers unchanged
001411  817E  FF90  005E  SDB_GUARD_IN                ASUB enter, 1
001412                    
001413  8180  0FA0  871F                              MOVE SDB_G_VAL, R8               ; nothing to restore yet
001414  8182  0FA1  0000                              MOVE 0, @R8
001415                    
001416  8184  0FA0  864B                              MOVE HANDLE_DEV, R8              ; who claims the buffer?
001417  8186  FFB0  003D                              RSUB _SDB_OWNER, 1
001418  8188  FFA2  0008                              RBRA _SDBGI_HAVE, C
001419  818A  0FA0  865D                              MOVE CONFIG_DEVH, R8
001420  818C  FFB0  0037                              RSUB _SDB_OWNER, 1
001421  818E  FFA2  0002                              RBRA _SDBGI_HAVE, C
001422  8190  FFA0  002A                              RBRA _SDBGI_OK, 1                ; nobody: nothing to restore
001423                    
001424                                                ; R8: device handle, R9: owning FDH
001425  8192  0800        _SDBGI_HAVE                 MOVE R8, R0
001426  8193  0904                                    MOVE R9, R1
001427                    
001428  8194  0120                                    MOVE R1, R8                      ; dirty? then write it back
001429  8195  1FA0  000B                              ADD FAT32$FDH_FLAGS, R8
001430  8197  0860                                    MOVE @R8, R8
001431  8198  9FA0  0001                              AND FAT32$FDHF_DIRTY, R8
001432  819A  FFA3  0007                              RBRA _SDBGI_CLEAN, Z
001433  819C  0120                                    MOVE R1, R8
001434  819D  FF90  0068                              ASUB f32_fflush, 1
001435  819F  CFA4  0000                              CMP 0, R9
001436  81A1  FFAB  001D                              RBRA _SDBGI_NO, !Z               ; cannot write back: refuse
001437                    
001438                                                ; which sector does the library think it is holding?
001439  81A3  0120        _SDBGI_CLEAN                MOVE R1, R8
001440  81A4  1FA0  0001                              ADD FAT32$FDH_CLUSTER_LO, R8
001441  81A6  0864                                    MOVE @R8, R9
001442  81A7  0120                                    MOVE R1, R8
001443  81A8  1FA0  0002                              ADD FAT32$FDH_CLUSTER_HI, R8
001444  81AA  0868                                    MOVE @R8, R10
001445  81AB  0120                                    MOVE R1, R8
001446  81AC  1FA0  0003                              ADD FAT32$FDH_SECTOR, R8
001447  81AE  086C                                    MOVE @R8, R11
001448  81AF  0020                                    MOVE R0, R8
001449  81B0  FFB0  0089                              RSUB SDB_CLULBA, 1
001450  81B2  FFAA  000C                              RBRA _SDBGI_NO, !C               ; cannot be restored: refuse
001451                    
001452  81B4  0FA0  871D                              MOVE SDB_G_LBA, R8
001453  81B6  0922                                    MOVE R9, @R8++
001454  81B7  0A21                                    MOVE R10, @R8
001455  81B8  0FA0  871F                              MOVE SDB_G_VAL, R8
001456  81BA  0FA1  0001                              MOVE 1, @R8
001457                    
001458  81BC  AFB8  0004  _SDBGI_OK                   OR 0x0004, R14                   ; set Carry
001459  81BE  FFA0  0002                              RBRA _SDBGI_RET, 1
001460  81C0  9FB8  FFFB  _SDBGI_NO                   AND 0xFFFB, R14                  ; clear Carry
001461  81C2  FF90  0060  _SDBGI_RET                  ASUB leave, 1
001462  81C4  0DBC                                    MOVE @R13++, R15
001463                    
001464                    ; Input: R8: device handle
001465                    ; Output: Carry=1 and R9 = the FDH that claims the buffer, R8 unchanged
001466  81C5  E0C0        _SDB_OWNER                  INCRB
001467  81C6  CFA1  0000                              CMP 0, @R8                       ; device handle initialized?
001468  81C8  FFA3  000A                              RBRA _SDB_OWN_NO, Z
001469  81CA  0800                                    MOVE R8, R0
001470  81CB  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001471  81CD  0064                                    MOVE @R0, R9
001472  81CE  FFA3  0004                              RBRA _SDB_OWN_NO, Z              ; nobody claims it
001473  81D0  AFB8  0004                              OR 0x0004, R14
001474  81D2  FFA0  0002                              RBRA _SDB_OWN_R, 1
001475  81D4  9FB8  FFFB  _SDB_OWN_NO                 AND 0xFFFB, R14
001476  81D6  E100        _SDB_OWN_R                  DECRB
001477  81D7  0DBC                                    MOVE @R13++, R15
001478                    
001479                    ; SDB_GUARD_OUT
001480                    ; Puts the hardware buffer back to the sector SDB_GUARD_IN identified, so
001481                    ; that the FAT32 library finds exactly what it left behind.
001482                    ;
001483                    ; Input: none
001484                    ; Output: none, all registers unchanged
001485  81D8  FF90  005E  SDB_GUARD_OUT               ASUB enter, 1
001486  81DA  0FA0  871F                              MOVE SDB_G_VAL, R8
001487  81DC  CFA1  0000                              CMP 0, @R8
001488  81DE  FFA3  0018                              RBRA _SDBGO_RET, Z               ; nothing to restore
001489                    
001490  81E0  0FA0  871D                              MOVE SDB_G_LBA, R8
001491  81E2  08A8                                    MOVE @R8++, R10
001492  81E3  086C                                    MOVE @R8, R11
001493  81E4  0A20                                    MOVE R10, R8
001494  81E5  0B24                                    MOVE R11, R9
001495  81E6  FF90  003C                              ASUB sd_r_block, 1
001496  81E8  CFA0  0000                              CMP 0, R8
001497  81EA  FFA3  000C                              RBRA _SDBGO_RET, Z               ; restored
001498                    
001499                                                ; the restoring read failed, so the card is already broken.
001500                                                ; Reset the controller, try once more, and if that fails too
001501                                                ; make sure the library re-reads instead of trusting a buffer
001502                                                ; that now holds something else than it believes.
001503  81EC  FFB0  FF89                              RSUB SDB_SDERR, 1
001504  81EE  0A20                                    MOVE R10, R8
001505  81EF  0B24                                    MOVE R11, R9
001506  81F0  FF90  003C                              ASUB sd_r_block, 1
001507  81F2  CFA0  0000                              CMP 0, R8
001508  81F4  FFA3  0002                              RBRA _SDBGO_RET, Z
001509  81F6  FFB0  0003                              RSUB SDB_ORPHAN, 1
001510  81F8  FF90  0060  _SDBGO_RET                  ASUB leave, 1
001511  81FA  0DBC                                    MOVE @R13++, R15
001512                    
001513                    ; SDB_ORPHAN
001514                    ; Last resort, only used when the hardware buffer could not be restored: tell
001515                    ; both device handles that the buffer contents are unknown, so that the
001516                    ; library re-reads rather than serving something stale.
001517                    ;
001518                    ; "Unknown" is expressed by handing the buffer to SDB_DUMMY_FDH, an all-zero
001519                    ; and therefore never dirty file handle, and not by the obvious 0: FAT32$FLUSH
001520                    ; returns immediately when called with R8 = 0 and then leaves R9 - its error
001521                    ; code - untouched, and FAT32$FILE_SEEK checks that stale R9 right after
001522                    ; calling it, so a seek would silently do nothing.
001523                    ;
001524                    ; Input: none
001525                    ; Output: none, all registers unchanged
001526  81FB  FF90  005E  SDB_ORPHAN                  ASUB enter, 1
001527                    
001528                    
001529                    
001530                    
001531                    
001532  81FD  0FA0  864B                              MOVE HANDLE_DEV, R8
001533  81FF  FFB0  0007                              RSUB _SDB_ORPH1, 1
001534  8201  0FA0  865D                              MOVE CONFIG_DEVH, R8
001535  8203  FFB0  0003                              RSUB _SDB_ORPH1, 1
001536  8205  FF90  0060                              ASUB leave, 1
001537  8207  0DBC                                    MOVE @R13++, R15
001538                    
001539  8208  E0C0        _SDB_ORPH1                  INCRB
001540  8209  0804                                    MOVE R8, R1
001541  820A  CFA1  0000                              CMP 0, @R8
001542  820C  FFA3  0006                              RBRA _SDB_ORPH_R, Z
001543  820E  0800                                    MOVE R8, R0
001544  820F  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
001545  8211  0F88  8711                              MOVE SDB_DUMMY_FDH, R2
001546  8213  0201                                    MOVE R2, @R0
001547  8214  0120        _SDB_ORPH_R                 MOVE R1, R8
001548  8215  E100                                    DECRB
001549  8216  0DBC                                    MOVE @R13++, R15
001550                    
001551                    ; ----------------------------------------------------------------------------
001552                    ; 32-bit helpers
001553                    ; ----------------------------------------------------------------------------
001554                    
001555                    ; SDB_B2BLK
001556                    ; Converts a byte position into a 512-byte block index (unsigned 32 bit).
001557                    ;
001558                    ; Input: R9/R10: byte position lo/hi
001559                    ; Output: R9/R10: block index lo/hi
001560  8217  E0C0        SDB_B2BLK                   INCRB
001561  8218  0A00                                    MOVE R10, R0
001562  8219  9F80  01FF                              AND 0x01FF, R0                   ; bits that move down into..
001563  821B  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the low word; clear X so..
001564  821D  5F80  0007                              SHL 7, R0                        ; ..SHL shifts in zeros
001565  821F  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001566  8221  6FA4  0009                              SHR 9, R9
001567  8223  1024                                    ADD R0, R9
001568  8224  9FB8  FFFB                              AND 0xFFFB, R14
001569  8226  6FA8  0009                              SHR 9, R10
001570  8228  E100                                    DECRB
001571  8229  0DBC                                    MOVE @R13++, R15
001572                    
001573                    ; SDB_BLK2B
001574                    ; Converts a 512-byte block index into a byte position (unsigned 32 bit).
001575                    ;
001576                    ; Input: R9/R10: block index lo/hi
001577                    ; Output: R9/R10: byte position lo/hi
001578  822A  E0C0        SDB_BLK2B                   INCRB
001579  822B  0900                                    MOVE R9, R0
001580  822C  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
001581  822E  6F80  0007                              SHR 7, R0                        ; bits that move up into..
001582  8230  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the high word; clear X
001583  8232  5FA8  0009                              SHL 9, R10
001584  8234  1028                                    ADD R0, R10
001585  8235  9FB8  FFFD                              AND 0xFFFD, R14
001586  8237  5FA4  0009                              SHL 9, R9
001587  8239  E100                                    DECRB
001588  823A  0DBC                                    MOVE @R13++, R15
001589                    
001590                    ; SDB_CLULBA
001591                    ; The absolute SD card LBA of one sector within one cluster, i.e. exactly
001592                    ; what FAT32$RW_SIC computes, with every range check spelled out.
001593                    ;
001594                    ; Input: R8: device handle
001595                    ; R9/R10: cluster lo/hi
001596                    ; R11: sector within the cluster
001597                    ; Output: Carry=1: R9/R10 = LBA lo/hi
001598                    ; Carry=0: the cluster or the sector is out of range
001599                    ; R8, R11 unchanged
001600  823B  E0C0        SDB_CLULBA                  INCRB
001601  823C  0800                                    MOVE R8, R0                      ; R0: device handle
001602  823D  0B04                                    MOVE R11, R1                     ; R1: sector
001603                    
001604  823E  CFA8  0000                              CMP 0, R10                       ; cluster >= 2?
001605  8240  FFAB  0006                              RBRA _SDBCL_C1, !Z
001606  8242  CFA4  0001                              CMP 1, R9
001607  8244  FFA4  0044                              RBRA _SDBCL_NO, N                ; cluster = 0
001608  8246  FFA3  0042                              RBRA _SDBCL_NO, Z                ; cluster = 1
001609  8248  CFA8  0FFF  _SDBCL_C1                   CMP SDB_EOC_HI, R10              ; cluster < 0x0FFFFFF0?
001610  824A  FFAB  0006                              RBRA _SDBCL_C2, !Z
001611  824C  C93E  FFF0                              CMP R9, SDB_EOC_LO
001612  824E  FFA4  003A                              RBRA _SDBCL_NO, N
001613  8250  FFA3  0038                              RBRA _SDBCL_NO, Z
001614  8252  CA3E  0FFF  _SDBCL_C2                   CMP R10, 0x0FFF                  ; and inside 28 bits at all?
001615  8254  FFA4  0034                              RBRA _SDBCL_NO, N
001616                    
001617  8256  0008                                    MOVE R0, R2                      ; R2: sectors per cluster
001618  8257  1F88  000C                              ADD FAT32$DEV_SECT_PER_CLUS, R2
001619  8259  0248                                    MOVE @R2, R2
001620  825A  FFA3  002E                              RBRA _SDBCL_NO, Z
001621  825C  020C                                    MOVE R2, R3
001622  825D  3F8C  0001                              SUB 1, R3
001623  825F  C10C                                    CMP R1, R3                       ; sector inside the cluster?
001624  8260  FFA4  0028                              RBRA _SDBCL_NO, N
001625                    
001626  8262  0920                                    MOVE R9, R8                      ; (cluster - 2) * spc
001627  8263  0A24                                    MOVE R10, R9
001628  8264  3FA0  0002                              SUB 2, R8
001629  8266  4FA4  0000                              SUBC 0, R9
001630  8268  0228                                    MOVE R2, R10
001631  8269  BB2C                                    XOR R11, R11
001632  826A  FF90  0032                              ASUB mulu32, 1                   ; R11|R10|R9|R8 = 64 bit

001680  8228  0800                                    MOVE R8, R0                      ; R0: device handle
001681  8229  0B04                                    MOVE R11, R1                     ; R1: sector
001682                    
001683  822A  CFA8  0000                              CMP 0, R10                       ; cluster >= 2?
001684  822C  FFAB  0006                              RBRA _SDBCL_C1, !Z
001685  822E  CFA4  0001                              CMP 1, R9
001686  8230  FFA4  0044                              RBRA _SDBCL_NO, N                ; cluster = 0
001687  8232  FFA3  0042                              RBRA _SDBCL_NO, Z                ; cluster = 1
001688  8234  CFA8  0FFF  _SDBCL_C1                   CMP SDB_EOC_HI, R10              ; cluster < 0x0FFFFFF0?
001689  8236  FFAB  0006                              RBRA _SDBCL_C2, !Z
001690  8238  C93E  FFF0                              CMP R9, SDB_EOC_LO
001691  823A  FFA4  003A                              RBRA _SDBCL_NO, N
001692  823C  FFA3  0038                              RBRA _SDBCL_NO, Z
001693  823E  CA3E  0FFF  _SDBCL_C2                   CMP R10, 0x0FFF                  ; and inside 28 bits at all?
001694  8240  FFA4  0034                              RBRA _SDBCL_NO, N
001695                    
001696  8242  0008                                    MOVE R0, R2                      ; R2: sectors per cluster
001697  8243  1F88  000C                              ADD FAT32$DEV_SECT_PER_CLUS, R2
001698  8245  0248                                    MOVE @R2, R2
001699  8246  FFA3  002E                              RBRA _SDBCL_NO, Z
001700  8248  020C                                    MOVE R2, R3
001701  8249  3F8C  0001                              SUB 1, R3
001702  824B  C10C                                    CMP R1, R3                       ; sector inside the cluster?
001703  824C  FFA4  0028                              RBRA _SDBCL_NO, N
001704                    
001705  824E  0920                                    MOVE R9, R8                      ; (cluster - 2) * spc
001706  824F  0A24                                    MOVE R10, R9
001707  8250  3FA0  0002                              SUB 2, R8
001708  8252  4FA4  0000                              SUBC 0, R9
001709  8254  0228                                    MOVE R2, R10
001710  8255  BB2C                                    XOR R11, R11

001992  8410  0621                                    MOVE R6, @R8
001993  8411  0520                                    MOVE R5, R8
001994  8412  1FA0  0001                              ADD SDB_E_NBLK_HI, R8
001995  8414  0721                                    MOVE R7, @R8
001996  8415  0520                                    MOVE R5, R8
001997  8416  1FA0  0002                              ADD SDB_E_LBA_LO, R8
001998  8418  0922                                    MOVE R9, @R8++
001999  8419  0A21                                    MOVE R10, @R8
002000  841A  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002001  841C  0DBC        _SDB_EMIT_R                 MOVE @R13++, R15
002002                    
002003                    ; SDB_FAT_NEXT
002004                    ; Reads the FAT32 chain successor of a cluster. Uses a one entry cache for
002005                    ; the FAT sector, so a run of consecutive clusters costs one SD card block
002006                    ; read per 128 clusters. Expects SDB_GUARD_IN to have been called.
002007                    ;
002008                    ; Input: R8: device handle
002009                    ; R9/R10: cluster lo/hi
002010                    ; Output: Carry=1: R9/R10 = successor cluster lo/hi (28 bit)
002011                    ; Carry=0: the FAT sector could not be read
002012                    ; R8 unchanged
002013  841D  E0C0        SDB_FAT_NEXT                INCRB
002014  841E  0800                                    MOVE R8, R0                      ; R0: device handle
002015  841F  0904                                    MOVE R9, R1                      ; R1: byte offset in sector
002016  8420  9F84  007F                              AND 0x007F, R1                   ; 128 FAT entries per sector
002017  8422  9FB8  FFFD                              AND 0xFFFD, R14                  ; clear X
002018  8424  5F84  0002                              SHL 2, R1                        ; 4 bytes per entry
002019                    
002020                                                ; FAT sector number = cluster / 128
002021  8426  0A08                                    MOVE R10, R2
002022  8427  9F88  007F                              AND 0x007F, R2
002023  8429  9FB8  FFFD                              AND 0xFFFD, R14
002024  842B  5F88  0009                              SHL 9, R2
002025  842D  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C
002026  842F  6FA4  0007                              SHR 7, R9
002027  8431  1224                                    ADD R2, R9
002028  8432  9FB8  FFFB                              AND 0xFFFB, R14
002029  8434  6FA8  0007                              SHR 7, R10
002030                    
002031  8436  0008                                    MOVE R0, R2                      ; plus the FAT start LBA
002032  8437  1F88  0008                              ADD FAT32$DEV_FAT_LO, R2
002033  8439  028C                                    MOVE @R2++, R3
002034  843A  0248                                    MOVE @R2, R2
002035  843B  1324                                    ADD R3, R9
002036  843C  2228                                    ADDC R2, R10
002037  843D  FFA2  004E                              RBRA _SDB_FN_ERR, C              ; 32-bit overflow
002038                    
002039                                                ; is this sector already in the hardware buffer?
002040  843F  0F88  872E                              MOVE SDB_S_FCVAL, R2
002041  8441  CF89  0000                              CMP 0, @R2
002042  8443  FFA3  000A                              RBRA _SDB_FN_RD, Z
002043  8445  0F88  872C                              MOVE SDB_S_FCLBA, R2
002044  8447  C264                                    CMP @R2, R9
002045  8448  FFAB  0005                              RBRA _SDB_FN_RD, !Z
002046  844A  1F88  0001                              ADD 1, R2
002047  844C  C268                                    CMP @R2, R10
002048  844D  FFA3  0016                              RBRA _SDB_FN_BUF, Z
002049                    
002050  844F  0F88  872E  _SDB_FN_RD                  MOVE SDB_S_FCVAL, R2             ; cache is stale in any case
002051  8451  0F89  0000                              MOVE 0, @R2
002052  8453  0908                                    MOVE R9, R2                      ; R2/R3: remember the LBA
002053  8454  0A0C                                    MOVE R10, R3
002054  8455  0220                                    MOVE R2, R8
002055  8456  0324                                    MOVE R3, R9
002056  8457  FF90  003C                              ASUB sd_r_block, 1
002057  8459  CFA0  0000                              CMP 0, R8
002058  845B  FFAB  002E                              RBRA _SDB_FN_SDE, !Z
002059  845D  0FA0  872C                              MOVE SDB_S_FCLBA, R8
002060  845F  0222                                    MOVE R2, @R8++
002061  8460  0321                                    MOVE R3, @R8
002062  8461  0FA0  872E                              MOVE SDB_S_FCVAL, R8
002063  8463  0FA1  0001                              MOVE 1, @R8
002064                    
002065                                                ; read the 32-bit little-endian FAT entry. Keep one
002066                                                ; instruction between writing IO$SD_DATA_POS and reading
002067                                                ; IO$SD_DATA, exactly like SD$READ_BYTE does: the buffer is a
002068                                                ; block RAM whose output is registered (see byte_bram.vhd).
002069  8465  0F88  FF22  _SDB_FN_BUF                 MOVE IO$SD_DATA_POS, R2
002070  8467  0F8C  FF23                              MOVE IO$SD_DATA, R3
002071  8469  0110                                    MOVE R1, R4                      ; R4: walking byte offset
002072  846A  0409                                    MOVE R4, @R2
002073  846B  1F90  0001                              ADD 1, R4                        ; spacing, and the next offset
002074  846D  0364                                    MOVE @R3, R9                     ; byte 0
002075  846E  0409                                    MOVE R4, @R2
002076  846F  1F90  0001                              ADD 1, R4
002077  8471  0354                                    MOVE @R3, R5                     ; byte 1
002078  8472  9FB8  FFFD                              AND 0xFFFD, R14
002079  8474  5F94  0008                              SHL 8, R5
002080  8476  1524                                    ADD R5, R9
002081  8477  0409                                    MOVE R4, @R2
002082  8478  1F90  0001                              ADD 1, R4
002083  847A  0368                                    MOVE @R3, R10                    ; byte 2
002084  847B  0409                                    MOVE R4, @R2
002085  847C  1F90  0001                              ADD 1, R4
002086  847E  0354                                    MOVE @R3, R5                     ; byte 3
002087  847F  9FB8  FFFD                              AND 0xFFFD, R14
002088  8481  5F94  0008                              SHL 8, R5
002089  8483  1528                                    ADD R5, R10
002090  8484  9FA8  0FFF                              AND 0x0FFF, R10                  ; FAT32 entries are 28 bit
002091  8486  0020                                    MOVE R0, R8
002092  8487  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002093  8489  FFA0  0005                              RBRA _SDB_FN_RET, 1
002094                    
002095  848B  FFB0  FCEA  _SDB_FN_SDE                 RSUB SDB_SDERR, 1
002096  848D  0020        _SDB_FN_ERR                 MOVE R0, R8
002097  848E  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002098  8490  E100        _SDB_FN_RET                 DECRB
002099  8491  0DBC                                    MOVE @R13++, R15
002100                    
002101                    ; ----------------------------------------------------------------------------
002102                    ; Block transfers
002103                    ; ----------------------------------------------------------------------------
002104                    
002105                    ; SDB_SD2VD
002106                    ; Copies the 512 bytes in the buffer of the SD controller into the internal
002107                    ; block buffer of a virtual drive. Device and 4k window selection are hoisted
002108                    ; out of the loop, which is what makes this about twenty times faster than
002109                    ; the original per-byte VD_CAD_WRITE sequence.
002110                    ;
002111                    ; Input: R8: virtual drive number (only used for the vdrives device select)
002112                    ; Output: none, all registers unchanged
002113  8492  E0C0        SDB_SD2VD                   INCRB
002114  8493  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002115  8495  0F84  866F                              MOVE VDRIVES_DEVICE, R1
002116  8497  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002117  8498  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0
002118  849A  0F81  0000                              MOVE VD_WIN_CAD, @R0             ; control and data registers
002119                    
002120  849C  0F80  FF22                              MOVE IO$SD_DATA_POS, R0
002121  849E  0F84  FF23                              MOVE IO$SD_DATA, R1
002122  84A0  0F88  7005                              MOVE VD_B_ADDR, R2
002123  84A2  0F8C  7006                              MOVE VD_B_DOUT, R3
002124  84A4  0F90  7007                              MOVE VD_B_WREN, R4
002125  84A6  B514                                    XOR R5, R5
002126  84A7  0501        _SDB_S2V_L                  MOVE R5, @R0                     ; position in the SD buffer
002127  84A8  0509                                    MOVE R5, @R2                     ; address in the drive buffer
002128  84A9  014D                                    MOVE @R1, @R3                    ; the byte itself
002129  84AA  0F91  0001                              MOVE 1, @R4                      ; strobe write enable
002130  84AC  0F91  0000                              MOVE 0, @R4
002131  84AE  1F94  0001                              ADD 1, R5
002132  84B0  CF94  0200                              CMP 0x0200, R5
002133  84B2  FFAB  FFF3                              RBRA _SDB_S2V_L, !Z
002134  84B4  E100                                    DECRB
002135  84B5  0DBC                                    MOVE @R13++, R15
002136                    
002137                    ; SDB_VD2SD
002138                    ; Copies the 512 bytes from the internal block buffer of a virtual drive into
002139                    ; the buffer of the SD controller. The drive buffer address register lives in
002140                    ; the control/data window while the data register lives in the drive window,
002141                    ; so the window selector has to be toggled per byte; the device selection is
002142                    ; still hoisted out of the loop.
002143                    ;
002144                    ; Input: R8: virtual drive number
002145                    ; Output: none, all registers unchanged
002146  84B6  E0C0        SDB_VD2SD                   INCRB
002147  84B7  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002148  84B9  0F84  866F                              MOVE VDRIVES_DEVICE, R1
002149  84BB  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002150                    
002151  84BC  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002152  84BE  0F84  0001                              MOVE VD_WIN_DRV, R1
002153  84C0  1804                                    ADD R8, R1                       ; R1: window of this drive
002154  84C1  0F88  FF22                              MOVE IO$SD_DATA_POS, R2
002155  84C3  0F8C  FF23                              MOVE IO$SD_DATA, R3
002156  84C5  0F90  7005                              MOVE VD_B_ADDR, R4
002157  84C7  0F94  700B                              MOVE VD_B_DIN, R5
002158  84C9  B618                                    XOR R6, R6
002159  84CA  0F81  0000  _SDB_V2S_L                  MOVE VD_WIN_CAD, @R0             ; control and data registers
002160  84CC  0611                                    MOVE R6, @R4                     ; address in the drive buffer
002161  84CD  0101                                    MOVE R1, @R0                     ; drive specific registers
002162  84CE  0609                                    MOVE R6, @R2                     ; position in the SD buffer
002163  84CF  054D                                    MOVE @R5, @R3                    ; the byte itself
002164  84D0  1F98  0001                              ADD 1, R6
002165  84D2  CF98  0200                              CMP 0x0200, R6
002166  84D4  FFAB  FFF4                              RBRA _SDB_V2S_L, !Z
002167  84D6  E100                                    DECRB
002168  84D7  0DBC                                    MOVE @R13++, R15
002169                    
002170                    ; SDB_SD2DEV
002171                    ; Copies the 512 bytes in the buffer of the SD controller into an M2M byte
002172                    ; streaming device (a CRT/ROM load target), handling the 4k window boundary.
002173                    ;
002174                    ; Input: R8: target device id
002175                    ; R9: target 4k window
002176                    ; R10: target address within the window (M2M$RAMROM_DATA based)
002177                    ; Output: R9/R10: window and address behind the last written byte
002178                    ; R8 unchanged
002179  84D8  E0C0        SDB_SD2DEV                  INCRB
002180  84D9  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002181  84DB  0801                                    MOVE R8, @R0
002182  84DC  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002183  84DE  0901                                    MOVE R9, @R0
002184  84DF  0F84  FF22                              MOVE IO$SD_DATA_POS, R1
002185  84E1  0F88  FF23                              MOVE IO$SD_DATA, R2
002186  84E3  0F8C  7000                              MOVE M2M$RAMROM_DATA, R3
002187  84E5  1F8C  1000                              ADD 0x1000, R3                   ; R3: end of window marker
002188  84E7  B410                                    XOR R4, R4                       ; R4: position in the SD buf
002189  84E8  0F94  0200                              MOVE 0x0200, R5                  ; R5: bytes still to go
002190                                                ; One instruction has to sit between writing IO$SD_DATA_POS
002191                                                ; and reading IO$SD_DATA, exactly like SD$READ_BYTE does: the
002192                                                ; buffer is a block RAM with a registered output, see
002193                                                ; M2M/QNICE/vhdl/byte_bram.vhd. The ADD below is that
002194                                                ; instruction and does useful work at the same time.
002195  84EA  0405        _SDB_S2D_L                  MOVE R4, @R1                     ; position in the SD buffer
002196  84EB  1F90  0001                              ADD 1, R4
002197  84ED  026A                                    MOVE @R2, @R10++                 ; the byte itself
002198  84EE  C328                                    CMP R3, R10                      ; 4k window boundary?
002199  84EF  FFAB  0005                              RBRA _SDB_S2D_1, !Z              ; no
002200  84F1  0FA8  7000                              MOVE M2M$RAMROM_DATA, R10        ; yes: next window
002201  84F3  1FA4  0001                              ADD 1, R9
002202  84F5  0901                                    MOVE R9, @R0
002203  84F6  3F94  0001  _SDB_S2D_1                  SUB 1, R5
002204  84F8  FFAB  FFF0                              RBRA _SDB_S2D_L, !Z
002205  84FA  E100                                    DECRB
002206  84FB  0DBC                                    MOVE @R13++, R15
002207                    
002208                    ; ----------------------------------------------------------------------------
002209                    ; High level entry points
002210                    ; ----------------------------------------------------------------------------
002211                    
002212                    ; SDB_VD_RDBLK
002213                    ; Prepares one virtual drive block read: maps the byte position to an LBA and
002214                    ; reads that block into the buffer of the SD controller. On success the
002215                    ; caller acknowledges sd_rd_i and then calls SDB_SD2VD.
002216                    ;
002217                    ; Input: R8: virtual drive number
002218                    ; R9: file handle of the disk image
002219                    ; R10/R11: byte position within the image, lo/hi
002220                    ; R12: amount of bytes the core asked for
002221                    ; Output: Carry=1: the block is in the buffer of the SD controller
002222                    ; Carry=0: use the FAT32 library path instead
002223                    ; R8 .. R12 unchanged
002224  84FC  E0C0        SDB_VD_RDBLK                INCRB
002225  84FD  0800                                    MOVE R8, R0
002226  84FE  0904                                    MOVE R9, R1
002227  84FF  0A08                                    MOVE R10, R2
002228  8500  0B0C                                    MOVE R11, R3
002229  8501  0C10                                    MOVE R12, R4
002230  8502  FFB0  0054                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002231  8504  FFAA  0017                              RBRA _SDB_VRD_NO, !C
002232  8506  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002233  8507  0A18                                    MOVE R10, R6
002234  8508  FFB0  FC74                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002235  850A  FFAA  0011                              RBRA _SDB_VRD_NO, !C             ; no: nothing was touched
002236  850C  0520                                    MOVE R5, R8
002237  850D  0624                                    MOVE R6, R9
002238  850E  FF90  003C                              ASUB sd_r_block, 1
002239  8510  CFA0  0000                              CMP 0, R8
002240  8512  FFAB  0005                              RBRA _SDB_VRD_SDE, !Z            ; SD error: try the slow path
002241  8514  0020                                    MOVE R0, R8
002242  8515  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002243  8517  FFA0  0007                              RBRA _SDB_VRD_R, 1
002244  8519  FFB0  FC5C  _SDB_VRD_SDE                RSUB SDB_SDERR, 1
002245  851B  FFB0  FCBB                              RSUB SDB_GUARD_OUT, 1
002246  851D  0020        _SDB_VRD_NO                 MOVE R0, R8
002247  851E  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002248  8520  0124        _SDB_VRD_R                  MOVE R1, R9
002249  8521  0228                                    MOVE R2, R10
002250  8522  032C                                    MOVE R3, R11
002251  8523  0430                                    MOVE R4, R12
002252  8524  E100                                    DECRB
002253  8525  0DBC                                    MOVE @R13++, R15
002254                    
002255                    ; SDB_VD_RDDONE
002256                    ; Called by HANDLE_DRV_RD after SDB_SD2VD has emptied the buffer: puts the
002257                    ; FAT32 library's sector back into it.
002258                    ;
002259                    ; Input: none
002260                    ; Output: none, all registers unchanged
002261  8526  FFB0  FCB0  SDB_VD_RDDONE               RSUB SDB_GUARD_OUT, 1
002262  8528  0DBC                                    MOVE @R13++, R15
002263                    
002264                    ; SDB_VD_WRBLK
002265                    ; Writes one virtual drive block: maps the byte position to an LBA, copies
002266                    ; the internal block buffer of the drive into the buffer of the SD controller
002267                    ; and writes it. The caller acknowledges sd_wr_i afterwards.
002268                    ;
002269                    ; Input: R8: virtual drive number
002270                    ; R9: file handle of the disk image
002271                    ; R10/R11: byte position within the image, lo/hi
002272                    ; R12: amount of bytes the core wants to write
002273                    ; Output: Carry=1: the block has been written to the SD card
002274                    ; Carry=0: nothing was written, use the FAT32 library path instead
002275                    ; R8 .. R12 unchanged
002276  8529  E0C0        SDB_VD_WRBLK                INCRB
002277  852A  0800                                    MOVE R8, R0
002278  852B  0904                                    MOVE R9, R1
002279  852C  0A08                                    MOVE R10, R2
002280  852D  0B0C                                    MOVE R11, R3
002281  852E  0C10                                    MOVE R12, R4
002282  852F  FFB0  0027                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002283  8531  FFAA  001C                              RBRA _SDB_VWR_NO, !C
002284  8533  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002285  8534  0A18                                    MOVE R10, R6
002286  8535  FFB0  FC47                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002287  8537  FFAA  0016                              RBRA _SDB_VWR_NO, !C             ; no: nothing was touched
002288  8539  0020                                    MOVE R0, R8
002289  853A  FFB0  FF7A                              RSUB SDB_VD2SD, 1
002290  853C  0520                                    MOVE R5, R8
002291  853D  0624                                    MOVE R6, R9
002292  853E  FF90  003E                              ASUB sd_w_block, 1
002293  8540  CFA0  0000                              CMP 0, R8
002294  8542  FFAB  0007                              RBRA _SDB_VWR_SDE, !Z
002295  8544  FFB0  FC92                              RSUB SDB_GUARD_OUT, 1            ; the write is done, restore
002296  8546  0020                                    MOVE R0, R8
002297  8547  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002298  8549  FFA0  0007                              RBRA _SDB_VWR_R, 1
002299  854B  FFB0  FC2A  _SDB_VWR_SDE                RSUB SDB_SDERR, 1                ; SD error: try the slow path
002300  854D  FFB0  FC89                              RSUB SDB_GUARD_OUT, 1
002301  854F  0020        _SDB_VWR_NO                 MOVE R0, R8
002302  8550  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002303  8552  0124        _SDB_VWR_R                  MOVE R1, R9
002304  8553  0228                                    MOVE R2, R10
002305  8554  032C                                    MOVE R3, R11
002306  8555  0430                                    MOVE R4, R12
002307  8556  E100                                    DECRB
002308  8557  0DBC                                    MOVE @R13++, R15
002309                    
002310                    ; Common preparation for SDB_VD_RDBLK / SDB_VD_WRBLK. Expects the inputs in
002311                    ; the caller's R0 (drive), R1 (FDH), R2/R3 (byte position) and R4 (amount of
002312                    ; bytes) and returns Carry=1 plus the LBA in R9/R10. Runs in the caller's
002313                    ; register bank on purpose. Touches nothing outside our own variables.
002314  8558  0FA0  0200  _SDB_PREP                   MOVE 0x0200, R8
002315  855A  C420                                    CMP R4, R8                       ; exactly one block?
002316  855B  FFAB  0016                              RBRA _SDB_PREP_NO, !Z            ; no: let the FAT32 path do
002317  855D  0220                                    MOVE R2, R8                      ; ..partial/multi blocks
002318  855E  9FA0  01FF                              AND 0x01FF, R8                   ; block aligned?
002319  8560  FFAB  0011                              RBRA _SDB_PREP_NO, !Z            ; no
002320  8562  0020                                    MOVE R0, R8
002321  8563  FFB0  FBE6                              RSUB SDB_VDMAP, 1
002322  8565  082C                                    MOVE R8, R11                     ; R11: map
002323  8566  0124                                    MOVE R1, R9
002324  8567  FFB0  FBFB                              RSUB SDB_CHECK, 1
002325  8569  FFAA  0008                              RBRA _SDB_PREP_NO, !C
002326  856B  0224                                    MOVE R2, R9
002327  856C  0328                                    MOVE R3, R10
002328  856D  FFB0  FCA8                              RSUB SDB_B2BLK, 1
002329  856F  0B20                                    MOVE R11, R8
002330  8570  FFB0  FD1E                              RSUB SDB_LBA, 1                  ; sets/clears Carry
002331  8572  0DBC                                    MOVE @R13++, R15
002332  8573  9FB8  FFFB  _SDB_PREP_NO                AND 0xFFFB, R14                  ; clear Carry
002333  8575  0DBC                                    MOVE @R13++, R15
002334                    
002335                    ; SDB_FREAD_FAST
002336                    ; Streams whole 512-byte blocks of a mapped file directly from the SD card
002337                    ; into an M2M byte streaming device and then positions the file handle right
002338                    ; behind them, so that the caller's byte loop reads the rest as usual.
002339                    ;
002340                    ; It deliberately stops one whole block short of the end of the file, so that
002341                    ; the position it hands over is always strictly inside the file and the
002342                    ; caller reaches EOF through the FAT32 library, exactly as before.
002343                    ;
002344                    ; The final f32_fseek is what restores the library: a seek unconditionally
002345                    ; re-reads the sector into the hardware buffer and re-claims ownership, so
002346                    ; afterwards the library is in a state it produced itself. If anything at all
002347                    ; goes wrong the file position is put back where it was and Carry=0 is
002348                    ; returned, i.e. the caller sees "nothing happened".
002349                    ;
002350                    ; Input: R8: file handle (FDH)
002351                    ; R9: pointer to the block map
002352                    ; R10: target device id
002353                    ; R11: target 4k window
002354                    ; R12: target address within the window
002355                    ; Output: Carry=1: R11/R12 updated, the file position is behind the data
002356                    ; Carry=0: nothing was transferred, the file position is unchanged
002357                    ; and R11/R12 are unchanged
002358  8576  E0C0        SDB_FREAD_FAST              INCRB
002359  8577  0800                                    MOVE R8, R0                      ; R0: FDH
002360  8578  0904                                    MOVE R9, R1                      ; R1: map
002361  8579  0A08                                    MOVE R10, R2                     ; R2: target device
002362  857A  0B0C                                    MOVE R11, R3                     ; R3: target 4k window
002363  857B  0C10                                    MOVE R12, R4                     ; R4: target address
002364                    
002365  857C  0FA0  8720                              MOVE SDB_FF_STAT, R8
002366  857E  0FA1  0001                              MOVE SDB_B_NOMAP, @R8
002367  8580  0FA0  8721                              MOVE SDB_FF_BLKS, R8
002368  8582  0FA1  0000                              MOVE 0, @R8
002369                    
002370  8584  0120                                    MOVE R1, R8
002371  8585  0024                                    MOVE R0, R9
002372  8586  FFB0  FBDC                              RSUB SDB_CHECK, 1
002373  8588  FFAA  008A                              RBRA _SDBFF_NO, !C
002374                    
002375                                                ; only from the very beginning of the file
002376  858A  0020                                    MOVE R0, R8
002377  858B  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002378  858D  CFA1  0000                              CMP 0, @R8
002379  858F  FFAB  0083                              RBRA _SDBFF_NO, !Z
002380  8591  0020                                    MOVE R0, R8
002381  8592  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002382  8594  CFA1  0000                              CMP 0, @R8
002383  8596  FFAB  007C                              RBRA _SDBFF_NO, !Z
002384                    
002385                                                ; how many whole blocks do we take? Always one less than the
002386                                                ; file has, so that the handover position is strictly inside
002387                                                ; the file and the caller still reaches EOF through the
002388                                                ; library. A CRT/ROM file is never 32 MB or larger, so one
002389                                                ; word of block count is plenty and anything else is refused.
002390  8598  0120                                    MOVE R1, R8
002391  8599  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
002392  859B  CFA1  0000                              CMP 0, @R8
002393  859D  FFAB  0075                              RBRA _SDBFF_NO, !Z
002394  859F  0120                                    MOVE R1, R8
002395  85A0  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
002396  85A2  085C                                    MOVE @R8, R7                     ; R7: blocks still to do
002397  85A3  3F9C  0001                              SUB 1, R7
002398  85A5  FFA3  006D                              RBRA _SDBFF_NO, Z                ; a one block file: byte loop
002399  85A7  FFA4  006B                              RBRA _SDBFF_NO, N                ; cannot happen: TBLK was 0
002400                    
002401  85A9  0FA0  8720                              MOVE SDB_FF_STAT, R8
002402  85AB  0FA1  000B                              MOVE SDB_B_GUARD, @R8
002403  85AD  FFB0  FBCF                              RSUB SDB_GUARD_IN, 1             ; nothing touched if it fails
002404  85AF  FFAA  0063                              RBRA _SDBFF_NO, !C
002405                    
002406  85B1  B514                                    XOR R5, R5                       ; R5/R6: block index
002407  85B2  B618                                    XOR R6, R6
002408                    
002409  85B3  CF9C  0000  _SDBFF_LOOP                 CMP 0, R7
002410  85B5  FFA3  0020                              RBRA _SDBFF_DONE, Z
002411  85B7  0120                                    MOVE R1, R8
002412  85B8  0524                                    MOVE R5, R9
002413  85B9  0628                                    MOVE R6, R10
002414  85BA  FFB0  FCD4                              RSUB SDB_LBA, 1
002415  85BC  FFAA  0019                              RBRA _SDBFF_DONE, !C
002416                    
002417                    
002418                    
002419                    
002420  85BE  0920                                    MOVE R9, R8
002421  85BF  0A24                                    MOVE R10, R9
002422  85C0  FF90  003C                              ASUB sd_r_block, 1
002423  85C2  CFA0  0000                              CMP 0, R8
002424  85C4  FFAB  000F                              RBRA _SDBFF_SDE, !Z              ; SD error: stop here
002425  85C6  0220                                    MOVE R2, R8
002426  85C7  0324                                    MOVE R3, R9
002427  85C8  0428                                    MOVE R4, R10
002428  85C9  FFB0  FF0D                              RSUB SDB_SD2DEV, 1
002429  85CB  090C                                    MOVE R9, R3
002430  85CC  0A10                                    MOVE R10, R4
002431  85CD  1F94  0001                              ADD 1, R5
002432  85CF  2F98  0000                              ADDC 0, R6
002433  85D1  3F9C  0001                              SUB 1, R7
002434  85D3  FFA0  FFDE                              RBRA _SDBFF_LOOP, 1
002435                    
002436  85D5  FFB0  FBA0  _SDBFF_SDE                  RSUB SDB_SDERR, 1
002437                    
002438                                                ; the hardware buffer is ours now; whatever we do next, the
002439                                                ; library has to be put back. A seek does that properly.
002440  85D7  0FA0  8721  _SDBFF_DONE                 MOVE SDB_FF_BLKS, R8
002441  85D9  0521                                    MOVE R5, @R8
002442  85DA  CF94  0000                              CMP 0, R5                        ; anything transferred?
002443  85DC  FFAB  0004                              RBRA _SDBFF_SEEK, !Z
002444  85DE  CF98  0000                              CMP 0, R6
002445  85E0  FFA3  0027                              RBRA _SDBFF_REW, Z               ; no: just put it back
002446                    
002447  85E2  0FA0  8720  _SDBFF_SEEK                 MOVE SDB_FF_STAT, R8
002448  85E4  0FA1  000C                              MOVE SDB_B_SEEK, @R8
002449  85E6  0524                                    MOVE R5, R9                      ; file position = blocks * 512
002450  85E7  0628                                    MOVE R6, R10
002451  85E8  FFB0  FC40                              RSUB SDB_BLK2B, 1
002452  85EA  092C                                    MOVE R9, R11                     ; R11/R12: expected position
002453  85EB  0A30                                    MOVE R10, R12
002454  85EC  0020                                    MOVE R0, R8
002455  85ED  FF90  0054                              ASUB f32_fseek, 1
002456  85EF  CFA4  0000                              CMP 0, R9                        ; seek reported success?
002457  85F1  FFAB  0016                              RBRA _SDBFF_REW, !Z
002458  85F3  0020                                    MOVE R0, R8                      ; ..and actually got there?
002459  85F4  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
002460  85F6  C86C                                    CMP @R8, R11
002461  85F7  FFAB  0010                              RBRA _SDBFF_REW, !Z
002462  85F9  0020                                    MOVE R0, R8
002463  85FA  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
002464  85FC  C870                                    CMP @R8, R12
002465  85FD  FFAB  000A                              RBRA _SDBFF_REW, !Z
002466                    
002467  85FF  0FA0  8720                              MOVE SDB_FF_STAT, R8
002468  8601  0FA1  0000                              MOVE SDB_B_OK, @R8
002469  8603  032C                                    MOVE R3, R11
002470  8604  0430                                    MOVE R4, R12
002471  8605  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002472  8607  FFA0  000D                              RBRA _SDBFF_RET, 1
002473                    
002474                                                ; Put the file back to the start and report "nothing done".
002475                                                ; The caller has not seen the updated target pointers, so it
002476                                                ; simply overwrites whatever we already transferred. The seek
002477                                                ; also restores the library's sector buffer; if even that
002478                                                ; fails, the buffer is marked unknown.
002479  8609  0020        _SDBFF_REW                  MOVE R0, R8
002480  860A  B924                                    XOR R9, R9
002481  860B  BA28                                    XOR R10, R10
002482  860C  FF90  0054                              ASUB f32_fseek, 1
002483  860E  CFA4  0000                              CMP 0, R9
002484  8610  FFA3  0002                              RBRA _SDBFF_NO, Z
002485  8612  FFB0  FBE7                              RSUB SDB_ORPHAN, 1
002486                    
002487  8614  9FB8  FFFB  _SDBFF_NO                   AND 0xFFFB, R14                  ; clear Carry
002488  8616              _SDBFF_RET                  
002489  8616  E100                                    DECRB
002490  8617  0DBC                                    MOVE @R13++, R15
002491                    

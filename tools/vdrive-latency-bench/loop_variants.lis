002601  8635  0F84  875E                              MOVE SIM_VDRIVES_DEV, R1
002602  8637  0141                                    MOVE @R1, @R0
002603  8638  0F80  875D                              MOVE SIM_RAMROM_4KWIN, R0
002604  863A  0F81  0100                              MOVE 0x0100, @R0
002605  863C  0921                                    MOVE R9, @R8

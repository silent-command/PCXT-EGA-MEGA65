002010  83BB  FFB0  002D                              RSUB _SDB_BAIL, 1
002011  83BD  FFB0  0032                              RSUB _SDB_EMIT, 1
002012  83BF  FFAA  0024                              RBRA _SDBMB_OUT, !C
002013  83C1  0FA0  874F                              MOVE SDB_S_BLEFT, R8             ; blocks left -= extent size
002014  83C3  3622                                    SUB R6, @R8++
002015  83C4  4721                                    SUBC R7, @R8
002016  83C5  0FA0  8757                              MOVE SDB_S_NEXT, R8              ; continue with the cluster..
002017  83C7  0FA4  8753                              MOVE SDB_S_CLU, R9               ; ..that broke the run
002018  83C9  08A6                                    MOVE @R8++, @R9++
002019  83CA  0865                                    MOVE @R8, @R9
002020  83CB  1F90  0001                              ADD 1, R4
002021  83CD  1F94  0004                              ADD SDB_E_SIZE, R5
002022  83CF  FFA0  FF7E                              RBRA _SDBMB_EXT, 1
002023                    
002024                                                ; ---- the current run covers the rest of the file
002025  83D1  0FA0  874F  _SDBMB_LAST                 MOVE SDB_S_BLEFT, R8             ; extent size = blocks left
002026  83D3  0898                                    MOVE @R8++, R6
002027  83D4  085C                                    MOVE @R8, R7
002028  83D5  0FA0  000A                              MOVE SDB_B_LBA, R8
002029  83D7  FFB0  0011                              RSUB _SDB_BAIL, 1
002030  83D9  FFB0  0016                              RSUB _SDB_EMIT, 1
002031  83DB  FFAA  0008                              RBRA _SDBMB_OUT, !C
002032  83DD  1F90  0001                              ADD 1, R4
002033  83DF  0405                                    MOVE R4, @R1                     ; map is complete and valid
002034  83E0  0120                                    MOVE R1, R8
002035  83E1  1FA0  0004                              ADD SDB_M_BAIL, R8
002036  83E3  0FA1  0000                              MOVE SDB_B_OK, @R8

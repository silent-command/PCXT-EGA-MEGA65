000545                    ; ****************************************************************************
000546                    ; MiSTer2MEGA65 (M2M) QNICE ROM
000547                    ;
000548                    ; System definition file for registers and MMIO
000549                    ;
000550                    ; done by sy2002 in 2022 and licensed under GPL v3
000551                    ; ****************************************************************************
000552                    
000553                    ; ----------------------------------------------------------------------------
000554                    ; Control and status register
000555                    ; ----------------------------------------------------------------------------
000556                    
000557                    M2M$CSR                     .EQU 0xFFE0
000558                                                ; Bit 0: Reset the MiSTer core
000559                                                ; Bit 1: Pause the MiSTer core
000560                                                ; Bit 2: Show On-Screen-Menu (OSM) as an overlay over core output
000561                                                ; Bit 3: Keyboard connection between M65 keyb. and the core
000562                                                ; Bit 4: Joy. port 1 connection between M65 joy. port and core
000563                                                ; Bit 5: Joy. port 2 connection between M65 joy. port and core
000564                                                ; Bit 6: SD Card: Mode: 0=Auto: SD card automatically switches
000565                                                ; between the internal card (bottom tray) and the external
000566                                                ; card (back slot). The external card has higher precedence.
000567                                                ; Bit 7: SD Card: If Mode=1: 0=force internal / 1=force external
000568                                                ; Bit 8: SD Card: Currently active: 0=internal / 1=external
000569                                                ; Bit 9: SD Card: Internal SD card detected
000570                                                ; Bit 10: SD Card: External SD card detected
000571                                                ; Bit 11: Ascal autoset: If set to 1: M2M$ASCAL_MODE (which is
000572                                                ; controlling QNICE ouput port ascal_mode_o) is automatically
000573                                                ; kept in sync with ascal_mode_i
000574                                                ; Bits 12..15: RESERVED
000575                                                ;
000576                                                ; Bits 8, 9, 10 are read-only
000577                    
000578                    M2M$CSR_RESET               .EQU 0x0001
000579                    M2M$CSR_UN_RESET            .EQU 0xFFFE
000580                    M2M$CSR_PAUSE               .EQU 0x0002
000581                    M2M$CSR_UN_PAUSE            .EQU 0xFFFD
000582                    M2M$CSR_OSM                 .EQU 0x0004
000583                    M2M$CSR_UN_OSM              .EQU 0xFFFB
000584                    M2M$CSR_KBD                 .EQU 0x0008
000585                    M2M$CSR_UN_KBD              .EQU 0xFFF7
000586                    M2M$CSR_JOY1                .EQU 0x0010
000587                    M2M$CSR_UN_JOY1             .EQU 0xFFEF
000588                    M2M$CSR_JOY2                .EQU 0x0020
000589                    M2M$CSR_UN_JOY2             .EQU 0xFFDF
000590                    M2M$CSR_SD_MODE             .EQU 0x0040
000591                    M2M$CSR_UN_SD_MODE          .EQU 0xFFBF
000592                    M2M$CSR_SD_FORCE            .EQU 0x0080
000593                    M2M$CSR_UN_SD_FORCE         .EQU 0xFF7F
000594                    M2M$CSR_SD_ACTIVE           .EQU 0x0100
000595                    M2M$CSR_UN_SD_ACTIVE        .EQU 0xFEFF
000596                    M2M$CSR_SD_DET_INT          .EQU 0x0200
000597                    M2M$CSR_UN_SD_DET_INT       .EQU 0xFDFF
000598                    M2M$CSR_SD_DET_EXT          .EQU 0x0400
000599                    M2M$CSR_UN_SD_DET_EXT       .EQU 0xFBFF
000600                    M2M$CSR_ASCAL_AUTO          .EQU 0x0800
000601                    M2M$CSR_UN_ASCAL_AUTO       .EQU 0xF7FF
000602                    
000603                    M2M$CSR_KBD_JOY             .EQU 0x0038
000604                    M2M$CSR_UN_KBD_JOY          .EQU 0xFFC7
000605                    
000606                    ; ----------------------------------------------------------------------------
000607                    ; VGA and On-Screen-Menu (OSM)
000608                    ; ----------------------------------------------------------------------------
000609                    
000610                    ; All coordinates and sizes in the OSM context are specified in characters
000611                    ; The high-byte of the 16-bit value is always x or dx and the low-byte y or dy
000612                    
000613                    ; When bit 2 of the CSR = 1, then the OSM is shown at the coordinates
000614                    ; and in the size given by these two registers, i.e. these registers are used
000615                    ; by the display hardware
000616                    M2M$OSM_XY                  .EQU 0xFFE1                      ; x|y coordinates
000617                    M2M$OSM_DXDY                .EQU 0xFFE2                      ; dx|dy width and height
000618                    
000619                    ; Screen attributes: Single bits
000620                    M2M$SA_INVERSE              .EQU 0x80
000621                    M2M$SA_DARK                 .EQU 0x40
000622                    M2M$SA_BG_RED               .EQU 0x20
000623                    M2M$SA_BG_GREEN             .EQU 0x10
000624                    M2M$SA_BG_BLUE              .EQU 0x08
000625                    M2M$SA_FG_RED               .EQU 0x04
000626                    M2M$SA_FG_GREEN             .EQU 0x02
000627                    M2M$SA_FG_BLUE              .EQU 0x01
000628                    
000629                    ; Screen attributes: Common bit-combinations
000630                    M2M$SA_COL_STD              .EQU 0x0B                        ; cyan font on blue background
000631                    M2M$SA_COL_STD_INV          .EQU 0x8B                        ; inverse standard
000632                    M2M$SA_COL_TTLE             .EQU 0x0E                        ; Title: Yellow on blue background
000633                    M2M$SA_COL_TTLE_INV         .EQU 0x8E                        ; inverse Title
000634                    M2M$SA_COL_SEL              .EQU 0x0F                        ; selection: white font on blue background
000635                    
000636                    ; Special characters in font Anikki-16x16
000637                    M2M$FC_TL                   .EQU 201                         ; fat top/left corner
000638                    M2M$FC_SH                   .EQU 205                         ; fat straight horizontal
000639                    M2M$FC_TR                   .EQU 187                         ; fat top/right corner
000640                    M2M$FC_SV                   .EQU 186                         ; fat straight vertical
000641                    M2M$FC_BL                   .EQU 200                         ; fat bottom/left corner
000642                    M2M$FC_BR                   .EQU 188                         ; fat bottom/right corner
000643                    M2M$FC_HE_LEFT              .EQU 185                         ; fat straight horiz. line ends: left part
000644                    M2M$FC_HE_RIGHT             .EQU 204                         ; fat straight horiz. line ends: right part
000645                    M2M$NC_SH                   .EQU 196                         ; normal straight horizontal
000646                    M2M$NC_VE_LEFT              .EQU 199                         ; normal vertical line end: left part
000647                    M2M$NC_VE_RIGHT             .EQU 182                         ; normal vertical line end: right part
000648                    M2M$DIR_L                   .EQU 17                          ; left char for displaying a directory
000649                    M2M$DIR_R                   .EQU 16                          ; right char for displaying a directory
000650                    M2M$OPT_SEL_MULTI           .EQU 7                           ; selection char for options menu: multi-sel.
000651                    M2M$OPT_SEL_SINGLE          .EQU 61                          ; ditto for single select
000652                    M2M$LD_PROGRESS             .EQU 254                         ; character used for progress bar
000653                    M2M$LD_SPACE                .EQU 32                          ; space character
000654                    
000655                    ; ----------------------------------------------------------------------------
000656                    ; HDMI: Avalon Scaler (ascal.vhd)
000657                    ; ----------------------------------------------------------------------------
000658                    
000659                    M2M$ASCAL_MODE              .EQU 0xFFE3                      ; ascal mode register
000660                                                ; this reg. is read-only if CSR bit 11 = 1
000661                    
000662                    ; ascal mode: bits 2 downto 0
000663                    M2M$ASCAL_NEAREST           .EQU 0x0000                      ; Nearest neighbor
000664                    M2M$ASCAL_BILINEAR          .EQU 0x0001                      ; Bilinear
000665                    M2M$ASCAL_SBILINEAR         .EQU 0x0002                      ; Sharp Bilinear
000666                    M2M$ASCAL_BICUBIC           .EQU 0x0003                      ; Bicubic
000667                    M2M$ASCAL_POLYPHASE         .EQU 0x0004                      ; Polyphase filter (used for CRT emulation)
000668                    
000669                    ; ascal Polyphase addresses
000670                    M2M$ASCAL_PP_HORIZ          .EQU 0x0000
000671                    M2M$ASCAL_PP_VERT           .EQU 0x0100
000672                    
000673                    ; ascal mode: bits 3 and 4
000674                    M2M$ASCAL_TRIPLEBUF         .EQU 0x0008                      ; Activate triple-buffering
000675                    M2M$ASCAL_RESERVED          .EQU 0x0010                      ; reserved (see ascal.vhd)
000676                    
000677                    ; ----------------------------------------------------------------------------
000678                    ; Special-purpose and general-purpose 16-bit input flags
000679                    ; Read-only; direct pass through from SOC inputs, not buffered in a register.
000680                    ; (Currently reserved and not used, yet)
000681                    ; ----------------------------------------------------------------------------
000682                    
000683                    ; special-purpose register that gets its semantics via the Shell firmware
000684                    M2M$SPECIAL                 .EQU 0xFFE4
000685                    
000686                    ; general-purpose register, can be freely used and is not used by the Shell
000687                    M2M$GENERAL                 .EQU 0xFFE5
000688                    
000689                    ; ----------------------------------------------------------------------------
000690                    ; Keyboard for the framework (independent from the keyboard of the core)
000691                    ; ----------------------------------------------------------------------------
000692                    
000693                    ; Low active realtime snapshot of the currently pressed keys (read-only)
000694                    ; (MMIO "qnice_keys_o" register of m2m_keys.vhd)
000695                    M2M$KEYBOARD                .EQU 0xFFE8
000696                    
000697                    ; Typematic delay (DLY) and typematic repeat (SPD)
000698                    ; DLY: How long needs the key to be pressed, until the typematic repeat starts
000699                    ; SPD: How fast will the pressed key be repeated
000700                    ; IMPORTANT: These values are empiric and relative to QNICE V1.61
000701                    M2M$TYPEMATIC_DLY           .EQU 0x8000                      ; ~0.5sec in QNICE V1.61
000702                    M2M$TYPEMATIC_SPD           .EQU 0x1000                      ; ~12 per sec
000703                    
000704                    ; Definition of the bits in M2M$KEYBOARD
000705                    M2M$KEY_UP                  .EQU 0x0001
000706                    M2M$KEY_DOWN                .EQU 0x0002
000707                    M2M$KEY_LEFT                .EQU 0x0004
000708                    M2M$KEY_RIGHT               .EQU 0x0008
000709                    M2M$KEY_RETURN              .EQU 0x0010
000710                    M2M$KEY_SPACE               .EQU 0x0020
000711                    M2M$KEY_RUNSTOP             .EQU 0x0040
000712                    M2M$KEY_HELP                .EQU 0x0080
000713                    M2M$KEY_F1                  .EQU 0x0100
000714                    M2M$KEY_F3                  .EQU 0x0200
000715                    
000716                    ; ----------------------------------------------------------------------------
000717                    ; 256-bit General purpose control flags
000718                    ; ----------------------------------------------------------------------------
000719                    
000720                    ; 256-bit directly controled by the programmer (not used by the Shell)
000721                    ; Select a window between 0 and 15 in M2M$CFD_ADDR and access the control
000722                    ; flags sliced into 16-bit chunks via M2M$CFD_DATA
000723                    ; exposed by QNICE via control_d_o
000724                    M2M$CFD_ADDR                .EQU 0xFFF0
000725                    M2M$CFD_DATA                .EQU 0xFFF1
000726                    
000727                    ; 256-bit controled by the Shell via the options menu, i.e. the menu that
000728                    ; opens when the core is running and the user presses "Help" on the keyboard:
000729                    ; the bit order is: bit 0 = topmost menu entry, the mapping is 1-to-1 to
000730                    ; OPTM_ITEMS / OPTM_GROUPS in config.vhd
000731                    ; exposed by QNICE via control_m_o; M2M$CFM_ADDR runs from 0 to 15
000732                    M2M$CFM_ADDR                .EQU 0xFFF2
000733                    M2M$CFM_DATA                .EQU 0xFFF3
000734                    
000735                    ; ----------------------------------------------------------------------------
000736                    ; MMIO 4k-segmented access to RAMs, ROMs and similarily behaving devices
000737                    ; ----------------------------------------------------------------------------
000738                    
000739                    M2M$RAMROM_DEV              .EQU 0xFFF4
000740                                                ; Devices 0x0000 .. 0x00FF: RESERVED (see below)
000741                                                ; Devices 0x0100 .. 0xFFFF: Free to be used for any RAM, ROM or device
000742                                                ; that behaves like a RAM or ROM from the
000743                                                ; perspective of QNICE
000744                    
000745                    M2M$VRAM_DATA               .EQU 0x0000                      ; Device for VRAM: Data
000746                    M2M$VRAM_ATTR               .EQU 0x0001                      ; Device for VRAM: Attributes
000747                    M2M$CONFIG                  .EQU 0x0002                      ; Static Shell config data (config.vhd)
000748                    M2M$ASCAL_PPHASE            .EQU 0x0003                      ; ascal.vhd Polyphase filter RAM
000749                    M2M$HYPERRAM                .EQU 0x0004                      ; Device for the built-in 8MB of HyperRAM
000750                    M2M$SDRAM                   .EQU 0x0005                      ; @TODO/RESERVED for future R4 boards
000751                    
000752                    M2M$SYS_INFO                .EQU 0x00FF                      ; Device for System Info
000753                    
000754                    M2M$RAMROM_4KWIN            .EQU 0xFFF5                      ; 4k window selector
000755                    M2M$RAMROM_DATA             .EQU 0x7000                      ; 4k MMIO window to read/write
000756                    
000757                    ; ----------------------------------------------------------------------------
000758                    ; Sysinfo device: Selectors and addresses
000759                    ; ----------------------------------------------------------------------------
000760                    
000761                    ; Selectors (4k windows)
000762                    M2M$SYS_VDRIVES             .EQU 0x0000                      ; vdrives constants (globals.vhd)
000763                    M2M$SYS_VGA                 .EQU 0x0010                      ; gfx adaptor 0: VGA
000764                    M2M$SYS_HDMI                .EQU 0x0011                      ; gfx adaptor 1: HDMI
000765                    M2M$SYS_CRTSANDROMS         .EQU 0x0020                      ; sim. CRTs. & ROMs (globals.vhd)
000766                    M2M$SYS_CORE                .EQU 0x0030                      ; info about the MiSTer core
000767                    
000768                    ; The following read-only registers are meant to be used by the QNICE
000769                    ; firmware. They enable the ability to specify the hardware screen resolution
000770                    ; in characters as well as the start coordinates and size of the main screen.
000771                    ; The position and size of the option menu is deducted.
000772                    M2M$SYS_DXDY                .EQU 0x7000
000773                    M2M$SHELL_M_XY              .EQU 0x7001                      ; main screen: x|y start coordinates
000774                    M2M$SHELL_M_DXDY            .EQU 0x7002                      ; main screen: dx|dy width and height
000775                    
000776                    ; M2M$SYS_CORE registers: measurement from ASCAL
000777                    M2M$SYS_CORE_X              .EQU 0x7000                      ; visible dx measurement from ASCAL
000778                    M2M$SYS_CORE_Y              .EQU 0x7001                      ; visible dy measurement from ASCAL
000779                    
000780                    ; M2M$SYS_CORE registers: measurement from M2M component
000781                    M2M$SYS_CORE_H_PXLS         .EQU 0x7002                      ; visible dx
000782                    M2M$SYS_CORE_V_PXLS         .EQU 0x7003                      ; visible dy
000783                    M2M$SYS_CORE_H_PLSE         .EQU 0x7004                      ; horizontal pulse
000784                    M2M$SYS_CORE_H_BP           .EQU 0x7005                      ; horizontal back porch
000785                    M2M$SYS_CORE_H_FP           .EQU 0x7006                      ; horizontal front porch
000786                    M2M$SYS_CORE_V_PLSE         .EQU 0x7007                      ; vertical pulse
000787                    M2M$SYS_CORE_V_BP           .EQU 0x7008                      ; vertical back porch
000788                    M2M$SYS_CORE_V_FP           .EQU 0x7009                      ; vertical front porch
000789                    M2M$SYS_CORE_H_FREQ         .EQU 0x700A                      ; horizontal frequency in Hz
000790                    
000791                    ; ----------------------------------------------------------------------------
000792                    ; Static Shell configuration data (config.vhd): Selectors and addresses
000793                    ; ----------------------------------------------------------------------------
000794                    
000795                    ; Selectors (4k windows)
000796                    
000797                    M2M$CFG_WHS                 .EQU 0x1000                      ; Welcome & Help screens
000798                    M2M$CFG_DIR_START           .EQU 0x0100                      ; Start folder for file browser
000799                    M2M$CFG_CFG_FILE            .EQU 0x0101                      ; Config file for OSM persistence
000800                    M2M$CFG_GENERAL             .EQU 0x0110                      ; General configuration settings
000801                    M2M$CFG_CORENAME            .EQU 0x0200                      ; String: name and version of core
000802                    
000803                    M2M$CFG_OPTM_ITEMS          .EQU 0x0300 ; "Help" menu / Options menu items
000804                    M2M$CFG_OPTM_GROUPS         .EQU 0x0301                      ; Menu groups
000805                    M2M$CFG_OPTM_STDSEL         .EQU 0x0302                      ; Menu items that are selected by default
000806                    M2M$CFG_OPTM_LINES          .EQU 0x0303                      ; Separator lines
000807                    M2M$CFG_OPTM_START          .EQU 0x0304                      ; Position of very first cursor pos
000808                    M2M$CFG_OPTM_ICOUNT         .EQU 0x0305                      ; Amount of menu items
000809                    M2M$CFG_OPTM_MOUNT          .EQU 0x0306                      ; Menu item = mount a drive
000810                    M2M$CFG_OPTM_SINGLE         .EQU 0x0307                      ; Single-select menu item
000811                    M2M$CFG_OPTM_MSTR           .EQU 0x0308                      ; Mount string to display instead of %s
000812                    M2M$CFG_OPTM_DIM            .EQU 0x0309                      ; DX and DY of Options/Help menu
000813                    M2M$CFG_OPTM_SSTR           .EQU 0x030A                      ; Saving string to display instead of %s
000814                    M2M$CFG_OPTM_HELP           .EQU 0x0310                      ; Menu item = show a help menu
000815                    M2M$CFG_OPTM_CRTROM         .EQU 0x0311                      ; Menu item = manually load CRT/ROM
000816                    M2M$CFG_OPTM_CRSTR          .EQU 0x0312                      ; CRT/ROM load str. to show instead of %s
000817                    
000818                    ; M2M$CFG_WHS
000819                    
000820                    M2M$WHS_PAGES               .EQU 0x7FFF                      ; Amount of pages in current WHS element
000821                    M2M$WHS_WELCOME             .EQU 0x0000                      ; WHS array element: Welcome page
000822                    M2M$WHS_HELP_INDEX          .EQU 0x0001                      ; WHS array: Help pages start with index 1
000823                    M2M$WHS_HELP_NEXT           .EQU 0x0100                      ; WHS array element: Next help structure
000824                    M2M$WHS_PAGE_NEXT           .EQU 0x0001                      ; WHS array element: Next page / prev page
000825                    
000826                    ; M2M$CFG_OPTM_DIM: Addresses
000827                    
000828                    M2M$SHELL_O_DX              .EQU 0x7000                      ; Width of Help/Options menu
000829                    M2M$SHELL_O_DY              .EQU 0x7001                      ; Height of Help/Options menu
000830                    
000831                    ; M2M$CFG_GENERAL Addresses
000832                    
000833                    M2M$CFG_RP_COUNTER          .EQU 0x7001 ; keep reset for a "QNICE loop while"
000834                    M2M$CFG_RP_PAUSE            .EQU 0x7002                      ; pause core when any OSD opens
000835                    M2M$CFG_RP_WELCOME          .EQU 0x7003                      ; show the welcome screen in general
000836                    M2M$CFG_RP_WLCM_RST         .EQU 0x7004                      ; show welcome screen after reset
000837                    M2M$CFG_RP_KB_RST           .EQU 0x7005                      ; connect the keyboard at reset
000838                    M2M$CFG_RP_J1_RST           .EQU 0x7006                      ; connect the joystick 1 at reset
000839                    M2M$CFG_RP_J2_RST           .EQU 0x7007                      ; connect the joystick 2 at reset
000840                    M2M$CFG_RP_KB_OSD           .EQU 0x7008                      ; connect the keyboard at OSD
000841                    M2M$CFG_RP_J1_OSD           .EQU 0x7009                      ; connect the joystick 1 at OSD
000842                    M2M$CFG_RP_J2_OSD           .EQU 0x700A                      ; connect the joystick 2 at OSD
000843                    
000844                    M2M$CFG_ASCAL_USAGE         .EQU 0x700B                      ; firmware treatment of ascal mode
000845                    M2M$CFG_ASCAL_MODE          .EQU 0x700C                      ; hardcoded ascal mode, if applicable
000846                    
000847                    M2M$CFG_VD_AT_DELAY         .EQU 0x700D                      ; Anti-Thrashing delay (virtual drives)
000848                    M2M$CFG_VD_ITERSIZE         .EQU 0x700E                      ; Bytes that are saving per flushing-iter.
000849                    
000850                    M2M$CFG_SAVEOSDCFG          .EQU 0x700F                      ; Remember on-screen-menu settings
000851                    
000852                    ; M2M$CFG_ASCAL_USAGE modes
000853                    M2M$CFG_AUSE_CFG            .EQU 0x0000                      ; use ASCAL_MODE from config.vhd
000854                    M2M$CFG_AUSE_CUSTOM         .EQU 0x0001                      ; controlled via custom QNICE assembly
000855                    M2M$CFG_AUSE_AUTO           .EQU 0x0002                      ; auto-sync via M2M$CFG_ASCAL_USAGE
000856                    
000857                    ; ----------------------------------------------------------------------------
000858                    ; Virtual Drives Device for MiSTer "SD" interface (vdrives.vhd)
000859                    ; ----------------------------------------------------------------------------
000860                    
000861                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000862                    VD_NUM                      .EQU 0x7000                      ; amount of virtual drives
000863                    VD_DEVICE                   .EQU 0x7001                      ; address of the vdrives.vhd device
000864                    VD_RAM_BUFFERS              .EQU 0x7100                      ; array of RAM buffers to store dsk images
000865                    VD_BUF_SDDIRECT             .EQU 0xAAAA ; "buffer" value: no RAM buffer, the image
000866                                                ; stays on the SD card and blocks are
000867                                                ; transferred on request (see shell.asm)
000868                    
000869                    ; window selectors for vdrives.vhd
000870                    VD_WIN_CAD                  .EQU 0x0000                      ; control and data registers
000871                    VD_WIN_DRV                  .EQU 0x0001                      ; drive 0, next window = drive 1, ...
000872                    
000873                    ; VD_WIN_CAD: control and data registers
000874                    VD_IMG_MOUNT                .EQU 0x7000                      ; image mounted, lowest bit = drive 0
000875                    VD_RO                       .EQU 0x7001                      ; read-only for currently mounted drive
000876                    VD_SIZE_L                   .EQU 0x7002                      ; image file size, low word
000877                    VD_SIZE_H                   .EQU 0x7003                      ; image file size, high word
000878                    VD_TYPE                     .EQU 0x7004                      ; image file type (2-bit value)
000879                    VD_B_ADDR                   .EQU 0x7005                      ; drive buffer: address
000880                    VD_B_DOUT                   .EQU 0x7006                      ; drive buffer: data out (to drive)
000881                    VD_B_WREN                   .EQU 0x7007                      ; drive buffer: write enable (also needs ack)
000882                    VD_VDNUM                    .EQU 0x7008                      ; number of virtual drives
000883                    VD_BLKSZ                    .EQU 0x7009                      ; block size for LBA in bytes
000884                    VD_DRV_MOUNT                .EQU 0x700A                      ; drive mounted, lowest bit = drive 0
000885                    
000886                    ; VD_WIN_DRV (and onwards): virtual drive specific registers
000887                    VD_LBA_L                    .EQU 0x7000                      ; SD LBA low word
000888                    VD_LBA_H                    .EQU 0x7001                      ; SD LBA high word
000889                    VD_BLKCNT                   .EQU 0x7002                      ; SD block count
000890                    VD_BYTES_L                  .EQU 0x7003                      ; SD block address in bytes: low word
000891                    VD_BYTES_H                  .EQU 0x7004                      ; SD block address in bytes: high word
000892                    VD_SIZEB                    .EQU 0x7005                      ; SD block data amount in bytes
000893                    VD_4K_WIN                   .EQU 0x7006                      ; SD block address in 4k win logic: window
000894                    VD_4K_OFFS                  .EQU 0x7007                      ; SD block address in 4k win logic: offset
000895                    VD_RD                       .EQU 0x7008                      ; SD read request
000896                    VD_WR                       .EQU 0x7009                      ; SD write request
000897                    VD_ACK                      .EQU 0x700A                      ; SD acknowledge
000898                    VD_B_DIN                    .EQU 0x700B                      ; drive buffer: data in (from drive)
000899                    VD_CACHE_DIRTY              .EQU 0x700C                      ; cache dirty flag
000900                    VD_CACHE_FLUSHING           .EQU 0x700D                      ; cache flushing flag
000901                    VD_CACHE_FLUSH_ST           .EQU 0x700E                      ; cache flushing can start now
000902                    VD_CACHE_FLUSH_DE           .EQU 0x700F                      ; delay in ms between VD_WR and FLUSH_ST
000903                    
000904                    ; ----------------------------------------------------------------------------
000905                    ; Automatically and manually loadable cartridges and ROMs
000906                    ; ----------------------------------------------------------------------------
000907                    
000908                    ; sysinfo addresses (data is configured by the user in globals.vhd)
000909                    CRTROM_MAN_NUM_A            .EQU 0x7000                      ; amount of manually loadable CRTs/ROMs
000910                    CRTROM_AUT_NUM_A            .EQU 0x7001                      ; amount of automatically loadable ROMs
000911                    CRTROM_MAN_BUFFERS          .EQU 0x7100                      ; array of records: manually loadable
000912                    CRTROM_AUT_BUFFERS          .EQU 0x7200                      ; array of records: automatically loadable
000913                    CRTROM_AUT_FILES            .EQU 0x7300                      ; auto-load filesnames
000914                    
000915                    ; Type of byte streaming device for receiving the CRT/ROM data
000916                    CRTROM_TYPE_DEVICE          .EQU 0x0000                      ; any QNICE compatible device
000917                    CRTROM_TYPE_HYPRAM          .EQU 0x0001                      ; HyperRAM
000918                    CRTROM_TYPE_SDRAM           .EQU 0x0002                      ; @TODO/RESERVED for future R4 boards
000919                    CRTROM_TYPE_MNDTRY          .EQU 0x0003                      ; mandatory ROM
000920                    CTRROM_TYPE_OPTNL           .EQU 0x0004                      ; optional ROM
000921                    
000922                    ; Control and status registers of a CRT/ROM device
000923                    CRTROM_CSR_4KWIN            .EQU 0xFFFF                      ; 4K window in the device addr. space
000924                    
000925                    CRTROM_CSR_STATUS           .EQU 0x7000                      ; QNICE to device: load status (see below)
000926                    CRTROM_CSR_FS_LO            .EQU 0x7001                      ; filesize of CRT/ROM: low word
000927                    CRTROM_CSR_FS_HI            .EQU 0x7002                      ; filesize of CRT/ROM: high word
000928                    CRTROM_CSR_PARSEST          .EQU 0x7010                      ; device to QNICE: parse status
000929                    CRTROM_CSR_PARSEE1          .EQU 0x7011                      ; device to QNICE: error code
000930                    CRTROM_CSR_ADDR_LO          .EQU 0x7012                      ; device to QNICE: load address low word
000931                    CRTROM_CSR_ADDR_HI          .EQU 0x7013                      ; device to QNICE: load address high word
000932                    CRTROM_CSR_ERR_STRT         .EQU 0x7100                      ; device to QNICE: status string
000933                    
000934                    ; QNICE to device: CRT/ROM load status
000935                    CRTROM_CSR_ST_IDLE          .EQU 0x0000                      ; device is initialized, no loading
000936                    CRTROM_CSR_ST_LDNG          .EQU 0x0001                      ; loading takes place
000937                    CRTROM_CSR_ST_ERR           .EQU 0x0002                      ; loading failed
000938                    CRTROM_CSR_ST_OK            .EQU 0x0003                      ; loading successful
000939                    
000940                    ; Device to QNICE: Parsing status
000941                    CRTROM_CSR_PT_IDLE          .EQU 0x0000                      ; parser is idle
000942                    CRTROM_CSR_PT_PRSNG         .EQU 0x0001                      ; parser is parsing
000943                    CRTROM_CSR_PT_OK            .EQU 0x0002                      ; parsing successful
000944                    CRTROM_CSR_PT_ERR           .EQU 0x0003                      ; parsing error

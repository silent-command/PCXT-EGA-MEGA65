000548                    
000549  8002  0FB0  0012  START                       MOVE 18, R12                     ; R12: sectors per track (R0..R7 are banked)
000550  8004  FFB0  0005                              RSUB TABLE, 1
000551  8006  0FB0  0009                              MOVE 9, R12
000552  8008  FFB0  0001                              RSUB TABLE, 1
000553  800A  E000                                    HALT
000554                    
000555                    ; print the conversion of every LBA 0 .. 160 * spt - 1
000556  800B  E0C0        TABLE                       INCRB
000557  800C  B000                                    XOR R0, R0                       ; R0: LBA
000558  800D  0C04                                    MOVE R12, R1                     ; R1: spt
000559  800E  0FA0  00A0                              MOVE 160, R8
000560  8010  0124                                    MOVE R1, R9
000561  8011  FF90  0028                              ASUB mulu, 1                     ; R10 = 160 * spt = LBA count
000562  8013  0A08                                    MOVE R10, R2
000563  8014  0120        _TABLE_1                    MOVE R1, R8
000564  8015  FF90  0026                              ASUB puthex, 1
000565  8017  0FA0  0020                              MOVE 0x0020, R8
000566  8019  FF90  0004                              ASUB putc, 1
000567  801B  0020                                    MOVE R0, R8
000568  801C  FF90  0026                              ASUB puthex, 1
000569  801E  0FA0  0020                              MOVE 0x0020, R8
000570  8020  FF90  0004                              ASUB putc, 1
000571  8022  0020                                    MOVE R0, R8
000572  8023  0124                                    MOVE R1, R9
000573  8024  FFB0  001B                              RSUB FLP_LBA2CHS, 1              ; R8 = C, R9 = H, R10 = R
000574  8026  090C                                    MOVE R9, R3
000575  8027  0A10                                    MOVE R10, R4
000576  8028  FF90  0026                              ASUB puthex, 1                   ; C
000577  802A  0FA0  0020                              MOVE 0x0020, R8
000578  802C  FF90  0004                              ASUB putc, 1
000579  802E  0320                                    MOVE R3, R8
000580  802F  FF90  0026                              ASUB puthex, 1                   ; H
000581  8031  0FA0  0020                              MOVE 0x0020, R8
000582  8033  FF90  0004                              ASUB putc, 1
000583  8035  0420                                    MOVE R4, R8
000584  8036  FF90  0026                              ASUB puthex, 1                   ; R
000585  8038  FF90  000A                              ASUB crlf, 1
000586  803A  1F80  0001                              ADD 1, R0
000587  803C  C200                                    CMP R2, R0
000588  803D  FFAB  FFD5                              RBRA _TABLE_1, !Z
000589  803F  E100                                    DECRB
000590  8040  0DBC                                    MOVE @R13++, R15
000591                    
000592                    ; ****************************************************************************
000593                    ; PCXT-EGA on MiSTer2MEGA65: internal floppy drive, pure arithmetic
000594                    ;
000595                    ; flpdrv_calc.asm: the LBA -> C/H/R conversion of the physical floppy path,
000596                    ; kept free of any hardware or shell dependency so that
000597                    ; tools/vdrive-latency-bench/flp_chs.asm can run exactly this code in the
000598                    ; QNICE emulator (docs/floppy.md, "Geometry").
000599                    ;
000600                    ; The FDC (CORE/rtl/overlay/floppy.v) turns the C/H/R DOS asked for into
000601                    ; LBA = (C * 2 + H) * SPT + R - 1
000602                    ; with the SPT it was told at mount time (18 for a 1.44 MB image, 9 for
000603                    ; 720 KB), and the inverse here must use that same SPT, never the rate the
000604                    ; engine happens to read at. Sectors are 1-based: LBA 0 = C0 H0 R1,
000605                    ; LBA 18 = C0 H1 R1 on 1.44 MB, LBA 36 = C1 H0 R1.
000606                    ;
000607                    ; done by silent-command in 2026 and licensed under GPL v3
000608                    ; ****************************************************************************
000609                    
000610                    ; FLP_LBA2CHS: R8 = LBA (0..2879), R9 = sectors per track (9 or 18)
000611                    ; Returns: R8 = cylinder, R9 = head, R10 = sector (1-based)
000612                    ; Division by repeated subtraction: at most 320 iterations, no EAE needed.
000613  8041  E0C0        FLP_LBA2CHS                 INCRB
000614  8042  0800                                    MOVE R8, R0                      ; R0: remainder
000615  8043  B104                                    XOR R1, R1                       ; R1: track = LBA / SPT
000616  8044  C900        _FLP_L2C_1                  CMP R9, R0                       ; SPT > remainder?
000617  8045  FFA4  0005                              RBRA _FLP_L2C_2, N               ; yes: division done
000618  8047  3900                                    SUB R9, R0
000619  8048  1F84  0001                              ADD 1, R1
000620  804A  FFA0  FFF8                              RBRA _FLP_L2C_1, 1
000621  804C  1F80  0001  _FLP_L2C_2                  ADD 1, R0                        ; R = remainder + 1
000622  804E  0028                                    MOVE R0, R10
000623  804F  0124                                    MOVE R1, R9
000624  8050  9FA4  0001                              AND 0x0001, R9                   ; H = track mod 2
000625  8052  0120                                    MOVE R1, R8
000626  8053  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C (SHR shifts it in)
000627  8055  6FA0  0001                              SHR 1, R8                        ; C = track / 2
000628  8057  E100                                    DECRB
000629  8058  0DBC                                    MOVE @R13++, R15



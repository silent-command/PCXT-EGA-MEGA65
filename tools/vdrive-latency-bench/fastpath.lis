001316  81FF  FFB0  05E0                              RSUB SDB_SD2VD, 1
001317  8201  FFB0  0672                              RSUB SDB_VD_RDDONE, 1
001318  8203  0FA0  8973                              MOVE HANDLE_FILE2, R8            ; ..and the second handle must
001319  8205  0FA4  B200                              MOVE BUF_B, R9                   ; ..still read the same bytes
001320  8207  FFB0  0111                              RSUB FREAD512, 1
001321  8209  0FA0  B000                              MOVE BUF_A, R8
001322  820B  0FA4  B200                              MOVE BUF_B, R9

001227                    ; ============================================================================
001228                    ; Test 6: SDB_FREAD_FAST, the CRT/ROM loader path
001229                    ; 6a: a file that fits into one 4k window, all bytes are checked
001230                    ; 6b: a 16 KB file, so that the 4k window wrap is exercised; the last
001231                    ; window and the byte-wise tail are checked
001232                    ; ============================================================================
001233  8180  0FA0  8BA1                              MOVE S_T6A, R8
001234  8182  FF90  0008                              ASUB puts, 1
001235  8184  0FA0  89B0                              MOVE F_SMALL, R8
001236  8186  0FA4  0664                              MOVE 1636, R9                    ; file size
001237  8188  FFB0  01F2                              RSUB CHKROM, 1
001238                    
001239  818A  0FA0  8BC4                              MOVE S_T6B, R8
001240  818C  FF90  0008                              ASUB puts, 1
001241  818E  0FA0  89A3                              MOVE F_TESTROM, R8
001242  8190  0FA4  412C                              MOVE 16684, R9                   ; file size
001243  8192  FFB0  01E8                              RSUB CHKROM, 1
001244                    
001245                                                ; A file that ends exactly on a cluster boundary. Seeking such
001246                                                ; a file to its very end walks one step past the last cluster,
001247                                                ; and FAT32$RW_SIC then issues a block read at a wild LBA,
001248                                                ; which latches the error state of the real SD controller.
001249                                                ; The fast path must stop one whole block short, so that the
001250                                                ; position it hands over is always strictly inside the file.
001251  8194  0FA0  8BE6                              MOVE S_T6C, R8
001252  8196  FF90  0008                              ASUB puts, 1
001253  8198  0FA0  89BB                              MOVE F_EXACT, R8
001254  819A  0FA4  8000                              MOVE 32768, R9                   ; exactly one 64 sector cluster
001255  819C  FFB0  01DE                              RSUB CHKROM, 1
001256                    
001257                    ; ============================================================================
001258                    ; Test 7: after a map build that gives up, the FAT32 library must be exactly
001259                    ; where it was. This is the property that broke on real hardware.
001260                    ; ============================================================================
001261  819E  0FA0  8C12                              MOVE S_T7, R8
001262  81A0  FF90  0008                              ASUB puts, 1
001263  81A2  0FA0  8997                              MOVE F_FRAG16, R8                ; twelve extents: always bails
001264  81A4  FFB0  008C                              RSUB OPEN, 1
001265  81A6  0FA0  8967                              MOVE HANDLE_FILE, R8             ; reference: read 512 bytes
001266  81A8  0FA4  B000                              MOVE BUF_A, R9                   ; ..before doing anything
001267  81AA  FFB0  016E                              RSUB FREAD512, 1
001268  81AC  0FA0  8967                              MOVE HANDLE_FILE, R8
001269  81AE  B924                                    XOR R9, R9
001270  81AF  BA28                                    XOR R10, R10
001271  81B0  FF90  0054                              ASUB f32_fseek, 1
001272  81B2  0FA0  8967                              MOVE HANDLE_FILE, R8             ; now let the map build run
001273  81B4  0FA4  8D2B                              MOVE SDB_RM_MAP, R9              ; ..and give up half way
001274  81B6  FFB0  0482                              RSUB SDB_MAP_BUILD, 1
001275  81B8  0FA0  8967                              MOVE HANDLE_FILE, R8             ; the very next library read
001276  81BA  0FA4  B200                              MOVE BUF_B, R9                   ; ..must still be correct
001277  81BC  FFB0  015C                              RSUB FREAD512, 1
001278  81BE  0FA0  B000                              MOVE BUF_A, R8
001279  81C0  0FA4  B200                              MOVE BUF_B, R9
001280  81C2  FFB0  016B                              RSUB CMP512, 1
001281  81C4  FFB0  028F                              RSUB VERDICT0, 1
001282                    
001283                                                ; the same for a vdrive block read that uses the fast path:
001284                                                ; it must not disturb a second, unrelated file handle
001285  81C6  0FA0  8C3D                              MOVE S_T7B, R8
001286  81C8  FF90  0008                              ASUB puts, 1
001287  81CA  0FA0  897F                              MOVE F_FREEDOS, R8
001288  81CC  FFB0  0064                              RSUB OPEN, 1
001289  81CE  0FA0  8967                              MOVE HANDLE_FILE, R8

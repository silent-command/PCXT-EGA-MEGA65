002628                    ; SDB_FAT_NEXT
002629                    ; Reads the FAT32 chain successor of a cluster. Uses a one entry cache for
002630                    ; the FAT sector, so a run of consecutive clusters costs one SD card block
002631                    ; read per 128 clusters. Expects SDB_GUARD_IN to have been called.
002632                    ;
002633                    ; Input: R8: device handle
002634                    ; R9/R10: cluster lo/hi
002635                    ; Output: Carry=1: R9/R10 = successor cluster lo/hi (28 bit)
002636                    ; Carry=0: the FAT sector could not be read
002637                    ; R8 unchanged
002638  876C  E0C0        SDB_FAT_NEXT                INCRB
002639  876D  0800                                    MOVE R8, R0                      ; R0: device handle
002640  876E  0904                                    MOVE R9, R1                      ; R1: byte offset in sector
002641  876F  9F84  007F                              AND 0x007F, R1                   ; 128 FAT entries per sector
002642  8771  9FB8  FFFD                              AND 0xFFFD, R14                  ; clear X
002643  8773  5F84  0002                              SHL 2, R1                        ; 4 bytes per entry
002644                    
002645                                                ; FAT sector number = cluster / 128
002646  8775  0A08                                    MOVE R10, R2
002647  8776  9F88  007F                              AND 0x007F, R2
002648  8778  9FB8  FFFD                              AND 0xFFFD, R14
002649  877A  5F88  0009                              SHL 9, R2
002650  877C  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C
002651  877E  6FA4  0007                              SHR 7, R9
002652  8780  1224                                    ADD R2, R9
002653  8781  9FB8  FFFB                              AND 0xFFFB, R14
002654  8783  6FA8  0007                              SHR 7, R10
002655                    
002656  8785  0008                                    MOVE R0, R2                      ; plus the FAT start LBA
002657  8786  1F88  0008                              ADD FAT32$DEV_FAT_LO, R2
002658  8788  028C                                    MOVE @R2++, R3
002659  8789  0248                                    MOVE @R2, R2
002660  878A  1324                                    ADD R3, R9
002661  878B  2228                                    ADDC R2, R10
002662  878C  FFA2  004E                              RBRA _SDB_FN_ERR, C              ; 32-bit overflow
002663                    
002664                                                ; is this sector already in the hardware buffer?
002665  878E  0F88  8D71                              MOVE SDB_S_FCVAL, R2
002666  8790  CF89  0000                              CMP 0, @R2
002667  8792  FFA3  000A                              RBRA _SDB_FN_RD, Z
002668  8794  0F88  8D6F                              MOVE SDB_S_FCLBA, R2
002669  8796  C264                                    CMP @R2, R9
002670  8797  FFAB  0005                              RBRA _SDB_FN_RD, !Z
002671  8799  1F88  0001                              ADD 1, R2
002672  879B  C268                                    CMP @R2, R10
002673  879C  FFA3  0016                              RBRA _SDB_FN_BUF, Z
002674                    
002675  879E  0F88  8D71  _SDB_FN_RD                  MOVE SDB_S_FCVAL, R2             ; cache is stale in any case
002676  87A0  0F89  0000                              MOVE 0, @R2
002677  87A2  0908                                    MOVE R9, R2                      ; R2/R3: remember the LBA
002678  87A3  0A0C                                    MOVE R10, R3
002679  87A4  0220                                    MOVE R2, R8
002680  87A5  0324                                    MOVE R3, R9
002681  87A6  FF90  003C                              ASUB sd_r_block, 1
002682  87A8  CFA0  0000                              CMP 0, R8
002683  87AA  FFAB  002E                              RBRA _SDB_FN_SDE, !Z
002684  87AC  0FA0  8D6F                              MOVE SDB_S_FCLBA, R8
002685  87AE  0222                                    MOVE R2, @R8++
002686  87AF  0321                                    MOVE R3, @R8
002687  87B0  0FA0  8D71                              MOVE SDB_S_FCVAL, R8
002688  87B2  0FA1  0001                              MOVE 1, @R8
002689                    
002690                                                ; read the 32-bit little-endian FAT entry. Keep one
002691                                                ; instruction between writing IO$SD_DATA_POS and reading
002692                                                ; IO$SD_DATA, exactly like SD$READ_BYTE does: the buffer is a
002693                                                ; block RAM whose output is registered (see byte_bram.vhd).
002694  87B4  0F88  FF22  _SDB_FN_BUF                 MOVE IO$SD_DATA_POS, R2
002695  87B6  0F8C  FF23                              MOVE IO$SD_DATA, R3
002696  87B8  0110                                    MOVE R1, R4                      ; R4: walking byte offset
002697  87B9  0409                                    MOVE R4, @R2
002698  87BA  1F90  0001                              ADD 1, R4                        ; spacing, and the next offset
002699  87BC  0364                                    MOVE @R3, R9                     ; byte 0
002700  87BD  0409                                    MOVE R4, @R2
002701  87BE  1F90  0001                              ADD 1, R4
002702  87C0  0354                                    MOVE @R3, R5                     ; byte 1
002703  87C1  9FB8  FFFD                              AND 0xFFFD, R14
002704  87C3  5F94  0008                              SHL 8, R5
002705  87C5  1524                                    ADD R5, R9
002706  87C6  0409                                    MOVE R4, @R2
002707  87C7  1F90  0001                              ADD 1, R4
002708  87C9  0368                                    MOVE @R3, R10                    ; byte 2
002709  87CA  0409                                    MOVE R4, @R2
002710  87CB  1F90  0001                              ADD 1, R4
002711  87CD  0354                                    MOVE @R3, R5                     ; byte 3
002712  87CE  9FB8  FFFD                              AND 0xFFFD, R14
002713  87D0  5F94  0008                              SHL 8, R5
002714  87D2  1528                                    ADD R5, R10
002715  87D3  9FA8  0FFF                              AND 0x0FFF, R10                  ; FAT32 entries are 28 bit
002716  87D5  0020                                    MOVE R0, R8
002717  87D6  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002718  87D8  FFA0  0005                              RBRA _SDB_FN_RET, 1
002719                    
002720  87DA  FFB0  FCEA  _SDB_FN_SDE                 RSUB SDB_SDERR, 1
002721  87DC  0020        _SDB_FN_ERR                 MOVE R0, R8
002722  87DD  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002723  87DF  E100        _SDB_FN_RET                 DECRB
002724  87E0  0DBC                                    MOVE @R13++, R15

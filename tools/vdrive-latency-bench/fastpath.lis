001297  81DD  0FA0  8973                              MOVE HANDLE_FILE2, R8
001298  81DF  0FA4  2600                              MOVE 0x2600, R9                  ; byte 9728, inside extent 1
001299  81E1  BA28                                    XOR R10, R10
001300  81E2  FF90  0054                              ASUB f32_fseek, 1
001301  81E4  0FA0  8973                              MOVE HANDLE_FILE2, R8            ; reference bytes
001302  81E6  0FA4  B000                              MOVE BUF_A, R9
001303  81E8  FFB0  0130                              RSUB FREAD512, 1
001304  81EA  0FA0  8973                              MOVE HANDLE_FILE2, R8
001305  81EC  0FA4  2600                              MOVE 0x2600, R9
001306  81EE  BA28                                    XOR R10, R10
001307  81EF  FF90  0054                              ASUB f32_fseek, 1
001308  81F1  B820                                    XOR R8, R8                       ; a fast vdrive block read in
001309  81F2  0FA4  8967                              MOVE HANDLE_FILE, R9             ; ..between, on the other file
001310  81F4  0FA8  0000                              MOVE 0x0000, R10
001311  81F6  0FAC  0002                              MOVE 0x0002, R11                 ; byte 131072 of freedos.vhd
001312  81F8  0FB0  0200                              MOVE 0x0200, R12
001313  81FA  FFB0  064F                              RSUB SDB_VD_RDBLK, 1
001314  81FC  FFAA  0015                              RBRA _T7B_NO, !C

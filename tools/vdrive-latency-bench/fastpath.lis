001784                    
001785                    ; ============================================================================
001786                    ; ****************************************************************************
001787                    ; MiSTer2MEGA65 (M2M) QNICE ROM
001788                    ;
001789                    ; sdblock.asm: direct 512-byte block access to files on the SD card
001790                    ;
001791                    ; The FAT32 library of the QNICE Monitor only offers a byte-wise API
001792                    ; (f32_fread / f32_fwrite). Every single byte revalidates the cluster and the
001793                    ; sector of the file handle, which costs about 107 instructions per byte, and
001794                    ; f32_fseek walks the cluster chain from the start of the file, which makes a
001795                    ; random access at the far end of a 42 MB image cost seconds.
001796                    ;
001797                    ; This module resolves the on-disk layout of a file *once* into a compact
001798                    ; extent table and can then map "block N of the file" to an absolute SD card
001799                    ; LBA. A block is then one SD$READ_BLOCK plus a tight copy loop out of the
001800                    ; 512-byte buffer of the SD controller.
001801                    ;
001802                    ; ----------------------------------------------------------------------------
001803                    ; THE TWO RULES
001804                    ; ----------------------------------------------------------------------------
001805                    ;
001806                    ; (1) The FAT32 library must never be able to tell that we were here.
001807                    ;
001808                    ; The 512-byte "sector buffer" of the FAT32 library IS the 512-byte
001809                    ; hardware buffer of the SD controller; the device handle only remembers
001810                    ; *which* file handle filled it (FAT32$DEV_BUFFERED_FDH). Every direct
001811                    ; access destroys the library's buffer while the library still believes
001812                    ; it holds a particular sector.
001813                    ;
001814                    ; Earlier versions of this file solved that by pointing
001815                    ; FAT32$DEV_BUFFERED_FDH at a dummy handle, i.e. by reaching into the
001816                    ; library's bookkeeping. That is not done any more. Instead:
001817                    ;
001818                    ; * SDB_GUARD_IN works out, *before* anything is touched, which sector
001819                    ; the library believes is in the buffer and whether that sector can
001820                    ; be read back. If it cannot, the fast path is refused and nothing
001821                    ; is touched at all.
001822                    ; * a dirty buffer is written back through the library first.
001823                    ; * SDB_GUARD_OUT reads that very sector back, so the buffer holds
001824                    ; exactly what it held before.
001825                    ; * SDB_FREAD_FAST, which moves the file position anyway, restores the
001826                    ; library state the library's own way: with an f32_fseek, which
001827                    ; unconditionally re-reads the sector and re-claims ownership.
001828                    ;
001829                    ; The one remaining poke, SDB_ORPHAN, exists only for the case where the
001830                    ; restoring read itself fails, i.e. where the card is already broken. It
001831                    ; is strictly better than leaving the library with a buffer that holds
001832                    ; something else than it thinks.
001833                    ;
001834                    ; (2) Any error anywhere leaves the caller with "nothing happened".
001835                    ;
001836                    ; Every entry point returns Carry=0 on any problem, and the byte-wise
001837                    ; FAT32 path then does all of the work exactly as it did before this
001838                    ; file existed. In particular:
001839                    ;
001840                    ; * an SD card error latches the controller into its error state (see
001841                    ; the IO$SD_CSR description in sysdef.asm: "you need to reset the
001842                    ; controller to go on"), which would make every *subsequent* library
001843                    ; access fail too. SDB_SDERR therefore issues SD$RESET after any
001844                    ; failed SD operation before we hand back control.
001845                    ; * SDB_FREAD_FAST never seeks to the end of the file. It always leaves
001846                    ; at least one whole block to the byte loop, so the file position it
001847                    ; hands over is strictly inside the file and the caller reaches EOF
001848                    ; through the library, the way it always did.
001849                    ; * every seek is verified against FAT32$FDH_ACCESS afterwards.
001850                    ;
001851                    ; ----------------------------------------------------------------------------
001852                    ; Serial logging
001853                    ; ----------------------------------------------------------------------------
001854                    ; To log what the fast path does to the serial console at boot (no keyboard
001855                    ; needed), remove the ";" in front of the #define below and rebuild the ROM
001856                    ; with CORE/m2m-rom/make_rom.sh. Put the ";" back to switch it off again.
001857                    ;
001858                    ;#define SDB_DEBUG
001859                    ;
001860                    ; This file needs the environment of shell.asm.
001861                    ;
001862                    ; done for the PCXT-EGA-MEGA65 port and licensed under GPL v3
001863                    ; ****************************************************************************
001864                    
001865                    ; ----------------------------------------------------------------------------
001866                    ; Layout of a block map (see SDB_VD_MAPS / SDB_RM_MAP in shell_vars.asm)
001867                    ; ----------------------------------------------------------------------------
001868                    
001869                    ; Maximum amount of extents (runs of physically consecutive clusters) that we
001870                    ; are willing to remember for one file. A freshly copied image file normally
001871                    ; is one single extent. Files that would need more extents than this fall
001872                    ; back to the FAT32 library path.
001873                    SDB_MAX_EXT                 .EQU 8
001874                    
001875                    SDB_M_NEXT                  .EQU 0                           ; amount of valid extents; 0 = no map
001876                    SDB_M_FDH                   .EQU 1                           ; FDH this map was built for
001877                    SDB_M_TBLK_LO               .EQU 2                           ; amount of *whole* 512-byte blocks..
001878                    SDB_M_TBLK_HI               .EQU 3                           ; ..in the file (filesize / 512)
001879                    SDB_M_BAIL                  .EQU 4                           ; why there is no map (SDB_B_*)
001880                    SDB_M_EXT                   .EQU 5                           ; start of the extent array
001881                    
001882                    ; one extent: amount of blocks (lo/hi) and the absolute SD card LBA (lo/hi)
001883                    ; of the first of them
001884                    SDB_E_NBLK_LO               .EQU 0
001885                    SDB_E_NBLK_HI               .EQU 1
001886                    SDB_E_LBA_LO                .EQU 2
001887                    SDB_E_LBA_HI                .EQU 3
001888                    SDB_E_SIZE                  .EQU 4
001889                    
001890                    ; size of one map in words: SDB_M_EXT + SDB_E_SIZE * SDB_MAX_EXT = 5 + 4*8
001891                    ; = 37, rounded up to 40 to leave room
001892                    SDB_M_SIZE                  .EQU 40
001893                    
001894                    ; Amount of virtual drives that SDB_VD_MAPS in shell_vars.asm has room for.
001895                    ; The QNICE assembler cannot evaluate expressions in .BLOCK, so the size of
001896                    ; SDB_VD_MAPS is the literal SDB_M_SIZE * SDB_VD_MAX_N and both have to be
001897                    ; kept in sync by hand. Virtual drives beyond SDB_VD_MAX_N are not broken,
001898                    ; they just always use the (slow) FAT32 library path.
001899                    SDB_VD_MAX_N                .EQU 3
001900                    
001901                    ; Why a map could not be built. Logged, and also readable from SDB_M_BAIL.
001902                    SDB_B_OK                    .EQU 0
001903                    SDB_B_NOMAP                 .EQU 1                           ; no map slot for this drive
001904                    SDB_B_NODEV                 .EQU 2                           ; file handle has no device handle
001905                    SDB_B_NOSPC                 .EQU 3                           ; sectors per cluster is zero
001906                    SDB_B_EMPTY                 .EQU 4                           ; file is shorter than one block
001907                    SDB_B_BADSTART              .EQU 5                           ; start cluster < 2
001908                    SDB_B_FRAG                  .EQU 6                           ; more extents than SDB_MAX_EXT
001909                    SDB_B_FATERR                .EQU 7                           ; could not read a FAT sector
001910                    SDB_B_BADCLUS               .EQU 8                           ; illegal cluster in the chain
001911                    SDB_B_SHORT                 .EQU 9                           ; chain ends before the file does
001912                    SDB_B_LBA                   .EQU 10                          ; LBA arithmetic out of range
001913                    SDB_B_GUARD                 .EQU 11                          ; buffer could not be made restorable
001914                    SDB_B_SEEK                  .EQU 12                          ; restoring seek failed
001915                    
001916                    ; end-of-chain marker: everything >= 0x0FFFFFF8 terminates a FAT32 chain,
001917                    ; and everything >= 0x0FFFFFF0 is reserved, so refuse all of it
001918                    SDB_EOC_HI                  .EQU 0x0FFF
001919                    SDB_EOC_LO                  .EQU 0xFFF0
001920                    
001921                    ; ----------------------------------------------------------------------------
001922                    ; Housekeeping
001923                    ; ----------------------------------------------------------------------------
001924                    
001925                    ; SDB_INVAL_ALL
001926                    ; Invalidates all block maps, i.e. everything falls back to the FAT32 library
001927                    ; until the maps are rebuilt. Called from VD_INIT and whenever the SD card
001928                    ; changes. Also clears the two zero-filled helper structures, because the
001929                    ; variables live in uninitialized RAM.
001930                    ;
001931                    ; Input: none
001932                    ; Output: none, all registers unchanged
001933  8475  E0C0        SDB_INVAL_ALL               INCRB
001934  8476  0F80  8CB3                              MOVE SDB_VD_MAPS, R0
001935  8478  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001936  847A  0F81  0000  _SDBIA_L                    MOVE 0, @R0
001937  847C  1F80  0028                              ADD SDB_M_SIZE, R0
001938  847E  3F84  0001                              SUB 1, R1
001939  8480  FFAB  FFF8                              RBRA _SDBIA_L, !Z
001940  8482  0F80  8D2B                              MOVE SDB_RM_MAP, R0
001941  8484  0F81  0000                              MOVE 0, @R0
001942  8486  0F80  8D53                              MOVE SDB_NULL_MAP, R0
001943  8488  0F81  0000                              MOVE 0, @R0
001944  848A  0F80  8D62                              MOVE SDB_G_VAL, R0
001945  848C  0F81  0000                              MOVE 0, @R0
001946                    
001947                                                ; SDB_DUMMY_FDH must read as an all-zero, and therefore never
001948                                                ; dirty, file handle: SDB_ORPHAN hands it to FAT32$FLUSH
001949  848E  0F80  8D54                              MOVE SDB_DUMMY_FDH, R0
001950  8490  0F84  000C                              MOVE FAT32$FDH_STRUCT_SIZE, R1
001951  8492  0F82  0000  _SDBIA_L2                   MOVE 0, @R0++
001952  8494  3F84  0001                              SUB 1, R1
001953  8496  FFAB  FFFA                              RBRA _SDBIA_L2, !Z
001954  8498  E100                                    DECRB
001955  8499  0DBC                                    MOVE @R13++, R15
001956                    
001957                    ; SDB_VDMAP
001958                    ; Returns the block map that belongs to a virtual drive. Drives that have no
001959                    ; map (see SDB_VD_MAX_N) get the permanently empty SDB_NULL_MAP, which makes
001960                    ; SDB_CHECK fail and therefore forces the FAT32 library path.
001961                    ;
001962                    ; Input: R8: virtual drive number
001963                    ; Output: R8: pointer to the block map
001964  849A  E0C0        SDB_VDMAP                   INCRB
001965  849B  0800                                    MOVE R8, R0
001966  849C  0F84  0003                              MOVE SDB_VD_MAX_N, R1
001967  849E  C100                                    CMP R1, R0                       ; drive number < maximum?
001968  849F  FFA4  0004                              RBRA _SDBVM_OK, N                ; yes
001969  84A1  0FA0  8D53                              MOVE SDB_NULL_MAP, R8            ; no: never mapped
001970  84A3  FFA0  000C                              RBRA _SDBVM_D, 1
001971  84A5  0FA0  8CB3  _SDBVM_OK                   MOVE SDB_VD_MAPS, R8
001972  84A7  CF80  0000  _SDBVM_L                    CMP 0, R0
001973  84A9  FFA3  0006                              RBRA _SDBVM_D, Z
001974  84AB  1FA0  0028                              ADD SDB_M_SIZE, R8
001975  84AD  3F80  0001                              SUB 1, R0
001976  84AF  FFA0  FFF6                              RBRA _SDBVM_L, 1
001977  84B1  E100        _SDBVM_D                    DECRB
001978  84B2  0DBC                                    MOVE @R13++, R15
001979                    
001980                    ; SDB_CHECK
001981                    ; Is the given map valid and does it belong to the given file handle?
001982                    ;
001983                    ; Input: R8: pointer to the block map
001984                    ; R9: file handle (FDH)
001985                    ; Output: Carry=1 if the map can be used, all registers unchanged
001986  84B3  E0C0        SDB_CHECK                   INCRB
001987  84B4  CFA1  0000                              CMP 0, @R8                       ; any extents?
001988  84B6  FFA3  000A                              RBRA _SDBC_NO, Z                 ; no: unusable
001989  84B8  0800                                    MOVE R8, R0
001990  84B9  1F80  0001                              ADD SDB_M_FDH, R0
001991  84BB  C064                                    CMP @R0, R9                      ; built for this file handle?
001992  84BC  FFAB  0004                              RBRA _SDBC_NO, !Z                ; no: unusable
001993  84BE  AFB8  0004                              OR 0x0004, R14                   ; set Carry
001994  84C0  FFA0  0002                              RBRA _SDBC_R, 1
001995  84C2  9FB8  FFFB  _SDBC_NO                    AND 0xFFFB, R14                  ; clear Carry
001996  84C4  E100        _SDBC_R                     DECRB
001997  84C5  0DBC                                    MOVE @R13++, R15
001998                    
001999                    ; SDB_SDERR
002000                    ; Called after a failed SD card operation. The controller latches its error
002001                    ; state and refuses everything until it is reset, which would turn our
002002                    ; problem into a fatal error in the *next* FAT32 library call. Reset it, so
002003                    ; that the fallback path starts from a clean controller.
002004                    ;
002005                    ; Input: R8: the error code (only used for logging)
002006                    ; Output: none, R8 unchanged
002007  84C6  E0C0        SDB_SDERR                   INCRB
002008  84C7  0800                                    MOVE R8, R0
002009                    
002010                    
002011                    
002012                    
002013                    
002014                    
002015                    
002016  84C8  FF90  003A                              ASUB sd_reset, 1
002017  84CA  0020                                    MOVE R0, R8
002018  84CB  E100                                    DECRB
002019  84CC  0DBC                                    MOVE @R13++, R15
002020                    
002021                    ; ----------------------------------------------------------------------------
002022                    ; Guarding the FAT32 library's sector buffer
002023                    ; ----------------------------------------------------------------------------
002024                    
002025                    ; SDB_GUARD_IN
002026                    ; Prepares for direct SD card access. Works out which sector the FAT32
002027                    ; library believes the hardware buffer holds and remembers its LBA so that
002028                    ; SDB_GUARD_OUT can put it back, and writes the buffer back first if it is
002029                    ; dirty. Refuses (Carry=0) without touching anything if the sector cannot be
002030                    ; identified or the write-back fails.
002031                    ;
002032                    ; Input: none
002033                    ; Output: Carry=1: direct access is allowed
002034                    ; Carry=0: do not touch the SD card, nothing has been touched
002035                    ; all registers unchanged
002036  84CD  FF90  005E  SDB_GUARD_IN                ASUB enter, 1
002037                    
002038  84CF  0FA0  8D62                              MOVE SDB_G_VAL, R8               ; nothing to restore yet
002039  84D1  0FA1  0000                              MOVE 0, @R8
002040                    
002041  84D3  0FA0  8C8E                              MOVE HANDLE_DEV, R8              ; who claims the buffer?
002042  84D5  FFB0  003D                              RSUB _SDB_OWNER, 1
002043  84D7  FFA2  0008                              RBRA _SDBGI_HAVE, C
002044  84D9  0FA0  8CA0                              MOVE CONFIG_DEVH, R8
002045  84DB  FFB0  0037                              RSUB _SDB_OWNER, 1
002046  84DD  FFA2  0002                              RBRA _SDBGI_HAVE, C
002047  84DF  FFA0  002A                              RBRA _SDBGI_OK, 1                ; nobody: nothing to restore
002048                    
002049                                                ; R8: device handle, R9: owning FDH
002050  84E1  0800        _SDBGI_HAVE                 MOVE R8, R0
002051  84E2  0904                                    MOVE R9, R1
002052                    
002053  84E3  0120                                    MOVE R1, R8                      ; dirty? then write it back
002054  84E4  1FA0  000B                              ADD FAT32$FDH_FLAGS, R8
002055  84E6  0860                                    MOVE @R8, R8
002056  84E7  9FA0  0001                              AND FAT32$FDHF_DIRTY, R8
002057  84E9  FFA3  0007                              RBRA _SDBGI_CLEAN, Z
002058  84EB  0120                                    MOVE R1, R8
002059  84EC  FF90  0068                              ASUB f32_fflush, 1
002060  84EE  CFA4  0000                              CMP 0, R9
002061  84F0  FFAB  001D                              RBRA _SDBGI_NO, !Z               ; cannot write back: refuse
002062                    
002063                                                ; which sector does the library think it is holding?
002064  84F2  0120        _SDBGI_CLEAN                MOVE R1, R8
002065  84F3  1FA0  0001                              ADD FAT32$FDH_CLUSTER_LO, R8
002066  84F5  0864                                    MOVE @R8, R9
002067  84F6  0120                                    MOVE R1, R8
002068  84F7  1FA0  0002                              ADD FAT32$FDH_CLUSTER_HI, R8
002069  84F9  0868                                    MOVE @R8, R10
002070  84FA  0120                                    MOVE R1, R8
002071  84FB  1FA0  0003                              ADD FAT32$FDH_SECTOR, R8
002072  84FD  086C                                    MOVE @R8, R11
002073  84FE  0020                                    MOVE R0, R8
002074  84FF  FFB0  0089                              RSUB SDB_CLULBA, 1
002075  8501  FFAA  000C                              RBRA _SDBGI_NO, !C               ; cannot be restored: refuse
002076                    
002077  8503  0FA0  8D60                              MOVE SDB_G_LBA, R8
002078  8505  0922                                    MOVE R9, @R8++
002079  8506  0A21                                    MOVE R10, @R8
002080  8507  0FA0  8D62                              MOVE SDB_G_VAL, R8
002081  8509  0FA1  0001                              MOVE 1, @R8
002082                    
002083  850B  AFB8  0004  _SDBGI_OK                   OR 0x0004, R14                   ; set Carry
002084  850D  FFA0  0002                              RBRA _SDBGI_RET, 1
002085  850F  9FB8  FFFB  _SDBGI_NO                   AND 0xFFFB, R14                  ; clear Carry
002086  8511  FF90  0060  _SDBGI_RET                  ASUB leave, 1
002087  8513  0DBC                                    MOVE @R13++, R15
002088                    
002089                    ; Input: R8: device handle
002090                    ; Output: Carry=1 and R9 = the FDH that claims the buffer, R8 unchanged
002091  8514  E0C0        _SDB_OWNER                  INCRB
002092  8515  CFA1  0000                              CMP 0, @R8                       ; device handle initialized?
002093  8517  FFA3  000A                              RBRA _SDB_OWN_NO, Z
002094  8519  0800                                    MOVE R8, R0
002095  851A  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
002096  851C  0064                                    MOVE @R0, R9
002097  851D  FFA3  0004                              RBRA _SDB_OWN_NO, Z              ; nobody claims it
002098  851F  AFB8  0004                              OR 0x0004, R14
002099  8521  FFA0  0002                              RBRA _SDB_OWN_R, 1
002100  8523  9FB8  FFFB  _SDB_OWN_NO                 AND 0xFFFB, R14
002101  8525  E100        _SDB_OWN_R                  DECRB
002102  8526  0DBC                                    MOVE @R13++, R15
002103                    
002104                    ; SDB_GUARD_OUT
002105                    ; Puts the hardware buffer back to the sector SDB_GUARD_IN identified, so
002106                    ; that the FAT32 library finds exactly what it left behind.
002107                    ;
002108                    ; Input: none
002109                    ; Output: none, all registers unchanged
002110  8527  FF90  005E  SDB_GUARD_OUT               ASUB enter, 1
002111  8529  0FA0  8D62                              MOVE SDB_G_VAL, R8
002112  852B  CFA1  0000                              CMP 0, @R8
002113  852D  FFA3  0018                              RBRA _SDBGO_RET, Z               ; nothing to restore
002114                    
002115  852F  0FA0  8D60                              MOVE SDB_G_LBA, R8
002116  8531  08A8                                    MOVE @R8++, R10
002117  8532  086C                                    MOVE @R8, R11
002118  8533  0A20                                    MOVE R10, R8
002119  8534  0B24                                    MOVE R11, R9
002120  8535  FF90  003C                              ASUB sd_r_block, 1
002121  8537  CFA0  0000                              CMP 0, R8
002122  8539  FFA3  000C                              RBRA _SDBGO_RET, Z               ; restored
002123                    
002124                                                ; the restoring read failed, so the card is already broken.
002125                                                ; Reset the controller, try once more, and if that fails too
002126                                                ; make sure the library re-reads instead of trusting a buffer
002127                                                ; that now holds something else than it believes.
002128  853B  FFB0  FF89                              RSUB SDB_SDERR, 1
002129  853D  0A20                                    MOVE R10, R8
002130  853E  0B24                                    MOVE R11, R9
002131  853F  FF90  003C                              ASUB sd_r_block, 1
002132  8541  CFA0  0000                              CMP 0, R8
002133  8543  FFA3  0002                              RBRA _SDBGO_RET, Z
002134  8545  FFB0  0003                              RSUB SDB_ORPHAN, 1
002135  8547  FF90  0060  _SDBGO_RET                  ASUB leave, 1
002136  8549  0DBC                                    MOVE @R13++, R15
002137                    
002138                    ; SDB_ORPHAN
002139                    ; Last resort, only used when the hardware buffer could not be restored: tell
002140                    ; both device handles that the buffer contents are unknown, so that the
002141                    ; library re-reads rather than serving something stale.
002142                    ;
002143                    ; "Unknown" is expressed by handing the buffer to SDB_DUMMY_FDH, an all-zero
002144                    ; and therefore never dirty file handle, and not by the obvious 0: FAT32$FLUSH
002145                    ; returns immediately when called with R8 = 0 and then leaves R9 - its error
002146                    ; code - untouched, and FAT32$FILE_SEEK checks that stale R9 right after
002147                    ; calling it, so a seek would silently do nothing.
002148                    ;
002149                    ; Input: none
002150                    ; Output: none, all registers unchanged
002151  854A  FF90  005E  SDB_ORPHAN                  ASUB enter, 1
002152                    
002153                    
002154                    
002155                    
002156                    
002157  854C  0FA0  8C8E                              MOVE HANDLE_DEV, R8
002158  854E  FFB0  0007                              RSUB _SDB_ORPH1, 1
002159  8550  0FA0  8CA0                              MOVE CONFIG_DEVH, R8
002160  8552  FFB0  0003                              RSUB _SDB_ORPH1, 1
002161  8554  FF90  0060                              ASUB leave, 1
002162  8556  0DBC                                    MOVE @R13++, R15
002163                    
002164  8557  E0C0        _SDB_ORPH1                  INCRB
002165  8558  0804                                    MOVE R8, R1
002166  8559  CFA1  0000                              CMP 0, @R8
002167  855B  FFA3  0006                              RBRA _SDB_ORPH_R, Z
002168  855D  0800                                    MOVE R8, R0
002169  855E  1F80  0011                              ADD FAT32$DEV_BUFFERED_FDH, R0
002170  8560  0F88  8D54                              MOVE SDB_DUMMY_FDH, R2
002171  8562  0201                                    MOVE R2, @R0
002172  8563  0120        _SDB_ORPH_R                 MOVE R1, R8
002173  8564  E100                                    DECRB
002174  8565  0DBC                                    MOVE @R13++, R15
002175                    
002176                    ; ----------------------------------------------------------------------------
002177                    ; 32-bit helpers
002178                    ; ----------------------------------------------------------------------------
002179                    
002180                    ; SDB_B2BLK
002181                    ; Converts a byte position into a 512-byte block index (unsigned 32 bit).
002182                    ;
002183                    ; Input: R9/R10: byte position lo/hi
002184                    ; Output: R9/R10: block index lo/hi
002185  8566  E0C0        SDB_B2BLK                   INCRB
002186  8567  0A00                                    MOVE R10, R0
002187  8568  9F80  01FF                              AND 0x01FF, R0                   ; bits that move down into..
002188  856A  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the low word; clear X so..
002189  856C  5F80  0007                              SHL 7, R0                        ; ..SHL shifts in zeros
002190  856E  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
002191  8570  6FA4  0009                              SHR 9, R9
002192  8572  1024                                    ADD R0, R9
002193  8573  9FB8  FFFB                              AND 0xFFFB, R14
002194  8575  6FA8  0009                              SHR 9, R10
002195  8577  E100                                    DECRB
002196  8578  0DBC                                    MOVE @R13++, R15
002197                    
002198                    ; SDB_BLK2B
002199                    ; Converts a 512-byte block index into a byte position (unsigned 32 bit).
002200                    ;
002201                    ; Input: R9/R10: block index lo/hi
002202                    ; Output: R9/R10: byte position lo/hi
002203  8579  E0C0        SDB_BLK2B                   INCRB
002204  857A  0900                                    MOVE R9, R0
002205  857B  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear C so SHR shifts in 0
002206  857D  6F80  0007                              SHR 7, R0                        ; bits that move up into..
002207  857F  9FB8  FFFD                              AND 0xFFFD, R14                  ; ..the high word; clear X
002208  8581  5FA8  0009                              SHL 9, R10
002209  8583  1028                                    ADD R0, R10
002210  8584  9FB8  FFFD                              AND 0xFFFD, R14
002211  8586  5FA4  0009                              SHL 9, R9
002212  8588  E100                                    DECRB
002213  8589  0DBC                                    MOVE @R13++, R15
002214                    
002215                    ; SDB_CLULBA
002216                    ; The absolute SD card LBA of one sector within one cluster, i.e. exactly
002217                    ; what FAT32$RW_SIC computes, with every range check spelled out.
002218                    ;
002219                    ; Input: R8: device handle
002220                    ; R9/R10: cluster lo/hi
002221                    ; R11: sector within the cluster
002222                    ; Output: Carry=1: R9/R10 = LBA lo/hi
002223                    ; Carry=0: the cluster or the sector is out of range
002224                    ; R8, R11 unchanged
002225  858A  E0C0        SDB_CLULBA                  INCRB
002226  858B  0800                                    MOVE R8, R0                      ; R0: device handle
002227  858C  0B04                                    MOVE R11, R1                     ; R1: sector
002228                    
002229  858D  CFA8  0000                              CMP 0, R10                       ; cluster >= 2?
002230  858F  FFAB  0006                              RBRA _SDBCL_C1, !Z
002231  8591  CFA4  0001                              CMP 1, R9
002232  8593  FFA4  0044                              RBRA _SDBCL_NO, N                ; cluster = 0
002233  8595  FFA3  0042                              RBRA _SDBCL_NO, Z                ; cluster = 1
002234  8597  CFA8  0FFF  _SDBCL_C1                   CMP SDB_EOC_HI, R10              ; cluster < 0x0FFFFFF0?
002235  8599  FFAB  0006                              RBRA _SDBCL_C2, !Z
002236  859B  C93E  FFF0                              CMP R9, SDB_EOC_LO
002237  859D  FFA4  003A                              RBRA _SDBCL_NO, N
002238  859F  FFA3  0038                              RBRA _SDBCL_NO, Z
002239  85A1  CA3E  0FFF  _SDBCL_C2                   CMP R10, 0x0FFF                  ; and inside 28 bits at all?
002240  85A3  FFA4  0034                              RBRA _SDBCL_NO, N
002241                    
002242  85A5  0008                                    MOVE R0, R2                      ; R2: sectors per cluster
002243  85A6  1F88  000C                              ADD FAT32$DEV_SECT_PER_CLUS, R2
002244  85A8  0248                                    MOVE @R2, R2
002245  85A9  FFA3  002E                              RBRA _SDBCL_NO, Z
002246  85AB  020C                                    MOVE R2, R3
002247  85AC  3F8C  0001                              SUB 1, R3
002248  85AE  C10C                                    CMP R1, R3                       ; sector inside the cluster?
002249  85AF  FFA4  0028                              RBRA _SDBCL_NO, N
002250                    
002251  85B1  0920                                    MOVE R9, R8                      ; (cluster - 2) * spc
002252  85B2  0A24                                    MOVE R10, R9
002253  85B3  3FA0  0002                              SUB 2, R8
002254  85B5  4FA4  0000                              SUBC 0, R9
002255  85B7  0228                                    MOVE R2, R10
002256  85B8  BB2C                                    XOR R11, R11
002257  85B9  FF90  0032                              ASUB mulu32, 1                   ; R11|R10|R9|R8 = 64 bit
002258  85BB  CFA8  0000                              CMP 0, R10                       ; more than 32 bits?
002259  85BD  FFAB  001A                              RBRA _SDBCL_NO, !Z
002260  85BF  CFAC  0000                              CMP 0, R11
002261  85C1  FFAB  0016                              RBRA _SDBCL_NO, !Z
002262                    
002263  85C3  002C                                    MOVE R0, R11                     ; plus cluster_begin_lba
002264  85C4  1FAC  000A                              ADD FAT32$DEV_CLUSTER_LO, R11
002265  85C6  0BA8                                    MOVE @R11++, R10
002266  85C7  0B6C                                    MOVE @R11, R11
002267  85C8  1A20                                    ADD R10, R8
002268  85C9  2B24                                    ADDC R11, R9
002269  85CA  FFA2  000D                              RBRA _SDBCL_NO, C                ; 32-bit overflow
002270  85CC  1120                                    ADD R1, R8                       ; plus the sector
002271  85CD  2FA4  0000                              ADDC 0, R9
002272  85CF  FFA2  0008                              RBRA _SDBCL_NO, C
002273                    
002274  85D1  0928                                    MOVE R9, R10                     ; return the LBA in R9/R10
002275  85D2  0824                                    MOVE R8, R9
002276  85D3  0020                                    MOVE R0, R8
002277  85D4  012C                                    MOVE R1, R11
002278  85D5  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002279  85D7  FFA0  0004                              RBRA _SDBCL_RET, 1
002280  85D9  0020        _SDBCL_NO                   MOVE R0, R8
002281  85DA  012C                                    MOVE R1, R11
002282  85DB  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002283  85DD  E100        _SDBCL_RET                  DECRB
002284  85DE  0DBC                                    MOVE @R13++, R15
002285                    
002286                    ; SDB_LBA
002287                    ; Maps a block index within the file to an absolute SD card LBA.
002288                    ;
002289                    ; Input: R8: pointer to the block map
002290                    ; R9/R10: block index lo/hi
002291                    ; Output: Carry=1: R9/R10 = LBA lo/hi
002292                    ; Carry=0: the block cannot be mapped (use the FAT32 library)
002293                    ; R8 unchanged
002294  85DF  E0C0        SDB_LBA                     INCRB
002295  85E0  0800                                    MOVE R8, R0                      ; R0: map
002296  85E1  0904                                    MOVE R9, R1                      ; R1/R2: remaining block idx
002297  85E2  0A08                                    MOVE R10, R2
002298  85E3  004C                                    MOVE @R0, R3                     ; R3: amount of extents
002299  85E4  FFA3  0037                              RBRA _SDBL_NO, Z
002300                    
002301                                                ; reject anything that is not completely inside the file
002302  85E6  0010                                    MOVE R0, R4
002303  85E7  1F90  0003                              ADD SDB_M_TBLK_HI, R4
002304  85E9  C211                                    CMP R2, @R4
002305  85EA  FFA4  0031                              RBRA _SDBL_NO, N                 ; idx_hi > total_hi
002306  85EC  FFAB  0008                              RBRA _SDBL_C1, !Z                ; idx_hi < total_hi: inside
002307  85EE  0010                                    MOVE R0, R4
002308  85EF  1F90  0002                              ADD SDB_M_TBLK_LO, R4
002309  85F1  C111                                    CMP R1, @R4
002310  85F2  FFA4  0029                              RBRA _SDBL_NO, N                 ; idx_lo > total_lo
002311  85F4  FFA3  0027                              RBRA _SDBL_NO, Z                 ; idx_lo = total_lo: outside
002312                    
002313  85F6  0010        _SDBL_C1                    MOVE R0, R4
002314  85F7  1F90  0005                              ADD SDB_M_EXT, R4                ; R4: current extent
002315  85F9  0454        _SDBL_LOOP                  MOVE @R4, R5                     ; R5/R6: blocks in extent
002316  85FA  0418                                    MOVE R4, R6
002317  85FB  1F98  0001                              ADD SDB_E_NBLK_HI, R6
002318  85FD  0658                                    MOVE @R6, R6
002319  85FE  C218                                    CMP R2, R6                       ; remainder < extent size?
002320  85FF  FFA4  0014                              RBRA _SDBL_NEXT, N               ; rem_hi > ext_hi: no
002321  8601  FFAB  0005                              RBRA _SDBL_HIT, !Z               ; rem_hi < ext_hi: yes
002322  8603  C114                                    CMP R1, R5
002323  8604  FFA4  000F                              RBRA _SDBL_NEXT, N               ; rem_lo > ext_lo: no
002324  8606  FFA3  000D                              RBRA _SDBL_NEXT, Z               ; rem_lo = ext_lo: no
002325                    
002326  8608  0418        _SDBL_HIT                   MOVE R4, R6
002327  8609  1F98  0002                              ADD SDB_E_LBA_LO, R6
002328  860B  06A4                                    MOVE @R6++, R9                   ; R9/R10: LBA of the extent
002329  860C  0668                                    MOVE @R6, R10
002330  860D  1124                                    ADD R1, R9                       ; plus the remainder
002331  860E  2228                                    ADDC R2, R10
002332  860F  FFA2  000C                              RBRA _SDBL_NO, C                 ; 32-bit overflow
002333  8611  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002334  8613  FFA0  000A                              RBRA _SDBL_RET, 1
002335                    
002336  8615  3504        _SDBL_NEXT                  SUB R5, R1                       ; remainder -= extent size
002337  8616  4608                                    SUBC R6, R2
002338  8617  1F90  0004                              ADD SDB_E_SIZE, R4               ; next extent
002339  8619  3F8C  0001                              SUB 1, R3
002340  861B  FFAB  FFDC                              RBRA _SDBL_LOOP, !Z
002341  861D  9FB8  FFFB  _SDBL_NO                    AND 0xFFFB, R14                  ; clear Carry
002342  861F  E100        _SDBL_RET                   DECRB
002343  8620  0DBC                                    MOVE @R13++, R15
002344                    
002345                    ; Unsigned 32-bit "A >= B" for two little-endian word pairs in memory.
002346                    ; The answer is returned in the Carry flag and not in N/Z, because MOVE @R13++, R15 is
002347                    ; a MOVE (see sysdef.asm) and a MOVE overwrites N and Z but not the Carry.
002348                    ; Input: R8: pointer to A (lo, hi), R9: pointer to B (lo, hi)
002349                    ; Output: Carry=1 if A >= B, R8 and R9 unchanged
002350  8621  E0C0        _SDB_GE32                   INCRB
002351  8622  0800                                    MOVE R8, R0
002352  8623  0904                                    MOVE R9, R1
002353  8624  1F80  0001                              ADD 1, R0
002354  8626  1F84  0001                              ADD 1, R1
002355  8628  C045                                    CMP @R0, @R1                     ; high words
002356  8629  FFA4  000B                              RBRA _SDB_G32Y, N                ; A_hi > B_hi
002357  862B  FFAB  0005                              RBRA _SDB_G32N, !Z               ; A_hi < B_hi
002358  862D  C865                                    CMP @R8, @R9                     ; low words
002359  862E  FFA4  0006                              RBRA _SDB_G32Y, N
002360  8630  FFA3  0004                              RBRA _SDB_G32Y, Z
002361  8632  9FB8  FFFB  _SDB_G32N                   AND 0xFFFB, R14                  ; clear Carry
002362  8634  FFA0  0002                              RBRA _SDB_G32R, 1
002363  8636  AFB8  0004  _SDB_G32Y                   OR 0x0004, R14                   ; set Carry
002364  8638  E100        _SDB_G32R                   DECRB
002365  8639  0DBC                                    MOVE @R13++, R15
002366                    
002367                    ; ----------------------------------------------------------------------------
002368                    ; Building the map
002369                    ; ----------------------------------------------------------------------------
002370                    
002371                    ; SDB_MAP_BUILD
002372                    ; Walks the FAT cluster chain of an open file once and stores the result as
002373                    ; an extent table, so that SDB_LBA can map blocks to LBAs afterwards. Costs
002374                    ; one SD card block read per 128 clusters of the file.
002375                    ;
002376                    ; Reads FAT sectors directly and therefore destroys the FAT32 library's
002377                    ; sector buffer, so it guards and restores it (see THE TWO RULES above). It
002378                    ; never modifies the file handle: the file position is the same afterwards.
002379                    ;
002380                    ; Input: R8: file handle (FDH)
002381                    ; R9: pointer to the block map to be filled
002382                    ; Output: none. The map is left invalid (extent count = 0, reason in
002383                    ; SDB_M_BAIL) when the file cannot be described, which makes all
002384                    ; callers fall back silently.

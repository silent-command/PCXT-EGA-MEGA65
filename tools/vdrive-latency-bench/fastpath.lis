001200                    ; Test 5: a file with twelve extents - must fall back, silently
001201                    ; ============================================================================
001202  8153  0FA0  8B82                              MOVE S_T5, R8
001203  8155  FF90  0008                              ASUB puts, 1
001204  8157  0FA0  8997                              MOVE F_FRAG16, R8
001205  8159  FFB0  00D7                              RSUB OPEN, 1
001206  815B  0FA0  8967                              MOVE HANDLE_FILE, R8
001207  815D  0FA4  8CB3                              MOVE SDB_VD_MAPS, R9
001208  815F  FFB0  04D9                              RSUB SDB_MAP_BUILD, 1
001209  8161  0FA0  8CB3                              MOVE SDB_VD_MAPS, R8
001210  8163  FFB0  00E7                              RSUB PRMAP, 1
001211  8165  0FA0  8CB3                              MOVE SDB_VD_MAPS, R8
001212  8167  CFA1  0000                              CMP 0, @R8 ; must be "no map"
001213  8169  FFAB  000F                              RBRA _T5_F, !Z
001214  816B  B820                                    XOR R8, R8                       ; ..and the entry point must
001215  816C  0FA4  8967                              MOVE HANDLE_FILE, R9             ; ..report the fallback
001216  816E  BA28                                    XOR R10, R10
001217  816F  BB2C                                    XOR R11, R11
001218  8170  0FB0  0200                              MOVE 0x0200, R12
001219  8172  FFB0  06D7                              RSUB SDB_VD_RDBLK, 1
001220  8174  FFA2  0004                              RBRA _T5_F, C
001221  8176  0FA0  89E1                              MOVE S_OK, R8
001222  8178  FFA0  0004                              RBRA _T5_P, 1
001223  817A  0FA0  89E6  _T5_F                       MOVE S_FAIL, R8
001224  817C  FFB0  02F0                              RSUB BUMPFAIL, 1
001225  817E  FF90  0008  _T5_P                       ASUB puts, 1

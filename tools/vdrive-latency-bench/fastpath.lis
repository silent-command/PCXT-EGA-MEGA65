000983                    ; Test 1: the 42 MB, contiguous image file
000984                    ; ============================================================================
000985  8016  0FA0  8A76  _MOUNTED                    MOVE S_T1, R8
000986  8018  FF90  0008                              ASUB puts, 1
000987  801A  0FA0  897F                              MOVE F_FREEDOS, R8
000988  801C  FFB0  0214                              RSUB OPEN, 1
000989                    
000990                                                ; the one-off mount time cost: walking 1344 cluster chain
000991                                                ; entries, in emulator instructions
000992  801E  0FA0  FF0B                              MOVE IO$CYC_STATE, R8
000993  8020  0FA1  0001                              MOVE 1, @R8
000994  8022  0FA0  FF08                              MOVE IO$CYC_LO, R8
000995  8024  0850                                    MOVE @R8, R4
000996  8025  0FA0  FF09                              MOVE IO$CYC_MID, R8
000997  8027  0854                                    MOVE @R8, R5
000998  8028  0FA0  8967                              MOVE HANDLE_FILE, R8
000999  802A  0FA4  8CB3                              MOVE SDB_VD_MAPS, R9
001000  802C  FFB0  060C                              RSUB SDB_MAP_BUILD, 1
001001  802E  0FA0  FF08                              MOVE IO$CYC_LO, R8
001002  8030  0858                                    MOVE @R8, R6
001003  8031  0FA0  FF09                              MOVE IO$CYC_MID, R8
001004  8033  085C                                    MOVE @R8, R7
001005  8034  3418                                    SUB R4, R6
001006  8035  451C                                    SUBC R5, R7
001007  8036  0FA0  89FA                              MOVE S_MAPC, R8
001008  8038  FF90  0008                              ASUB puts, 1
001009  803A  0720                                    MOVE R7, R8
001010  803B  FF90  0026                              ASUB puthex, 1
001011  803D  0620                                    MOVE R6, R8
001012  803E  FF90  0026                              ASUB puthex, 1
001013  8040  FF90  000A                              ASUB crlf, 1
001014                    
001015  8042  0FA0  8CB3                              MOVE SDB_VD_MAPS, R8
001016  8044  FFB0  0206                              RSUB PRMAP, 1
001017                    
001018                                                ; blocks to check: first, second, around the 64 sector
001019                                                ; cluster boundary, a marker block, the last one, and two
001020                                                ; blocks past the end of the file
001021  8046  0F80  8C68                              MOVE T1_BLKS, R0
001022  8048  00A4        _T1_L                       MOVE @R0++, R9                   ; block index lo
001023  8049  00A8                                    MOVE @R0++, R10                  ; block index hi
001024  804A  00AC                                    MOVE @R0++, R11                  ; expectation: 0=ok 1=nomap
001025  804B  CFAC  FFFF                              CMP 0xFFFF, R11
001026  804D  FFA3  0008                              RBRA _T1B, Z
001027  804F  0FA0  8967                              MOVE HANDLE_FILE, R8
001028  8051  FFB0  02F1                              RSUB CHKBLK, 1
001029  8053  FFB0  03DD                              RSUB VERDICT, 1
001030  8055  FFA0  FFF1                              RBRA _T1_L, 1
001031                    
001032                                                ; and 16 pseudo random blocks spread over the whole image
001033  8057  0FA0  8A9B  _T1B                        MOVE S_T1B, R8
001034  8059  FF90  0008                              ASUB puts, 1
001035  805B  0F80  0010                              MOVE 16, R0                      ; R0: blocks still to check
001036  805D  0F84  1234                              MOVE 0x1234, R1                  ; R1/R2: LCG state
001037  805F  0F88  5678                              MOVE 0x5678, R2
001038  8061  B30C                                    XOR R3, R3                       ; R3: amount of bad blocks
001039  8062  0FA0  4E6D  _T1B_L                      MOVE 0x4E6D, R8                  ; state = state * 0x41C64E6D
001040  8064  0FA4  41C6                              MOVE 0x41C6, R9                  ; .. + 12345 (the classic one)
001041  8066  0128                                    MOVE R1, R10
001042  8067  022C                                    MOVE R2, R11
001043  8068  FF90  0032                              ASUB mulu32, 1
001044  806A  1FA0  3039                              ADD 0x3039, R8
001045  806C  2FA4  0000                              ADDC 0, R9
001046  806E  0804                                    MOVE R8, R1
001047  806F  0908                                    MOVE R9, R2
001048  8070  0228                                    MOVE R2, R10                     ; block = state >> 16, which
001049  8071  9FA8  0001                              AND 0x0001, R10                  ; .. is 0 .. 131071, then
001050  8073  0124                                    MOVE R1, R9                      ; .. masked into the image
001051  8074  CFA8  0001                              CMP 1, R10
001052  8076  FFAB  0005                              RBRA _T1B_C, !Z
001053  8078  CFA4  5000                              CMP 0x5000, R9                   ; keep it below 86016
001054  807A  FFA4  0001                              RBRA _T1B_C, N                   ; still inside the image
001055  807C  BA28                                    XOR R10, R10                     ; no: fold it down
001056  807D  0FA0  8967  _T1B_C                      MOVE HANDLE_FILE, R8
001057  807F  FFB0  02C3                              RSUB CHKBLK, 1
001058  8081  CFA0  0000                              CMP 0, R8
001059  8083  FFA3  0002                              RBRA _T1B_N, Z
001060  8085  1F8C  0001                              ADD 1, R3
001061  8087  3F80  0001  _T1B_N                      SUB 1, R0
001062  8089  FFAB  FFD7                              RBRA _T1B_L, !Z
001063  808B  0320                                    MOVE R3, R8
001064  808C  FFB0  03C7                              RSUB VERDICT0, 1

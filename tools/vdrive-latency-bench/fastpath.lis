001100                    ; Test 3: read after write, both directions
001101                    ; ============================================================================
001102  80C1  0FA0  8B06                              MOVE S_T3, R8
001103  80C3  FF90  0008                              ASUB puts, 1
001104                    
001105                                                ; (a) direct write, then read back through the FAT32 library
001106  80C5  0FA0  B000                              MOVE BUF_A, R8
001107  80C7  0FA4  0055                              MOVE 0x0055, R9
001108  80C9  FFB0  01B2                              RSUB PATTERN, 1
001109  80CB  0FA4  8C8C                              MOVE T3_BLK, R9
001110  80CD  0964                                    MOVE @R9, R9
001111  80CE  BA28                                    XOR R10, R10
001112  80CF  FFB0  0212                              RSUB WRBLK, 1                    ; fills the drive buffer and
001113  80D1  FFAA  0044                              RBRA _T3_NOMAP, !C               ; ..calls SDB_VD_WRBLK
001114                    
001115  80D3  0FA4  8C8C                              MOVE T3_BLK, R9
001116  80D5  0964                                    MOVE @R9, R9
001117  80D6  BA28                                    XOR R10, R10
001118  80D7  0FA0  8967                              MOVE HANDLE_FILE, R8
001119  80D9  FFB0  01C4                              RSUB RDSLOW, 1                   ; f32 read into BUF_B
001120  80DB  0FA0  B000                              MOVE BUF_A, R8
001121  80DD  0FA4  B200                              MOVE BUF_B, R9
001122  80DF  FFB0  024E                              RSUB CMP512, 1
001123  80E1  FFB0  0372                              RSUB VERDICT0, 1
001124                    
001125                                                ; (b) the same block through the fast read path
001126  80E3  0FA0  8B25                              MOVE S_T3B, R8
001127  80E5  FF90  0008                              ASUB puts, 1
001128  80E7  0FA0  8967                              MOVE HANDLE_FILE, R8
001129  80E9  0FA4  8C8C                              MOVE T3_BLK, R9
001130  80EB  0964                                    MOVE @R9, R9
001131  80EC  BA28                                    XOR R10, R10
001132  80ED  FFB0  0255                              RSUB CHKBLK, 1                   ; fast vs slow, both re-read
001133  80EF  FFB0  0364                              RSUB VERDICT0, 1
001134                    
001135                                                ; (c) write through the FAT32 library, read through the fast
001136                                                ; path: this is the direction that would show a stale
001137                                                ; buffer if SDB_FLUSHINV were missing
001138  80F1  0FA0  8B44                              MOVE S_T3C, R8
001139  80F3  FF90  0008                              ASUB puts, 1
001140  80F5  0FA0  B000                              MOVE BUF_A, R8
001141  80F7  0FA4  00A7                              MOVE 0x00A7, R9
001142  80F9  FFB0  0182                              RSUB PATTERN, 1
001143  80FB  0FA0  8967                              MOVE HANDLE_FILE, R8
001144  80FD  0FA4  8C8C                              MOVE T3_BLK, R9
001145  80FF  0964                                    MOVE @R9, R9
001146  8100  BA28                                    XOR R10, R10
001147  8101  FFB0  01AA                              RSUB WRSLOW, 1                   ; f32_fwrite + f32_fflush
001148  8103  0FA0  8967                              MOVE HANDLE_FILE, R8
001149  8105  0FA4  8C8C                              MOVE T3_BLK, R9
001150  8107  0964                                    MOVE @R9, R9
001151  8108  BA28                                    XOR R10, R10
001152  8109  FFB0  01BA                              RSUB RDFAST, 1                   ; SDB_VD_RDBLK into BUF_B
001153  810B  FFAA  000A                              RBRA _T3_NOMAP, !C
001154  810D  0FA0  B000                              MOVE BUF_A, R8
001155  810F  0FA4  B200                              MOVE BUF_B, R9
001156  8111  FFB0  021C                              RSUB CMP512, 1
001157  8113  FFB0  0340                              RSUB VERDICT0, 1
001158  8115  FFA0  0006                              RBRA _T4, 1
001159  8117  0FA0  89E6  _T3_NOMAP                   MOVE S_FAIL, R8
001160  8119  FF90  0008                              ASUB puts, 1
001161  811B  FFB0  0351                              RSUB BUMPFAIL, 1

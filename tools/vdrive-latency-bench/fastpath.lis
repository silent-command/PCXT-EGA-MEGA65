000970  8002  0FA0  8C8E                              MOVE HANDLE_DEV, R8
000971  8004  0FA4  0001                              MOVE 1, R9
000972  8006  FF90  0044                              ASUB f32_mnt_sd, 1
000973  8008  CFA4  0000                              CMP 0, R9
000974  800A  FFA3  000A                              RBRA _MOUNTED, Z
000975  800C  0FA0  89C6                              MOVE S_EMNT, R8
000976  800E  FF90  0008                              ASUB puts, 1
000977  8010  0920                                    MOVE R9, R8
000978  8011  FF90  0026                              ASUB puthex, 1
000979  8013  FF90  000A                              ASUB crlf, 1
000980  8015  E000                                    HALT

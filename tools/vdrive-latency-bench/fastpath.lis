002726                    ; ----------------------------------------------------------------------------
002727                    ; Block transfers
002728                    ; ----------------------------------------------------------------------------
002729                    
002730                    ; SDB_SD2VD
002731                    ; Copies the 512 bytes in the buffer of the SD controller into the internal
002732                    ; block buffer of a virtual drive. Device and 4k window selection are hoisted
002733                    ; out of the loop, which is what makes this about twenty times faster than
002734                    ; the original per-byte VD_CAD_WRITE sequence.
002735                    ;
002736                    ; Input: R8: virtual drive number (only used for the vdrives device select)
002737                    ; Output: none, all registers unchanged
002738  87E1  E0C0        SDB_SD2VD                   INCRB
002739  87E2  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002740  87E4  0F84  8CB2                              MOVE VDRIVES_DEVICE, R1
002741  87E6  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002742  87E7  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0
002743  87E9  0F81  0000                              MOVE VD_WIN_CAD, @R0             ; control and data registers
002744                    
002745  87EB  0F80  FF22                              MOVE IO$SD_DATA_POS, R0
002746  87ED  0F84  FF23                              MOVE IO$SD_DATA, R1
002747  87EF  0F88  7005                              MOVE VD_B_ADDR, R2
002748  87F1  0F8C  7006                              MOVE VD_B_DOUT, R3
002749  87F3  0F90  7007                              MOVE VD_B_WREN, R4
002750  87F5  B514                                    XOR R5, R5
002751  87F6  0501        _SDB_S2V_L                  MOVE R5, @R0                     ; position in the SD buffer
002752  87F7  0509                                    MOVE R5, @R2                     ; address in the drive buffer
002753  87F8  014D                                    MOVE @R1, @R3                    ; the byte itself
002754  87F9  0F91  0001                              MOVE 1, @R4                      ; strobe write enable
002755  87FB  0F91  0000                              MOVE 0, @R4
002756  87FD  1F94  0001                              ADD 1, R5
002757  87FF  CF94  0200                              CMP 0x0200, R5
002758  8801  FFAB  FFF3                              RBRA _SDB_S2V_L, !Z
002759  8803  E100                                    DECRB
002760  8804  0DBC                                    MOVE @R13++, R15
002761                    
002762                    ; SDB_VD2SD
002763                    ; Copies the 512 bytes from the internal block buffer of a virtual drive into
002764                    ; the buffer of the SD controller. The drive buffer address register lives in
002765                    ; the control/data window while the data register lives in the drive window,
002766                    ; so the window selector has to be toggled per byte; the device selection is
002767                    ; still hoisted out of the loop.
002768                    ;
002769                    ; Input: R8: virtual drive number
002770                    ; Output: none, all registers unchanged
002771  8805  E0C0        SDB_VD2SD                   INCRB
002772  8806  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002773  8808  0F84  8CB2                              MOVE VDRIVES_DEVICE, R1
002774  880A  0141                                    MOVE @R1, @R0                    ; select the vdrives device
002775                    
002776  880B  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002777  880D  0F84  0001                              MOVE VD_WIN_DRV, R1
002778  880F  1804                                    ADD R8, R1                       ; R1: window of this drive
002779  8810  0F88  FF22                              MOVE IO$SD_DATA_POS, R2
002780  8812  0F8C  FF23                              MOVE IO$SD_DATA, R3
002781  8814  0F90  7005                              MOVE VD_B_ADDR, R4
002782  8816  0F94  700B                              MOVE VD_B_DIN, R5
002783  8818  B618                                    XOR R6, R6
002784  8819  0F81  0000  _SDB_V2S_L                  MOVE VD_WIN_CAD, @R0             ; control and data registers
002785  881B  0611                                    MOVE R6, @R4                     ; address in the drive buffer
002786  881C  0101                                    MOVE R1, @R0                     ; drive specific registers
002787  881D  0609                                    MOVE R6, @R2                     ; position in the SD buffer
002788  881E  054D                                    MOVE @R5, @R3                    ; the byte itself
002789  881F  1F98  0001                              ADD 1, R6
002790  8821  CF98  0200                              CMP 0x0200, R6
002791  8823  FFAB  FFF4                              RBRA _SDB_V2S_L, !Z
002792  8825  E100                                    DECRB
002793  8826  0DBC                                    MOVE @R13++, R15
002794                    
002795                    ; SDB_SD2DEV
002796                    ; Copies the 512 bytes in the buffer of the SD controller into an M2M byte
002797                    ; streaming device (a CRT/ROM load target), handling the 4k window boundary.
002798                    ;
002799                    ; Input: R8: target device id
002800                    ; R9: target 4k window
002801                    ; R10: target address within the window (M2M$RAMROM_DATA based)
002802                    ; Output: R9/R10: window and address behind the last written byte
002803                    ; R8 unchanged
002804  8827  E0C0        SDB_SD2DEV                  INCRB
002805  8828  0F80  FFF4                              MOVE M2M$RAMROM_DEV, R0
002806  882A  0801                                    MOVE R8, @R0
002807  882B  0F80  FFF5                              MOVE M2M$RAMROM_4KWIN, R0        ; R0: window selector
002808  882D  0901                                    MOVE R9, @R0
002809  882E  0F84  FF22                              MOVE IO$SD_DATA_POS, R1
002810  8830  0F88  FF23                              MOVE IO$SD_DATA, R2
002811  8832  0F8C  7000                              MOVE M2M$RAMROM_DATA, R3
002812  8834  1F8C  1000                              ADD 0x1000, R3                   ; R3: end of window marker
002813  8836  B410                                    XOR R4, R4                       ; R4: position in the SD buf
002814  8837  0F94  0200                              MOVE 0x0200, R5                  ; R5: bytes still to go
002815                                                ; One instruction has to sit between writing IO$SD_DATA_POS
002816                                                ; and reading IO$SD_DATA, exactly like SD$READ_BYTE does: the
002817                                                ; buffer is a block RAM with a registered output, see
002818                                                ; M2M/QNICE/vhdl/byte_bram.vhd. The ADD below is that
002819                                                ; instruction and does useful work at the same time.
002820  8839  0405        _SDB_S2D_L                  MOVE R4, @R1                     ; position in the SD buffer
002821  883A  1F90  0001                              ADD 1, R4
002822  883C  026A                                    MOVE @R2, @R10++                 ; the byte itself
002823  883D  C328                                    CMP R3, R10                      ; 4k window boundary?
002824  883E  FFAB  0005                              RBRA _SDB_S2D_1, !Z              ; no
002825  8840  0FA8  7000                              MOVE M2M$RAMROM_DATA, R10        ; yes: next window
002826  8842  1FA4  0001                              ADD 1, R9
002827  8844  0901                                    MOVE R9, @R0
002828  8845  3F94  0001  _SDB_S2D_1                  SUB 1, R5
002829  8847  FFAB  FFF0                              RBRA _SDB_S2D_L, !Z
002830  8849  E100                                    DECRB
002831  884A  0DBC                                    MOVE @R13++, R15
002832                    
002833                    ; ----------------------------------------------------------------------------
002834                    ; High level entry points
002835                    ; ----------------------------------------------------------------------------
002836                    
002837                    ; SDB_VD_RDBLK
002838                    ; Prepares one virtual drive block read: maps the byte position to an LBA and
002839                    ; reads that block into the buffer of the SD controller. On success the
002840                    ; caller acknowledges sd_rd_i and then calls SDB_SD2VD.
002841                    ;
002842                    ; Input: R8: virtual drive number
002843                    ; R9: file handle of the disk image
002844                    ; R10/R11: byte position within the image, lo/hi
002845                    ; R12: amount of bytes the core asked for
002846                    ; Output: Carry=1: the block is in the buffer of the SD controller
002847                    ; Carry=0: use the FAT32 library path instead
002848                    ; R8 .. R12 unchanged
002849  884B  E0C0        SDB_VD_RDBLK                INCRB
002850  884C  0800                                    MOVE R8, R0
002851  884D  0904                                    MOVE R9, R1
002852  884E  0A08                                    MOVE R10, R2
002853  884F  0B0C                                    MOVE R11, R3
002854  8850  0C10                                    MOVE R12, R4
002855  8851  FFB0  0054                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002856  8853  FFAA  0017                              RBRA _SDB_VRD_NO, !C
002857  8855  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002858  8856  0A18                                    MOVE R10, R6
002859  8857  FFB0  FC74                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002860  8859  FFAA  0011                              RBRA _SDB_VRD_NO, !C             ; no: nothing was touched
002861  885B  0520                                    MOVE R5, R8
002862  885C  0624                                    MOVE R6, R9
002863  885D  FF90  003C                              ASUB sd_r_block, 1
002864  885F  CFA0  0000                              CMP 0, R8
002865  8861  FFAB  0005                              RBRA _SDB_VRD_SDE, !Z            ; SD error: try the slow path
002866  8863  0020                                    MOVE R0, R8
002867  8864  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002868  8866  FFA0  0007                              RBRA _SDB_VRD_R, 1
002869  8868  FFB0  FC5C  _SDB_VRD_SDE                RSUB SDB_SDERR, 1
002870  886A  FFB0  FCBB                              RSUB SDB_GUARD_OUT, 1
002871  886C  0020        _SDB_VRD_NO                 MOVE R0, R8
002872  886D  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002873  886F  0124        _SDB_VRD_R                  MOVE R1, R9
002874  8870  0228                                    MOVE R2, R10
002875  8871  032C                                    MOVE R3, R11
002876  8872  0430                                    MOVE R4, R12
002877  8873  E100                                    DECRB
002878  8874  0DBC                                    MOVE @R13++, R15
002879                    
002880                    ; SDB_VD_RDDONE
002881                    ; Called by HANDLE_DRV_RD after SDB_SD2VD has emptied the buffer: puts the
002882                    ; FAT32 library's sector back into it.
002883                    ;
002884                    ; Input: none
002885                    ; Output: none, all registers unchanged
002886  8875  FFB0  FCB0  SDB_VD_RDDONE               RSUB SDB_GUARD_OUT, 1
002887  8877  0DBC                                    MOVE @R13++, R15
002888                    
002889                    ; SDB_VD_WRBLK
002890                    ; Writes one virtual drive block: maps the byte position to an LBA, copies
002891                    ; the internal block buffer of the drive into the buffer of the SD controller
002892                    ; and writes it. The caller acknowledges sd_wr_i afterwards.
002893                    ;
002894                    ; Input: R8: virtual drive number
002895                    ; R9: file handle of the disk image
002896                    ; R10/R11: byte position within the image, lo/hi
002897                    ; R12: amount of bytes the core wants to write
002898                    ; Output: Carry=1: the block has been written to the SD card
002899                    ; Carry=0: nothing was written, use the FAT32 library path instead
002900                    ; R8 .. R12 unchanged
002901  8878  E0C0        SDB_VD_WRBLK                INCRB
002902  8879  0800                                    MOVE R8, R0
002903  887A  0904                                    MOVE R9, R1
002904  887B  0A08                                    MOVE R10, R2
002905  887C  0B0C                                    MOVE R11, R3
002906  887D  0C10                                    MOVE R12, R4
002907  887E  FFB0  0027                              RSUB _SDB_PREP, 1                ; R9/R10: LBA
002908  8880  FFAA  001C                              RBRA _SDB_VWR_NO, !C
002909  8882  0914                                    MOVE R9, R5                      ; R5/R6: LBA
002910  8883  0A18                                    MOVE R10, R6
002911  8884  FFB0  FC47                              RSUB SDB_GUARD_IN, 1             ; can we put the buffer back?
002912  8886  FFAA  0016                              RBRA _SDB_VWR_NO, !C             ; no: nothing was touched
002913  8888  0020                                    MOVE R0, R8
002914  8889  FFB0  FF7A                              RSUB SDB_VD2SD, 1
002915  888B  0520                                    MOVE R5, R8
002916  888C  0624                                    MOVE R6, R9
002917  888D  FF90  003E                              ASUB sd_w_block, 1
002918  888F  CFA0  0000                              CMP 0, R8
002919  8891  FFAB  0007                              RBRA _SDB_VWR_SDE, !Z
002920  8893  FFB0  FC92                              RSUB SDB_GUARD_OUT, 1            ; the write is done, restore
002921  8895  0020                                    MOVE R0, R8
002922  8896  AFB8  0004                              OR 0x0004, R14                   ; set Carry
002923  8898  FFA0  0007                              RBRA _SDB_VWR_R, 1
002924  889A  FFB0  FC2A  _SDB_VWR_SDE                RSUB SDB_SDERR, 1                ; SD error: try the slow path
002925  889C  FFB0  FC89                              RSUB SDB_GUARD_OUT, 1
002926  889E  0020        _SDB_VWR_NO                 MOVE R0, R8
002927  889F  9FB8  FFFB                              AND 0xFFFB, R14                  ; clear Carry
002928  88A1  0124        _SDB_VWR_R                  MOVE R1, R9
002929  88A2  0228                                    MOVE R2, R10
002930  88A3  032C                                    MOVE R3, R11
002931  88A4  0430                                    MOVE R4, R12
002932  88A5  E100                                    DECRB
002933  88A6  0DBC                                    MOVE @R13++, R15
002934                    
002935                    ; Common preparation for SDB_VD_RDBLK / SDB_VD_WRBLK. Expects the inputs in
002936                    ; the caller's R0 (drive), R1 (FDH), R2/R3 (byte position) and R4 (amount of
002937                    ; bytes) and returns Carry=1 plus the LBA in R9/R10. Runs in the caller's
002938                    ; register bank on purpose. Touches nothing outside our own variables.
002939  88A7  0FA0  0200  _SDB_PREP                   MOVE 0x0200, R8
002940  88A9  C420                                    CMP R4, R8                       ; exactly one block?
002941  88AA  FFAB  0016                              RBRA _SDB_PREP_NO, !Z            ; no: let the FAT32 path do
002942  88AC  0220                                    MOVE R2, R8                      ; ..partial/multi blocks
002943  88AD  9FA0  01FF                              AND 0x01FF, R8                   ; block aligned?
002944  88AF  FFAB  0011                              RBRA _SDB_PREP_NO, !Z            ; no
002945  88B1  0020                                    MOVE R0, R8
002946  88B2  FFB0  FBE6                              RSUB SDB_VDMAP, 1
002947  88B4  082C                                    MOVE R8, R11                     ; R11: map
002948  88B5  0124                                    MOVE R1, R9
002949  88B6  FFB0  FBFB                              RSUB SDB_CHECK, 1
002950  88B8  FFAA  0008                              RBRA _SDB_PREP_NO, !C
002951  88BA  0224                                    MOVE R2, R9
002952  88BB  0328                                    MOVE R3, R10
002953  88BC  FFB0  FCA8                              RSUB SDB_B2BLK, 1
002954  88BE  0B20                                    MOVE R11, R8
002955  88BF  FFB0  FD1E                              RSUB SDB_LBA, 1                  ; sets/clears Carry
002956  88C1  0DBC                                    MOVE @R13++, R15
002957  88C2  9FB8  FFFB  _SDB_PREP_NO                AND 0xFFFB, R14                  ; clear Carry
002958  88C4  0DBC                                    MOVE @R13++, R15
002959                    
002960                    ; SDB_FREAD_FAST
002961                    ; Streams whole 512-byte blocks of a mapped file directly from the SD card
002962                    ; into an M2M byte streaming device and then positions the file handle right
002963                    ; behind them, so that the caller's byte loop reads the rest as usual.
002964                    ;
002965                    ; It deliberately stops one whole block short of the end of the file, so that
002966                    ; the position it hands over is always strictly inside the file and the
002967                    ; caller reaches EOF through the FAT32 library, exactly as before.
002968                    ;
002969                    ; The final f32_fseek is what restores the library: a seek unconditionally
002970                    ; re-reads the sector into the hardware buffer and re-claims ownership, so
002971                    ; afterwards the library is in a state it produced itself. If anything at all
002972                    ; goes wrong the file position is put back where it was and Carry=0 is
002973                    ; returned, i.e. the caller sees "nothing happened".
002974                    ;
002975                    ; Input: R8: file handle (FDH)
002976                    ; R9: pointer to the block map
002977                    ; R10: target device id
002978                    ; R11: target 4k window
002979                    ; R12: target address within the window
002980                    ; Output: Carry=1: R11/R12 updated, the file position is behind the data
002981                    ; Carry=0: nothing was transferred, the file position is unchanged
002982                    ; and R11/R12 are unchanged
002983  88C5  E0C0        SDB_FREAD_FAST              INCRB
002984  88C6  0800                                    MOVE R8, R0                      ; R0: FDH
002985  88C7  0904                                    MOVE R9, R1                      ; R1: map
002986  88C8  0A08                                    MOVE R10, R2                     ; R2: target device
002987  88C9  0B0C                                    MOVE R11, R3                     ; R3: target 4k window
002988  88CA  0C10                                    MOVE R12, R4                     ; R4: target address
002989                    
002990  88CB  0FA0  8D63                              MOVE SDB_FF_STAT, R8
002991  88CD  0FA1  0001                              MOVE SDB_B_NOMAP, @R8
002992  88CF  0FA0  8D64                              MOVE SDB_FF_BLKS, R8
002993  88D1  0FA1  0000                              MOVE 0, @R8
002994                    
002995  88D3  0120                                    MOVE R1, R8
002996  88D4  0024                                    MOVE R0, R9
002997  88D5  FFB0  FBDC                              RSUB SDB_CHECK, 1
002998  88D7  FFAA  008A                              RBRA _SDBFF_NO, !C
002999                    
003000                                                ; only from the very beginning of the file
003001  88D9  0020                                    MOVE R0, R8
003002  88DA  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
003003  88DC  CFA1  0000                              CMP 0, @R8
003004  88DE  FFAB  0083                              RBRA _SDBFF_NO, !Z
003005  88E0  0020                                    MOVE R0, R8
003006  88E1  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
003007  88E3  CFA1  0000                              CMP 0, @R8
003008  88E5  FFAB  007C                              RBRA _SDBFF_NO, !Z
003009                    
003010                                                ; how many whole blocks do we take? Always one less than the
003011                                                ; file has, so that the handover position is strictly inside
003012                                                ; the file and the caller still reaches EOF through the
003013                                                ; library. A CRT/ROM file is never 32 MB or larger, so one
003014                                                ; word of block count is plenty and anything else is refused.
003015  88E7  0120                                    MOVE R1, R8
003016  88E8  1FA0  0003                              ADD SDB_M_TBLK_HI, R8
003017  88EA  CFA1  0000                              CMP 0, @R8
003018  88EC  FFAB  0075                              RBRA _SDBFF_NO, !Z
003019  88EE  0120                                    MOVE R1, R8
003020  88EF  1FA0  0002                              ADD SDB_M_TBLK_LO, R8
003021  88F1  085C                                    MOVE @R8, R7                     ; R7: blocks still to do
003022  88F2  3F9C  0001                              SUB 1, R7
003023  88F4  FFA3  006D                              RBRA _SDBFF_NO, Z                ; a one block file: byte loop
003024  88F6  FFA4  006B                              RBRA _SDBFF_NO, N                ; cannot happen: TBLK was 0
003025                    
003026  88F8  0FA0  8D63                              MOVE SDB_FF_STAT, R8
003027  88FA  0FA1  000B                              MOVE SDB_B_GUARD, @R8
003028  88FC  FFB0  FBCF                              RSUB SDB_GUARD_IN, 1             ; nothing touched if it fails
003029  88FE  FFAA  0063                              RBRA _SDBFF_NO, !C
003030                    
003031  8900  B514                                    XOR R5, R5                       ; R5/R6: block index
003032  8901  B618                                    XOR R6, R6
003033                    
003034  8902  CF9C  0000  _SDBFF_LOOP                 CMP 0, R7
003035  8904  FFA3  0020                              RBRA _SDBFF_DONE, Z
003036  8906  0120                                    MOVE R1, R8
003037  8907  0524                                    MOVE R5, R9
003038  8908  0628                                    MOVE R6, R10
003039  8909  FFB0  FCD4                              RSUB SDB_LBA, 1
003040  890B  FFAA  0019                              RBRA _SDBFF_DONE, !C
003041                    
003042                    
003043                    
003044                    
003045  890D  0920                                    MOVE R9, R8
003046  890E  0A24                                    MOVE R10, R9
003047  890F  FF90  003C                              ASUB sd_r_block, 1
003048  8911  CFA0  0000                              CMP 0, R8
003049  8913  FFAB  000F                              RBRA _SDBFF_SDE, !Z              ; SD error: stop here
003050  8915  0220                                    MOVE R2, R8
003051  8916  0324                                    MOVE R3, R9
003052  8917  0428                                    MOVE R4, R10
003053  8918  FFB0  FF0D                              RSUB SDB_SD2DEV, 1
003054  891A  090C                                    MOVE R9, R3
003055  891B  0A10                                    MOVE R10, R4
003056  891C  1F94  0001                              ADD 1, R5
003057  891E  2F98  0000                              ADDC 0, R6
003058  8920  3F9C  0001                              SUB 1, R7
003059  8922  FFA0  FFDE                              RBRA _SDBFF_LOOP, 1
003060                    
003061  8924  FFB0  FBA0  _SDBFF_SDE                  RSUB SDB_SDERR, 1
003062                    
003063                                                ; the hardware buffer is ours now; whatever we do next, the
003064                                                ; library has to be put back. A seek does that properly.
003065  8926  0FA0  8D64  _SDBFF_DONE                 MOVE SDB_FF_BLKS, R8
003066  8928  0521                                    MOVE R5, @R8
003067  8929  CF94  0000                              CMP 0, R5                        ; anything transferred?
003068  892B  FFAB  0004                              RBRA _SDBFF_SEEK, !Z
003069  892D  CF98  0000                              CMP 0, R6
003070  892F  FFA3  0027                              RBRA _SDBFF_REW, Z               ; no: just put it back
003071                    
003072  8931  0FA0  8D63  _SDBFF_SEEK                 MOVE SDB_FF_STAT, R8
003073  8933  0FA1  000C                              MOVE SDB_B_SEEK, @R8
003074  8935  0524                                    MOVE R5, R9                      ; file position = blocks * 512
003075  8936  0628                                    MOVE R6, R10
003076  8937  FFB0  FC40                              RSUB SDB_BLK2B, 1
003077  8939  092C                                    MOVE R9, R11                     ; R11/R12: expected position
003078  893A  0A30                                    MOVE R10, R12
003079  893B  0020                                    MOVE R0, R8
003080  893C  FF90  0054                              ASUB f32_fseek, 1
003081  893E  CFA4  0000                              CMP 0, R9                        ; seek reported success?
003082  8940  FFAB  0016                              RBRA _SDBFF_REW, !Z
003083  8942  0020                                    MOVE R0, R8                      ; ..and actually got there?
003084  8943  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
003085  8945  C86C                                    CMP @R8, R11
003086  8946  FFAB  0010                              RBRA _SDBFF_REW, !Z
003087  8948  0020                                    MOVE R0, R8
003088  8949  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
003089  894B  C870                                    CMP @R8, R12
003090  894C  FFAB  000A                              RBRA _SDBFF_REW, !Z
003091                    
003092  894E  0FA0  8D63                              MOVE SDB_FF_STAT, R8
003093  8950  0FA1  0000                              MOVE SDB_B_OK, @R8
003094  8952  032C                                    MOVE R3, R11
003095  8953  0430                                    MOVE R4, R12
003096  8954  AFB8  0004                              OR 0x0004, R14                   ; set Carry
003097  8956  FFA0  000D                              RBRA _SDBFF_RET, 1
003098                    
003099                                                ; Put the file back to the start and report "nothing done".
003100                                                ; The caller has not seen the updated target pointers, so it
003101                                                ; simply overwrites whatever we already transferred. The seek
003102                                                ; also restores the library's sector buffer; if even that
003103                                                ; fails, the buffer is marked unknown.
003104  8958  0020        _SDBFF_REW                  MOVE R0, R8
003105  8959  B924                                    XOR R9, R9
003106  895A  BA28                                    XOR R10, R10
003107  895B  FF90  0054                              ASUB f32_fseek, 1
003108  895D  CFA4  0000                              CMP 0, R9
003109  895F  FFA3  0002                              RBRA _SDBFF_NO, Z
003110  8961  FFB0  FBE7                              RSUB SDB_ORPHAN, 1
003111                    
003112  8963  9FB8  FFFB  _SDBFF_NO                   AND 0xFFFB, R14                  ; clear Carry
003113  8965              _SDBFF_RET                  
003114  8965  E100                                    DECRB
003115  8966  0DBC                                    MOVE @R13++, R15

001609                    ; ---- CRT/ROM loader check.
001610                    ; R8: file name, R9: file size in bytes (< 64 KB)
001611                    ;
001612                    ; Works out for itself what SDB_FREAD_FAST is supposed to do: it takes
001613                    ; all whole 512-byte blocks except the last one, so
001614                    ; blocks = size/512 - 1, bytes = blocks*512,
001615                    ; window = bytes/4096, address = 0x7000 + bytes mod 4096
001616                    ; Then it checks
001617                    ; (a) the returned 4k window and address,
001618                    ; (b) that the handed-over file position is exactly "bytes",
001619                    ; (c) that reading the rest byte-wise yields exactly (size - bytes)
001620                    ; bytes and then EOF, with the right content, read through a
001621                    ; second file handle on the same device so that the two handles
001622                    ; fight over the FAT32 library's one sector buffer,
001623                    ; (d) every byte still visible in the 4k window against f32_fread.
001624  837C  FF90  005E  CHKROM                      ASUB enter, 1
001625  837E  0900                                    MOVE R9, R0                      ; R0: file size
001626  837F  0808                                    MOVE R8, R2                      ; R2: file name
001627  8380  FFB0  FEB0                              RSUB OPEN, 1
001628                    
001629  8382  0004                                    MOVE R0, R1                      ; R1: bytes taken by the
001630  8383  9FB8  FFFB                              AND 0xFFFB, R14                  ; ..fast path
001631  8385  6F84  0009                              SHR 9, R1
001632  8387  3F84  0001                              SUB 1, R1
001633  8389  9FB8  FFFD                              AND 0xFFFD, R14
001634  838B  5F84  0009                              SHL 9, R1
001635                    
001636  838D  010C                                    MOVE R1, R3                      ; R3: expected 4k window
001637  838E  9FB8  FFFB                              AND 0xFFFB, R14
001638  8390  6F8C  000C                              SHR 12, R3
001639  8392  0110                                    MOVE R1, R4                      ; R4: expected address
001640  8393  9F90  0FFF                              AND 0x0FFF, R4
001641  8395  1F90  7000                              ADD M2M$RAMROM_DATA, R4
001642                    
001643  8397  0FA0  8967                              MOVE HANDLE_FILE, R8
001644  8399  0FA4  8D2B                              MOVE SDB_RM_MAP, R9
001645  839B  FFB0  029D                              RSUB SDB_MAP_BUILD, 1
001646  839D  0FA0  8967                              MOVE HANDLE_FILE, R8
001647  839F  0FA4  8D2B                              MOVE SDB_RM_MAP, R9
001648  83A1  0FA8  00AB                              MOVE 0x00AB, R10                 ; target device (ignored here)
001649  83A3  BB2C                                    XOR R11, R11                     ; target 4k window
001650  83A4  0FB0  7000                              MOVE M2M$RAMROM_DATA, R12        ; plain RAM in the emulator
001651  83A6  FFB0  051D                              RSUB SDB_FREAD_FAST, 1
001652  83A8  FFAA  0079                              RBRA _CR_NO, !C
001653  83AA  C32C                                    CMP R3, R11                      ; (a) window as expected?
001654  83AB  FFAB  007C                              RBRA _CR_BAD, !Z
001655  83AD  C430                                    CMP R4, R12                      ; address as expected?
001656  83AE  FFAB  0079                              RBRA _CR_BAD, !Z
001657                    
001658                                                ; (b) the file position must be exactly R1
001659  83B0  0FA0  8967                              MOVE HANDLE_FILE, R8
001660  83B2  1FA0  0008                              ADD FAT32$FDH_ACCESS_HI, R8
001661  83B4  CFA1  0000                              CMP 0, @R8
001662  83B6  FFAB  0071                              RBRA _CR_BAD, !Z
001663  83B8  0FA0  8967                              MOVE HANDLE_FILE, R8
001664  83BA  1FA0  0007                              ADD FAT32$FDH_ACCESS_LO, R8
001665  83BC  C121                                    CMP R1, @R8
001666  83BD  FFAB  006A                              RBRA _CR_BAD, !Z
001667                    
001668                                                ; (c) the tail, alternating between two file handles
001669  83BF  0FA0  8C8E                              MOVE HANDLE_DEV, R8
001670  83C1  0FA4  8973                              MOVE HANDLE_FILE2, R9
001671  83C3  0228                                    MOVE R2, R10
001672  83C4  BB2C                                    XOR R11, R11
001673  83C5  FF90  0050                              ASUB f32_fopen, 1
001674  83C7  CFA8  0000                              CMP 0, R10
001675  83C9  FFAB  005E                              RBRA _CR_BAD, !Z
001676  83CB  0FA0  8973                              MOVE HANDLE_FILE2, R8
001677  83CD  0124                                    MOVE R1, R9
001678  83CE  BA28                                    XOR R10, R10
001679  83CF  FF90  0054                              ASUB f32_fseek, 1
001680  83D1  CFA4  0000                              CMP 0, R9
001681  83D3  FFAB  0054                              RBRA _CR_BAD, !Z
001682                    
001683  83D5  001C                                    MOVE R0, R7                      ; R7: tail bytes still to go
001684  83D6  311C                                    SUB R1, R7
001685  83D7  CF9C  0000  _CR_TL                      CMP 0, R7
001686  83D9  FFA3  0018                              RBRA _CR_TD, Z
001687  83DB  0FA0  8967                              MOVE HANDLE_FILE, R8
001688  83DD  FF90  0052                              ASUB f32_fread, 1
001689  83DF  CFA8  0000                              CMP 0, R10                       ; tail must not be short
001690  83E1  FFAB  0046                              RBRA _CR_BAD, !Z
001691  83E3  0914                                    MOVE R9, R5
001692  83E4  0FA0  8973                              MOVE HANDLE_FILE2, R8
001693  83E6  FF90  0052                              ASUB f32_fread, 1
001694  83E8  CFA8  0000                              CMP 0, R10
001695  83EA  FFAB  003D                              RBRA _CR_BAD, !Z
001696  83EC  C524                                    CMP R5, R9                       ; both handles must agree
001697  83ED  FFAB  003A                              RBRA _CR_BAD, !Z
001698  83EF  3F9C  0001                              SUB 1, R7
001699  83F1  FFA0  FFE4                              RBRA _CR_TL, 1
001700  83F3  0FA0  8967  _CR_TD                      MOVE HANDLE_FILE, R8
001701  83F5  FF90  0052                              ASUB f32_fread, 1
001702  83F7  CFA8  EEEE                              CMP FAT32$EOF, R10               ; ..and must not be long
001703  83F9  FFAB  002E                              RBRA _CR_BAD, !Z
001704                    
001705                                                ; (d) the bytes that are still visible in the 4k window
001706  83FB  0314                                    MOVE R3, R5                      ; R5: their file offset
001707  83FC  9FB8  FFFD                              AND 0xFFFD, R14
001708  83FE  5F94  000C                              SHL 12, R5
001709  8400  011C                                    MOVE R1, R7                      ; R7: how many of them
001710  8401  351C                                    SUB R5, R7
001711  8402  FFA3  001B                              RBRA _CR_OK, Z                   ; the window is empty
001712  8404  0FA0  8967                              MOVE HANDLE_FILE, R8
001713  8406  0524                                    MOVE R5, R9
001714  8407  BA28                                    XOR R10, R10
001715  8408  FF90  0054                              ASUB f32_fseek, 1
001716  840A  CFA4  0000                              CMP 0, R9
001717  840C  FFAB  001B                              RBRA _CR_BAD, !Z
001718  840E  0F98  7000                              MOVE M2M$RAMROM_DATA, R6
001719  8410  0FA0  8967  _CR_CL                      MOVE HANDLE_FILE, R8
001720  8412  FF90  0052                              ASUB f32_fread, 1
001721  8414  CFA8  0000                              CMP 0, R10

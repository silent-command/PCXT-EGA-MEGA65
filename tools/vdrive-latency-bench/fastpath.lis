001507  82F6  FFAA  001E                              RBRA _WRB_NO, !C
001508  82F8  0F98  FF22                              MOVE IO$SD_DATA_POS, R6
001509  82FA  0F9C  FF23                              MOVE IO$SD_DATA, R7
001510  82FC  0FA0  B000                              MOVE BUF_A, R8
